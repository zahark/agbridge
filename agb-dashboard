#!/usr/bin/env python3
# agb-dashboard -- watch several agent rows at once, by NAME.
#
# agterm can show a view-only grid of live sessions, one cell per pane, up to
# nine of them. Driving it by hand means knowing three things:
#
#   * **The row ids.** `agtermctl dashboard` takes ids or unique id prefixes
#     and NEVER names -- and `agb-refresh` re-mints every row, so an id you
#     wrote down is dead. That is the same trap `agb-peer-setup` was built to
#     route around, and the reason this command resolves fresh on every run.
#   * **That the `:left` suffix matters.** A BARE id takes every pane of its
#     session and agterm's nine-cell cap counts PANES, so a row somebody opened
#     a split on silently costs two cells.
#   * **That somebody has to close it.** agterm has exactly one grid and no
#     ownership token, so a grid nobody closes is a grid in everybody's way.
#
# ⚠️ **And the dangerous one, which is why this is a wrapper and not an alias.**
# When only SOME cells resolve, agterm exits **0**, opens the grid without the
# rest, and names the casualties as `unresolved: <id>` on stdout alone. So the
# honest-looking grid is the one missing the agent you opened it to watch.
#
# ⚠️ **Why a separate script and not a fourth `agb-peer` verb.** `agb-peer send`
# runs on cluster hosts, inside agents, on every message, and CPython caches no
# bytecode for a `__main__` -- so everything in that file is re-parsed by every
# agent every time. Selector resolution, a preflight and a foreground hold
# belong on the other side of that line. Same argument as `agb`/`agb_mac`/
# `agb_ops`, one tier down; same shape as `agb-peer-setup`.
#
# What it shares rather than reimplements: row matching (`match_sessions`), the
# roster grammar, `dashboard_cells` and the `Ctl` wrapper all stay in
# `agb-peer`, which remains their single owner. This script loads it by path.
# ⚠️ `close_grid` is the one thing with the same name on both sides and it is
# NOT shared -- the two differ in arity and return type for a reason argued at
# each of them, so read that before merging them.
#
# Usage:
#
#   agb-dashboard alice bob          # two rows, by label
#   agb-dashboard --roster ~/peers   # everyone in a relay roster
#   agb-dashboard --mru              # whatever you were just using

import os
import sys

VERSION = "0.1.0"

# ⚠️ The `sys.modules` key is a THREE-WAY CROSS-FILE AGREEMENT: this file,
# `agb-peer-setup`'s `PEER_MODULE`, and `tests/conftest.py`'s `peer` fixture
# (CLAUDE.md invariant 14). All three must register `agb-peer` under this exact
# string. If any one disagrees it loads a SECOND module object with its own
# `PeerError` class, so `except peer.PeerError` around a call into this script
# silently does not catch -- a failure that reads like a loader bug rather than
# like a naming disagreement, which is why it has a test of its own.
PEER_MODULE = "agb_peer"

USAGE = """usage:
  agb-dashboard <selector> [<selector> ...]   grid those rows
  agb-dashboard --roster <file>               grid a relay roster's members
  agb-dashboard --mru                         grid the rows you last used
  agb-dashboard --version

  <selector>       a substring of the row's label, its id, or an id prefix.
                   Prefer the label: `agb-refresh` re-mints every id.
  --roster <file>  participants from an `agb-peer relay` roster file
  --mru            let agterm pick; asserts no membership, so nothing is
                   resolved and nothing can be reported missing
  --detach         open the grid and exit, printing the command that closes it
  --help           this text
"""

# The parser tables, in the convention the other parsers in this project use.
DASH_FLAGS = ("--mru", "--detach", "--version", "--help")
DASH_VALUE_ARGS = ("--roster",)


class DashError(Exception):
    """This script's own one-line-message-plus-exit-code error.

    Separate from `agb-peer`'s `PeerError` only because it is raised before the
    sibling is necessarily loaded -- a usage error happens with no module in
    hand, and must not require one.
    """

    def __init__(self, message, code=1):
        Exception.__init__(self, message)
        self.code = code


def peer_path():
    """Where `agb-peer` is: beside the REAL path of this file.

    ⚠️ `realpath`, not `dirname(__file__)`, and the install instruction is why:
    this script is symlinked onto `$PATH` beside `agb-peer`, so an unresolved
    `__file__` looks in the symlink's directory and finds nothing. `agb`'s own
    `sibling_path` and `agb-peer-setup` carry the same note for the same reason
    -- and a test run from the checkout would never notice, because there the
    two coincide.
    """
    return os.path.join(os.path.dirname(os.path.realpath(__file__)), "agb-peer")


def load_peer(path=None):
    """`agb-peer` as a module, loaded once and shared.

    Mirrors `agb._load_sibling` and `agb-peer-setup.load_peer`: an early return
    out of `sys.modules` so two callers get one module object, an explicit
    `SourceFileLoader` because the file has no `.py` extension and
    `spec_from_file_location` alone would leave `spec.loader` as None, and a
    `del` on failure -- without which a half-initialised module is returned by
    the next call as if it had loaded, turning the second failure into a
    baffling AttributeError.
    """
    mod = sys.modules.get(PEER_MODULE)
    if mod is not None:
        return mod
    import importlib.util
    from importlib.machinery import SourceFileLoader
    target = path or peer_path()
    loader = SourceFileLoader(PEER_MODULE, target)
    spec = importlib.util.spec_from_file_location(PEER_MODULE, target,
                                                  loader=loader)
    mod = importlib.util.module_from_spec(spec)
    sys.modules[PEER_MODULE] = mod
    try:
        loader.exec_module(mod)
    except BaseException:
        del sys.modules[PEER_MODULE]
        raise
    return mod


def parse_args(argv):
    """Hand-rolled, matching the convention the other parsers use.

    Purely SYNTACTIC: it answers "is this argv well formed", and leaves "do
    these options make a coherent request" to `select_mode`. The split is not
    tidiness -- `--version` has to be answerable by an argv that names no mode
    at all, and folding the mode rules in here would refuse it.

    `--opt=` with an empty inline value is a MISSING-VALUE error rather than an
    empty string, in this parser as in all of them: an empty `--roster` would
    otherwise be read as a file called "".
    """
    opts = {"selectors": [], "roster": None, "mru": False, "detach": False,
            "version": False, "help": False}
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--":
            # Everything after `--` is a selector, so a label that begins with
            # a dash is still nameable.
            opts["selectors"].extend(argv[i + 1:])
            break
        if arg.startswith("--"):
            name, sep, inline = arg.partition("=")
            if name in DASH_FLAGS:
                if sep:
                    raise DashError("%s takes no value" % (name,))
                opts[name[2:].replace("-", "_")] = True
            elif name in DASH_VALUE_ARGS:
                if sep:
                    if not inline:
                        raise DashError("%s needs a value" % (name,))
                    value = inline
                else:
                    i += 1
                    if i >= len(argv):
                        raise DashError("%s needs a value" % (name,))
                    value = argv[i]
                opts[name[2:].replace("-", "_")] = value
            else:
                raise DashError("unknown option: %s" % (name,))
        else:
            opts["selectors"].append(arg)
        i += 1
    return opts


def select_mode(opts):
    """Which of the three questions this argv asks: selectors, roster or mru.

    ⚠️ **The refusals are the point.** The three modes answer different
    questions -- "watch these named rows", "watch this roster", "watch whatever
    I was just using" -- and there is no defensible way to merge them, so
    preferring one silently would be a guess dressed as a feature. `--mru`
    asserts NO membership, which is exactly why it is the one mode where a
    missing cell is not a shortfall; combining it with a membership set would
    make that exemption apply to rows the user did name.

    ⚠️ **[decision] `--roster` beside positional selectors is refused too**,
    although no checkbox demanded it. A union is defensible on paper -- both
    assert membership and `resolve_selectors` dedupes -- but nothing specifies
    how a bare selector's default `left` composes with a roster entry's own
    pane, and refusing is reversible while a silent union is not.
    """
    named = []
    if opts["selectors"]:
        named.append("selectors")
    if opts["roster"]:
        named.append("--roster")
    if opts["mru"]:
        named.append("--mru")
    if len(named) > 1:
        raise DashError(
            "%s cannot be combined -- they ask different questions; pick one"
            % (" and ".join(named),))
    if not named:
        raise DashError(
            "name at least one row, or use --roster <file> or --mru")
    if opts["mru"]:
        return "mru"
    if opts["roster"]:
        return "roster"
    return "selectors"


def main(argv, out=None, peer=None, ctl=None, read_line=None):
    out = out or sys.stdout
    if not argv:
        raise DashError(USAGE.rstrip("\n"), 1)
    opts = parse_args(argv)
    if opts["version"]:
        # Answered without loading the sibling: a version query must work in a
        # tree where `agb-peer` is missing, which is one of the things it is
        # asked in order to find out.
        out.write("agb-dashboard %s\n" % (VERSION,))
        return 0
    if opts["help"]:
        out.write(USAGE)
        return 0
    mode = select_mode(opts)
    if mode == "mru":
        return run_mru(opts, out, peer=peer, ctl=ctl, read_line=read_line)
    return run_grid(opts, out, peer=peer, ctl=ctl, read_line=read_line)


# The pane a BARE selector means. Panes reach this command only through
# `--roster`, whose grammar already carries one per participant; a positional
# selector names a row and says nothing about which half of it to show.
DEFAULT_PANE = "left"


def resolve_selectors(sessions, selectors, peer=None):
    """`[(name, want, pane)]` -> `([(name, id, pane)], [problem], [(name, kept)])`.

    ⚠️ **It takes `sessions`, not a `ctl`.** One `agtermctl tree --json`,
    fetched once by the caller. Taking the `ctl` would mean one subprocess per
    selector -- nine of them for a full grid -- and the row set can move
    between them, so two selectors could be answered by two different worlds.

    ⚠️ **It classifies on `len(match_sessions(...))` rather than calling
    `resolve`.** `resolve` raises one `PeerError` with code 2 for unresolved,
    ambiguous AND agterm-has-no-rows-at-all alike, so telling those apart
    through it would mean string-matching an error message.

    ⚠️ **THE NAME IS CARRIED, and it is not decoration.** A cell knows the word
    the user wrote for it -- a roster participant name, or the selector itself
    -- because every report about that cell has to use it. The relay argues the
    same rule where it names an excluded participant: *by NAME, not by row id;
    a hex prefix would make them go and look up which participant vanished*.
    It applies HARDER here, because this command REFUSES, so the token in the
    message is the operator's only clue which roster line to edit. The shape is
    deliberately the relay's own `(name, id, pane)` cells, so the two tools
    report the same thing the same way.

    ⚠️ **The dedupe key is `(id, pane)`, NOT the id alone.** `X:left` and
    `X:right` are two legitimate, distinct cells, and a roster may hold
    `alice=<label>` beside `split=<same label>:right`. Deduping by id would
    silently drop one -- the same class of missing cell this command exists to
    remove. First-seen order is kept, and it is a DEDUPE rather than a refusal:
    two ways of naming one cell is not a user error, spending two of the nine
    cells on it is the bug.

    ⚠️ **What it deduped is RETURNED, though, because a silent drop is the
    worse bug.** The relay reports the identical situation by name
    (`_one_name_per_row`) and refuses to let the second name stand; here the
    two names are kept and the cell is shown once, so the third value is what
    stops that being invisible. It is not a `problem`: a problem refuses.

    A bare string selector is accepted as `(selector, selector, DEFAULT_PANE)`
    -- the defaulting rule lives here, with the resolution, rather than being
    spelled at each call site.
    """
    peer = peer or load_peer()
    resolved, problems, folded, seen = [], [], [], {}
    for item in selectors:
        if isinstance(item, str):
            name, want, pane = item, item, DEFAULT_PANE
        else:
            name, want, pane = item
        matches = peer.match_sessions(sessions, want)
        if not matches:
            problems.append("%s: no row matches it -- `agb-peer --list` shows "
                            "them" % (want,))
            continue
        if len(matches) > 1:
            names = ", ".join(str(s.get("name") or s.get("id"))
                              for s in matches[:5])
            problems.append("%s: matches %d rows (%s) -- use a longer prefix "
                            "or the row id" % (want, len(matches), names))
            continue
        key = (matches[0]["id"], pane)
        if key in seen:
            folded.append((name, seen[key]))
            continue
        seen[key] = name
        resolved.append((name, key[0], key[1]))
    return resolved, problems, folded


def wanted_from(opts, peer):
    """What this argv asks to be shown, as `(name, want, pane)` triples.

    ⚠️ **The participant NAME is kept, and it used to be thrown away here.**
    A roster line is `carol=<row>:<pane>`; only `<row>` was passed on, so every
    later report about that cell could name it by row-id prefix at best --
    which is the one thing this whole command exists not to make people do.
    `carol` is what the operator typed and what they will search the file for,
    and it is unique per line where a `<row>` substring need not be. For a
    positional selector the name IS the selector: the word the user wrote is
    the best token either way.

    The roster is parsed with **`minimum=1`**, not the default 2. agterm
    accepts a one-cell grid (measured), and a one-participant roster is a legal
    thing to want to watch -- a relay needs somebody to talk to, a grid does
    not. `agb-peer-setup` records the same asymmetry deliberately.
    """
    if opts["roster"]:
        spec = peer.parse_roster_text(peer.read_roster_file(opts["roster"]),
                                      minimum=1)
        return [(name, spec[name][0], spec[name][1]) for name in sorted(spec)]
    return [(want, want, DEFAULT_PANE) for want in opts["selectors"]]


class _Quiet(object):
    """An `out` whose `write` CANNOT RAISE -- for everything printed once the
    grid is UP.

    🔴 **A user-facing write sitting outside the cleanup guard**, which is the
    same shape as three earlier bugs in this area and was demonstrated with a
    probe rather than argued. `agb-dashboard alice | head` closes stdout the
    instant `head` exits, and the next write raises `BrokenPipeError`. Every
    line printed between `ctl.dashboard(...)` answering ok and the hold's
    `finally` was outside any guard, so that exception unwound straight past
    the close -- `__main__` reports it (a `BrokenPipeError` is an `OSError`, so
    `is_handled` catches it and exits 1) and the run ends with a grid on the
    only screen agterm has and nothing owning it:

        BrokenPipeError closed
        [('tree',), ('dashboard', ['AAAA1111:left'])]      # opened, never closed

    ⚠️ **Applied at the moment the grid goes up, rather than around each
    call.** A report ADDED later is then covered by construction instead of by
    the next author remembering -- which is the failure mode itself: `agb-peer`
    already had `_quiet` for the relay's `say`, written for this exact reason,
    and the newer file did not carry it. Before that point there is nothing to
    orphan, and a write that fails there SHOULD be fatal.
    """

    def __init__(self, out):
        self.out = out

    def write(self, text):
        try:
            self.out.write(text)
        except Exception:
            pass


def close_grid(ctl):
    """`(closed, why)` for agterm's one grid -- and it NEVER raises.

    🔴 **`Ctl.dashboard_close` can raise, and both callers here assumed a
    two-tuple.** `_spawn` raises `PeerError` when agtermctl cannot be started
    at all -- a removed binary, a `$PATH` an agterm pane did not inherit, the
    `/proc/<pid>/exe (deleted)` case after an upgrade. On the strict path that
    meant the `DashError` naming the still-up partial grid was never
    constructed: the user got an errno and no word that a grid is on screen,
    which is precisely the failure this command exists to prevent. In the
    hold's `finally` it replaced the exit with a traceback out of the cleanup.
    The reason to catch it here rather than at each site is that both need the
    same answer -- "no, and here is why" -- which is what the two-tuple already
    says.

    ⚠️ **`agb-peer` has a `close_grid` too, and this is NOT it.** Same name,
    different arity and a different return: the relay's takes a `say` and
    answers a bool, because it has a running loop to report into and a
    latched ownership flag to clear. This one has neither -- its two callers
    put the reason inside a `DashError` and inside a printed warning -- so it
    hands the reason back instead. The file header lists what this script
    shares rather than reimplements; this is the one that is reimplemented,
    and it is argued here rather than left for a reader to notice, the way
    `open_split`/`open_drawer` are. What they share is the REASON to exist,
    which lives on `Ctl.dashboard_close` where both can see it.
    """
    try:
        return ctl.dashboard_close()
    except Exception as exc:
        return False, "%s" % (exc,)


def run_grid(opts, out, peer=None, ctl=None, read_line=None):
    """Resolve, preflight, open -- and refuse rather than show a partial grid.

    ⚠️ **Fail-closed on asserted membership.** Selectors and a roster both say
    "these are the agents I want to watch", so anything short of all of them is
    a shortfall and opens nothing: an unresolved selector, an ambiguous one, a
    participant in a pane the grid cannot express, or a cell agterm itself
    dropped. `--mru` is the exempt mode precisely because it asserts no
    membership.
    """
    peer = peer or load_peer()
    ctl = ctl if ctl is not None else peer.Ctl()
    wanted = wanted_from(opts, peer)
    sessions = peer.sessions_of(ctl.tree())
    if not sessions:
        # Its own message rather than N identical "no row matches" lines: with
        # no rows at all the answer is about agterm, not about what was typed.
        raise DashError("agterm reports no sessions at all -- is it running, "
                        "and is a bridge up?", 2)
    resolved, problems, folded = resolve_selectors(sessions, wanted, peer)
    if problems:
        # ⚠️ Refused **without calling `agtermctl dashboard`** -- not without
        # calling agtermctl at all: the `tree --json` above has already run, by
        # design. Opening the rest is exactly what this command exists not to
        # do, and there is no `--partial`: shipping one unrequested would
        # reintroduce the behaviour being removed, behind a flag nobody knows
        # to avoid.
        raise DashError("nothing opened -- %d selector(s) did not resolve:"
                        "\n  %s" % (len(problems), "\n  ".join(problems)), 2)
    cells, excluded = peer.dashboard_cells([(r[1], r[2]) for r in resolved])
    if excluded:
        # ⚠️ **A shortfall HERE, unlike in the relay**, where the same exclusion
        # is reported and the grid opens anyway. The relay's grid is an adjunct
        # to carrying messages; this command's entire output is the grid, so a
        # roster naming a `scratch` participant must refuse rather than open one
        # quietly missing them.
        #
        # ⚠️ **BY NAME, not by row-id prefix**, which is the relay's argued rule
        # (`update_grid`) and applies harder here: this refuses, so the token in
        # the message is the operator's only clue which roster line to edit.
        # `BBBB2222 (scratch)` sent them to look up an id they never wrote --
        # and `agb-refresh` re-mints ids, which is the trap the whole command
        # routes around.
        away = set(excluded)
        raise DashError("nothing opened -- agterm's grid takes only %s panes, "
                        "and these are elsewhere: %s"
                        % ("/".join(peer.DASHBOARD_PANES),
                           ", ".join("%s (%s)" % (name, pane)
                                     for name, row, pane in resolved
                                     if (row, pane) in away)), 2)
    if len(cells) > peer.DASHBOARD_MAX_CELLS:
        # ⚠️ **After the dedupe**, so two spellings of one cell do not spend
        # two of the nine. Preflighted rather than left to agterm because every
        # cell carries an explicit pane, which turns agterm's cap on PANES into
        # a cap on agents and makes this count exact.
        #
        # ⚠️ **And after the EXCLUSION, which it was not**, so the count is of
        # cells that could actually go in a grid. The relay applies its cap in
        # this order too. Measured the other way round: ten participants of
        # which two are `:scratch` -- eight gridable -- refused with "shows 9
        # cells; got 10" and never mentioned the scratch ones, so fixing the
        # count was two round trips against a roster that was one edit from
        # working.
        raise DashError("agterm's dashboard shows %d cells; got %d"
                        % (peer.DASHBOARD_MAX_CELLS, len(cells)), 2)
    ok, said, why = ctl.dashboard(cells)
    if not ok:
        # agterm refuses an invalid id and a wholly unresolvable set BEFORE
        # opening anything (measured), so there is no grid to close here.
        raise DashError("the dashboard would not open: %s" % (why,), 2)
    # 🔴 **From here a grid is UP and this run owns it**, so nothing printed
    # may be able to abort the path that closes it. See `_Quiet`.
    out = _Quiet(out)
    missed = peer.unresolved_lines(said)
    if missed:
        # 🔴 **CLOSE FIRST, THEN REFUSE.** agterm prints `unresolved:` *after*
        # it has already opened the grid with the rest, so exiting on it would
        # leave exactly the silently-partial grid this command exists to
        # remove -- and with no hold running, nothing else would ever close it.
        closed, why_close = close_grid(ctl)
        raise DashError(
            "agterm opened the grid without every row and said so on stdout: "
            "%s -- %s" % ("; ".join(missed),
                          "closed it again" if closed
                          # ⚠️ **The literal command, here too.** It was
                          # printed when the HOLD's close failed and not when
                          # this one did, on the reasoning that the moment a
                          # user most needs it is the moment they least want to
                          # go and look it up -- which is the same moment. Two
                          # docs claimed it was printed here already.
                          else "AND THE GRID IS STILL UP (%s). Close it with: "
                               "%s" % (why_close, CLOSE_COMMAND)), 2)
    named = dict((s["id"], s.get("name")) for s in sessions)
    out.write("agb-dashboard: %d cell(s)\n" % (len(cells),))
    for _name, row, pane in resolved:
        # `_name`: the report is the record of what went on the SCREEN, so it
        # names each cell the way agterm does. The selector that asked for it
        # is what the REFUSALS use, where the operator has to go and edit
        # something -- two different questions, deliberately answered with two
        # different tokens.
        out.write("  %s %s %s\n" % (row[:8], pane, named.get(row) or ""))
    for name, kept in folded:
        # ⚠️ **Said, not silent.** A dedupe is not a shortfall -- two ways of
        # naming one cell is not a user error -- so it does not refuse. But the
        # relay reports the identical situation by name, and a roster is its
        # grammar: without this, `carol` is simply not on the screen and
        # nothing anywhere says which name went or why.
        out.write("  (%s names the same cell as %s -- shown once)\n"
                  % (name, kept))
    return finish(opts, out, ctl, read_line)


def run_mru(opts, out, peer=None, ctl=None, read_line=None):
    """agterm picks the rows; this command asserts nothing about them.

    ⚠️ **The strict `unresolved:` rule is deliberately NOT applied here**, and
    that is not an oversight to be tidied up later. Everywhere else it is
    sound because the user named a membership, so anything agterm dropped is a
    measurable shortfall against what was asked for. `--mru` names nobody, so
    there is no set to fall short of -- and a line agterm printed about a row
    this command never requested would be reported as *our* failure and would
    close a grid the user can perfectly well use.

    Nothing is resolved, so there is no `tree --json` either: no selector means
    no question to ask about the row set.
    """
    peer = peer or load_peer()
    ctl = ctl if ctl is not None else peer.Ctl()
    ok, _said, why = ctl.dashboard(["--mru"])
    if not ok:
        raise DashError("the dashboard would not open: %s" % (why,), 2)
    # The grid is up and this run owns it -- see `_Quiet`, and `run_grid`.
    out = _Quiet(out)
    out.write("agb-dashboard: --mru -- agterm chose the rows.\n"
              "  No membership was asserted, so nothing was resolved and\n"
              "  nothing can be reported missing. Name rows to get that check.\n")
    return finish(opts, out, ctl, read_line)


# The literal, copy-pasteable way to close the grid by hand. Printed on the
# `--detach` path because that run ends with a grid up and nothing owning it,
# and again when a hold's own close FAILS -- which is the moment a user most
# needs it and least wants to go and look it up.
CLOSE_COMMAND = "agtermctl dashboard --close"

# ⚠️ Both facts are things the tool has to SAY, not only document.
#
#   * **Run it from outside agterm.** That is the condition Task 0's
#     measurement holds under: a terminal outside agterm stayed responsive
#     while a grid was up, and a blocking read returned on Enter. Whether a
#     shell *inside* an agterm session does the same is untested, so the tool
#     names the route that was measured rather than implying both work.
#   * **A held grid does not follow.** `agb-refresh` re-mints every row id, and
#     these cells carry the ids resolved at open, so a refresh under a held
#     grid leaves dead cells. `agb-peer relay --dashboard` is the one that
#     re-resolves and re-opens; this is a one-shot. Saying so here rather than
#     only in the docs is deliberate -- the person who needs it is looking at
#     the grid, not at `docs/commands.md`.
HOLD_NOTE = (
    "  Run this from a terminal OUTSIDE agterm -- that is where the hold was\n"
    "  measured to stay responsive while a grid is up.\n"
    "  This grid does NOT follow: an `agb-refresh` re-mints every row id and\n"
    "  leaves dead cells here. `agb-peer relay --dashboard` is the one that\n"
    "  re-resolves and re-opens.\n"
    "press enter to close the grid (Ctrl-C closes it too)\n")


def finish(opts, out, ctl, read_line=None):
    """What happens to the grid now that it is up: held, or handed over.

    ⚠️ **Something must own a grid, because agterm has exactly one and no
    ownership token.** The default is therefore to hold it in the foreground
    and close it on the way out; `--detach` is the explicit hand-over, and it
    prints the close command precisely because after it nothing else will.
    """
    if opts["detach"]:
        out.write("agb-dashboard: left open (--detach). Close it with:\n"
                  "  %s\n" % (CLOSE_COMMAND,))
        return 0
    return hold(out, ctl,
                read_line if read_line is not None else sys.stdin.readline)


def hold(out, ctl, read_line):
    """Wait, then close the grid -- on enter, on EOF and on `Ctrl-C` alike.

    ⚠️ **EOF IS AN EMPTY STRING, NOT AN EXCEPTION.** `sys.stdin.readline()`
    returns `""` at end of input; it does not raise `EOFError`, which is what
    `input()` does. `agb-peer-setup` -- the same family of file -- treated the
    real `""` as an ordinary answer and every re-prompting loop in it spun:
    measured at 305,869 menu prints and 1.8 million lines in six seconds, on
    any non-interactive invocation. This function reads **once**, so it cannot
    spin whatever comes back; the empty string is still tested explicitly
    because it means something different from a keypress and is worth saying.

    ⚠️ **The discriminator is the NEWLINE, so the RAW value is tested before
    stripping.** Enter gives `"\n"`, which strips to `""` and means "close it";
    EOF gives `""` with no newline. Strip first and the two become
    indistinguishable, and the dangerous one silently becomes the harmless one.

    ⚠️ **The close is in a `finally`, which is the whole point of holding.**
    `Ctrl-C` is the documented way out of a foreground wait and is not an
    `Exception`, so an `except` clause here would miss it and orphan the grid
    this run opened -- the one failure mode the hold exists to prevent. The
    `KeyboardInterrupt` is then left to propagate: `__main__` already reports
    it as an exit rather than a crash.
    """
    try:
        # ⚠️ **INSIDE the `try`, and it was not.** The caller wraps `out` once
        # the grid is up, so this is belt and braces there -- but `hold` is the
        # function whose entire job is the close, and a write of its own
        # sitting outside its own guard makes that contract depend on who
        # called it.
        out.write(HOLD_NOTE)
        try:
            raw = read_line()
        except EOFError:
            # `input()`-shaped readers still work, even though the real one
            # cannot get here.
            raw = ""
        if raw == "":
            # ⚠️ `is None` was tested here too, and nothing can produce it:
            # `readline` returns `""`, `input()` raises, and the `Reader` fake
            # models the first. An unreachable arm is indistinguishable from a
            # guard that quietly narrows -- the rule this file applied to two
            # other branches and not to this one.
            out.write("agb-dashboard: stdin ended -- closing the grid\n")
    finally:
        closed, why = close_grid(ctl)
        if not closed:
            out.write("agb-dashboard: the grid would not close (%s)\n"
                      "  IT IS STILL UP. Close it with:\n"
                      "  %s\n" % (why, CLOSE_COMMAND))
    # ⚠️ **0 even when the close failed, and the asymmetry with the strict
    # path's exit 2 is deliberate.** There the run FAILED -- it could not show
    # what was asked for -- and the leftover grid is a second casualty of that.
    # Here the run did exactly what it was asked: it opened the grid, held it,
    # and the user ended it. A grid left up is not by itself a failure, which
    # `--detach` says by being a supported mode that ends the same way. What
    # the user needs is the warning and the command, in capitals, and that is
    # printed above.
    return 0


# The classes that reach `__main__` and are a message rather than a crash.
#
#   * `PeerError` -- the sibling's own, for anything it refuses: a tree that is
#     not JSON, a roster that will not parse, an agtermctl that will not start.
#     `RosterConflict` is a SUBCLASS and needs no entry of its own; see below.
#   * `AgbError` -- `agb_ops`' hand-rolled parsers raise it. Nothing here loads
#     `agb_ops` today, so this one has no reachable raiser and is kept
#     deliberately: `agb-peer-setup`, from the same family, does load it, and a
#     name absent from this tuple escapes as a traceback rather than a message.
#   * `OSError` -- `agb.read_config` re-raises every errno except
#     ENOENT/ENOTDIR, and an unreadable roster is an `OSError` too.
#
# ⚠️ `IOError` is NOT here: it is an alias of `OSError` in Python 3, so it can
# never be a class `__name__` and the entry that named it was decoration.
HANDLED_ERRORS = ("PeerError", "AgbError", "OSError")


def is_handled(error):
    """Is this one of `HANDLED_ERRORS`, including by inheritance?

    ⚠️ **Matched by class NAME rather than in an `except` clause** because
    naming the sibling's classes there would mean importing the sibling first,
    and a usage error is raised with no module in hand.

    🔴 **Over the whole MRO, not `type(error).__name__`.** That is not a
    generalisation, it is the bug: a real filesystem error arrives as
    `FileNotFoundError` or `PermissionError`, whose `__name__` is neither
    `"OSError"` nor `"IOError"` -- so the two entries written to catch exactly
    those were INERT, and an unreadable roster file ended in a traceback. The
    MRO also makes `RosterConflict` fall out of `PeerError` instead of needing
    its own entry, which is what the old exact match had to spell by hand.
    """
    return bool(set(cls.__name__ for cls in type(error).__mro__)
                & set(HANDLED_ERRORS))


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except DashError as error:
        sys.stderr.write("agb-dashboard: %s\n" % (error,))
        sys.exit(error.code)
    except KeyboardInterrupt:
        # Its own clause because it is not an `Exception` -- the class-name
        # match below cannot see it, and a `Ctrl-C` at the foreground hold is
        # the DOCUMENTED way to end a held grid rather than a crash.
        sys.stderr.write("agb-dashboard: interrupted\n")
        sys.exit(1)
    except Exception as error:
        if is_handled(error):
            sys.stderr.write("agb-dashboard: %s\n" % (error,))
            sys.exit(getattr(error, "code", 1))
        raise
