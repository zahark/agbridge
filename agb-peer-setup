#!/usr/bin/env python3
# agb-peer-setup -- build an `agb-peer relay --roster` file, interactively.
#
# The roster grammar is `name=<row>[:<pane>][@<target>[:<tmux>]]`, and writing
# one by hand means knowing three things that are not obvious:
#
#   * **What text goes in `<row>`.** Not the row title agterm shows -- that is
#     `label · host · cwd · pane · beat`, and `parse_roster_text` splits on
#     WHITESPACE, so a title cannot be a spec at all. Not the row id either:
#     `agb-refresh` re-mints every row and every id changes, which is why
#     `docs/commands.md` says to name a label substring.
#   * **The suffix grammar**, including that `:<tmux>` without `@<target>`
#     reparses as a pane rather than meaning what it looks like.
#   * **That the write has to be ATOMIC.** A roster rewritten in place can be
#     read truncated at a line boundary, and a truncated roster parses cleanly
#     as a shorter one -- so the relay applies a departure nobody asked for.
#
# So this is a picker over live rows plus one writer that gets the third right.
#
# ⚠️ **Why this is a separate script and not a fourth `agb-peer` verb.**
# `agb-peer send` runs on cluster hosts, inside agents, on every message, and
# CPython caches no bytecode for a `__main__` -- so everything in that file is
# re-parsed by every agent every time. A menu loop, a picker and config
# resolution belong on the other side of that line. It is the same argument
# that produced `agb`/`agb_mac`/`agb_ops`, one tier down.
#
# What it shares rather than reimplements: the roster grammar, its validation,
# the byte gate and both writers all live in `agb-peer`, which stays the single
# owner of the file format. This script loads it by path and calls it.
#
# Usage:
#
#   agb-peer-setup <roster-file>          # the interactive editor
#   agb-peer-setup validate <roster-file> # would `agb-peer relay` start?

import os
import sys

VERSION = "0.1.0"

# ⚠️ The `sys.modules` key is a CROSS-FILE AGREEMENT with tests/conftest.py's
# `peer` fixture (CLAUDE.md invariant 14). Both must register the module under
# this exact string, or a test gets a second module object and
# `setup.PeerError is peer.PeerError` fails -- in a way that reads like a
# loader bug rather than a naming disagreement.
PEER_MODULE = "agb_peer"

USAGE = """usage:
  agb-peer-setup <roster-file>            build or edit a relay roster
  agb-peer-setup validate <roster-file>   would `agb-peer relay` start with it?
  agb-peer-setup --version
"""


def peer_path():
    """Where `agb-peer` is: beside the REAL path of this file.

    ⚠️ `realpath`, not `dirname(__file__)`, and the install instruction is why:
    this script is symlinked onto `$PATH` beside `agb-peer`, so an unresolved
    `__file__` looks in the symlink's directory and finds nothing. `agb`'s own
    `sibling_path` carries the same note for the same reason -- and a test run
    from the checkout would never notice, because there the two coincide.
    """
    return os.path.join(os.path.dirname(os.path.realpath(__file__)), "agb-peer")


def load_peer(path=None):
    """`agb-peer` as a module, loaded once and shared.

    Mirrors `agb._load_sibling`: an early return out of `sys.modules` so two
    callers get one module object, an explicit `SourceFileLoader` because the
    file has no `.py` extension and `spec_from_file_location` alone would leave
    `spec.loader` as None, and a `del` on failure -- without which a
    half-initialised module is returned by the next call as if it had loaded,
    turning the second failure into a baffling AttributeError.
    """
    mod = sys.modules.get(PEER_MODULE)
    if mod is not None:
        return mod
    import importlib.util
    from importlib.machinery import SourceFileLoader
    target = path or peer_path()
    loader = SourceFileLoader(PEER_MODULE, target)
    spec = importlib.util.spec_from_file_location(PEER_MODULE, target,
                                                  loader=loader)
    mod = importlib.util.module_from_spec(spec)
    sys.modules[PEER_MODULE] = mod
    try:
        loader.exec_module(mod)
    except BaseException:
        del sys.modules[PEER_MODULE]
        raise
    return mod


# agterm joins a row's title with this, and the LABEL is the first component.
# Spelled here rather than imported because `agb_mac` is a Mac-side sibling of
# `agb`, not of this script, and loading it to read one constant would drag in
# the whole bridge. It is a cross-file agreement with `agb_mac.TITLE_SEP`; a
# disagreement shows up as every row being refused for containing whitespace.
TITLE_SEP = " \u00b7 "

# `agb_mac` prefixes a title when the row is not a live agent. Both END in a
# space, so leaving them on makes the first component "[?] label" -- which the
# whitespace rule below then refuses, making every stale or finished row
# unpickable for a reason that reads like a bug.
TITLE_PREFIXES = ("[?] ", "[done] ")

# What a `<row>` may not contain: `parse_roster_text` splits lines on
# WHITESPACE, and `@` and `:` are the suffix grammar.
ROW_FORBIDDEN = ("@", ":")


def row_value(session):
    """(label, None) for a usable `<row>`, else (None, reason).

    ⚠️ **The label, not the title, and not the id.** The title is
    `label · host · cwd · pane · beat` and `parse_roster_text` splits on
    whitespace, so a title can never be a spec. The id is worse in a way that
    looks fine: it works today and breaks at the next `agb-refresh`, which
    re-mints every row -- which is why `docs/commands.md` says to name a label
    substring.

    ⚠️ **`row_fields` is configurable and this assumes the default order.**
    `label,host,cwd,pane,beat` puts the label first; `row_fields = host,label`
    would put the host there instead, and this would happily propose it. The
    failure is a plausible-looking `<row>` that resolves to the wrong row or to
    nothing -- which is what `row_is_unique` is for. Detecting the setting would
    mean reading the bridge's config to answer a question the uniqueness check
    already answers better.
    """
    title = str(session.get("name") or "")
    for prefix in TITLE_PREFIXES:
        if title.startswith(prefix):
            title = title[len(prefix):]
            break
    label = title.split(TITLE_SEP)[0].strip()
    if not label:
        return None, "that row has no label to name it by"
    if label.split() != [label]:
        return None, ("%r contains whitespace, and a roster line is split on "
                      "whitespace" % (label,))
    for char in ROW_FORBIDDEN:
        if char in label:
            return None, ("%r contains %r, which is roster grammar"
                          % (label, char))
    return label, None


def row_is_unique(peer, sessions, candidate, picked):
    """True when `candidate` resolves to `picked` and to nothing else.

    ⚠️ **`len(matches) == 1` is NOT "the right row", and the difference is a
    silent wrong answer.** `match_sessions` returns the first NON-EMPTY tier --
    exact id, then id prefix, then name substring -- so a label that happens to
    prefix some other row's id wins on the id tier and never reaches the name
    tier at all. One match, confidently, on a row the user did not pick.
    """
    matches = peer.match_sessions(sessions, candidate)
    if not matches:
        return False, "%r matches no row" % (candidate,)
    if len(matches) > 1:
        names = ", ".join(str(m.get("name") or m.get("id"))
                          for m in matches[:3])
        return False, ("%r matches %d rows (%s) -- it has to name exactly one"
                       % (candidate, len(matches), names))
    if matches[0].get("id") != picked.get("id"):
        return False, ("%r resolves to %r, not to the row you picked -- an id "
                       "prefix beats a label"
                       % (candidate, matches[0].get("name")
                          or matches[0].get("id")))
    return True, None


def format_candidates(sessions):
    """[(display, session)] for the picker. Pure: the caller numbers them.

    ⚠️ **MODE is deliberately not shown, and `agb-peer --list` does show it.**
    That listing exists to answer "can I send to this right now", so a
    disagreement with the tool would be worse than no listing at all. This one
    answers "which row do you mean", and the answer is resolved again at write
    time and again by the relay on every tick -- so a mode read here would cost
    one `session text` per row on an interactive path and still be stale by the
    time anybody uses the file.
    """
    rows = []
    for session in sessions:
        label, _reason = row_value(session)
        rows.append(("%-24s %-8s %s"
                     % (label or (session.get("name") or "?"),
                        str(session.get("id") or "")[:8],
                        session.get("cwd") or ""), session))
    return rows


def discover_rows(peer, ctl, say):
    """Live rows, freshly. `[]` and a message when agterm cannot be reached.

    ⚠️ **Fresh on every call, never cached for the session.** Rows are exactly
    what changes while somebody sets this up -- an agent starts, `agb-refresh`
    re-mints every id. And a discovery failure must never abort the editor:
    typing a label by hand is the fallback the whole tool degrades to.
    """
    try:
        return peer.sessions_of(ctl.tree())
    except peer.PeerError as exc:
        say("agterm could not be reached (%s) -- type a row label instead"
            % (exc,))
        return []


# Where `agb` lives on a Mac. `agb-refresh` spells the same default, and for
# the same reason: the bridge loads its modules from the INSTALL, not from a
# checkout, so a tool that reads the same config has to look where the running
# system does.
DEFAULT_AGB = os.path.join(os.path.expanduser("~"), ".local", "lib",
                           "agbridge", "agb")


def load_ops(agb_path=None):
    """`agb_ops`, through `agb`'s own door. Raises `SetupError` if it cannot.

    ⚠️ **`agb._load_ops()`, not a second loader.** That function already does
    all of this -- registers `agb` in `sys.modules` first so the sibling's own
    `import agb` binds the module already running, then loads by path -- and
    `tests/conftest.py` routes through it deliberately, so that a broken door
    fails tests rather than being quietly bypassed. Reimplementing it here
    would be a second copy free to drift from the first.

    `agb` itself still has to be loaded by path, because THIS script is not one
    of its siblings; only that first hop is ours.
    """
    import importlib.util
    from importlib.machinery import SourceFileLoader
    target = agb_path or DEFAULT_AGB
    if not os.path.isfile(target):
        raise SetupError("no agb at %s -- pass --agb <path>" % (target,), 3)
    agb = sys.modules.get("agb")
    if agb is None or getattr(agb, "__file__", None) != target:
        loader = SourceFileLoader("agb", target)
        spec = importlib.util.spec_from_file_location("agb", target,
                                                      loader=loader)
        agb = importlib.util.module_from_spec(spec)
        sys.modules["agb"] = agb
        loader.exec_module(agb)
    return agb, agb._load_ops()


def agbridge_hint(ops, session):
    """A picked row's own `agb pane` options, or None if it is not one.

    ⚠️ **`agb_ops.parse_pane_args`, not a hand-rolled walk over `foreground`.**
    That array is a real argv with a real parser, and CLAUDE.md's rule for
    exactly this case is: where it is not ambiguous, CALL the parser rather
    than imitating it. An imitation also cannot reproduce a REFUSAL -- an argv
    `agb pane` would reject describes a row whose settings cannot be trusted,
    and a walk would confidently return values from it.

    A refusal here is `None`, not an exception: `foreground` is whatever
    somebody launched, so `AgbError` is an ordinary answer rather than a fault.
    """
    argv = session.get("foreground") or []
    try:
        index = list(argv).index("pane")
    except ValueError:
        return None
    try:
        opts = ops.parse_pane_args(list(argv)[index + 1:])
    except Exception as exc:                       # agb.AgbError, by any name
        if type(exc).__name__ != "AgbError":
            raise
        return None
    return opts if opts.get("host") else None


def row_target(ops, hint, unreadable):
    """The row's own resolved ssh target, via `agb pane`'s own resolver.

    ⚠️ **`unreadable` is the CALLER's list and is passed straight through.**
    Handing `pane_settings` a fresh `[]` here would look identical and report
    nothing: the caller's list stays empty, so the "could not read the config"
    branch downstream can never fire, and an EACCES config degrades silently to
    a bare hostname -- which is the wrong-machine bug with the diagnostic
    removed. `pane_settings`' own docstring is a write-up of that failure.
    """
    target, _jump = ops.pane_settings(hint, unreadable=unreadable)
    return target


def host_choices(agb, ops, hint, unreadable):
    """[(hostname, ssh target)] from the RIGHT instance's config.

    ⚠️ **The instance is the one the picked ROW belongs to**, named by its own
    `--config`, because a Mac running two bridges has two `host_<name>` tables
    and reading the default one would resolve instance B's rows through
    instance A's table. A row minted by a DEFAULT install carries no `--config`
    at all -- that is every default install, not a legacy case -- and
    `read_config(None)` is exactly the right answer for it.

    ⚠️ **`pane_settings` cannot answer this and never could**: it returns one
    target for one host, and deliberately never exposes the table. Enumerating
    it is a separate read, which is why the failure has to be collected
    separately too.
    """
    if hint is None:
        return []
    try:
        config = agb.read_config(hint.get("config"))
    except (IOError, OSError) as exc:
        unreadable.append(exc)
        return []
    return sorted((key[len("host_"):], value)
                  for key, value in config.items()
                  if key.startswith(ops.CONFIG_KEY_PREFIXES[0]))


def offer_agbridge_default(ops, hint, config):
    """Whether `[a]` -- "let the relay read the row's own host" -- is honest.

    ⚠️ **The relay does NOT apply the `host_<name>` mapping.**
    `scan_participant` takes `pane_argv_field(foreground, "--host")` and hands
    it to ssh VERBATIM. So on a host that needs an alias, `[a]` produces a
    roster that parses, validates, prints a working-looking next command, and
    then silently never delivers. Offering it only when the mapping is a no-op
    is what keeps that option truthful.
    """
    if not hint or not hint.get("host"):
        return False
    host = hint["host"]
    return ops.ssh_target_for(host, config or {}) == host


class Draft(object):
    """The roster being edited: an ORDERED list, plus the bytes it came from.

    ⚠️ **`entries` is a list of `(name, spec)`, not `parse_participants`' dict.**
    That dict keeps insertion order only as a CPython 3.6 implementation
    detail, and 3.6.8 is this project's floor -- so "delete the second one"
    cannot be built on it. The order here is the FILE's line order, re-derived
    from the lines rather than read out of the dict.

    `loaded` is whatever `roster_bytes` answered when this session opened the
    file: the bytes, or `ROSTER_ABSENT`. It is the gate a later write compares
    against, so it must not be refreshed by anything but a write or a reload.
    """

    def __init__(self, path, entries=None, loaded=None):
        self.path = path
        self.entries = list(entries or [])
        self.loaded = loaded
        self.dirty = False

    def names(self):
        return [name for name, _spec in self.entries]

    def index_of(self, name):
        for i, (existing, _spec) in enumerate(self.entries):
            if existing == name:
                return i
        return -1


def load_draft(peer, path, say):
    """Open `path` for editing, repairing what can be repaired.

    ⚠️ **`minimum=1`, not the default 2.** A one-participant roster is a legal
    state for a RUNNING relay -- somebody left -- and refusing to open one
    would mean this tool cannot be used to add the second participant back.

    ⚠️ **Empty, malformed and not-UTF-8 are REPAIR paths, not refusals.** Those
    are precisely the files somebody needs an editor for. `loaded` is still set
    from the raw bytes, so a later write still gates against what was really
    there; only the parsed entries are dropped.

    ⚠️ **Unreadable is NOT a repair path**, and that asymmetry is the point.
    `roster_bytes` raises for it, and opening anyway would mean a later write
    gates against nothing and renames over a file nobody could read -- the
    vacuous gate this whole design exists to avoid. It propagates.

    A malformed file's surviving lines are deliberately not salvaged one by
    one: `parse_roster_text` is all-or-nothing, and a partial salvage would
    have to re-implement the grammar to decide which lines survived.
    """
    raw = peer.roster_bytes(path)                  # unreadable raises, on purpose
    if raw is peer.ROSTER_ABSENT:
        say("%s does not exist yet -- starting an empty roster" % (path,))
        return Draft(path, [], peer.ROSTER_ABSENT)
    try:
        entries = parse_ordered(peer, raw)
    except peer.PeerError as exc:
        say("%s could not be read as a roster (%s) -- starting an empty draft; "
            "writing will replace it" % (path, exc))
        return Draft(path, [], raw)
    if len(entries) < 2:
        say("note: %d participant(s). A relay cannot START with fewer than 2, "
            "though a running one can drop to 1 when somebody leaves."
            % (len(entries),))
    return Draft(path, entries, raw)


def parse_ordered(peer, raw):
    """`[(name, spec)]` in the file's LINE order.

    The whole file goes through `parse_roster_text` first, so the grammar and
    every refusal are the relay's own -- this only decides the ORDER, by
    walking the lines again and looking each name up in the parsed result.

    ⚠️ **This walk is NOT mutation-distinguishable, and that is worth saying
    out loud rather than leaving as an implied guarantee.** On CPython 3.6+ a
    dict preserves insertion order, `parse_participants` inserts in word order,
    and word order is file order -- so `[(n, people[n]) for n in people]`
    returns exactly the same list for every input, and a test cannot tell the
    two apart on any interpreter this project runs on. Measured: substituting
    the dict comprehension leaves the whole suite green.

    It is kept because the ORDER IS A CONTRACT HERE and should be stated
    rather than inherited: `[d]` deletes by position and `[e]` edits in place,
    so a reader asking "what fixes the order" should find an answer in the code
    rather than a language guarantee two files away. That is a legibility
    argument, not a correctness one, and pretending otherwise would put a guard
    in the suite that defends against nothing.
    """
    people = peer.parse_roster_text(raw, minimum=1)
    text = raw.decode("utf-8") if isinstance(raw, bytes) else raw
    entries, seen = [], set()
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        for word in line.split():
            name = word.partition("=")[0]
            if name in people and name not in seen:
                seen.add(name)
                entries.append((name, people[name]))
    for name in people:                            # belt and braces
        if name not in seen:
            entries.append((name, people[name]))
    return entries


def main(argv, out=None, peer=None, read_line=None, ctl=None):
    out = out or sys.stdout
    if not argv:
        raise SetupError(USAGE.rstrip("\n"), 1)
    if argv[0] in ("--version", "version"):
        out.write("agb-peer-setup %s\n" % (VERSION,))
        return 0
    if argv[0] == "validate":
        if len(argv) != 2:
            raise SetupError("validate takes one roster file", 1)
        return cmd_validate(argv[1], out, peer=peer)
    if len(argv) != 1 or argv[0].startswith("-"):
        raise SetupError(USAGE.rstrip("\n"), 1)
    return run_editor(argv[0], out, peer=peer, read_line=read_line, ctl=ctl)


class SetupError(Exception):
    """This script's own one-line-message-plus-exit-code error.

    Separate from `agb-peer`'s `PeerError` only because it is raised before the
    sibling is necessarily loaded -- usage errors happen with no module in hand.
    """

    def __init__(self, message, code=1):
        Exception.__init__(self, message)
        self.code = code


def cmd_validate(path, out, peer=None):
    raise SetupError("validate is not implemented yet", 70)


def run_editor(path, out, peer=None, read_line=None, ctl=None):
    raise SetupError("the interactive editor is not implemented yet", 70)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except SetupError as error:
        sys.stderr.write("agb-peer-setup: %s\n" % (error,))
        sys.exit(error.code)
    except KeyboardInterrupt:
        sys.stderr.write("agb-peer-setup: interrupted\n")
        sys.exit(1)
    except Exception as error:
        # ⚠️ FOUR classes reach here, not one, and each was a real escape.
        #   * `PeerError` -- the sibling's own, for anything it refuses.
        #   * `AgbError`  -- `agb_ops.parse_pane_args` raises it for an argv it
        #     will not read, and a picked row's `foreground` is arbitrary.
        #   * `OSError`/`IOError` -- `agb.read_config` re-raises every errno
        #     except ENOENT/ENOTDIR, so an unreadable instance config arrives
        #     as one of these while looking up an ssh target.
        # They cannot be named in the `except` clause above without importing
        # the sibling first, which usage errors must not require -- so they are
        # matched here by class name instead.
        if type(error).__name__ in ("PeerError", "RosterConflict", "AgbError",
                                    "OSError", "IOError"):
            sys.stderr.write("agb-peer-setup: %s\n" % (error,))
            sys.exit(getattr(error, "code", 1))
        raise
