#!/usr/bin/env python3
# agb-peer-setup -- build an `agb-peer relay --roster` file, interactively.
#
# The roster grammar is `name=<row>[:<pane>][@<target>[:<tmux>]]`, and writing
# one by hand means knowing three things that are not obvious:
#
#   * **What text goes in `<row>`.** Not the row title agterm shows -- that is
#     `label · host · cwd · pane · beat`, and `parse_roster_text` splits on
#     WHITESPACE, so a title cannot be a spec at all. Not the row id either:
#     `agb-refresh` re-mints every row and every id changes, which is why
#     `docs/commands.md` says to name a label substring.
#   * **The suffix grammar**, including that `:<tmux>` without `@<target>`
#     reparses as a pane rather than meaning what it looks like.
#   * **That the write has to be ATOMIC.** A roster rewritten in place can be
#     read truncated at a line boundary, and a truncated roster parses cleanly
#     as a shorter one -- so the relay applies a departure nobody asked for.
#
# So this is a picker over live rows plus one writer that gets the third right.
#
# ⚠️ **Why this is a separate script and not a fourth `agb-peer` verb.**
# `agb-peer send` runs on cluster hosts, inside agents, on every message, and
# CPython caches no bytecode for a `__main__` -- so everything in that file is
# re-parsed by every agent every time. A menu loop, a picker and config
# resolution belong on the other side of that line. It is the same argument
# that produced `agb`/`agb_mac`/`agb_ops`, one tier down.
#
# What it shares rather than reimplements: the roster grammar, its validation,
# the byte gate and both writers all live in `agb-peer`, which stays the single
# owner of the file format. This script loads it by path and calls it.
#
# Usage:
#
#   agb-peer-setup <roster-file>          # the interactive editor
#   agb-peer-setup validate <roster-file> # would `agb-peer relay` start?

import os
import sys

VERSION = "0.1.0"

# ⚠️ The `sys.modules` key is a CROSS-FILE AGREEMENT with tests/conftest.py's
# `peer` fixture (CLAUDE.md invariant 14). Both must register the module under
# this exact string, or a test gets a second module object and
# `setup.PeerError is peer.PeerError` fails -- in a way that reads like a
# loader bug rather than a naming disagreement.
PEER_MODULE = "agb_peer"

USAGE = """usage:
  agb-peer-setup <roster-file>            build or edit a relay roster
  agb-peer-setup validate <roster-file>   would `agb-peer relay` start with it?
  agb-peer-setup --version
"""


def peer_path():
    """Where `agb-peer` is: beside the REAL path of this file.

    ⚠️ `realpath`, not `dirname(__file__)`, and the install instruction is why:
    this script is symlinked onto `$PATH` beside `agb-peer`, so an unresolved
    `__file__` looks in the symlink's directory and finds nothing. `agb`'s own
    `sibling_path` carries the same note for the same reason -- and a test run
    from the checkout would never notice, because there the two coincide.
    """
    return os.path.join(os.path.dirname(os.path.realpath(__file__)), "agb-peer")


def load_peer(path=None):
    """`agb-peer` as a module, loaded once and shared.

    Mirrors `agb._load_sibling`: an early return out of `sys.modules` so two
    callers get one module object, an explicit `SourceFileLoader` because the
    file has no `.py` extension and `spec_from_file_location` alone would leave
    `spec.loader` as None, and a `del` on failure -- without which a
    half-initialised module is returned by the next call as if it had loaded,
    turning the second failure into a baffling AttributeError.
    """
    mod = sys.modules.get(PEER_MODULE)
    if mod is not None:
        return mod
    import importlib.util
    from importlib.machinery import SourceFileLoader
    target = path or peer_path()
    loader = SourceFileLoader(PEER_MODULE, target)
    spec = importlib.util.spec_from_file_location(PEER_MODULE, target,
                                                  loader=loader)
    mod = importlib.util.module_from_spec(spec)
    sys.modules[PEER_MODULE] = mod
    try:
        loader.exec_module(mod)
    except BaseException:
        del sys.modules[PEER_MODULE]
        raise
    return mod


# agterm joins a row's title with this, and the LABEL is the first component.
# Spelled here rather than imported because `agb_mac` is a Mac-side sibling of
# `agb`, not of this script, and loading it to read one constant would drag in
# the whole bridge. It is a cross-file agreement with `agb_mac.TITLE_SEP`; a
# disagreement shows up as every row being refused for containing whitespace.
TITLE_SEP = " \u00b7 "

# `agb_mac` prefixes a title when the row is not a live agent. Both END in a
# space, so leaving them on makes the first component "[?] label" -- which the
# whitespace rule below then refuses, making every stale or finished row
# unpickable for a reason that reads like a bug.
TITLE_PREFIXES = ("[?] ", "[done] ")

# What a `<row>` may not contain: `parse_roster_text` splits lines on
# WHITESPACE, and `@` and `:` are the suffix grammar.
ROW_FORBIDDEN = ("@", ":")


def row_value(session):
    """(label, None) for a usable `<row>`, else (None, reason).

    ⚠️ **The label, not the title, and not the id.** The title is
    `label · host · cwd · pane · beat` and `parse_roster_text` splits on
    whitespace, so a title can never be a spec. The id is worse in a way that
    looks fine: it works today and breaks at the next `agb-refresh`, which
    re-mints every row -- which is why `docs/commands.md` says to name a label
    substring.

    ⚠️ **`row_fields` is configurable and this assumes the default order.**
    `label,host,cwd,pane,beat` puts the label first; `row_fields = host,label`
    would put the host there instead, and this would happily propose it. The
    failure is a plausible-looking `<row>` that resolves to the wrong row or to
    nothing -- which is what `row_is_unique` is for. Detecting the setting would
    mean reading the bridge's config to answer a question the uniqueness check
    already answers better.
    """
    title = str(session.get("name") or "")
    for prefix in TITLE_PREFIXES:
        if title.startswith(prefix):
            title = title[len(prefix):]
            break
    label = title.split(TITLE_SEP)[0].strip()
    if not label:
        return None, "that row has no label to name it by"
    if label.split() != [label]:
        return None, ("%r contains whitespace, and a roster line is split on "
                      "whitespace" % (label,))
    for char in ROW_FORBIDDEN:
        if char in label:
            return None, ("%r contains %r, which is roster grammar"
                          % (label, char))
    return label, None


def row_is_unique(peer, sessions, candidate, picked):
    """True when `candidate` resolves to `picked` and to nothing else.

    ⚠️ **`len(matches) == 1` is NOT "the right row", and the difference is a
    silent wrong answer.** `match_sessions` returns the first NON-EMPTY tier --
    exact id, then id prefix, then name substring -- so a label that happens to
    prefix some other row's id wins on the id tier and never reaches the name
    tier at all. One match, confidently, on a row the user did not pick.
    """
    matches = peer.match_sessions(sessions, candidate)
    if not matches:
        return False, "%r matches no row" % (candidate,)
    if len(matches) > 1:
        names = ", ".join(str(m.get("name") or m.get("id"))
                          for m in matches[:3])
        return False, ("%r matches %d rows (%s) -- it has to name exactly one"
                       % (candidate, len(matches), names))
    if matches[0].get("id") != picked.get("id"):
        return False, ("%r resolves to %r, not to the row you picked -- an id "
                       "prefix beats a label"
                       % (candidate, matches[0].get("name")
                          or matches[0].get("id")))
    return True, None


def format_candidates(sessions):
    """[(display, session)] for the picker. Pure: the caller numbers them.

    ⚠️ **MODE is deliberately not shown, and `agb-peer --list` does show it.**
    That listing exists to answer "can I send to this right now", so a
    disagreement with the tool would be worse than no listing at all. This one
    answers "which row do you mean", and the answer is resolved again at write
    time and again by the relay on every tick -- so a mode read here would cost
    one `session text` per row on an interactive path and still be stale by the
    time anybody uses the file.
    """
    rows = []
    for session in sessions:
        label, _reason = row_value(session)
        rows.append(("%-24s %-8s %s"
                     % (label or (session.get("name") or "?"),
                        str(session.get("id") or "")[:8],
                        session.get("cwd") or ""), session))
    return rows


def discover_rows(peer, ctl, say):
    """Live rows, freshly. `[]` and a message when agterm cannot be reached.

    ⚠️ **Fresh on every call, never cached for the session.** Rows are exactly
    what changes while somebody sets this up -- an agent starts, `agb-refresh`
    re-mints every id. And a discovery failure must never abort the editor:
    typing a label by hand is the fallback the whole tool degrades to.
    """
    try:
        return peer.sessions_of(ctl.tree())
    except peer.PeerError as exc:
        say("agterm could not be reached (%s) -- type a row label instead"
            % (exc,))
        return []


# Where `agb` lives on a Mac. `agb-refresh` spells the same default, and for
# the same reason: the bridge loads its modules from the INSTALL, not from a
# checkout, so a tool that reads the same config has to look where the running
# system does.
DEFAULT_AGB = os.path.join(os.path.expanduser("~"), ".local", "lib",
                           "agbridge", "agb")


def load_ops(agb_path=None):
    """`agb_ops`, through `agb`'s own door. Raises `SetupError` if it cannot.

    ⚠️ **`agb._load_ops()`, not a second loader.** That function already does
    all of this -- registers `agb` in `sys.modules` first so the sibling's own
    `import agb` binds the module already running, then loads by path -- and
    `tests/conftest.py` routes through it deliberately, so that a broken door
    fails tests rather than being quietly bypassed. Reimplementing it here
    would be a second copy free to drift from the first.

    `agb` itself still has to be loaded by path, because THIS script is not one
    of its siblings; only that first hop is ours.
    """
    import importlib.util
    from importlib.machinery import SourceFileLoader
    target = agb_path or DEFAULT_AGB
    if not os.path.isfile(target):
        raise SetupError("no agb at %s -- pass --agb <path>" % (target,), 3)
    agb = sys.modules.get("agb")
    if agb is None or getattr(agb, "__file__", None) != target:
        loader = SourceFileLoader("agb", target)
        spec = importlib.util.spec_from_file_location("agb", target,
                                                      loader=loader)
        agb = importlib.util.module_from_spec(spec)
        sys.modules["agb"] = agb
        loader.exec_module(agb)
    return agb, agb._load_ops()


def agbridge_hint(ops, session):
    """A picked row's own `agb pane` options, or None if it is not one.

    ⚠️ **`agb_ops.parse_pane_args`, not a hand-rolled walk over `foreground`.**
    That array is a real argv with a real parser, and CLAUDE.md's rule for
    exactly this case is: where it is not ambiguous, CALL the parser rather
    than imitating it. An imitation also cannot reproduce a REFUSAL -- an argv
    `agb pane` would reject describes a row whose settings cannot be trusted,
    and a walk would confidently return values from it.

    A refusal here is `None`, not an exception: `foreground` is whatever
    somebody launched, so `AgbError` is an ordinary answer rather than a fault.
    """
    argv = session.get("foreground") or []
    try:
        index = list(argv).index("pane")
    except ValueError:
        return None
    try:
        opts = ops.parse_pane_args(list(argv)[index + 1:])
    except Exception as exc:                       # agb.AgbError, by any name
        if type(exc).__name__ != "AgbError":
            raise
        return None
    return opts if opts.get("host") else None


def row_target(ops, hint, unreadable):
    """The row's own resolved ssh target, via `agb pane`'s own resolver.

    ⚠️ **`unreadable` is the CALLER's list and is passed straight through.**
    Handing `pane_settings` a fresh `[]` here would look identical and report
    nothing: the caller's list stays empty, so the "could not read the config"
    branch downstream can never fire, and an EACCES config degrades silently to
    a bare hostname -- which is the wrong-machine bug with the diagnostic
    removed. `pane_settings`' own docstring is a write-up of that failure.
    """
    target, _jump = ops.pane_settings(hint, unreadable=unreadable)
    return target


def host_choices(agb, ops, hint, unreadable):
    """[(hostname, ssh target)] from the RIGHT instance's config.

    ⚠️ **The instance is the one the picked ROW belongs to**, named by its own
    `--config`, because a Mac running two bridges has two `host_<name>` tables
    and reading the default one would resolve instance B's rows through
    instance A's table. A row minted by a DEFAULT install carries no `--config`
    at all -- that is every default install, not a legacy case -- and
    `read_config(None)` is exactly the right answer for it.

    ⚠️ **`pane_settings` cannot answer this and never could**: it returns one
    target for one host, and deliberately never exposes the table. Enumerating
    it is a separate read, which is why the failure has to be collected
    separately too.
    """
    if hint is None:
        return []
    try:
        config = agb.read_config(hint.get("config"))
    except (IOError, OSError) as exc:
        unreadable.append(exc)
        return []
    return sorted((key[len("host_"):], value)
                  for key, value in config.items()
                  if key.startswith(ops.CONFIG_KEY_PREFIXES[0]))


def offer_agbridge_default(ops, hint, config):
    """Whether `[a]` -- "let the relay read the row's own host" -- is honest.

    ⚠️ **The relay does NOT apply the `host_<name>` mapping.**
    `scan_participant` takes `pane_argv_field(foreground, "--host")` and hands
    it to ssh VERBATIM. So on a host that needs an alias, `[a]` produces a
    roster that parses, validates, prints a working-looking next command, and
    then silently never delivers. Offering it only when the mapping is a no-op
    is what keeps that option truthful.
    """
    if not hint or not hint.get("host"):
        return False
    host = hint["host"]
    return ops.ssh_target_for(host, config or {}) == host


class Draft(object):
    """The roster being edited: an ORDERED list, plus the bytes it came from.

    ⚠️ **`entries` is a list of `(name, spec)`, not `parse_participants`' dict.**
    That dict keeps insertion order only as a CPython 3.6 implementation
    detail, and 3.6.8 is this project's floor -- so "delete the second one"
    cannot be built on it. The order here is the FILE's line order, re-derived
    from the lines rather than read out of the dict.

    `loaded` is whatever `roster_bytes` answered when this session opened the
    file: the bytes, or `ROSTER_ABSENT`. It is the gate a later write compares
    against, so it must not be refreshed by anything but a write or a reload.
    """

    def __init__(self, path, entries=None, loaded=None):
        self.path = path
        self.entries = list(entries or [])
        self.loaded = loaded
        self.dirty = False

    def names(self):
        return [name for name, _spec in self.entries]

    def index_of(self, name):
        for i, (existing, _spec) in enumerate(self.entries):
            if existing == name:
                return i
        return -1


def load_draft(peer, path, say):
    """Open `path` for editing, repairing what can be repaired.

    ⚠️ **`minimum=1`, not the default 2.** A one-participant roster is a legal
    state for a RUNNING relay -- somebody left -- and refusing to open one
    would mean this tool cannot be used to add the second participant back.

    ⚠️ **Empty, malformed and not-UTF-8 are REPAIR paths, not refusals.** Those
    are precisely the files somebody needs an editor for. `loaded` is still set
    from the raw bytes, so a later write still gates against what was really
    there; only the parsed entries are dropped.

    ⚠️ **Unreadable is NOT a repair path**, and that asymmetry is the point.
    `roster_bytes` raises for it, and opening anyway would mean a later write
    gates against nothing and renames over a file nobody could read -- the
    vacuous gate this whole design exists to avoid. It propagates.

    A malformed file's surviving lines are deliberately not salvaged one by
    one: `parse_roster_text` is all-or-nothing, and a partial salvage would
    have to re-implement the grammar to decide which lines survived.
    """
    raw = peer.roster_bytes(path)                  # unreadable raises, on purpose
    if raw is peer.ROSTER_ABSENT:
        say("%s does not exist yet -- starting an empty roster" % (path,))
        return Draft(path, [], peer.ROSTER_ABSENT)
    warn_about_comments(raw, say)
    try:
        entries = parse_ordered(peer, raw)
    except peer.PeerError as exc:
        say("%s could not be read as a roster (%s) -- starting an empty draft; "
            "writing will replace it" % (path, exc))
        return Draft(path, [], raw)
    if len(entries) < 2:
        say("note: %d participant(s). A relay cannot START with fewer than 2, "
            "though a running one can drop to 1 when somebody leaves."
            % (len(entries),))
    return Draft(path, entries, raw)


def warn_about_comments(raw, say):
    """Say, ONCE and up front, that writing does not preserve comments.

    ⚠️ **This editor rewrites the file as generated output.** Entries are the
    only thing it models, so a `#` line has nowhere to attach: it belongs
    between two entries, or above one, or to the file as a whole, and the
    parser -- which skips comments entirely -- cannot tell which. Preserving
    them faithfully would mean modelling the file's layout rather than its
    participants, for a feature nothing else here needs.

    That trade is defensible. Making it SILENTLY is not, and it nearly shipped
    that way: the cookbook's own hand-written roster carries a comment on its
    first line, so the documented way to author one produces a file this tool
    would have eaten without a word.

    ⚠️ **The warning is at LOAD, not at write**, and the difference is the
    whole point. At write time the user has already picked rows, typed names
    and chosen transports; telling them then means either losing the comments
    or losing the work. At load it is information they can still act on -- copy
    the file, or edit it by hand instead.
    """
    text = raw.decode("utf-8", "replace") if isinstance(raw, bytes) else raw
    comments = sum(1 for line in text.splitlines()
                   if line.strip().startswith("#"))
    if comments:
        say("note: this file has %d comment line%s. Writing rewrites it as "
            "generated output, so comments and blank lines are NOT preserved. "
            "Keep a copy if you need them."
            % (comments, "" if comments == 1 else "s"))
    return comments


def parse_ordered(peer, raw):
    """`[(name, spec)]` in the file's LINE order.

    The whole file goes through `parse_roster_text` first, so the grammar and
    every refusal are the relay's own -- this only decides the ORDER, by
    walking the lines again and looking each name up in the parsed result.

    ⚠️ **This walk is NOT mutation-distinguishable, and that is worth saying
    out loud rather than leaving as an implied guarantee.** On CPython 3.6+ a
    dict preserves insertion order, `parse_participants` inserts in word order,
    and word order is file order -- so `[(n, people[n]) for n in people]`
    returns exactly the same list for every input, and a test cannot tell the
    two apart on any interpreter this project runs on. Measured: substituting
    the dict comprehension leaves the whole suite green.

    It is kept because the ORDER IS A CONTRACT HERE and should be stated
    rather than inherited: `[d]` deletes by position and `[e]` edits in place,
    so a reader asking "what fixes the order" should find an answer in the code
    rather than a language guarantee two files away. That is a legibility
    argument, not a correctness one, and pretending otherwise would put a guard
    in the suite that defends against nothing.
    """
    people = peer.parse_roster_text(raw, minimum=1)
    text = raw.decode("utf-8") if isinstance(raw, bytes) else raw
    entries, seen = [], set()
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        for word in line.split():
            name = word.partition("=")[0]
            if name in people and name not in seen:
                seen.add(name)
                entries.append((name, people[name]))
    for name in people:                            # belt and braces
        if name not in seen:
            entries.append((name, people[name]))
    return entries


CANCEL = object()


def ask(read_line, say, prompt, default=None):
    """One line from the user, or `CANCEL`.

    ⚠️ **EOF IS AN EMPTY STRING, NOT AN EXCEPTION, AND EVERY LOOP HERE DEPENDS
    ON GETTING THAT RIGHT.** `sys.stdin.readline()` returns `""` at end of
    input -- it does not raise `EOFError`, which is what `input()` does. Treat
    `""` as an ordinary answer and every re-prompting loop in this file spins
    for ever: MEASURED against the real binary with stdin closed, 305,869 menu
    prints and 1.8 million lines of output in six seconds before the timeout
    killed it. Any non-interactive invocation does this -- a pipe that runs
    out, a closed stdin, a here-doc shorter than the prompts.

    ⚠️ **The discriminator is the NEWLINE, so the raw value must be tested
    before stripping.** A user pressing enter gives `"\n"`, which strips to
    `""` and legitimately means "take the default". EOF gives `""` with no
    newline at all. Strip first and the two become indistinguishable -- and the
    one that matters silently becomes the harmless one.

    ⚠️ Found by a live run, not by a test: the test fake raised `EOFError`,
    which real stdin never does, so the harness modelled a world where this
    could not happen and `test_eof_is_a_cancel_not_a_crash` passed against the
    broken code. `Script.read_line` now returns lines WITH their newline and
    `""` only when exhausted, which is what `readline` actually does.
    """
    say(prompt)
    try:
        raw = read_line()
    except EOFError:                    # `input()`-shaped readers still work
        return CANCEL
    if raw is None or raw == "":
        return CANCEL
    answer = raw.strip()
    if answer in ("q", "cancel"):
        return CANCEL
    return answer or (default if default is not None else "")


def pick_row(peer, ctl, read_line, say):
    """(row-label, picked-session) chosen from live rows, or CANCEL.

    Falls through to typing a label whenever discovery is unavailable or the
    user asks for it -- the tool has to stay usable with no agterm at all.
    """
    sessions = discover_rows(peer, ctl, say)
    if sessions:
        rows = format_candidates(sessions)
        say("live rows:")
        for i, (display, _sess) in enumerate(rows, 1):
            say("  %2d) %s" % (i, display))
        say("  %2d) type a label by hand" % (len(rows) + 1,))
        while True:
            answer = ask(read_line, say, "row [1-%d]: " % (len(rows) + 1,))
            if answer is CANCEL:
                return CANCEL
            if answer.isdigit() and 1 <= int(answer) <= len(rows):
                picked = rows[int(answer) - 1][1]
                label, reason = row_value(picked)
                if label is None:
                    say("cannot use that row: %s" % (reason,))
                    continue
                ok, why = row_is_unique(peer, sessions, label, picked)
                if not ok:
                    say("cannot use that row: %s" % (why,))
                    continue
                return label, picked
            if answer.isdigit() and int(answer) == len(rows) + 1:
                break
            say("pick a number from the list.")
    return type_row_label(peer, read_line, say, sessions)


def type_row_label(peer, read_line, say, sessions):
    """A hand-typed label, checked the same way a picked one is."""
    while True:
        answer = ask(read_line, say,
                     "row label (a substring of the row's title): ")
        if answer is CANCEL:
            return CANCEL
        probe = {"name": answer, "id": None}
        label, reason = row_value(probe)
        if label is None:
            say(reason)
            continue
        if sessions:
            matches = peer.match_sessions(sessions, label)
            if len(matches) != 1:
                say("%r matches %d rows -- it has to name exactly one."
                    % (label, len(matches)))
                continue
            return label, matches[0]
        # No discovery: nothing to check against, and refusing would make the
        # tool unusable exactly when agterm is unreachable.
        say("note: agterm is unreachable, so %r was not checked against a live "
            "row." % (label,))
        return label, None


def ask_name(peer, draft, read_line, say):
    """A participant name the REAL parser accepts, in this draft. Or CANCEL.

    ⚠️ **Validated against the WHOLE draft, not the one new word**, and that is
    not a stylistic choice. `parse_participants` builds a fresh `people = {}`
    on every call, so its "named twice" refusal only sees the words handed to
    THAT call -- measured: two single-word calls both accept `alice`. Passing
    one word therefore checks the alphabet and the reserved `relay`, and
    silently checks nothing at all for duplicates.
    """
    while True:
        answer = ask(read_line, say, "participant name: ")
        if answer is CANCEL:
            return CANCEL
        if not answer:
            continue
        words = peer.render_roster_lines(draft.entries) + ["%s=probe" % (answer,)]
        try:
            peer.parse_participants(words, minimum=1)
        except peer.PeerError as exc:
            say(str(exc))
            continue
        return answer


def ask_pane(peer, read_line, say):
    """Which pane of the row the agent's composer is in. Or CANCEL.

    A closed vocabulary (`PANE_KINDS`), defaulted to `left`, which is where a
    single-pane row's agent always is. It is a separate question from the
    `:<tmux target>` below -- one names an agterm pane, the other a tmux
    session -- and conflating them is why this prompt exists at all.
    """
    kinds = list(peer.PANE_KINDS)
    while True:
        answer = ask(read_line, say,
                     "agterm pane [%s] (default left): " % ("|".join(kinds),),
                     default="left")
        if answer is CANCEL:
            return CANCEL
        if answer in kinds:
            return answer
        say("pane must be one of %s." % ("|".join(kinds),))


def ask_transport(peer, ops, agb, hint, read_line, say):
    """(target, tmux_target) for the `@...` suffix, or CANCEL.

    The options map one-to-one onto what actually gets written, rather than
    onto a general idea of "where is this peer" -- there is no way to answer
    that question once for a row that agterm, ssh and tmux each locate
    differently.
    """
    unreadable = []
    config = {}
    choices = []
    # ⚠️ BOTH, not just `ops`. The table is enumerated with `agb.read_config`,
    # so `ops` alone gets as far as calling a method on None -- and the caller
    # legitimately has one without the other when `load_ops` was never reached
    # (no agb installed, or discovery never needed it).
    if hint is not None and ops is not None and agb is not None:
        choices = host_choices(agb, ops, hint, unreadable)
        config = dict(("host_" + name, target) for name, target in choices)
        if unreadable:
            say("warning: this row's config could not be read (%s) -- no host "
                "list, and you may need to type an ssh target"
                % (unreadable[0],))
    offer_default = (ops is not None
                     and offer_agbridge_default(ops, hint, config))
    options = []
    if offer_default:
        options.append(("a", "let the relay use the row's own host (%s)"
                        % (hint.get("host"),)))
    elif hint is not None and hint.get("host"):
        mapped = config.get("host_" + hint["host"])
        if mapped:
            say("note: %s maps to %s in this instance's config, and the relay "
                "uses the row's host VERBATIM -- so an ssh target is needed "
                "rather than the row default." % (hint["host"], mapped))
    options.extend([
        ("l", "tmux on this Mac"),
        ("s", "ssh to a host running tmux"),
        ("t", "ssh, naming a tmux session or pane explicitly"),
    ])
    while True:
        say("how does the relay reach this agent?")
        for key, text in options:
            say("  [%s] %s" % (key, text))
        answer = ask(read_line, say, "transport: ")
        if answer is CANCEL:
            return CANCEL
        if answer == "a" and offer_default:
            return None, None
        if answer == "l":
            tmux = ask(read_line, say, "tmux session or pane on this Mac: ")
            if tmux is CANCEL:
                return CANCEL
            if tmux:
                return "local", tmux
            say("a Mac-side participant needs a tmux target: an agterm row "
                "that is not an agbridge row has no --pane argv to read one "
                "from.")
            continue
        if answer in ("s", "t"):
            target = ask_ssh_target(choices, read_line, say)
            if target is CANCEL:
                return CANCEL
            if not target:
                continue
            if answer == "s":
                return target, None
            tmux = ask(read_line, say, "tmux session or pane on %s: " % (target,))
            if tmux is CANCEL:
                return CANCEL
            return target, (tmux or None)
        say("pick one of %s." % (", ".join(k for k, _t in options),))


def ask_ssh_target(choices, read_line, say):
    """An ssh target, offered from this instance's own `host_<name>` table.

    Both sides are shown because the mapping is the thing people get wrong, and
    the value written is the resolved TARGET -- the `host_boxN` key is a
    hostname the relay would hand to ssh unchanged.
    """
    if choices:
        say("hosts known to this row's config:")
        for i, (name, target) in enumerate(choices, 1):
            say("  %2d) %-16s -> %s" % (i, name, target))
        say("  or type any ssh target")
    answer = ask(read_line, say, "ssh target: ")
    if answer is CANCEL:
        return CANCEL
    if choices and answer.isdigit() and 1 <= int(answer) <= len(choices):
        return choices[int(answer) - 1][1]
    if answer.split() != [answer] or not answer:
        say("an ssh target cannot contain whitespace.")
        return ""
    return answer


def cmd_add(peer, draft, ctl, read_line, say, ops=None, agb=None):
    """Add one participant. Returns True when the draft changed."""
    picked = pick_row(peer, ctl, read_line, say)
    if picked is CANCEL:
        say("cancelled -- nothing was added.")
        return False
    label, session = picked
    name = ask_name(peer, draft, read_line, say)
    if name is CANCEL:
        say("cancelled -- nothing was added.")
        return False
    pane = ask_pane(peer, read_line, say)
    if pane is CANCEL:
        say("cancelled -- nothing was added.")
        return False
    hint = None
    if session is not None and ops is not None:
        hint = agbridge_hint(ops, session)
    transport = ask_transport(peer, ops, agb, hint, read_line, say)
    if transport is CANCEL:
        say("cancelled -- nothing was added.")
        return False
    target, tmux_target = transport
    entry = (name, (label, pane, target, tmux_target))
    draft.entries.append(entry)
    draft.dirty = True
    say("added: %s" % (peer.render_roster_lines([entry])[0],))
    return True


def cmd_delete(peer, draft, read_line, say):
    """Remove one participant. Returns True when the draft changed."""
    if not draft.entries:
        say("nothing to delete.")
        return False
    lines = peer.render_roster_lines(draft.entries)
    say("participants:")
    for i, line in enumerate(lines, 1):
        say("  %2d) %s" % (i, line))
    answer = ask(read_line, say, "delete which [1-%d]: " % (len(lines),))
    if answer is CANCEL:
        say("cancelled -- nothing was deleted.")
        return False
    if not (answer.isdigit() and 1 <= int(answer) <= len(lines)):
        say("not a number in range -- nothing was deleted.")
        return False
    name, _spec = draft.entries.pop(int(answer) - 1)
    draft.dirty = True
    # ⚠️ Announced, never refused, even down to zero. A running relay accepts
    # one participant -- somebody left -- and refusing the last delete would
    # mean this tool cannot perform the operation `--roster` exists for.
    say("deleted %s (%d left)" % (name, len(draft.entries)))
    return True


def cmd_edit_raw(peer, draft, read_line, say):
    """Edit one entry as a raw roster line, or add one. The expert hatch.

    ⚠️ **Validated with `parse_roster_text`, not `parse_participants`.**
    MEASURED: `parse_participants(['alice=my row'], minimum=1)` returns
    `{'alice': ('my row', ...)}` -- accepted. It receives words that are
    ALREADY SPLIT and never rejects whitespace inside `<row>`; only
    `parse_roster_text` does, by doing the splitting. Validating with the
    former lets a spaced line into the draft to fail at write time, which is
    exactly the "escape hatch becomes a trap" this prompt exists to avoid.
    """
    lines = peer.render_roster_lines(draft.entries)
    say("participants:")
    for i, line in enumerate(lines, 1):
        say("  %2d) %s" % (i, line))
    say("  %2d) add a new line" % (len(lines) + 1,))
    which = ask(read_line, say, "edit which [1-%d]: " % (len(lines) + 1,))
    if which is CANCEL:
        say("cancelled -- nothing was changed.")
        return False
    if not (which.isdigit() and 1 <= int(which) <= len(lines) + 1):
        say("not a number in range -- nothing was changed.")
        return False
    index = int(which) - 1
    adding = index == len(lines)
    if not adding:
        say("current: %s" % (lines[index],))
    edited = ask(read_line, say, "line: ")
    if edited is CANCEL or not edited:
        say("cancelled -- nothing was changed.")
        return False
    others = [line for i, line in enumerate(lines) if adding or i != index]
    try:
        people = peer.parse_roster_text(
            "\n".join(others + [edited]).encode("utf-8"), minimum=1)
    except peer.PeerError as exc:
        say("not a usable roster line: %s" % (exc,))
        if not adding:
            say("unchanged: %s" % (lines[index],))
        return False
    name = edited.split("=")[0].strip()
    if name not in people:
        say("that line does not define %r -- nothing was changed." % (name,))
        return False
    entry = (name, people[name])
    if adding:
        draft.entries.append(entry)
    else:
        draft.entries[index] = entry           # in place: the order is a contract
    draft.dirty = True
    say("now: %s" % (peer.render_roster_lines([entry])[0],))
    return True


def cmd_view(peer, draft, say):
    """Show the draft. Touches no disk: this is what is in memory."""
    if not draft.entries:
        say("the draft is empty.")
        return False
    say("draft (%d participant(s))%s:"
        % (len(draft.entries), " -- UNSAVED" if draft.dirty else ""))
    for line in peer.render_roster_lines(draft.entries):
        say("  %s" % (line,))
    return False


def cmd_quit(draft, read_line, say):
    """True when the editor should exit. Confirms only when there is a loss."""
    if not draft.dirty:
        return True
    answer = ask(read_line, say,
                 "discard unsaved changes? [y/N]: ", default="n")
    if answer is CANCEL:
        return True
    if answer.lower() in ("y", "yes"):
        say("discarded -- nothing was written.")
        return True
    return False


MENU = ("[a] add   [d] delete   [e] edit raw   [v] view   "
        "[w] write & exit   [q] quit > ")


def render_menu(peer, draft):
    """The header lines: the path, a dirty marker, and the entries."""
    lines = ["", "Roster: %s%s" % (draft.path, " *" if draft.dirty else "")]
    if draft.entries:
        for i, line in enumerate(peer.render_roster_lines(draft.entries), 1):
            lines.append("  %d) %s" % (i, line))
    else:
        lines.append("  (empty)")
    return lines


def main_loop(peer, draft, ctl, read_line, say, ops=None, agb=None):
    """The editor. Returns an exit code.

    ⚠️ **Unrecognised input re-shows the menu and does nothing**, which is the
    opposite of `agb pane`, whose menu falls through to attaching. There the
    fall-through is safe and useful; here the closest thing to a default would
    be an edit, and a mistyped key must never change somebody's roster.
    """
    while True:
        for line in render_menu(peer, draft):
            say(line)
        answer = ask(read_line, say, MENU)
        if answer is CANCEL or answer in ("q", "quit", "exit"):
            if cmd_quit(draft, read_line, say):
                return 0
            continue
        if answer == "a":
            cmd_add(peer, draft, ctl, read_line, say, ops=ops, agb=agb)
        elif answer == "d":
            cmd_delete(peer, draft, read_line, say)
        elif answer == "e":
            cmd_edit_raw(peer, draft, read_line, say)
        elif answer == "v":
            cmd_view(peer, draft, say)
        elif answer == "w":
            if cmd_write(peer, draft, ctl, read_line, say):
                return 0
        else:
            say("pick one of a, d, e, v, w, q.")


def one_name_per_row(peer, ctl, draft, say):
    """Warn when two participants resolve to the SAME row.

    ⚠️ `_one_name_per_row` exists in the relay because two DIFFERENT labels can
    each unambiguously match one row -- and then both drain that pane, so a
    message is delivered twice, and `try_deliver`'s self-guard compares NAMES,
    so a message to the alias is typed into the sender's own composer. A
    startup typo could do it before; a PICKER makes it easy, and
    `parse_participants` cannot see it because the names and the row strings
    both differ.
    """
    sessions = discover_rows(peer, ctl, lambda _m: None)
    if not sessions:
        return
    owner = {}
    for name, spec in draft.entries:
        matches = peer.match_sessions(sessions, spec[0])
        if len(matches) != 1:
            continue
        rid = matches[0].get("id")
        if rid in owner:
            say("warning: %r and %r both resolve to the same row (%s) -- the "
                "relay would deliver to it twice and can type a message into "
                "its own sender."
                % (owner[rid], name, matches[0].get("name") or rid))
        else:
            owner[rid] = name


def cmd_write(peer, draft, ctl, read_line, say):
    """Write the roster. True when the editor should exit.

    ⚠️ **Fewer than two participants WARNS, it does not refuse.** A relay
    cannot START with one, but a running one can legitimately drop to one when
    somebody leaves -- and refusing here would mean this tool cannot remove a
    participant from a running two-person relay, which is the workflow it
    exists to replace.
    """
    lines = peer.render_roster_lines(draft.entries)
    try:
        people = peer.parse_roster_text("\n".join(lines).encode("utf-8"),
                                        minimum=1)
    except peer.PeerError as exc:
        say("this draft is not a usable roster (%s) -- nothing was written."
            % (exc,))
        return False
    if len(people) < 2:
        say("note: %d participant(s). A relay cannot START with fewer than 2, "
            "though a RUNNING one can drop to 1 when somebody leaves -- so this"
            " is how you remove somebody." % (len(people),))
    one_name_per_row(peer, ctl, draft, say)
    try:
        peer.write_roster_file(draft.path, lines, draft.loaded)
    except peer.RosterConflict as exc:
        return conflict(peer, draft, lines, read_line, say, exc)
    draft.loaded = peer.roster_bytes(draft.path)
    draft.dirty = False
    say("wrote %s" % (draft.path,))
    say("")
    say("start the relay with:")
    say("  agb-peer relay --roster %s" % (draft.path,))
    return True


def conflict(peer, draft, lines, read_line, say, exc):
    """The roster moved underneath us. Save the draft, then ask. Never merge.

    ⚠️ **The recovery draft is written BEFORE anything is asked**, and through
    the UNGATED writer. "The draft is safe because it is still in memory" is
    operationally worthless: a closed terminal, a killed process or a user who
    panics loses it. And routing this through `write_roster_file` would raise
    `RosterConflict` from inside the conflict handler -- the one path standing
    between a conflict and lost work cannot itself be conditional.

    ⚠️ **Nothing is merged, ever.** These entries encode a participant and a
    transport, not prose; a line-wise merge would produce a roster that looks
    plausible and routes messages somewhere nobody chose.
    """
    say(str(exc))
    saved = None
    try:
        saved = peer.write_draft_file(draft.path + ".conflict", lines)
    except (IOError, OSError) as write_exc:
        say("could not save a recovery draft either (%s) -- do not quit until "
            "you have copied what you need." % (write_exc,))
    if saved:
        say("your draft was saved to %s" % (saved,))
    while True:
        say("  [v] view your draft   [r] reload from disk (discards it)")
        say("  [q] quit, leaving the recovery draft   [enter] back to the menu")
        answer = ask(read_line, say, "conflict > ")
        if answer is CANCEL:
            return True
        if answer == "v":
            for line in lines:
                say("  %s" % (line,))
        elif answer == "r":
            sure = ask(read_line, say,
                       "discard your draft and reload %s? [y/N]: "
                       % (draft.path,), default="n")
            if sure is not CANCEL and sure.lower() in ("y", "yes"):
                fresh = load_draft(peer, draft.path, say)
                draft.entries = fresh.entries
                draft.loaded = fresh.loaded
                draft.dirty = False
                say("reloaded -- your draft is only in %s now."
                    % (saved or "memory",))
                return False
        elif answer == "q":
            return True
        elif answer == "":
            return False
        else:
            say("pick v, r, q, or press enter.")


def main(argv, out=None, peer=None, read_line=None, ctl=None):
    out = out or sys.stdout
    if not argv:
        raise SetupError(USAGE.rstrip("\n"), 1)
    if argv[0] in ("--version", "version"):
        out.write("agb-peer-setup %s\n" % (VERSION,))
        return 0
    if argv[0] == "validate":
        if len(argv) != 2:
            raise SetupError("validate takes one roster file", 1)
        return cmd_validate(argv[1], out, peer=peer)
    if len(argv) != 1 or argv[0].startswith("-"):
        raise SetupError(USAGE.rstrip("\n"), 1)
    return run_editor(argv[0], out, peer=peer, read_line=read_line, ctl=ctl)


class SetupError(Exception):
    """This script's own one-line-message-plus-exit-code error.

    Separate from `agb-peer`'s `PeerError` only because it is raised before the
    sibling is necessarily loaded -- usage errors happen with no module in hand.
    """

    def __init__(self, message, code=1):
        Exception.__init__(self, message)
        self.code = code


def cmd_validate(path, out, peer=None):
    """Would `agb-peer relay --roster <path>` START? Exit 0 if so.

    ⚠️ **`minimum=2` here, where the editor uses 1, and the asymmetry is the
    answer rather than an inconsistency.** This command answers the question a
    support request actually asks -- "why will my relay not start" -- so it has
    to apply the STARTUP rule. The editor applies the runtime one, because a
    one-participant roster is a legal thing to be editing.
    """
    peer = peer or load_peer()
    try:
        people = peer.parse_roster_text(peer.read_roster_file(path), minimum=2)
    except peer.PeerError as exc:
        out.write("%s\n" % (exc,))
        return 1
    out.write("ok: %d participant(s)\n" % (len(people),))
    return 0


def run_editor(path, out, peer=None, read_line=None, ctl=None):
    peer = peer or load_peer()
    say = lambda message: out.write("%s\n" % (message,))
    if read_line is None:
        read_line = sys.stdin.readline
    if ctl is None:
        ctl = peer.Ctl()
    ops = agb = None
    try:
        agb, ops = load_ops()
    except SetupError as exc:
        # Not fatal: without `agb` there is no host list and no row hint, and
        # every prompt still works by hand. Saying so beats a silent downgrade.
        say("note: %s -- host lists and row hints are unavailable." % (exc,))
    draft = load_draft(peer, path, say)
    return main_loop(peer, draft, ctl, read_line, say, ops=ops, agb=agb)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except SetupError as error:
        sys.stderr.write("agb-peer-setup: %s\n" % (error,))
        sys.exit(error.code)
    except KeyboardInterrupt:
        sys.stderr.write("agb-peer-setup: interrupted\n")
        sys.exit(1)
    except Exception as error:
        # ⚠️ FOUR classes reach here, not one, and each was a real escape.
        #   * `PeerError` -- the sibling's own, for anything it refuses.
        #   * `AgbError`  -- `agb_ops.parse_pane_args` raises it for an argv it
        #     will not read, and a picked row's `foreground` is arbitrary.
        #   * `OSError`/`IOError` -- `agb.read_config` re-raises every errno
        #     except ENOENT/ENOTDIR, so an unreadable instance config arrives
        #     as one of these while looking up an ssh target.
        # They cannot be named in the `except` clause above without importing
        # the sibling first, which usage errors must not require -- so they are
        # matched here by class name instead.
        if type(error).__name__ in ("PeerError", "RosterConflict", "AgbError",
                                    "OSError", "IOError"):
            sys.stderr.write("agb-peer-setup: %s\n" % (error,))
            sys.exit(getattr(error, "code", 1))
        raise
