#!/bin/sh
# agb-refresh -- rebuild agterm's rows after agterm has forgotten them.
#
# Use it when agterm was closed, reset or reinstalled and the sidebar comes back
# empty (or a row is gone) while the bridge keeps logging:
#
#   agb bridge: agtermctl session rename failed (exit 1): error: no such session: <id>
#
# The Mac's `key -> row` map still names ids agterm has dropped. Nothing else
# clears a *bound* entry -- `close-done` only touches `[done]` rows and `prune`
# works from farm-side state -- so the binding has to be forgotten and re-minted.
#
#   agb-refresh                  # EVERY instance; all rows come back
#   agb-refresh --key a3f9c1e0   # one binding, wherever it lives
#   agb-refresh --dry-run        # say what would happen
#   agb-refresh --instance hostb # only that Mac-side instance
#
# WHICH INSTANCE used to be the one thing this command could not infer and the
# one thing it was dangerous to get wrong: with no --instance it stopped
# com.agbridge, forgot the DEFAULT instance's bindings and started it again,
# reporting success in exactly the words it would have used for the instance
# you meant. A bare run visits every instance now, so there is nothing left to
# infer -- but it still names the instance, the label and the config file on
# every run, because --instance/--label/--config/--rows narrow it back to one
# and such a run is exactly as silent about its own aim as it always was.
#
# NOTHING ON THE FARM IS TOUCHED. The agents, their keys and their state are
# untouched; only this Mac's binding is discarded, so rows return with the same
# identities.
#
# The three steps are a sequence for a reason: the bridge holds the map in
# memory and merges-then-writes on every save, so an edit underneath a running
# bridge can simply be rewritten.

set -eu

DEFAULT_LABEL="com.agbridge"
DEFAULT_AGENTS="$HOME/Library/LaunchAgents"
DEFAULT_AGB="$HOME/.local/lib/agbridge/agb"
# One directory, two spellings of what lives in it -- the same pair install.sh
# derives its own from (install.sh:61-65): the default instance's config is the
# file, a named instance's is a subdirectory of the same place.
#
# ⚠️ Unlike `$rows` and `$python` below, `$config` is NEVER left empty as the
# spelling of "not given" once it has been resolved. Two things read it and both
# break on "": `forget-rows --config ""` is a missing-value error, and the
# banner would name no file at all. (The liveness pattern used to be a third:
# it is now built from `$plistconfig` instead, whose emptiness IS meaningful --
# it is how "this plist predates the flag" is spelled, and it selects the broad
# pattern and the note that says so.)
DEFAULT_CONFIG_DIR="$HOME/.config/agbridge"
DEFAULT_CONFIG="$DEFAULT_CONFIG_DIR/config"

die() { printf 'agb-refresh: %s\n' "$*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }

usage() {
    cat >&2 <<'EOF'
usage: agb-refresh [--key <key>]... [--dry-run] [options]

  With none of --instance/--label/--config/--rows this acts on EVERY Mac-side
  instance in turn; any one of those narrows it to that instance alone.

  --key <key>        forget one binding; repeatable, and looked for in every
                     instance. Default: all of them
  --dry-run          say what would happen; change nothing
  --no-close         leave agterm's sessions open (they become duplicates
                     when the bridge mints fresh rows)
  --instance <name>  act on the instance installed as <name>: label
                     com.agbridge.<name>, and the config its plist names.
                     Sugar for --label and --config, which must always move
                     together
  --config <path>    the instance's config (default: the one the label's plist
                     was rendered with, else ~/.config/agbridge[/<name>]/config).
                     Given alone it also adopts the label of the plist that
                     names it -- which is what makes the bridge's own
                     `agb-refresh --config ...` hint act on the right job
  --label <name>     launchd label                     (default com.agbridge)
  --launch-agents <dir>                     (default ~/Library/LaunchAgents)
  --agb <path>       the installed agb          (default ~/.local/lib/agbridge/agb)
  --python <path>    interpreter to run it with
  --rows <path>      the rows map                 (default: beside the config)
  -h, --help         this message
EOF
}

# The same rule, and the same words, as `install.sh`'s `instance_ok`
# (install.sh:171): a name is a launchd label component, a plist FILENAME, a log
# directory and a config DIRECTORY, so `.` and `/` are refused outright -- there
# is no spelling of a `..` segment or a leading dot. The two validators have to
# agree, because a name this one accepts and the installer refuses names a plist
# that was never rendered.
instance_ok() {
    case "$1" in
        "") die "--instance needs a name" ;;
        -*) die "--instance must not start with '-': $1" ;;
        *[!A-Za-z0-9_-]*)
            die "--instance must be letters, digits, '-' or '_': $1. It names a launchd label component, a plist filename and a config directory, so a '/' or a '.' in it would look for all three somewhere other than where install.sh put them" ;;
    esac
}

agentsdir=$DEFAULT_AGENTS; agb=$DEFAULT_AGB
noclose=no
# `label` and `config` start EMPTY rather than at their defaults so that "was it
# given explicitly?" is still answerable below, where --instance fills them in.
label=""; config=""; instance=""
python=""; rows=""; dry=no; keys=""
# All set only once launchctl is known to exist; `set -u` needs them anyway.
# `broad` is the un-narrowed liveness pattern and stays EMPTY only when
# `$pattern` already IS the broad one -- that emptiness is how `bridge_alive`
# knows there is no second question left to ask. `notedloose` makes the note
# print once; `looseheld` says which answer held the wait on the last poll
# (empty, or one of `cmdline_is_ours`' reasons -- `spelling`, `rows`,
# `ambiguous`, `untagged` -- or `unknown` when `ps` would not say), which is what
# the 10s warning has to name.
pgrep=""; pattern=""; broad=""; notedloose=""; looseheld=""

# A value must be PRESENT and NON-EMPTY. ⚠️ The second half is not pedantry:
# `--config "$cfg"` with `$cfg` unset expands to one empty argument, so the
# COUNT is right and the value is not -- `$config` stays "", the resolution
# below falls through to the plist's config or to `$DEFAULT_CONFIG`, and the run
# repairs a different instance's map while every line of output looks exactly
# like the run that was meant. That is the silent wrong-instance hazard this
# whole command is built to make loud, arriving before the banner that makes it
# loud is composed. Same shape for `--label ""`, `--rows ""` and `--key ""`, so
# the rule is `need`'s and not any one flag's.
#
# ⚠️ It is also the rule `agb`'s own nine parsers already enforce -- `if not
# inline: raise ... needs a value`, for the `--opt=` and the `--opt ""` spelling
# alike -- so this is the shell agreeing with the Python rather than a new idea.
# `install.sh` spells the same function, because neither script can import the
# other (invariant 14); `tests/test_install_pkg.py` compares the two bodies.
need() { [ "$1" -gt 1 ] && [ -n "$3" ] || die "$2 needs a value"; }

while [ $# -gt 0 ]; do
    case $1 in
        --key) need $# "$1" "${2:-}"; keys="$keys $2"; shift 2 ;;
        --dry-run) dry=yes; shift ;;
        --no-close) noclose=yes; shift ;;
        # Validated here rather than after the loop, exactly as install.sh does
        # it: the name is a launchd label component and a config directory, and
        # a `..` in it would look for both somewhere else. `need` above already
        # refuses the EMPTY name (it used to only count arguments, so
        # `--instance ""` read as "not given" and refreshed the DEFAULT instance
        # while echoing the name back); `instance_ok` keeps its own empty case
        # anyway, since it is also install.sh's and the two must agree.
        --instance) need $# "$1" "${2:-}"; instance_ok "$2"; instance=$2; shift 2 ;;
        --config) need $# "$1" "${2:-}"; config=$2; shift 2 ;;
        --label) need $# "$1" "${2:-}"; label=$2; shift 2 ;;
        --launch-agents) need $# "$1" "${2:-}"; agentsdir=$2; shift 2 ;;
        --agb) need $# "$1" "${2:-}"; agb=$2; shift 2 ;;
        --python) need $# "$1" "${2:-}"; python=$2; shift 2 ;;
        --rows) need $# "$1" "${2:-}"; rows=$2; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *) usage; die "unknown option: $1" ;;
    esac
done

# Every `agb bridge` flag that CONSUMES the argument after it -- this script's
# copy of `agb_mac.BRIDGE_VALUE_ARGS`, and a cross-file agreement with no single
# source of truth (invariant 14: neither file can import the other, so
# `tests/test_agb_refresh.py` compares the two lists instead).
#
# ⚠️ ONE reader needs it now, and it is the one that CANNOT ask the parser.
# `ci_config_certain` is looking at a `ps` line, where argv has already been
# flattened with blanks -- there is no argv left to hand anybody, so it asks
# instead whether a `--config` could be sitting inside an earlier flag's value.
# `plist_arg` used to need the same list for a walk that SIMULATED
# `parse_bridge_args`; it calls that function directly now and takes the table
# out of it, so this copy no longer decides anything on the plist side. The rule
# both sides live by is unchanged: AN ARGUMENT CONSUMED AS A VALUE IS NOT A
# FLAG, however much it looks like one.
BRIDGE_VALUE_FLAGS="--config --feed-host --mac-id --statedir --remote-path --remote-python --watchdog --connections --rows --workspace"

# WHAT DOES THIS PLIST START THE BRIDGE WITH? `plist_arg <plist> <flag>` prints
# the value `agb bridge` would resolve for `<flag>`, and nothing at all when the
# plist carries no such flag.
#
# ⚠️ It EXITS 2 when the file cannot be read or is not a plist at all, and that
# is a DIFFERENT answer from "it carries no such flag" -- both print nothing, so
# the caller has to look at the status. `bind_label_to_config` does, and treats
# exit 2 as "this file says nothing", not as "this file implies the default
# config"; see the two guards there. And 2 is NOT the only non-zero status: there
# are FOUR in all, and only 0 and 2 are statements about the plist. They are
# spelled out once above `plist_read_ok`, which is what every call site asks --
# reading "non-zero" as "this file says nothing" is the wrong-job bounce that
# function exists to stop.
#
# ⚠️ THE PLIST IS PARSED WITH `plistlib`, AND THAT IS THE WHOLE DESIGN. This was
# an awk token scan for four review rounds, and every round found the same class
# of defect, because a hand-rolled XML tokenizer is not an XML parser. The last
# two, both valid plists that `plistlib` and `plutil` read without complaint:
#
#   * WHITESPACE INSIDE A TAG. XML allows `<string >` and `</array >` (a start
#     tag is `<` Name S? `>`, an end tag `</` Name S? `>`). The scan matched
#     neither, so `<string >/real/config</string>` VANISHED and the dangling
#     `--config` spent itself on the next element -- `--workspace` -- while
#     `</array >` never closed argv at all, letting a later `WatchPaths` array
#     overwrite the real config with its own `<string>`s. Both land on a path no
#     bridge is running on, which is the unsafe direction: the liveness pattern
#     is built from it, so the poll matches nothing and `forget-rows` lands under
#     a live bridge.
#   * A COMMENT SPLITTING A VALUE ACROSS RECORDS. `<string>/tmp/a<!--` newline
#     `-->b/config</string>` is the string `/tmp/ab/config` -- XML says character
#     data either side of a comment is one value -- and the scan, which carried
#     its "inside a comment" state across records but not the text before the
#     opener, lost the element and spent the dangling `--config` on the next one.
#     The comment above it claimed comments were one-directional and could only
#     ever HIDE argv; that was true only of a comment sitting between elements.
#
# Each round added a rule and the next round found the rule it did not have:
# whitespace in tags, comments spanning a value, CDATA, processing instructions,
# DOCTYPE internal subsets, character references, minification, nesting. That is
# not a converging sequence, and the fix for it is not a fifth rule.
#
# `plistlib` costs NO NEW DEPENDENCY: it is stdlib on macOS and on the Linux the
# suite runs on, it imports clean under `-S -E`, and this script already REQUIRES
# a python3 -- it dies without one and runs `agb` through it. Which is also why
# `$python` is resolved BEFORE the label is bound, further down: this reader is
# the first thing that needs it.
#
# `plutil` was rejected for the opposite reason: macOS-only, so the suite could
# not test what it shipped. `plistlib` is testable on both.
#
# It also reads what the token scan could not: BINARY plists (`plutil -convert
# binary1`), a config delivered as CDATA, entities and character references
# anywhere including in a flag NAME, a DOCTYPE with an internal subset, and a
# `<string>` whose tag spans lines. The old comment listed all of those as
# permanent limitations; they are gone, not narrowed.
#
# Measured, because this is now a PROCESS per question rather than an awk per
# question: a pathological directory of 20 plists, read twice each, costs 0.75 s
# against the scan's 0.20 s. A real `~/Library/LaunchAgents` holds one or two
# agbridge plists (~36 ms), and this is a recovery command that already sleeps in
# a poll loop waiting for a bridge to exit and starts a second python for
# `forget-rows`. The correctness is worth the 0.55 s worst case.
#
# ⚠️ NO `2>/dev/null`. The awk had one -- so that an unreadable plist stayed
# quiet -- and it swallowed the interpreter`s own diagnostics too, so a parse
# error in the program itself read as "this plist names no config" at every call
# site. The reader below is silent by construction instead: it catches its own
# errors and answers with a status, which leaves stderr free to carry a real bug.
#
# WHAT `plistlib` DOES NOT ANSWER is "what would `agb bridge` DO with this
# argv", and that half is no longer simulated here: the elements after the
# command word are handed to `agb_mac.parse_bridge_args` -- the function
# `agb bridge` itself parses with -- loaded out of the directory `$agb` lives in.
#
# ⚠️ THAT HALF WAS A HAND-WRITTEN WALK FOR FIVE REVIEW ROUNDS, and the sequence
# reads exactly like the awk one above it: each round added a rule and the next
# round found the rule it did not have. THE LAST occurrence and not the first
# (the parser reads value flags into a dict with no duplicate check, so a
# repeated flag overwrites and the last is what the bridge runs on); BOTH
# SPELLINGS, since `parse_bridge_args` partitions every argument on `=` before
# looking the name up, and last-wins holds ACROSS the two rather than within
# each; AN ELEMENT IS ONLY A FLAG IN FLAG POSITION, so `--workspace` followed by
# `--config=/other/config` is a WORKSPACE NAME that reads like a flag and the
# bridge never sees a config there. Every one of those is a property of
# `parse_bridge_args` restated in a second language, and each was a wrong-job
# bounce before it was a rule.
#
# ⚠️ AND THE FIFTH ROUND FOUND THE CLASS A RESTATEMENT CANNOT REACH: AN ARGV THE
# PARSER REJECTS. `bridge --config=/real/config --config=` is a missing-value
# error; `bridge --config /real bridge --config /decoy` a stray positional;
# `bridge --config /real --bogus` an unknown option; `bridge --config /real
# --watchdog soon` a number that is not one. `agb bridge` EXITS on every one of
# them, so the job runs no bridge and holds no map -- and the walk answered a
# real-looking config for all four, which made a dead KeepAlive job an exact,
# DECLARING claimant (rank 1) that outranked the live one. Simulating the
# rejection rules as well would have needed the BOOLEAN flag list as a second
# cross-file agreement, plus the two numeric validations, plus the positional
# rule: a WIDER agreement and a sixth round. Calling the parser retires the whole
# class, including the ones nobody has thought of yet.
#
# ⚠️ THE PARSER IS LOADED FROM BESIDE `$agb`, WHICH IS NOT A NEW DEPENDENCY.
# `agb` reaches `agb_mac` by path from its own directory (`agb.sibling_path`),
# `install.sh` copies the three files together and refuses to write an install
# where they are not, and step 2 of this very script -- `agb forget-rows` -- goes
# through `agb._load_mac()`. A tree where this load fails is a tree where the
# forget cannot run either, so the failure is worth having EARLY and LOUD rather
# than after the bootout: it is exit 3, which is fatal, and the message names
# `--agb` rather than `--python` because the interpreter is fine.
# `os.path.realpath` first, so an `agb` symlinked into a `bin/` directory finds
# the siblings next to the REAL file, exactly as `sibling_path` does.
#
# ⚠️ IT COSTS ONE MORE `import` PER QUESTION, MEASURED: 19.0 ms for the reader
# with `plistlib` alone against 21.6 ms with `agb` and `agb_mac` loaded too, on
# the 3.6.8 the floor is set by. Two plists read twice each is ~10 ms of it.
# `agb_mac` is deliberately NOT on the hook`s hot path, and this is not that
# path: it is a recovery command that already sleeps in a poll loop.
#
# ⚠️ AND ONLY `ProgramArguments`, because a plist is not an argv -- only one of
# its keys is. Every other key carries strings too (`ProcessType`,
# `StandardOutPath`, an `EnvironmentVariables` value, a `WatchPaths` array), and
# reading them made a plist that says nothing about a config name one. That is
# now structural rather than a boundary the reader has to hold: `plistlib` hands
# back a dict and this asks it for one key.
#
# ⚠️ AND ONLY THE PART OF IT AFTER THE `bridge` COMMAND WORD, because
# `ProgramArguments` is not the BRIDGE`s argv -- it is the whole command line,
# and `agb bridge` is handed only what follows the command name. The array
# `install.sh` renders is
#
#     <python> -S -E <agb> bridge --config <path>
#
# so four elements go by before any of it has anything to do with `agb bridge`
# at all, and `agb` itself reads its command from argv[1] and nothing else
# (`agb.main`; the wrong order is *run* in
# `tests/test_install_pkg.py::test_the_templates_config_flag_comes_after_the_command_name`,
# which is the authority for this paragraph rather than the shape of the
# template).
#
# Walking the whole array made a plist that starts NO BRIDGE claim a map:
# `<python> -S -E <agb> --config /real/config bridge` is the command `--config`,
# refused as unknown, restarted once every `ThrottleInterval` for ever under
# `KeepAlive`. Reading `/real/config` off it made that dead job an EXACT,
# DECLARING claimant -- rank 1 -- so a `--config /real/config` run bounced it,
# waited for nothing, and forgot the map while the real instance`s bridge was
# still live and merging. (Measured: two plists, the broken one sorting first;
# the run reported `stopped: com.agbridge.aaa` and never touched the job that
# was actually holding the map.)
#
# ⚠️ NO `bridge` IN THE ARRAY AT ALL IS `no such flag`, not `this file says
# nothing`. That is the same answer a plist predating the flag gives, and it has
# to be: an argv with no bridge in it starts no bridge, so it holds no map that
# is not the default one, and the caller`s "a plist carrying no `--config`
# implies `$DEFAULT_CONFIG`" reading already ranks such a job BELOW every job
# that names a config (rank 2/4 against 1/3). Answering exit 2 instead would
# make it invisible, which is the direction that strands a claimant -- and it
# would also swallow `<plist/>` and every plist with no `ProgramArguments`,
# which is the shape a Mac installed before instances existed still has.
#
# ⚠️ AND AN ARGV THE PARSER REFUSES IS `no such flag` TOO, for exactly that
# reason -- it is the same fact wearing different clothes. `agb bridge` prints
# the error and exits, launchd restarts it once every `ThrottleInterval` under
# `KeepAlive`, and no bridge is ever running: the job holds no map, so "this
# plist carries no `--config`" is the CORRECT answer for it and not a safety
# trade. Note what that costs at the one call site where the question is not
# "which job holds this map" but "where is this instance`s config" -- an
# `agb-refresh --instance hostb` whose plist has been hand-edited into something
# the parser refuses falls back to the conventional path instead of the config
# the broken argv names. That is the same answer that shape already got when the
# `--config` sat in front of the command word, it is the direction that is merely
# useless rather than destructive (`forget-rows` reports an empty map and exits
# 0, against bouncing a live instance`s job), and `--config` settles it.
#
# ⚠️ Unlike the `ps` side (`cmdline_is_ours`), there is NO AMBIGUITY to resolve
# here and none is invented: `ProgramArguments` is a real argv array, so a blank
# inside a value is inside one element and the parser is handed exactly what
# `agb bridge` would have been handed -- it is not a reading. That is also why
# this side may answer "no config" confidently where the flattened `ps` line may
# not.
#
# ⚠️ WHAT `plist_arg` STILL DOES NOTHING FOR, so that the next reader is not told
# a class is closed when it is only smaller:
#
#   * a file that is not a plist -- unreadable, truncated mid-element, or not
#     XML and not binary. `plistlib` raises and this answers exit 2, where the
#     token scan used to keep the last COMPLETE value it had seen. That looks
#     like a loss and is not: a truncated file is one launchd cannot load, so no
#     bridge was ever started from it, and the scan`s partial answer was not
#     safe either -- truncating a plist mid-array left it answering `--workspace`
#     as the config, which is a path no process carries. Exit 2 says "this file
#     says nothing" and `bind_label_to_config` skips it, which is where the
#     unreadable-plist guard already sends it and for the same reason.
#   * a `ProgramArguments` element that is not a string. launchd refuses such a
#     job outright, so nothing is running from it, and the whole array is
#     answered "no such flag" without asking the parser -- which would raise on
#     it (`arg.partition` on an int) rather than answer.
#   * a path containing a NEWLINE. The value comes back through a command
#     substitution, which strips trailing newlines, and `ps` could not put one
#     back together on the other side either.
#   * AN ARGV THAT REACHES `agb bridge` INDIRECTLY -- `/bin/sh -c "exec python3
#     <agb> bridge --config /x"` is one element, not seven, so no element equals
#     `bridge` and the answer is "no `--config`". That job IS running a bridge,
#     on `/x`, and this reads it as the default instance`s. Unchanged from the
#     whole-array walk, which found no `--config` element either; not narrowed
#     and not widened, and it is why the sentence above says the boundary is
#     `install.sh`-shaped argv rather than any command line that ends up running
#     a bridge.
#   * `bridge` APPEARING BEFORE THE COMMAND WORD as some other argument`s value
#     -- `<agb> hook bridge`, or an interpreter option that takes `bridge` as
#     its argument. The parse starts one element too early and reads the rest as
#     bridge flags. Both fail towards "no `--config`" for every argv shape a
#     human writes (there are no flags after the command word in either), and
#     neither is a command line that starts a bridge.
#   * AN `agb_mac` THAT IS NOT THE ONE THIS PLIST`S BRIDGE RUNS. The parser comes
#     from beside `$agb`, and a plist names an `agb` of its own in element 4; a
#     tree where those two disagree is answered by THIS one. Deliberate -- the
#     alternative is executing code from a path a hand-edited plist chose -- and
#     harmless in the shape `install.sh` writes, where they are the same file. An
#     `agb_mac` old enough not to know `--config` answers "no such flag" for every
#     plist, which is right in that world too: no bridge there accepts the flag.
#
# All of those fail towards "no config found". That is the LOUD direction for the
# default instance (the default label, and the note that says so) and the quiet
# one for a named instance, which is why the reader asks the real parser rather
# than drawing a boundary at what `install.sh` happens to write.
#
# ⚠️ THE READER IS `agb instances`, NOT AN EMBEDDED `-c` PROGRAM. Every
# paragraph above still describes what it does -- `plistlib`, only
# `ProgramArguments`, only what follows the `bridge` command word, and
# `agb_mac.parse_bridge_args` for the rest -- but the code that does it now
# lives in `agb_mac.run_instances`, and this function is the two-line call.
#
# It moved for one reason: this script is no longer the only caller. `agb
# close-done` and `agb forget-rows` sweep every instance too, and they run
# in-process on the Mac where a shell reader is unreachable. A second copy of
# the four-status contract, in a second language, is invariant 14`s fourth
# cross-file agreement arriving where it did not have to.
#
# TWO RULES THAT WENT WITH IT, and both still apply -- to Python source now
# rather than to a string this file quotes:
#
#   * NO APOSTROPHE was a rule about `'...'` shell quoting. There is no quoted
#     program left, so it is retired here and nowhere else; the possessives in
#     the comments above are still spelled with a backquote because rewriting
#     them would bury the diff that matters.
#   * PURE ASCII / BYTES OUT is NOT retired, it MOVED. Python decoded a `-c`
#     program with the LOCALE`s filesystem encoding, so one non-ASCII byte in
#     the source was `Unable to decode the command from the command line` and
#     every caller read "this plist names no config". A file loaded from disk
#     is decoded as UTF-8 regardless of locale, so that half is structural now.
#     The OUTPUT half is not: `-E` does not touch `LC_ALL`, so `run_instances`
#     writes the value to `sys.stdout.buffer` as UTF-8 bytes rather than with
#     `print`, which would raise under `LC_ALL=C` and -- worse -- SUCCEED under
#     ISO-8859-1, handing back a transcoded path that exists nowhere. That is
#     contract 1, it is stated beside the code in `agb_mac`, and it is guarded
#     by a three-locale test on both sides.
#
# ⚠️ AND THE EXIT-CODE COLLISION THIS OPENED, which is why the probe further
# down asks `agb instances --probe` rather than `import plistlib`. `agb` answers
# an UNKNOWN COMMAND with exit 2, `USAGE` on stderr and EMPTY STDOUT -- which is
# byte-identical to a new `agb` answering "this plist says nothing". So an
# `agb` older than `agb instances` would make every plist silent, the run would
# fall through to the default label and the conventional config, and it would
# report success in the words it uses when it is right. The probe is what makes
# exit 2 unambiguous afterwards, and it has to be STDOUT-compared: a status
# alone cannot see `--python /bin/echo`.
plist_arg() {
    # `--launch-agents` is INERT under `--plist` (that mode opens the file it
    # was handed and never lists a directory) and is passed anyway, so that
    # every `agb instances` call in this script names the same directory and
    # the sweep`s `--labels` call cannot be the only one carrying it -- a flag
    # forwarded from one site out of two is a flag that silently stops working.
    "$python" -S -E "$agb" instances \
        --plist "$1" --arg "$2" --launch-agents "$agentsdir"
}

# WHAT EACH `plist_arg` STATUS MEANS, spelled ONCE and asked at every call site.
# FOUR answers, not two, and only the first two are about the plist -- the last
# two are the ones that kept being lost:
#
#   0  answered. An empty value means "this argv carries no such flag", which
#      the callers read as a real answer (the default config is implied). An
#      argv `agb bridge` REFUSES is one of those: it starts no bridge, so it
#      holds no map -- see the block above `plist_arg`.
#   2  THIS FILE SAYS NOTHING -- it could not be read, or it is not a plist.
#      The callers skip it, or say so; see the guards at each.
#   3  THE PARSER COULD NOT BE LOADED from beside `$agb`. Also not a statement
#      about the plist, and a different one from the interpreter failing: the
#      tree cannot run `agb bridge` OR `agb forget-rows` either, so this run
#      cannot do its job at all. Fatal, and the message names `--agb`.
#      ⚠️ `agb.cmd_instances` catches `Exception` around the LOAD ONLY, not
#      around `run_instances`, and it must keep catching that broadly: a tree
#      with no `agb_mac` raises `FileNotFoundError` (the sibling is loaded by
#      PATH), which is an `OSError` and not an `ImportError`. Catching the
#      narrow pair let it escape as a traceback and exit 1 -- read here as
#      "the reader failed", i.e. blamed on `$python` instead of on `--agb`.
#   *  THE READER ITSELF FAILED, which is not a statement about the plist at
#      all. ⚠️ It is a statement about `$python` OR about `$agb`, and it stopped
#      being about the interpreter alone when the reader moved into `agb`:
#      exit 1 is now what `agb` returns for an `AgbError` and for any uncaught
#      exception in `run_instances`, neither of which the interpreter did. The
#      message below names BOTH files rather than guessing between them --
#      naming only `--python` would send an operator to replace a python3 that
#      is working. The probe further down has already proved that both can run
#      `agb instances --probe`, so a failure here is later than that.
#
# ⚠️ BOTH of the last two were folded into the second at all three call sites,
# and that is an ordinary operator mistake away: `--python /bin/false`,
# `--python` naming a shell script, an interpreter with no `plistlib`, a
# traceback in the reader -- or, for 3, an `--agb` naming a tree whose `agb_mac`
# is missing. Every one of the `--python` mistakes exits 1/126/127, every plist
# then "said nothing", and the run fell through to the DEFAULT label and the
# CONVENTIONAL config -- bouncing `com.agbridge` and forgetting a named
# instance`s bindings with that instance`s bridge live, reporting success in the
# words it uses when it is right. (Measured with `--python /bin/false`:
# `instance: (default)`, `stopped: com.agbridge`, exit 0.) So both are FATAL,
# and the message names the file that is actually wrong -- `--agb` for 3, the
# interpreter for the rest -- rather than the plist, which is fine in either.
#
# ⚠️ `die` from the PARENT shell, which is why this is a separate function
# called with `$?` rather than a wrapper around `plist_arg` that returns the
# value. A wrapper would be run inside `value=$(...)`, i.e. in a subshell, where
# `exit 1` ends the substitution and the script carries on with an empty value:
# the exact silent fallback this exists to stop, reintroduced by the tidier
# spelling.
plist_read_ok() {
    [ "$1" = 2 ] && return 0
    [ "$1" = 3 ] && die "cannot load agb_mac from beside $agb.
       agb-refresh asks agb_mac.parse_bridge_args what each launchd job was
       started with, and step 2 below runs agb forget-rows, which loads the same
       file -- so this tree cannot do either. Pass --agb <path to the installed
       agb>, or re-run install.sh mac --instance <name> to put agb, agb_mac and
       agb_ops back together (--instance is required, and a bare mac install is
       refused)."
    die "cannot read a plist: $python -S -E $agb instances exited $1 reading $2.
       That is the READER failing, not the plist -- and the reader is two files
       now, so this names both rather than guessing: either $python is not a
       real python3 (pass --python <path>), or that agb tree is broken (pass
       --agb <path to the installed agb>). The probe above proved both could
       answer --probe, so whatever this is, it is later than that.
       Continuing would bounce whichever job the unread plists left unclaimed
       and forget the wrong instance's bindings."
}

# WHERE A CONFIG'S MAP LIVES, canonically -- so two config paths can be compared
# for "do these repair the same instance" rather than for "were they typed the
# same way". The NAME says the rule; the block below says why it is the rule.
#
# ⚠️ It answers with the resolved DIRECTORY and NOTHING ELSE, because the
# directory is the whole of what `forget-rows` uses: `rows_path` and
# `placements_path` are `os.path.dirname(config) + "/rows"` and `.../placements`
# (agb_mac.instance_paths), so the basename plays no part in the map at all.
# Carrying the basename into the comparison -- which this did until the spelling
# below was tried -- makes it STRICTLY NARROWER than the equivalence it claims
# to mirror, and every spelling with a different final component falls through
# to the default label while `forget-rows` opens the right files:
#
#     --config <dir>/config   -> map <dir>/rows   canon <dir>
#     --config <dir>/         -> map <dir>/rows   canon <dir>   (tab completion)
#     --config <dir>//        -> map <dir>/rows   canon <dir>
#     --config <dir>/other    -> map <dir>/rows   canon <dir>
#
# The FINAL COMPONENT is still never resolved (no `readlink -f`), and a
# directory-only comparison already gives that: a config that is a symlink into
# another instance's directory keeps its map beside the LINK, which is where
# `forget-rows` will look, and the link's own directory is what canonicalises.
#
# Pure parameter expansion rather than `dirname`: that is an external command
# whose `--` handling varies across the BSD and GNU userlands this script runs
# on, and a path beginning with `-` would be read as an option by some of them.
# `cd -P` + `pwd -P` is what does the real work -- it collapses `//`, `.` and
# `..`, resolves symlinked parents, and makes a relative path absolute, all
# through the kernel rather than through string rules that would have to be
# reinvented here.
#
# ⚠️ It FAILS (non-zero, no output) rather than falling back to the string it
# was given, and every caller has to treat that as "no answer". One that quietly
# returned its input would make a directory that does not exist compare EQUAL to
# a plist naming a path that does, which is the wrong-label-with-the-wrong-map
# bounce `same_map`'s callers exist to prevent.
config_map_dir() {
    case $1 in
        */*) map_dir=${1%/*} ;;
        # No slash at all: `os.path.dirname("config")` is `""`, which
        # `os.path.join` turns into a plain `rows` -- relative to the cwd
        # `forget-rows` will run in, which is this one.
        *)   map_dir="." ;;
    esac
    # `${1%/*}` of `/config` is empty, and `cd ""` is not `cd /`.
    [ -n "$map_dir" ] || map_dir="/"
    map_dir=$(CDPATH= cd -P -- "$map_dir" 2>/dev/null && pwd -P) || return 1
    [ -n "$map_dir" ] || return 1
    printf '%s' "$map_dir"
}

# DO THESE TWO PATHS NAME ONE MAP? The equivalence itself, in ONE place, because
# two of them ask it -- `bind_label_to_config` below, and the untagged-bridge
# gate in the launchctl branch -- and it is the comparison design.md §5 records
# being got wrong four separate times. Spelled twice it had already drifted
# cosmetically while claiming in a comment to be the same rule, which is the
# state a fifth version arrives from.
#
# Raw FIRST: it is the answer for every ordinary invocation and it cannot fail,
# whereas `config_map_dir` needs the directory to exist. Then canonical, and
# FAIL CLOSED -- no canonical form on either side means the two are NOT known to
# name the same map. See `config_map_dir` on why it must not fall back to the
# string it was given.
#
# ⚠️ It answers a yes/no and nothing else, on purpose. The BASENAME plays no
# part in the map (`rows_path` is `dirname(config)/rows`), so it can never
# narrow this; where it does matter -- breaking the tie between two plists that
# have already matched -- it is read straight off the two paths at the call
# site, which is ranking, not matching.
same_map() {
    if [ "$1" = "$2" ]; then return 0; fi
    sm_a=$(config_map_dir "$1") || return 1
    sm_b=$(config_map_dir "$2") || return 1
    [ "$sm_a" = "$sm_b" ]
}

# WHICH LABEL, when only a config was named. Sets `$label` (or leaves it empty
# for the default below), and says so either way.
#
# ⚠️ This is the READER half of design.md §5's "--label and --config must
# always move together", and the bridge's own stale-row hint is what depends on
# it. `agb_mac.refresh_recipe` prints `agb-refresh --config <this instance's
# config>` into this instance's log -- the config path is the only identity a
# bridge has, since nothing tells it its instance name or its launchd label.
# With the label left at the default, that recipe followed literally is *worse*
# than the fixed `Run agb-refresh` it replaced: it boots out the DEFAULT job,
# waits for the DEFAULT bridge to exit, and then forgets THIS instance's
# bindings while THIS instance's bridge is still running -- and that bridge
# holds the row map in memory and merges-then-writes, so it re-mints rows
# against the ids `forget-rows` has just closed. The `no such session` spam
# that printed the hint comes back, with the rows now closed in agterm too.
#
# The label cannot be reconstructed from the config path either
# (`install.sh mac --instance hostb --config <elsewhere>` is supported), so it
# is looked up where it is recorded: the plists themselves, through the same
# `plist_arg` the wait below uses.
#
# ⚠️ The comparison is on the MAP, never on the spelling, and the two halves of
# this script are what make that necessary: the label is chosen here by matching
# the plist's text, while the MAP is derived on the other side of `forget-rows`
# by `os.path.dirname`, which normalises AND drops the basename. So a spelling
# that still names the right map -- `//`, a `.` segment, a relative path typed
# from the instance's own directory, a symlinked `$HOME`, the bare DIRECTORY a
# tab-completion leaves you holding -- could fail to name the right LABEL, and
# the fallback is the DEFAULT label. That pair is the exact accident this
# function exists to prevent, arriving from the other direction: boot out
# instance A, wait for A's bridge (the narrow liveness pattern is built from A's
# plist), then forget B's bindings while B's bridge is live and merging. And it
# is reachable by a human following instructions -- `pane_config_warning` tells
# the operator to type this path by hand, on precisely the rows whose config has
# moved.
#
# ⚠️ So `same_map` compares DIRECTORIES, and two configs that share one
# match even when their basenames differ -- because they share a map, which is
# the only thing this run can damage. Two instances deliberately installed into
# ONE directory therefore both match, and that is right: they share the map too,
# and the "more than one" warning below is exactly the report that situation
# deserves.
#
# ⚠️ MATCHING on the directory and CHOOSING between the matches are two
# different questions, and running them together is how a job that merely shares
# the map came to beat the one whose config was named exactly. `*.plist` expands
# in collating order, so `com.agbridge.aaa` -- naming `<dir>/config.bak` -- won
# over `com.agbridge.hostb` naming `<dir>/config` on a `--config <dir>/config`
# run. Both are matches and both are reported; the one that names THIS PATH is
# the one used, and a plist that says so beats one that only implies it. Not a
# narrowing: a directory-only match still wins when it is the only one.
#
# ⚠️ And a plist carrying NO `--config` is not "no answer" either -- it is an
# answer of `$DEFAULT_CONFIG`. The bridge it starts resolves `agb.config_path()`
# itself, so the map it holds is the default instance's, and skipping it made
# the wrong-job bounce SILENT: with a second job's config installed into the
# default directory (`--instance hostb --config ~/.config/agbridge/hostb-config`
# -- one map, two jobs), a `--config <default config>` run saw only hostb's
# plist, adopted its label, and found nothing to warn about because it was the
# only match.
#
# Two guards on that implication, because both directions of it are wrong:
#
#   * the plist must be READABLE AND PARSEABLE. `plist_arg` prints nothing both
#     for "no `--config` in it" and for "could not read it at all" (mode 000,
#     root owned) or "not a plist" (truncated, or some other file that ended up
#     under this name), and reading the second as the default config would let a
#     file that says nothing claim a map -- the wrong-job bounce manufactured by
#     the fix for it. The two are told apart by the STATUS, not by a separate
#     `-r` test: `plist_arg` exits 2 for both failures and 0 for a plist it read,
#     which also covers the cases `-r` cannot see (a directory of that name, a
#     binary blob that is not a plist, an I/O error mid-read).
#   * the name must be in the `com.agbridge` label space. `~/Library/LaunchAgents`
#     is shared with every other program on the Mac, and none of their plists
#     carries a `--config`; without this, `agb-refresh --config <default config>`
#     would count `com.some-other-app` as a claimant of agbridge's map and could
#     bounce it. An agbridge install under a `--label` of its own is therefore
#     NOT implied, which is the pre-existing behaviour: no match, the default
#     label, and the note that says so.
#
# Whether two paths name one map is `same_map`'s question and is asked nowhere
# else; the raw-then-canonical order and the fail-closed rule live with it.
bind_label_to_config() {
    # `bestrank=9` is the "nothing yet" sentinel: worse than any rank the loop
    # below can produce, so the first match always wins its own comparison.
    matched=""; claimants=""; nclaim=0; bestrank=9
    configbase=${config##*/}
    for candidate in "$agentsdir"/*.plist; do
        # An unmatched glob comes back as the pattern itself.
        [ -f "$candidate" ] || continue
        # ⚠️ An `if`, not `value=$(...) || value=""`, and the difference is the
        # whole first guard above: the STATUS is the answer to "did this file say
        # anything at all", and an assignment that discards it cannot tell "no
        # `--config`" from "not a plist". Either spelling survives `set -e` --
        # which is the OTHER reason this is not a bare assignment, since an
        # ASSIGNMENT from a command substitution takes that command's status, so
        # one unreadable plist in the directory would kill the whole script,
        # silently, in a recovery command.
        if value=$(plist_arg "$candidate" --config); then
            said=yes
        else
            # ⚠️ `$?` FIRST, before anything else can overwrite it. The four
            # statuses are four different answers and only ONE of them is
            # "this file says nothing"; see `plist_read_ok`, which dies on the
            # rest from here -- the parent shell -- rather than from inside the
            # substitution above, where an exit would be swallowed.
            plist_read_ok "$?" "$candidate"
            value=""; said=no
        fi
        name=${candidate##*/}
        name=${name%.plist}
        declared=yes
        if [ -z "$value" ]; then
            # No `--config` -- or no answer at all. See the two guards above.
            [ "$said" = yes ] || continue
            case $name in
                "$DEFAULT_LABEL"|"$DEFAULT_LABEL".*) ;;
                *) continue ;;
            esac
            value=$DEFAULT_CONFIG
            declared=no
        fi
        exact=no
        via=config
        if [ "$value" = "$config" ]; then
            exact=yes
        elif same_map "$value" "$config"; then
            # Not the same text, but the same MAP. Whether it is also the same
            # FILE is what breaks the tie below -- read off the paths, not off
            # `same_map`, because the basename is a RANKING input and must never
            # reach the match (see `same_map`).
            if [ "${value##*/}" = "$configbase" ]; then exact=yes; fi
        else
            # ⚠️ Its config names another map -- which is not the end of the
            # question, because `--config` is not the only flag that decides
            # which map a bridge holds. `agb bridge --rows` overrides the rows
            # half of one (`render_settings`: `opts.get("rows") or
            # rows_path(config)`), so a job started `--config <elsewhere>
            # --rows <this map's rows>` is writing the very file this run is
            # about to rewrite, and it is the job that has to be stopped.
            #
            # Read only here, and ranked last (see the table below): it is a
            # hand-edited plist -- `install.sh` renders no `--rows` -- so it may
            # only ever replace the "nothing claims this config" fallback, never
            # outbid a job that names the config itself.
            # The same four-way status as above, and asked the same way: this
            # file parsed a moment ago, so exit 2 here is a file that changed
            # under the run -- but a reader that has broken since is still the
            # reader, and reading it as "no --rows" is the same silent fallback.
            #
            # ⚠️ `if ...; then :; else` and NOT `if ! ...; then`. `!` sets `$?`
            # to the NEGATION of the command`s status, so the reader`s 2 comes
            # back as 0 inside the branch and `plist_read_ok` would die on every
            # unreadable plist. Verified, not assumed.
            if rowsvalue=$(plist_arg "$candidate" --rows); then :; else
                plist_read_ok "$?" "$candidate"
                rowsvalue=""
            fi
            [ -n "$rowsvalue" ] || continue
            # `${rows:-$config}` is the rows file this run rewrites: an explicit
            # `--rows` wins over the config's derivation on this side too
            # (`agb_mac.instance_paths`), and `same_map` compares directories,
            # which `<dir>/config` and `<dir>/rows` share.
            same_map "$rowsvalue" "${rows:-$config}" || continue
            via=rows
        fi
        claimants="$claimants $name"
        nclaim=$((nclaim + 1))
        # ⚠️ RANKED, and the second half of the rank is not decoration: a plist
        # that DECLARES this config beats one that merely IMPLIES it by carrying
        # no `--config`. Without that, the implication introduced above hands the
        # glob order back the decision it was just taken away from -- a stale
        # flagless `com.agbridge.old.plist` sorts before `com.agbridge.plist` and
        # would be bounced instead of the job that actually names the path. The
        # rest is glob order, which is at least deterministic and is reported.
        #
        #   rank 1  names this exact file + declares a --config
        #        2  names this exact file + only implies one
        #        3  shares the directory  + declares a --config
        #        4  shares the directory  + only implies one
        #        5  its --config is elsewhere; its --rows is in this map
        #       (9  the sentinel above: no claimant seen yet)
        if [ "$exact" = yes ]; then rank=1; else rank=3; fi
        if [ "$declared" = no ]; then rank=$((rank + 1)); fi
        if [ "$via" = rows ]; then rank=5; fi
        if [ "$rank" -lt "$bestrank" ]; then matched=$name; bestrank=$rank; fi
    done
    if [ -z "$matched" ]; then
        # Not fatal: an install made with `install.sh mac --config <nondefault>`
        # before the plist carried the flag is a plain `com.agbridge` job, and
        # that is exactly the case the default below is right for. Said out
        # loud, because the other reading -- a named instance whose plist was
        # deleted -- is the wrong-job bounce this function exists to prevent.
        #
        # ⚠️ And the CONSEQUENCE is spelled out, not just the fact, because the
        # note above reads as reassurance while the destructive steps run
        # anyway. This is the one branch where the label and the map provably
        # come from different places, so it says which job it is about to bounce
        # and whose bindings it is about to discard, in those words.
        #
        # ⚠️ Both are NAMED, never pointed at. This ran for a while saying "the
        # config above", and there is nothing above it: the banner that prints
        # the config comes later, so the one branch whose whole job is to be
        # precise about which config was pointing at blank space. `$config` is
        # always set here -- this function is only reached when `--config` was
        # given -- so it can simply be spelled.
        say "note:     no plist in $agentsdir names this config, so the label"
        say "          below is the default one. If this config belongs to an"
        say "          instance, pass --instance <name> (or --label) as well."
        say "          Otherwise this run stops $DEFAULT_LABEL and forgets the"
        say "          bindings of $config -- check they belong together,"
        say "          and use --dry-run if you are not sure."
        return 0
    fi
    # ⚠️ Reported on the COUNT of claimants, not on "was there a runner-up of
    # the same kind". Splitting the matches into exact and directory-only ones
    # gave two lists that could each hold one entry while two jobs were still
    # sharing the map -- the silence that made the wrong-job bounce above
    # invisible, arriving through the accounting rather than through the match.
    #
    # It is a warning and not a refusal because there is nothing to choose: the
    # jobs share a rows file, so whichever is bounced, the other keeps running
    # over the map `forget-rows` is about to rewrite. This is a recovery
    # command; it says so and gets on with it.
    if [ "$nclaim" -gt 1 ]; then
        say "WARNING:  more than one launchd job claims this config's map:"
        # `${claimants# }` strips the leading space the accumulator above leaves
        # on every value, so this line indents like the other three rather than
        # by nine and borrowing the tenth from the data.
        say "          ${claimants# }."
        say "          Using $matched -- the others keep running and hold the"
        say "          same rows file. Pass --label to pick one."
    fi
    label=$matched
}

# --instance is sugar over --label and --config, and the whole reason for the
# sugar is that those two must move TOGETHER: a label without its config stops
# instance B and forgets instance A's bindings. An explicit --label/--config
# still wins, because both of these are `[ -n ... ] ||` and so are the plain
# defaults below them.
#
# `--config` on its own stays supported and is not redundant: an install made
# with `install.sh mac --config <nondefault>` and no --instance has no instance
# name to pass, and would otherwise be unable to refresh against its own map.
# It is also what the bridge's stale-row hint prints, which is why it binds the
# label too (`bind_label_to_config`, above).
#
# ⚠️ BOTH RESOLVED HERE, ABOVE `bind_label_to_config`, and the `$agb` check with
# them: `plist_arg` reads a plist with `plistlib` AND asks
# `agb_mac.parse_bridge_args` what the argv means, so it needs the interpreter
# and the installed tree before the label can be bound. `$python` was left below
# once, and every `plist_arg` call in `bind_label_to_config` then ran
# `"" -S -E -c ...` -- a "command not found" per plist, so every plist answered
# nothing and the run fell through to the DEFAULT label with a named instance`s
# bridge live. `$agb` sat below for the same reason and would fail the same way,
# except louder: `plist_read_ok` turns the missing parser into a `die`, so the
# order below is what makes the message name the flag that is actually wrong.
if [ -z "$python" ]; then
    python=$(command -v python3 2>/dev/null || :)
    [ -n "$python" ] || die "no python3 found; pass --python <absolute path>"
fi

[ -f "$agb" ] || die "no agb at $agb (pass --agb <path>)"

# ⚠️ AND PROVED TO BE ONE, ONCE, before any plist is read. `-n` says a path was
# given; it does not say the path runs Python, and `--python` is typed by hand.
#
# `plist_read_ok` catches an interpreter that FAILS -- `/bin/false`, a missing
# file, a python with no `plistlib` -- because those come back non-zero. It
# cannot catch one that SUCCEEDS while meaning nothing: `--python /bin/echo`
# prints its own arguments and exits 0, so every plist "answers" a config path
# made of the reader`s source code. That is the unsafe polarity and no status
# can see it, which is why this asks a question with a known answer instead.
#
# ⚠️ ONE PROBE, NOT TWO, and it asks the REAL COMMAND rather than
# `import plistlib`. Since the reader moved into `agb instances`, this script
# runs no `-c` program at all -- `plistlib` is imported by `agb_mac`, not by the
# shell -- so a `plistlib` probe would prove a library nothing here calls
# directly. A known-answer probe of `agb instances` itself subsumes it and
# proves three more things at once:
#
#   * `$python` runs Python (`/bin/false`, a shell script, a missing file).
#   * `$python` is not merely EXITING 0 (`--python /bin/echo` prints its own
#     arguments, which is why the ANSWER is compared and not the status).
#   * `$agb` IS NEW ENOUGH TO HAVE `agb instances`. This is the one that had no
#     probe before and needs one most: `agb` answers an unknown command with
#     exit 2 and EMPTY STDOUT, which is byte-identical to a new `agb` saying
#     "this plist carries no such flag". Without this line a checkout
#     `agb-refresh` against an installed 0.5.0 `agb` would read every plist as
#     silent, fall through to the default label and the conventional config, and
#     bounce the wrong job reporting success. After it, exit 2 is unambiguous.
#
# ⚠️ Exit 3 is answered FIRST and separately, with `plist_read_ok`s own message.
# A tree with no `agb_mac` fails `--probe` too (`run_instances` lives there), and
# folding it into the message below would send an operator to replace a `python3`
# that is working. Same words as the three plist call sites, from one place.
#
# One extra process per run, in a command that already starts several and sleeps
# in a poll loop.
#
# ⚠️ STDOUT ONLY, and stderr deliberately neither captured nor discarded.
# Capturing it (`2>&1`) folds any startup noise into the answer, so an
# interpreter that works but says something would be refused -- the too-tight
# direction, on the flag an operator types by hand. Discarding it (`2>/dev/null`)
# is what the awk this reader replaced did, and it swallowed the traceback that
# explains WHY. Letting it through prints the real diagnosis immediately above
# the message below, and leaves the decision to the one string that answers it.
probestatus=0
probeanswer=$("$python" -S -E "$agb" instances --probe) || probestatus=$?
if [ "$probestatus" = 3 ]; then plist_read_ok 3 "$agb"; fi
if [ "$probeanswer" != instances-ok ]; then
    die "$python -S -E $agb instances --probe did not answer instances-ok.
       agb-refresh asks agb instances which config each launchd job was started
       with, so it can tell which map to repair.
       Either $python is not a usable python3, or that agb predates
       agb instances (0.5.0 and earlier) and answers unknown command -- which is
       empty stdout, exactly like a plist that names no config, so the two
       cannot be told apart later.
       Pass --python <absolute path to python3>, or re-run
       install.sh mac --instance <name> to install a current agb, agb_mac and
       agb_ops together (--instance is required, and a bare mac install is
       refused)."
fi

# HOW THIS SCRIPT NAMES ITSELF FOR THE RE-EXEC BELOW. `$0` is whatever the
# caller typed, and it is not always a path: `agb-refresh` found on `$PATH` (the
# installed spelling -- `install.sh` copies this file into `--dest`) and
# `sh agb-refresh` typed in the script's own directory both leave a `$0` with no
# slash. The suite invokes an ABSOLUTE path and would never see either, which is
# the harness-simpler-than-reality shape this file keeps being bitten by.
#
# ⚠️ THE CURRENT DIRECTORY FIRST, THEN `$PATH`, and the order is not a
# preference: it is the order `sh <name>` itself uses to find a script operand
# (bash tries the name as a path relative to the cwd and only then searches
# `$PATH`; verified, not assumed). Matching it is what guarantees the CHILDREN
# ARE THE SAME FILE AS THE PARENT -- with a copy in both places, `$PATH` first
# would sweep through a different copy of this script than the one running, and
# nothing would say so.
#
# ⚠️ And it is spelled out rather than left to `sh "$0"`, which happens to work
# on bash for both spellings, because POSIX does not require the `$PATH` search
# at all (dash does not do it) and because a name that resolves NOWHERE has to
# be one loud `die` here rather than `sh: can't open` once per instance, after
# the first job has already been booted out.
#
# `command -v` and not a hand-rolled `$PATH` walk: it is the shell's own
# resolution, including its `$PATH` parsing and its executable test. It answers
# a bare word for a builtin or a function, so only an answer WITH A SLASH is
# taken as a file.
sweep_self() {
    case $1 in
        */*) printf '%s' "$1"; return 0 ;;
    esac
    if [ -f "./$1" ]; then printf './%s' "$1"; return 0; fi
    ss_found=$(command -v "$1" 2>/dev/null || :)
    case $ss_found in
        */*) printf '%s' "$ss_found"; return 0 ;;
    esac
    return 1
}

# EVERY INSTANCE, unless this run named one.
#
# A bare `agb-refresh` used to act on the UNNAMED instance and report success in
# exactly the words it would have used for the one you meant. That default was
# an artifact of install order rather than of the domain: all the Mac-side
# instances have the same standing, any of them can be closed by hand, killed or
# come back with its rows forgotten, and the command that repairs that should not
# have to be told which. (design.md §5, limitation 1.)
#
# WHAT NARROWS IT, and why each one does:
#
#   --instance / --label / --config   name an instance outright.
#   --rows                            names ONE map, and naming a map IS naming
#                                     what to act on; such a run keeps today's
#                                     semantics exactly.
#
# ⚠️ `--key` does NOT narrow it, and that is the decision that keeps this file's
# own documented recipe (`agb-refresh --key a3f9c1e0`, at the top) working: it is
# typed by someone reading a key out of a bridge log, who has no way to know
# which instance minted it -- "you should not have to know which instance" is the
# whole point of the sweep. A key belongs to exactly one map, so the sweep finds
# it wherever it lives and fails only when NO instance had it.
#
# ⚠️ IT RE-EXECS THIS SCRIPT ONCE PER LABEL RATHER THAN LOOPING IN PROCESS. This
# is 1600 lines of `set -eu` with per-run globals -- `pattern`, `broad`,
# `notedloose`, `looseheld`, `waited`, `plistconfig`, `plistsaid` -- and a `die`
# on most error paths. An in-process loop would carry one instance's state into
# the next, and, worse, any `die` would end the whole sweep with jobs already
# booted out and never started again. A fresh process resets every global for
# free and leaves each `die` correct for the single instance it is about.
#
# ⚠️ AND THE CHILD CANNOT RE-SWEEP, structurally rather than by a rule it is
# told to obey: it is given `--label`, which is one of the four flags above.
if [ -z "$instance" ] && [ -z "$label" ] && [ -z "$config" ] && [ -z "$rows" ]
then
    # ⚠️ NON-ZERO IS FATAL, and it is contract 2 of `agb instances`: a missing
    # `~/Library/LaunchAgents` is exit 0 with no output ("no instances"), and
    # every other errno is exit 1 with the reason on stderr. Reading the second
    # as the first is invariant 12 verbatim -- "I could not answer" collapsing
    # into "the answer is nothing" -- and it would make a Mac with a momentarily
    # unreadable directory sweep nothing, fall through to the default job and
    # report success.
    sweepstatus=0
    sweeplabels=$("$python" -S -E "$agb" instances --labels \
        --launch-agents "$agentsdir") || sweepstatus=$?
    [ "$sweepstatus" = 0 ] || die "cannot list the instances in $agentsdir
       ($python -S -E $agb instances --labels exited $sweepstatus; the reason is
       on stderr above). \"I could not list them\" is not \"there are none\":
       taking it as none would fall back to the default instance and report
       success for a run that swept nothing.
       Fix that directory, or name one instance with --instance/--label/--config."
    if [ -z "$sweeplabels" ]; then
        # ⚠️ NO INSTANCES IS NOT AN ERROR, because a Mac with no plist at all is
        # the commonest thing this command is run on: agterm forgot its rows,
        # `install.sh mac --no-load` was used, or the plist was never rendered.
        # That run still forgets the default map and warns that nothing was
        # restarted, which is the recipe in SKILL.md and has to keep working. So
        # this falls THROUGH to the single-instance path below rather than
        # exiting.
        say "note:     no agbridge instance is installed in $agentsdir, so this"
        say "          run acts on the default instance alone."
    else
        sweepself=$(sweep_self "$0") || die "cannot find this script again to sweep with: \$0 is \"$0\", which is neither a path, nor a file in this directory, nor on \$PATH.
       The sweep re-runs this file once per instance, so it has to be able to
       name it. Invoke it by path (sh /path/to/agb-refresh), or name one
       instance with --instance/--label/--config."
        # ⚠️ EVERY FLAG IS FORWARDED EXPLICITLY, and `--dry-run` above all: a
        # sweep that dropped it would perform a REAL refresh of every instance
        # for a command that promised to change nothing. `--agb` and `--python`
        # matter just as much and are easier to lose sight of, because a child
        # without them falls back to `~/.local/lib/agbridge/agb` -- which exists
        # on a real Mac, so the sweep would quietly act through a DIFFERENT tree
        # from the one the parent was told to use.
        #
        # `--rows` is absent on purpose: it is one of the four flags that narrow,
        # so a run that carries one never reaches here.
        set -- --agb "$agb" --python "$python" --launch-agents "$agentsdir"
        for k in $keys; do set -- "$@" --key "$k"; done
        [ "$dry" = yes ] && set -- "$@" --dry-run
        [ "$noclose" = yes ] && set -- "$@" --no-close
        say "sweep:    every agbridge instance in $agentsdir"
        sweepn=0; sweepok=""; sweepfailed=""; sweepdown=""
        sweepstopped=""; sweepskipped=""; sweepsigcode=0
        # A here-document rather than a pipe, for the reason `bridge_alive` gives
        # for the same shape: a `while` on the right of a `|` runs in a subshell
        # in POSIX sh, and every counter below would be discarded with it.
        #
        # ⚠️ And `read -r` line by line rather than `for l in $sweeplabels`,
        # because `install.sh --label` puts no shape rule on a label: one
        # containing a blank would be split into two by IFS and swept as two
        # instances that do not exist. (A label containing a NEWLINE is
        # unrepresentable here, as a config path containing one already is.)
        while IFS= read -r sweeplabel; do
            [ -n "$sweeplabel" ] || continue
            # ⚠️ A CHILD KILLED BY A SIGNAL STOPS THE SWEEP. Ctrl-C reaches the
            # whole process group, so this is usually moot -- but when only the
            # child was signalled, carrying on would bounce the remaining
            # instances after the operator asked for it to stop.
            if [ "$sweepsigcode" != 0 ]; then
                sweepskipped="$sweepskipped $sweeplabel"
                continue
            fi
            sweepn=$((sweepn + 1))
            say ""
            sweepcode=0
            # ⚠️ `</dev/null`, because the loop's own stdin IS the here-document
            # holding the labels: a child that read one byte of it would eat the
            # instances that had not been swept yet.
            sh "$sweepself" --label "$sweeplabel" "$@" </dev/null || sweepcode=$?
            if [ "$sweepcode" = 0 ]; then
                sweepok="$sweepok $sweeplabel"
            elif [ "$sweepcode" = 4 ]; then
                # 4 is the child saying "I could not start the bridge again"
                # (see `start_label`). It is a different fact from a failed
                # forget and it is always an error, `--key` or not: an instance
                # left without a running bridge is the thing that would make
                # bare-is-all unsafe.
                sweepdown="$sweepdown $sweeplabel"
            elif [ "$sweepcode" -ge 128 ]; then
                sweepsigcode=$sweepcode
                sweepstopped=$sweeplabel
            else
                sweepfailed="$sweepfailed $sweeplabel(exit $sweepcode)"
            fi
        done <<EOF
$sweeplabels
EOF
        say ""
        sweeprc=0
        if [ -n "$sweepdown" ]; then
            say "WARNING:  no bridge was started again for:${sweepdown}."
            say "          Every instance is meant to end this run with its"
            say "          bridge back up -- re-run install.sh mac --instance"
            say "          <name> for those, one per label above."
            # ⚠️ EXCEPT the bare default label, and the sweep is exactly where
            # it turns up: it visits every plist in `$agentsdir`, a 0.5.0-era
            # nameless one included. `install.sh mac` requires `--instance`, so
            # the advice above would mint a SECOND instance beside that job
            # rather than repair it. `start_label` says the same thing for the
            # single-instance run; this is the sweep's copy, because the list
            # here is labels and the advice above is given once for all of them.
            case " $sweepdown " in
                *" $DEFAULT_LABEL "*)
                    say "          NOT $DEFAULT_LABEL, though: that one is a legacy"
                    say "          nameless install and a re-run would mint a second"
                    say "          instance beside it. Migrate it to a name --"
                    say "          CHANGELOG.md, 'Upgrading from <= 0.5.0'." ;;
            esac
            sweeprc=1
        fi
        if [ -n "$keys" ]; then
            # ⚠️ WITH `--key`, A CHILD'S EXIT 1 IS THE ORDINARY ANSWER and not a
            # failure: `agb forget-rows` returns 1 when a named key was not in
            # the map it opened, so every instance that does not hold the key
            # says 1. A key belongs to exactly one map, so the run succeeds when
            # ANY instance reported success and fails only when none did.
            #
            # ⚠️ What that cannot see, stated rather than hidden: several `--key`s
            # spread across DIFFERENT instances make every child answer 1 (each
            # forgets its own and reports the others missing), so this says no
            # instance had them although all of them were forgotten. It errs
            # towards a failure for work that succeeded -- the safe direction --
            # and each child's own `forget <key> -> <row>` lines are on the
            # terminal above. Telling the two apart would mean reading the
            # children's output instead of their status.
            if [ -n "$sweepok" ]; then
                say "keys:     forgotten by:${sweepok}"
            else
                say "WARNING:  no instance had all of these keys:${keys}"
                sweeprc=1
            fi
        elif [ -n "$sweepfailed" ]; then
            say "WARNING:  failed:${sweepfailed}"
            say "          The rest were still swept; the output above says how"
            say "          each one ended."
            sweeprc=1
        fi
        if [ "$sweepsigcode" != 0 ]; then
            say "WARNING:  $sweepstopped was interrupted, so the sweep stopped"
            say "          there. Its own bridge was started again before it"
            say "          exited; NOT visited:${sweepskipped:- (none)}"
            sweeprc=$sweepsigcode
        fi
        if [ "$sweepn" = 1 ]; then sweepword=instance; else sweepword=instances; fi
        say "swept:    $sweepn $sweepword"
        exit "$sweeprc"
    fi
fi

# The LABEL half is resolved first, on its own, because the plist it names is
# what the config half is read out of below.
if [ -n "$instance" ]; then
    [ -n "$label" ] || label="$DEFAULT_LABEL.$instance"
fi
if [ -z "$label" ] && [ -n "$config" ]; then bind_label_to_config; fi
[ -n "$label" ] || label="$DEFAULT_LABEL"

plist="$agentsdir/$label.plist"
uid=$(id -u)

# WHICH CONFIG. An explicit `--config` wins, exactly as it does in `install.sh`
# (install.sh:534) -- but with none given, ASK THE PLIST rather than rebuild the
# path by convention.
#
# ⚠️ `--instance hostb` does NOT imply `<config dir>/hostb/config`.
# `install.sh mac --instance hostb --config <somewhere else>` is supported and
# documented, and the plist is the only record of where that install put it.
# Reconstructing the conventional path there gives a config file that does not
# exist: `forget-rows` reports "the map is already empty" and returns 0, so the
# recovery command repairs a map that was never there and calls it a success --
# while the real map keeps its stale bindings and the `no such session` spam
# that sent you here carries on.
#
# The convention is still the fall-back, for the case the plist cannot answer:
# a Mac where the plist was never rendered (or was hand-deleted) can still be
# refreshed by name.
#
# ⚠️ BUT "THE PLIST IS NOT THERE" AND "THE PLIST IS THERE AND UNREADABLE" ARE
# NOT THE SAME QUESTION, and this site collapsed them. `plist_arg` answers exit
# 2 to both -- a missing file and a truncated, mode-000 or not-a-plist one -- and
# the convention is the right fall-back for only the first of them. For the
# second it is a guess about a file that is sitting right there saying otherwise:
# `agb-refresh --instance hostb` against an install made with `--config
# <elsewhere>` and a corrupted `com.agbridge.hostb.plist` repaired
# `~/.config/agbridge/hostb/config` -- a map that never existed, so `forget-rows`
# reported "already empty" and exited 0 -- while the liveness pattern, built from
# the same empty `$plistconfig`, waited for a bridge whose command line names the
# real config. Success, twice, on the wrong instance.
#
# So the unreadable case REFUSES, and names the flag that settles it. This is a
# recovery command: it is allowed to ask which map, and is not allowed to guess
# between two answers when the file that knows is unreadable.
#
# `[ -e ]` is what tells the two apart, and it is deliberately the weaker test.
# It answers false for a dangling symlink and for a plist under a directory this
# user cannot search -- both of which take the convention, exactly as they did
# before -- so this can only ever turn the noisier direction ON, never a working
# `agb-refresh --instance` OFF.
plistsaid=yes
if plistconfig=$(plist_arg "$plist" --config); then :; else
    # `$?` before anything else runs, and `plist_read_ok` dies unless it is 2.
    plist_read_ok "$?" "$plist"
    plistconfig=""; plistsaid=no
fi
if [ -z "$config" ]; then
    if [ -n "$plistconfig" ]; then
        config=$plistconfig
    elif [ "$plistsaid" = no ] && [ -e "$plist" ]; then
        die "$plist exists but could not be read as a plist.
       It is the only record of which config ${instance:+instance $instance }uses, so this run
       cannot tell which map to repair -- pass --config <path> to say, or
       re-run install.sh mac --instance <name> to render the plist again
       (--instance is required, and a bare mac install is refused)."
    elif [ -n "$instance" ]; then
        config="$DEFAULT_CONFIG_DIR/$instance/config"
    else
        config="$DEFAULT_CONFIG"
    fi
fi

# Said out loud on EVERY run, not only on failure. Running this against the
# wrong instance is its one real hazard and it is entirely silent: the stop, the
# forget and the start all succeed, and every other line of output is identical
# to the run you meant to make. The banner is the whole mitigation, which is why
# it is unconditional and names both halves -- the label says which job was
# bounced, the config says whose bindings were discarded.
#
# The NAME is read back out of the label when the command line did not carry
# one, because `bind_label_to_config` (and a bare `--label com.agbridge.hostb`)
# can land on an instance nobody typed the name of -- and a banner that answered
# "(default)" there would be the one line of output that is wrong, in the line
# whose entire job is to say which instance moved. `com.agbridge` itself has no
# suffix and stays "(default)".
#
# ⚠️ AND A LABEL OUTSIDE THE `com.agbridge` SPACE IS NOT THE DEFAULT ONE EITHER.
# `install.sh mac --label <anything>` puts no shape rule on a label, so
# `weird.label` is a real install -- and the fall-through used to answer
# "(default)" for it, which is the same falsehood the paragraph above forbids,
# in the same line. It became reachable without anybody typing a label when the
# bare run started SWEEPING: the sweep types `--label` for each plist it finds,
# custom labels included, so an operator who never named an instance was told a
# custom-label one was the default. Such an instance has no name but its label,
# so the label is what is shown; only `$DEFAULT_LABEL` itself is "(default)".
shown=$instance
if [ -z "$shown" ]; then
    case $label in
        "$DEFAULT_LABEL".*) shown=${label#"$DEFAULT_LABEL".} ;;
        "$DEFAULT_LABEL") ;;
        *) shown=$label ;;
    esac
fi
say "instance: ${shown:-(default)} -- label $label, config $config"

# `agb` is not executable and has no shebang on purpose, so it is always run as
# an argument to the interpreter.
#
# `--config` travels to `forget-rows`, which derives BOTH the rows map and the
# placements file from it. Passing only a rows path would forget this instance's
# bindings and then write its `key = workspace` lines into the DEFAULT
# instance's placements file -- the recovery command corrupting the instance it
# was not even asked about. An explicit --rows still wins, as it always did.
set -- forget-rows --config "$config"
for k in $keys; do set -- "$@" --key "$k"; done
[ -n "$rows" ] && set -- "$@" --rows "$rows"
[ "$dry" = yes ] && set -- "$@" --dry-run
[ "$noclose" = yes ] && set -- "$@" --no-close

if [ "$dry" = yes ]; then
    say "dry run:  would stop $label, forget the bindings below, then start it"
    "$python" -S -E "$agb" "$@" || :
    say "dry run:  nothing was changed"
    exit 0
fi

# 1. stop, and WAIT for it. `|| :` because "not running" is a fine state to
#    start from -- this is a recovery command and refusing to run when the
#    bridge is already down would be the opposite of helpful.
#
#    `bootout` returns as soon as launchd has accepted the request, not when the
#    process is gone, and the bridge is usually blocked reading its ssh. A
#    forget that lands while the old bridge is still alive is the thing this
#    script exists to prevent: that bridge holds the row map in memory and
#    merges-then-writes on every save, so it can re-mint rows against ids
#    `forget-rows` has just closed -- reinstating the "no such session" spam
#    that sent you here. So poll until the process is actually gone.
#
#    WHICH bridge, though. `--dest` is shared by every instance (one code
#    install, N configurations), so a bare `pgrep -f "$agb bridge"` matches
#    instance A's bridge while B is being refreshed: B boots out immediately,
#    the poll never clears, and the run ends in "still running after 10s" --
#    a warning that the forget may have been undone, printed on every single
#    refresh, in a recovery command reached by someone already annoyed. The
#    plist carries `--config <path>`, so that path separates them.
#
#    ⚠️ But the narrow pattern is DERIVED FROM THE PLIST, never assumed,
#    because assuming it is the same bug pointing the other way -- and that one
#    is silent. `install.sh mac --instance hostb` renders hostb's plist and does
#    NOT restart the default job, while it does install this newer agb-refresh
#    (shared --dest). So the normal state right after adding an instance is a
#    default bridge running with no `--config` in its command line. Against it a
#    narrow pattern matches nothing: `bridge_alive` answers false on the first
#    call, the poll exits with zero waits and no warning at all, and the forget
#    lands while that bridge is still alive -- re-minting rows against the ids
#    it has just closed. That is the "no such session" spam this script exists
#    to cure, reinstated by a fix aimed at a cosmetic warning.
#
#    So ask the plist what its bridge was actually started with: narrow when it
#    carries the flag, broad when it does not (or does not exist), and say so.
#
#    ⚠️ And that is still only what the PLIST says, which is not the same claim
#    as what the PROCESS is running. When the two disagree the narrow pattern
#    misses and the paragraph above happens anyway -- see `bridge_alive`, which
#    treats a narrow miss as unproven and asks one further question rather than
#    concluding the bridge is gone.
#
#    ⚠️ The VALUE is read from the plist too, not just the flag's presence
#    (`$plistconfig`, above). Deriving "is there a --config" from the plist and
#    then interpolating the config THIS RUN resolved is the same silent failure
#    the paragraph above describes, reached from the other end: an install made
#    with `--instance hostb --config <elsewhere>` has a plist whose value is not
#    the conventional one, so a pattern built from the convention matches
#    nothing -- zero waits, no warning, forget under a live bridge. And it is
#    the plist's value that is right in every case, because the plist is what
#    launchd actually started the process with; `--config` on THIS command line
#    says which map to repair, which is a different question.
#
#    The trailing `([[:space:]]|$)` is a boundary, and `pgrep -f` needs one:
#    it matches an unanchored ERE against the whole command line, so the default
#    instance's `.../agbridge/config` is a PREFIX of an instance named
#    `configb`'s `.../agbridge/configb/config`. Without the boundary a plain
#    `agb-refresh` while that instance is up polls a live process for the full
#    10 s and warns -- on the most common invocation there is.
#
#    ⚠️ And an ERE is what the two interpolated PATHS are read as too, which is
#    why they go through `ere_quote`. A config at `/tmp/a+b/config` interpolated
#    raw yields `a+b`, which matches `ab` and `aab` and not the path it came
#    from: the same zero-waits-no-warning-forget-under-a-live-bridge failure as
#    an undecoded entity, reached from a third direction. `$agb` is quoted for
#    the same reason -- it is a path in the same pattern and just as free to
#    contain a `+` or a `(`.
ere_quote() {
    printf '%s' "$1" | sed -e 's/[][(){}.*+?^$|\\]/\\&/g'
}

# DOES THIS PATH NAME A FILE THIS RUN REWRITES? The map is two files and they
# can come from two flags: `forget-rows` rewrites `dirname(<config>)/placements`
# always, and either `dirname(<config>)/rows` or the `--rows` this run was given
# (`agb_mac.instance_paths`). `same_map` compares DIRECTORIES, so one call per
# path covers both files under it.
ci_hits() {
    if same_map "$1" "$config"; then return 0; fi
    [ -n "$rows" ] || return 1
    same_map "$1" "$rows"
}

# EVERY VALUE OF `$2` ON THE LINE, OFFERED TO `ci_hits` IN POSITION ORDER.
# Returns 0 as soon as one of them names a file this run rewrites.
#
# ⚠️ EVERY occurrence, not the first, because the first is not the one the
# bridge is running on. `parse_bridge_args` (agb_mac) reads its value flags into
# a dict -- `opts[…] = inline`, no duplicate check -- so a repeated flag
# OVERWRITES and the LAST occurrence wins. A bridge started `… bridge --config
# /old --config <this instance's>` is holding THIS map, while reading only the
# first gave `/old` and its blank-prefix walk (`/old --config <this>`, `/old
# --config`, `/old`) never reached the winning value: not ours, no wait,
# `forget-rows` under a live bridge.
#
# ⚠️ And "the last one" cannot simply REPLACE "the first one" here, because on a
# flattened `ps` line the two readings are not exclusive -- see the blank walk
# below. `--config "/a --config /b"` is ONE path containing the literal text,
# indistinguishable from two flags, and the first reading is the right one for
# it while the last is right for a genuinely repeated flag. Nothing on the line
# says which. So both are offered: every occurrence, each with its own walk.
# That is a strict SUPERSET of what either reading alone proposes, and the extra
# candidates can only ever produce an over-match, which is a bounded 10 s wait.
#
# ⚠️ AND "EVERY OCCURRENCE" MEANS IN POSITION ORDER, over ONE marker that covers
# both spellings. Two `case` arms -- `*" --config "*` then `*" --config="*` --
# do not scan in position order at all: `case` picks by ARM order, so a line
# carrying an INLINE occurrence before a space-form one took the space arm and
# cut there, discarding the inline value and every prefix of it. That value is
# precisely what `parse_bridge_args` keeps under the one-flag-with-blanks
# reading this walk exists for (`--config=/tmp/a --config b/config` is ONE
# argument whose value is `/tmp/a --config b/config`), so the winning candidate
# was never offered: not ours, no wait, `forget-rows` under a live bridge. The
# earlier round's permutation check missed it by only ever building lines from
# SEPARATE flags, which is the reading in which the loss is a harmless
# over-match -- a harness narrower than the property it was guarding.
ci_scan() {
    cs_line=$1
    cs_flag=$2
    while :; do
        # One marker, cut at its FIRST occurrence (`#` is the shortest prefix),
        # which is what makes the scan positional. What follows it says which
        # spelling this is.
        case $cs_line in
            *" $cs_flag"*) cs_rest=${cs_line#*" $cs_flag"} ;;
            *) return 1 ;;
        esac
        # Past this occurrence, so the next turn finds the next one and the loop
        # always shortens. The last occurrence -- the one the parser keeps when
        # the line is read as separate flags -- is always reached: cutting at an
        # earlier one retains everything after it.
        cs_line=$cs_rest
        case $cs_rest in
            # `--config <value>`, and `--config=<value>`: `parse_bridge_args`
            # partitions on `=` before looking the name up, so both spellings
            # start a value right here.
            " "*) cs_rest=${cs_rest#" "} ;;
            "="*) cs_rest=${cs_rest#"="} ;;
            # `--configuration/x` inside somebody's path, or a line ending in a
            # bare `--config` (which is a missing-value error, so no bridge is
            # running on it). Not the flag: no candidate here, and no evidence
            # either way for `ci_config_certain` below.
            *) continue ;;
        esac
        # ⚠️ `ps` flattens the arguments with blanks, so a path CONTAINING a
        # blank cannot be told apart from the flag that follows it -- and blanks
        # are allowed (`install.sh --config` asks only that the path be
        # absolute). Every blank-terminated prefix is offered instead, longest
        # first. An over-match costs a bounded 10 s wait; an under-match is
        # `forget-rows` landing under a live bridge, so it errs in the direction
        # it can afford.
        while :; do
            if ci_hits "$cs_rest"; then return 0; fi
            case $cs_rest in
                *" "*) cs_rest=${cs_rest% *} ;;
                *) break ;;
            esac
        done
    done
}

# DOES THIS LINE PROVE THE BRIDGE WAS STARTED WITH A REAL `--config`?
#
# ⚠️ ` --config ` BYTES ARE NOT A `--config` FLAG. `ps` flattens argv, so
# `bridge --workspace "farm --config /other/config"` -- a bridge with NO config
# flag, running on `agb.config_path()`, holding the DEFAULT map -- prints a line
# byte-for-byte identical to one carrying the flag. Reading those bytes as proof
# is what let the answer skip the default-map question below and come back "not
# ours" on a default refresh: zero waits, `forget-rows` under a live bridge over
# the map being repaired. That is the unsafe polarity, and it is the same shape
# as every earlier round -- a test narrower than the thing it guards.
#
# It is UNDECIDABLE from the line alone (both readings are real argvs), so it is
# resolved towards the wait: a `--config` is proof only when NO OTHER
# value-taking flag appears before it, because there is then no value it could
# be part of. Everything else falls through to "could this be holding the
# default map?", which costs a bounded 10 s and only on a run that repairs that
# map.
#
# ⚠️ Not a narrowing of the ordinary case: `ProgramArguments` puts `--config`
# immediately after `bridge` (dist/com.agbridge.plist), so every launchd-started
# bridge is proof and another instance's is still not waited for. What changes
# is a hand-started `agb bridge --feed-host X --config Y`, which is now waited
# for on a default-map run -- which the "does nothing for" list below already
# claimed, from the other direction.
#
# The scan starts AFTER `<agb> bridge`, because argv does: a `--config` inside
# the agb path itself is not an argument at all, and taking it as one made the
# line "proof" with nothing before it. `${1#*"$agb bridge"}` leaves the line
# untouched when that text is absent, which is the cautious direction (more text
# to find a value-taking flag in).
ci_config_certain() {
    ci_marked=""
    cc_rest=${1#*"$agb bridge"}
    case $cc_rest in
        *" --config "*|*" --config="*) ci_marked=yes ;;
        *) return 1 ;;
    esac
    cc_pre=${cc_rest%%" --config"*}
    for cc_flag in $BRIDGE_VALUE_FLAGS; do
        # `--config` itself excepted: an earlier one could swallow this one, but
        # then the line carries a config flag either way, which is all this asks.
        case $cc_flag in --config) continue ;; esac
        case $cc_pre in *" $cc_flag"*) return 1 ;; esac
    done
    return 0
}

# IS THIS COMMAND LINE A BRIDGE OVER THE MAP THIS RUN REPAIRS?
#
# ⚠️ Attribution, not text matching. Two spellings of one path are one map
# (invariant 12) and `same_map` is the one place that comparison lives -- the
# same call `bind_label_to_config` makes about the plists. Comparing the strings
# here would reinstate, one door along, the bug `same_map` was extracted to fix.
#
# ⚠️ TWO FLAGS DECIDE WHICH MAP A BRIDGE HOLDS, not one. `render_settings`
# (agb_mac) spends `--rows` before the config -- `opts.get("rows") or
# rows_path(config)` -- so `bridge --config <elsewhere> --rows <this map's rows>`
# is writing the very file this run is about to rewrite while its `--config`
# names somewhere else entirely. Asking only about `--config` answered "not
# ours": zero waits, `forget-rows` under a live bridge that merges-then-writes
# and re-mints rows against the ids it has just closed. So both flags are
# scanned, and a `--rows` hit is enough on its own.
#
# ⚠️ But only `--config` decides the UNTAGGED question below. A bridge with a
# `--rows` and no `--config` still resolves `agb.config_path()` for its
# placements file, so it holds part of the default instance's map; letting
# `--rows` count as "this line carries a flag" would skip that question and
# under-match -- the unsafe direction again.
#
# `$ci_why` is the answer's REASON, computed here and read by `bridge_alive` for
# the note and the 10 s warning. Derived a second time from the line, it drifted
# from the first: it called a bridge whose only `--config` was the text
# `--configs/b` one that is "spelled differently". The two questions are the
# same question, so they are asked once.
cmdline_is_ours() {
    ci_why=""
    if ci_scan "$1" --config; then ci_why=spelling; return 0; fi
    if ci_scan "$1" --rows; then ci_why=rows; return 0; fi
    # Nothing on the line named a file this run rewrites. It is somebody else's
    # only if it is PROVABLY on a config of its own; otherwise it may be running
    # on `agb.config_path()`, and the DEFAULT instance's map is then the only one
    # it can hold.
    if ci_config_certain "$1"; then return 1; fi
    if [ -n "$ci_marked" ]; then ci_why=ambiguous; else ci_why=untagged; fi
    ci_hits "$DEFAULT_CONFIG"
}

# Say ONCE why a wait nobody asked for is happening -- a silent wait in a
# recovery command is indistinguishable from the hang it looks like -- and
# remember WHICH answer is holding it, because the 10 s warning has to name that
# and not `$label`.
loose_hold() {
    looseheld=$1
    [ -z "$notedloose" ] || return 0
    notedloose=yes
    case $1 in
        untagged)
            say "note:     a bridge is running whose command line carries no"
            say "          --config, so it cannot be told apart from this"
            say "          instance's -- waiting for it too rather than assuming"
            say "          it is gone. install.sh mac --no-load, a hand-started"
            say "          bridge, or a plist re-rendered without a restart all"
            say "          leave one."
            ;;
        spelling)
            say "note:     a bridge is running whose --config is spelled"
            say "          differently but resolves to this same map, so it IS"
            say "          this instance's and is being waited for. A re-rendered"
            say "          plist, a symlinked \$HOME, a relative path, or the flag"
            say "          given more than once (agb bridge keeps the LAST) all"
            say "          leave one."
            ;;
        rows)
            say "note:     a bridge is running whose --rows names this same map,"
            say "          so it is writing the file this run rewrites and is"
            say "          being waited for -- whatever its --config says."
            say "          agb bridge --rows overrides the rows file the config"
            say "          would have chosen."
            ;;
        ambiguous)
            say "note:     a bridge is running whose --config cannot be told"
            say "          apart from part of another flag's value (ps prints the"
            say "          arguments flattened), so it may be running on the"
            say "          default config and holding this map -- waiting for it"
            say "          rather than assuming it is gone."
            ;;
        *)
            say "note:     ps would not say what the running bridges were"
            say "          started with, so none of them can be told apart from"
            say "          this instance's -- waiting rather than assuming they"
            say "          are gone."
            ;;
    esac
}

# ⚠️ A NARROW MISS IS "NOT PROVEN GONE", NOT "GONE", and that distinction is the
# whole of this function.
#
# `$pattern` is derived from the PLIST; what it is being asked about is the
# RUNNING PROCESS. Nothing keeps those two in step. `install.sh mac --no-load`
# writes the plist and deliberately leaves the old bridge running (install.sh
# says so, in those words); a bridge started by hand for debugging carries
# whatever was typed; a re-rendered or hand-edited plist describes a process
# that has not restarted yet. In every one of those the plist carries `--config`
# and the live bridge does not, the narrow pattern matches nothing on the first
# poll, and the loop below never runs a second time: zero waits, no output, and
# `stopped:` printed as a claim nobody checked. The forget then lands under a
# live bridge, which merges-then-writes and re-mints rows against the ids it has
# just closed -- the `no such session` spam this script exists to cure, restored
# silently. On main the pattern was the broad one and that bridge WAS waited
# for, so a narrow miss taken as proof is a REGRESSION, not merely a gap.
#
# So a miss is not the end of the question. What is actually running is asked
# DIRECTLY instead: `pgrep -f` hands back the pids of every `<agb> bridge`,
# `ps -ww -o args=` turns those pids back into the command lines they were
# started with, and each one is attributed to a map by `same_map`.
#
# ⚠️ READING THE COMMAND LINES IS THE POINT, AND NO PATTERN CAN REPLACE IT.
# `pgrep -f` matches a regex against whatever spelling the process was started
# with, and there is no way to canonicalise the far side of a regex match. A
# bridge over THIS map started with a merely different spelling of the same path
# -- `<dir>/./config`, a relative path, a symlinked `$HOME`, or the plist
# re-rendered by `install.sh mac --instance` after the running bridge was
# started from an older one -- matches no narrow pattern; and under the
# SUBTRACTION this replaces (every bridge, minus the ones carrying `--config`)
# it was counted on both sides, read as "tagged, therefore somebody else's", and
# not waited for. `forget-rows` then ran under a live bridge, silently. That is
# the label-side bug `same_map` was extracted to fix, arriving on the process
# side, and it is why the answer here is a canonical comparison and not a regex.
#
# The rules, one per running bridge:
#
#   * it carries `--config X`  ->  ours iff `X` names a file this run rewrites.
#   * it carries `--rows R`  ->  ours iff `R` does, whatever its `--config` says:
#     `render_settings` spends `--rows` FIRST (`opts.get("rows") or
#     rows_path(config)`), so that is the map it holds.
#   * it carries no PROVABLE `--config`  ->  it may be resolving
#     `agb.config_path()` itself, so the DEFAULT instance's is the only map it
#     can hold: ours iff this run repairs that map. That gate is why
#     `install.sh mac --instance hostb` -- which renders hostb's plist and does
#     NOT restart the default job, leaving a pre-0.5.0 untagged bridge up for
#     ever -- does not buy every later `agb-refresh --instance hostb` a
#     ten-second wait ending in "com.agbridge.hostb is still running after 10s",
#     a warning that is provably false since hostb's own bridge exited before the
#     first poll.
#   * `ps` will not say  ->  unattributable is NOT gone, so it is waited for.
#
# ⚠️ WHAT THIS DOES NOTHING FOR, deliberately, so the next reader does not have
# to rediscover it:
#
#   * a bridge started from a DIFFERENT `agb` path. `$broad` names this one and
#     always has; nothing here widens that.
#   * a Mac with no `pgrep` -- there is no poll at all there, and never was.
#   * a plist that carries no `--config`: `$pattern` is already the broad one,
#     `$broad` is empty and none of this runs. The note printed there covers it
#     -- that pattern matches ANY bridge, so nothing is missed, only attributed
#     loosely.
#   * a config path containing a NEWLINE. `ps` prints one process per line and
#     nothing can put that back together.
#   * a bridge whose `--config` names a directory that no longer exists.
#     `same_map` fails closed, so it reads as another map's -- which it is, in
#     the only sense that matters here: there is no map there to protect.
#   * a bridge holding this map that repeats `--config` where the value the
#     PARSER keeps is another instance's and an earlier one is this map's
#     (`--config <this> --config <other>`). Every occurrence is offered, so that
#     is attributed as ours and waited for although the bridge is somebody
#     else's -- an over-match, which costs a bounded 10 s wait. It is the price
#     of not having to decide which of the two readings of a flattened line is
#     the right one, and it is the direction this probe is allowed to be wrong
#     in.
#   * a bridge whose `--config` value is a path that itself begins with the
#     text `--config` (`--config --config=/x` puts the bridge on a file
#     literally named `--config=/x`, since the parser takes the next argument
#     verbatim). The scan reads that value as a second occurrence and offers
#     candidates from inside it: over-matches only, on a path nobody has.
#   * a bridge whose `--config` genuinely is its own but sits after another
#     value-taking flag (`--feed-host X --config Y`). `ci_config_certain` cannot
#     tell that from the same bytes inside `X`, so it is waited for on a
#     default-map run: an over-match, and the same bounded 10 s.
#   * a bridge whose `--rows` names a DIFFERENT file in this map's directory
#     (`--rows <dir>/rows.bak`). `same_map` compares directories, so it reads as
#     ours -- an over-match, and the direction that costs a wait rather than a
#     forget under a live bridge.
#
# A config path containing a BLANK *is* handled, by `ci_scan` offering every
# blank-terminated prefix; a REPEATED `--config` is handled by offering every
# occurrence, because `agb bridge` keeps the last (see the note on `ci_scan`);
# either SPELLING of it is handled, by scanning one marker in position order
# rather than one `case` arm per spelling; a `--rows` that moves the map out from
# under the config is handled by scanning it too; a `--config` that might be
# inside another flag's value is handled by not treating it as proof; so is `ps`
# saying nothing, and so is a bridge started by hand as
# `agb bridge --feed-host X --config Y` (not proof, so waited for on a
# default-map run). All of them err towards a bounded wait.
#
# `$looseheld` records WHICH answer held the wait, for the 10s warning: `$label`
# is the job that was booted out, so naming it for a wait something else is
# driving names the one process that is provably not what the poll keeps
# matching.
bridge_alive() {
    [ -n "$pgrep" ] || return 1
    if "$pgrep" -f "$pattern" >/dev/null 2>&1; then looseheld=""; return 0; fi
    [ -n "$broad" ] || return 1
    ba_pids=$("$pgrep" -f "$broad" 2>/dev/null | tr '\n' ',') || :
    ba_pids=${ba_pids%,}
    # The one positive answer in this function: no bridge of any spelling is up.
    [ -n "$ba_pids" ] || return 1
    # `-o args=` is POSIX and prints no header; `-ww` because BSD `ps` truncates
    # to the terminal width (80 columns when stdout is not a tty) and would cut
    # the `--config` off the end of exactly the lines this reads. The plain form
    # is tried second in case some `ps` refuses the pair.
    #
    # ⚠️ Retried on EMPTINESS, not on the exit status. A `ps` that refuses
    # `-ww` prints nothing, but one asked about a mix of live and exited pids
    # may print the live ones AND exit non-zero -- and it is the lines that are
    # wanted. Retrying on the status throws those away and falls into the
    # "could not attribute" branch, which is safe but talks.
    ba_lines=$(ps -ww -o args= -p "$ba_pids" 2>/dev/null || :)
    [ -n "$ba_lines" ] || ba_lines=$(ps -o args= -p "$ba_pids" 2>/dev/null || :)
    if [ -z "$ba_lines" ]; then
        # Either those pids exited between the two commands -- ask again, since
        # "gone" is then a positive answer and not worth a note -- or `ps` will
        # not answer at all, and unattributable is not gone.
        "$pgrep" -f "$broad" >/dev/null 2>&1 || return 1
        loose_hold unknown
        return 0
    fi
    ba_held=""
    # A here-document, not a pipe: a `while` on the right of a `|` runs in a
    # subshell in POSIX sh and `$ba_held` would not survive it.
    while IFS= read -r ba_line; do
        [ -n "$ba_line" ] || continue
        if cmdline_is_ours "$ba_line"; then
            # ⚠️ WHICH note is read off `$ci_why`, the reason the attribution
            # itself just computed, and NOT off a second `case` on the line. A
            # second one drifts from the first: it said "spelled differently"
            # for a line whose only `--config` was the text `--configs/b`
            # inside some other flag's value -- a bridge that carries no
            # `--config` at all, described to the operator as one that does.
            # The two questions are the same question, so they are asked once.
            ba_held=$ci_why
            break
        fi
    done <<EOF
$ba_lines
EOF
    [ -n "$ba_held" ] || return 1
    loose_hold "$ba_held"
    return 0
}

# START THE JOB AGAIN. A function because there are now TWO ways out of the
# window between the bootout and the restart -- running to the end of the script,
# and being killed in the middle of it -- and both have to leave the bridge up.
# Spelling the four launchctl lines twice is how the two would drift.
#
# ⚠️ ITS RETURN VALUE IS A FACT ABOUT THE BRIDGE, not about launchctl: 1 means
# "this Mac is now without a bridge for this label", which the caller turns into
# exit 4 and the sweep reports as an error. Two branches deliberately answer 0:
#
#   * no `launchctl` at all -- nothing was stopped either, so nothing is down.
#   * NO PLIST AT THIS LABEL. It is what a Mac whose plist was never rendered
#     (or was hand-deleted) looks like, and `agb-refresh --instance <name>`
#     against one is a DOCUMENTED, working recipe -- the convention is the
#     fall-back for the config, and the warning below is the whole of what it
#     costs. Making it an error would repeal that promise, which is why "no
#     running bridge is an error" is a rule about the SWEEP: a label the sweep
#     visits came out of a plist in `$agentsdir`, so this branch cannot be
#     reached there -- unless that file is deleted underneath the run, a race
#     with a human `rm` whose only alternative is a second flag telling the child
#     it is inside a sweep.
start_label() {
    command -v launchctl >/dev/null 2>&1 || return 0
    if [ ! -f "$plist" ]; then
        say "WARNING:  no plist at $plist -- the bridge was not restarted"
        return 0
    fi
    if launchctl bootstrap "gui/$uid" "$plist" >/dev/null 2>&1; then
        say "started:  $label"
        return 0
    fi
    if launchctl load -w "$plist" >/dev/null 2>&1; then
        say "started:  $label (legacy load -w)"
        return 0
    fi
    # ⚠️ THE ADVICE BRANCHES ON THE LABEL, and it has to. `install.sh mac`
    # requires `--instance` now, so "run it again" is the repair for a NAMED
    # job and the opposite of a repair for the bare `com.agbridge` one: that is
    # a legacy nameless install, and a re-run MINTS A SECOND INSTANCE beside it
    # -- its own config, label and rows map, and every row duplicated. Same
    # reasoning as the "no --config in $plist" note above, and it reaches here
    # through the sweep, which visits every plist in `$agentsdir` including a
    # 0.5.0-era one. The name is `$instance` when it was typed, else the label's
    # own suffix; a custom label carries no name at all, so that case keeps the
    # placeholder rather than inventing one.
    #
    # ⚠️ AND THAT LAST CASE IS WHY THIS IS NOT `$shown`, the banner's answer,
    # which is in scope right here and agrees on every other label. `$shown`
    # answers `weird.label` for a custom-label install -- correct as a NAME to
    # display, and false as the value after `--instance`, which would derive
    # `~/.config/agbridge/weird.label/config` and the label
    # `com.agbridge.weird.label`: a command that installs a SECOND instance
    # rather than repairing this one. Display and advice are two questions, so
    # the rule is applied twice on purpose; `agb_mac.instance_display_name`
    # says the same from the other side, and
    # `test_the_restart_advice_never_offers_a_custom_label_as_a_name` pins the
    # divergence so a future edit cannot collapse the two by accident.
    if [ "$label" = "$DEFAULT_LABEL" ]; then
        say "WARNING:  could not start $label -- it is a legacy nameless install,"
        say "          so re-running install.sh mac would MINT A SECOND INSTANCE"
        say "          beside it rather than repair it (--instance is required"
        say "          now). Load $plist by hand, or migrate it to a name --"
        say "          CHANGELOG.md, 'Upgrading from <= 0.5.0'."
        return 1
    fi
    sl_name=$instance
    if [ -z "$sl_name" ]; then
        case $label in
            "$DEFAULT_LABEL".*) sl_name=${label#"$DEFAULT_LABEL".} ;;
        esac
    fi
    say "WARNING:  could not start $label -- run install.sh mac --instance ${sl_name:-<name>} again"
    return 1
}

# ⚠️ THE TRAP LIVES IN THIS PROCESS, WHICH UNDER A SWEEP IS THE CHILD. The
# window that matters is between `launchctl bootout` and the restart: a Ctrl-C
# there leaves that instance's bridge DOWN, with its rows forgotten and nothing
# to re-mint them -- the dark sidebar this command exists to cure, caused by it.
# A trap in the sweeping parent could not help, because the parent never boots
# anything out; one in BOTH would bootstrap the same job twice.
#
# Re-raised rather than `exit`ed, so the caller sees the conventional 128+signo
# and can tell an interrupt from a failure -- which is what stops the sweep at
# the instance the operator interrupted instead of carrying on through the rest.
on_signal() {
    trap - INT TERM HUP
    say ""
    say "WARNING:  interrupted (SIG$1) with $label stopped -- starting it again"
    say "          before exiting, so nothing is left down."
    start_label || :
    kill -"$1" $$
    # Only reached if the signal is somehow not fatal here; still non-zero, so
    # the sweep records it rather than reading the interrupt as a success.
    exit 1
}

# Derived INSIDE the launchctl branch, with the note it prints: `bridge_alive`
# is called from nowhere else, so on a host without launchctl this is advice
# about a poll that never runs.
if command -v launchctl >/dev/null 2>&1; then
    pattern="$(ere_quote "$agb") bridge"
    if [ -n "$plistconfig" ]; then
        # Kept as `$broad` before it is narrowed: the fallback probe in
        # `bridge_alive` needs the unnarrowed form, and rebuilding it there
        # would be a second place for the quoting to be got right.
        broad=$pattern
        pattern="$pattern --config $(ere_quote "$plistconfig")"'([[:space:]]|$)'
        # ⚠️ `$broad` is NOT gated on "does this run repair the default map"
        # any more, and that used to be a line here. The gate did not move, it
        # got narrower: it is now asked per BRIDGE, inside `cmdline_is_ours`,
        # where an untagged one is the only kind it can be about. Emptying
        # `$broad` here switched off the attribution of every OTHER bridge too
        # -- including one over this very map under a different spelling, which
        # is the case that made this a review finding.
    elif [ "$plistsaid" = no ]; then
        # ⚠️ A DIFFERENT NOTE, because it is a different fact. This branch used
        # to say "no --config in <plist>" for a file that had not been read at
        # all, and the advice that follows -- re-render it -- is the advice for
        # a plist predating the flag, not for one that is unreadable. The WAIT
        # is the same and is the safe direction either way (broad matches any
        # bridge); only the explanation was wrong, and it is the explanation
        # somebody acts on.
        say "note:     $plist could not be read, so the wait below matches ANY"
        say "          bridge on this Mac. That file is also the record of which"
        say "          config this job uses -- check it, or re-run"
        say "          install.sh mac --instance <name>."
    else
        # ⚠️ THE ADVICE HERE IS A MIGRATION, NOT A RE-RENDER, and that is the
        # one place the mandatory `--instance` changes what an operator should
        # be told. A plist with no `--config` predates the flag, i.e. it is a
        # nameless install -- and `install.sh mac` refuses a nameless install
        # now, so the obvious repair (re-run it with the original flags) does
        # not repair this job at all: it MINTS A SECOND INSTANCE beside it, with
        # its own config, label and rows map, and every row duplicated. There is
        # no in-place upgrade for such a job; giving it a name is the only route
        # forward, and the ordered steps for that live in the changelog.
        say "note:     no --config in $plist, so the wait below matches ANY"
        say "          bridge on this Mac. That plist predates the flag, and"
        say "          install.sh mac cannot re-render it in place: --instance"
        say "          is required now, so a re-run would MINT A NEW INSTANCE"
        say "          beside this one. Migrate it to a name instead --"
        say "          CHANGELOG.md, 'Upgrading from <= 0.5.0'."
    fi
    pgrep=$(command -v pgrep 2>/dev/null || :)
    # Armed HERE, one statement before the job goes down, and cleared once it is
    # back up: outside that window there is nothing for it to repair, and a trap
    # that outlived it would restart a job this run never stopped.
    trap 'on_signal INT' INT
    trap 'on_signal TERM' TERM
    trap 'on_signal HUP' HUP
    launchctl bootout "gui/$uid/$label" >/dev/null 2>&1 || :
    waited=0
    while bridge_alive; do
        # 40 x 0.25s. A bound rather than a spin: if something is holding the
        # process open we still go on and do the useful work, with the risk
        # named out loud rather than hanging for ever in a recovery command.
        if [ "$waited" -ge 40 ]; then
            # ⚠️ Which process, honestly. `$label` is the job that was booted
            # out; when the wait is held by something the narrow pattern never
            # matched, that job is exactly the one provably not still matching,
            # and naming it makes the warning false in the case it fires most.
            case $looseheld in
                untagged)
                    say "WARNING:  a bridge with no --config is still running after"
                    say "          10s; forgetting anyway. It holds the default"
                    say "          instance's map, which is the one being repaired."
                    ;;
                spelling)
                    say "WARNING:  a bridge whose --config is spelled differently (or"
                    say "          repeated) but names this same map is still running"
                    say "          after 10s; forgetting anyway."
                    ;;
                rows)
                    say "WARNING:  a bridge whose --rows names this same map is still"
                    say "          running after 10s; forgetting anyway. It writes the"
                    say "          file this run rewrites."
                    ;;
                ambiguous)
                    say "WARNING:  a bridge whose --config may be part of another"
                    say "          flag's value is still running after 10s; forgetting"
                    say "          anyway. It may be holding this map."
                    ;;
                unknown)
                    say "WARNING:  a bridge ps would not name is still running after"
                    say "          10s; forgetting anyway. It could not be told"
                    say "          apart from this instance's."
                    ;;
                *)
                    say "WARNING:  $label is still running after 10s; forgetting anyway."
                    ;;
            esac
            say "          If rows come back wrong, run agb-refresh again."
            break
        fi
        sleep 0.25 2>/dev/null || sleep 1
        waited=$((waited + 1))
    done
    say "stopped:  $label"
else
    say "note:     launchctl not found; skipping stop/start"
fi

# 2. forget. Through `agb`, never with sed: the map ends in an `#end <count>`
#    sentinel and a hand-edited line leaves the count wrong, which makes the
#    whole map read as corrupt and discards the bindings you meant to keep.
code=0
"$python" -S -E "$agb" "$@" || code=$?

# 3. start again, whatever step 2 said: leaving the bridge down because one key
#    was not in the map would turn a small surprise into a dark sidebar.
startok=yes
start_label || startok=no
trap - INT TERM HUP

say "next:     reopen agterm if it is closed; rows return on the next snapshot"

# ⚠️ 4 OVERRIDES `$code`, and it is the one status the sweep reads specially.
# `$code` is `agb forget-rows`' -- 1 when a `--key` was not in this map, which
# under a sweep is the ORDINARY answer from every instance that does not hold
# that key. A bridge that could not be started again is a different fact
# entirely: it is the one outcome that leaves this Mac worse than before the run,
# so it must not be indistinguishable from the answer the sweep expects most.
[ "$startok" = yes ] || exit 4
exit $code
