#!/bin/sh
# agb-refresh -- rebuild agterm's rows after agterm has forgotten them.
#
# Use it when agterm was closed, reset or reinstalled and the sidebar comes back
# empty (or a row is gone) while the bridge keeps logging:
#
#   agb bridge: agtermctl session rename failed (exit 1): error: no such session: <id>
#
# The Mac's `key -> row` map still names ids agterm has dropped. Nothing else
# clears a *bound* entry -- `close-done` only touches `[done]` rows and `prune`
# works from farm-side state -- so the binding has to be forgotten and re-minted.
#
#   agb-refresh                  # forget every binding; all rows come back
#   agb-refresh --key a3f9c1e0   # just one, when the other rows are still fine
#   agb-refresh --dry-run        # say what would happen
#   agb-refresh --instance hostb # the second Mac-side instance, not the default
#
# WHICH INSTANCE is the one thing this command cannot infer and the one thing
# it is dangerous to get wrong: without --instance it stops com.agbridge,
# forgets the default instance's bindings and starts it again, reporting
# success in exactly the words it would have used for the instance you meant.
# So it names the instance, the label and the config file on every run.
#
# NOTHING ON THE FARM IS TOUCHED. The agents, their keys and their state are
# untouched; only this Mac's binding is discarded, so rows return with the same
# identities.
#
# The three steps are a sequence for a reason: the bridge holds the map in
# memory and merges-then-writes on every save, so an edit underneath a running
# bridge can simply be rewritten.

set -eu

DEFAULT_LABEL="com.agbridge"
DEFAULT_AGENTS="$HOME/Library/LaunchAgents"
DEFAULT_AGB="$HOME/.local/lib/agbridge/agb"
# One directory, two spellings of what lives in it -- the same pair install.sh
# derives its own from (install.sh:53-57): the default instance's config is the
# file, a named instance's is a subdirectory of the same place.
#
# ⚠️ Unlike `$rows` and `$python` below, `$config` is NEVER left empty as the
# spelling of "not given" once it has been resolved. Two things read it and both
# break on "": `forget-rows --config ""` is a missing-value error, and the
# banner would name no file at all. (The liveness pattern used to be a third:
# it is now built from `$plistconfig` instead, whose emptiness IS meaningful --
# it is how "this plist predates the flag" is spelled, and it selects the broad
# pattern and the note that says so.)
DEFAULT_CONFIG_DIR="$HOME/.config/agbridge"
DEFAULT_CONFIG="$DEFAULT_CONFIG_DIR/config"

die() { printf 'agb-refresh: %s\n' "$*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }

usage() {
    cat >&2 <<'EOF'
usage: agb-refresh [--key <key>]... [--dry-run] [options]

  --key <key>        forget one binding; repeatable. Default: all of them
  --dry-run          say what would happen; change nothing
  --no-close         leave agterm's sessions open (they become duplicates
                     when the bridge mints fresh rows)
  --instance <name>  act on the instance installed as <name>: label
                     com.agbridge.<name>, and the config its plist names.
                     Sugar for --label and --config, which must always move
                     together
  --config <path>    the instance's config (default: the one the label's plist
                     was rendered with, else ~/.config/agbridge[/<name>]/config).
                     Given alone it also adopts the label of the plist that
                     names it -- which is what makes the bridge's own
                     `agb-refresh --config ...` hint act on the right job
  --label <name>     launchd label                     (default com.agbridge)
  --launch-agents <dir>                     (default ~/Library/LaunchAgents)
  --agb <path>       the installed agb          (default ~/.local/lib/agbridge/agb)
  --python <path>    interpreter to run it with
  --rows <path>      the rows map                 (default: beside the config)
  -h, --help         this message
EOF
}

# The same rule, and the same words, as `install.sh`'s `instance_ok`
# (install.sh:150): a name is a launchd label component, a plist FILENAME, a log
# directory and a config DIRECTORY, so `.` and `/` are refused outright -- there
# is no spelling of a `..` segment or a leading dot. The two validators have to
# agree, because a name this one accepts and the installer refuses names a plist
# that was never rendered.
instance_ok() {
    case "$1" in
        "") die "--instance needs a name" ;;
        -*) die "--instance must not start with '-': $1" ;;
        *[!A-Za-z0-9_-]*)
            die "--instance must be letters, digits, '-' or '_': $1. It names a launchd label component, a plist filename and a config directory, so a '/' or a '.' in it would look for all three somewhere other than where install.sh put them" ;;
    esac
}

agentsdir=$DEFAULT_AGENTS; agb=$DEFAULT_AGB
noclose=no
# `label` and `config` start EMPTY rather than at their defaults so that "was it
# given explicitly?" is still answerable below, where --instance fills them in.
label=""; config=""; instance=""
python=""; rows=""; dry=no; keys=""
# All set only once launchctl is known to exist; `set -u` needs them anyway.
# `broad` is the un-narrowed liveness pattern and stays EMPTY when `$pattern`
# already is the broad one, or when this run repairs a map an untagged bridge
# cannot be holding -- that emptiness is how `bridge_alive` knows there is no
# second question left to ask. `notedloose` makes its note print once;
# `looseheld` says which of the two questions answered on the last poll, which
# is what the 10s warning has to name.
pgrep=""; pattern=""; broad=""; notedloose=""; looseheld=""

need() { [ "$1" -gt 1 ] || die "$2 needs a value"; }

while [ $# -gt 0 ]; do
    case $1 in
        --key) need $# "$1"; keys="$keys $2"; shift 2 ;;
        --dry-run) dry=yes; shift ;;
        --no-close) noclose=yes; shift ;;
        # Validated here rather than after the loop, exactly as install.sh does
        # it: `need` only counts arguments, so `--instance ""` would otherwise
        # read as "not given" and refresh the DEFAULT instance while echoing the
        # name back.
        --instance) need $# "$1"; instance_ok "$2"; instance=$2; shift 2 ;;
        --config) need $# "$1"; config=$2; shift 2 ;;
        --label) need $# "$1"; label=$2; shift 2 ;;
        --launch-agents) need $# "$1"; agentsdir=$2; shift 2 ;;
        --agb) need $# "$1"; agb=$2; shift 2 ;;
        --python) need $# "$1"; python=$2; shift 2 ;;
        --rows) need $# "$1"; rows=$2; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *) usage; die "unknown option: $1" ;;
    esac
done

# The `<string>` that FOLLOWS `<string>--config</string>` in a rendered plist,
# or nothing. awk rather than sed or grep -A: `getline` is POSIX and behaves
# the same in BSD awk, where `sed -n '/x/{n;s/../p;}'` and GNU `grep -A1` are
# both a portability bet.
#
# ⚠️ The three entities `install.sh` writes ARE decoded here, and the comment
# this replaces claimed they could not occur ("a path with an `&` or a `<` in
# it never got written in the first place"). It gets written: `install.sh`'s
# `rep()` runs every substituted value through `xml_escape` first, so
# `install.sh mac --config '/tmp/a&b/config'` renders
# `<string>/tmp/a&amp;b/config</string>` and `plutil -lint` is perfectly happy
# with it -- the XML is valid, it was the *decoding* that was missing. Left
# undecoded both halves fail quietly: `$config` names a file that does not
# exist, so `forget-rows` reports "the map is already empty" and exits 0
# against a map it never opened, and the liveness pattern matches no bridge at
# all -- zero waits, no warning, forget under a live bridge.
#
# `"\\&"` in the replacement, never `"&"`: an unescaped `&` there means the
# matched text, so `gsub(/&amp;/, "&")` is a no-op that reads like a fix.
# `&amp;` is decoded LAST, because a path containing the literal text `&lt;` is
# written `&amp;lt;` and decoding `&amp;` first would turn it into a `<`.
plist_config() {
    awk '/<string>--config<\/string>/ {
             if ((getline) <= 0) exit
             gsub(/^[^<]*<string>|<\/string>.*$/, "")
             gsub(/&lt;/, "<")
             gsub(/&gt;/, ">")
             gsub(/&amp;/, "\\&")
             print
             exit
         }' "$1" 2>/dev/null
}

# WHERE A CONFIG'S MAP LIVES, canonically -- so two config paths can be compared
# for "do these repair the same instance" rather than for "were they typed the
# same way". The NAME says the rule; the block below says why it is the rule.
#
# ⚠️ It answers with the resolved DIRECTORY and NOTHING ELSE, because the
# directory is the whole of what `forget-rows` uses: `rows_path` and
# `placements_path` are `os.path.dirname(config) + "/rows"` and `.../placements`
# (agb_mac.instance_paths), so the basename plays no part in the map at all.
# Carrying the basename into the comparison -- which this did until the spelling
# below was tried -- makes it STRICTLY NARROWER than the equivalence it claims
# to mirror, and every spelling with a different final component falls through
# to the default label while `forget-rows` opens the right files:
#
#     --config <dir>/config   -> map <dir>/rows   canon <dir>
#     --config <dir>/         -> map <dir>/rows   canon <dir>   (tab completion)
#     --config <dir>//        -> map <dir>/rows   canon <dir>
#     --config <dir>/other    -> map <dir>/rows   canon <dir>
#
# The FINAL COMPONENT is still never resolved (no `readlink -f`), and a
# directory-only comparison already gives that: a config that is a symlink into
# another instance's directory keeps its map beside the LINK, which is where
# `forget-rows` will look, and the link's own directory is what canonicalises.
#
# Pure parameter expansion rather than `dirname`: that is an external command
# whose `--` handling varies across the BSD and GNU userlands this script runs
# on, and a path beginning with `-` would be read as an option by some of them.
# `cd -P` + `pwd -P` is what does the real work -- it collapses `//`, `.` and
# `..`, resolves symlinked parents, and makes a relative path absolute, all
# through the kernel rather than through string rules that would have to be
# reinvented here.
#
# ⚠️ It FAILS (non-zero, no output) rather than falling back to the string it
# was given, and every caller has to treat that as "no answer". One that quietly
# returned its input would make a directory that does not exist compare EQUAL to
# a plist naming a path that does, which is the wrong-label-with-the-wrong-map
# bounce `same_map`'s callers exist to prevent.
config_map_dir() {
    case $1 in
        */*) map_dir=${1%/*} ;;
        # No slash at all: `os.path.dirname("config")` is `""`, which
        # `os.path.join` turns into a plain `rows` -- relative to the cwd
        # `forget-rows` will run in, which is this one.
        *)   map_dir="." ;;
    esac
    # `${1%/*}` of `/config` is empty, and `cd ""` is not `cd /`.
    [ -n "$map_dir" ] || map_dir="/"
    map_dir=$(CDPATH= cd -P -- "$map_dir" 2>/dev/null && pwd -P) || return 1
    [ -n "$map_dir" ] || return 1
    printf '%s' "$map_dir"
}

# DO THESE TWO PATHS NAME ONE MAP? The equivalence itself, in ONE place, because
# two of them ask it -- `bind_label_to_config` below, and the untagged-bridge
# gate in the launchctl branch -- and it is the comparison design.md §5 records
# being got wrong four separate times. Spelled twice it had already drifted
# cosmetically while claiming in a comment to be the same rule, which is the
# state a fifth version arrives from.
#
# Raw FIRST: it is the answer for every ordinary invocation and it cannot fail,
# whereas `config_map_dir` needs the directory to exist. Then canonical, and
# FAIL CLOSED -- no canonical form on either side means the two are NOT known to
# name the same map. See `config_map_dir` on why it must not fall back to the
# string it was given.
#
# ⚠️ It answers a yes/no and nothing else, on purpose. The BASENAME plays no
# part in the map (`rows_path` is `dirname(config)/rows`), so it can never
# narrow this; where it does matter -- breaking the tie between two plists that
# have already matched -- it is read straight off the two paths at the call
# site, which is ranking, not matching.
same_map() {
    if [ "$1" = "$2" ]; then return 0; fi
    sm_a=$(config_map_dir "$1") || return 1
    sm_b=$(config_map_dir "$2") || return 1
    [ "$sm_a" = "$sm_b" ]
}

# WHICH LABEL, when only a config was named. Sets `$label` (or leaves it empty
# for the default below), and says so either way.
#
# ⚠️ This is the READER half of design.md §5's "--label and --config must
# always move together", and the bridge's own stale-row hint is what depends on
# it. `agb_mac.refresh_recipe` prints `agb-refresh --config <this instance's
# config>` into this instance's log -- the config path is the only identity a
# bridge has, since nothing tells it its instance name or its launchd label.
# With the label left at the default, that recipe followed literally is *worse*
# than the fixed `Run agb-refresh` it replaced: it boots out the DEFAULT job,
# waits for the DEFAULT bridge to exit, and then forgets THIS instance's
# bindings while THIS instance's bridge is still running -- and that bridge
# holds the row map in memory and merges-then-writes, so it re-mints rows
# against the ids `forget-rows` has just closed. The `no such session` spam
# that printed the hint comes back, with the rows now closed in agterm too.
#
# The label cannot be reconstructed from the config path either
# (`install.sh mac --instance hostb --config <elsewhere>` is supported), so it
# is looked up where it is recorded: the plists themselves, through the same
# `plist_config` the wait below uses.
#
# ⚠️ The comparison is on the MAP, never on the spelling, and the two halves of
# this script are what make that necessary: the label is chosen here by matching
# the plist's text, while the MAP is derived on the other side of `forget-rows`
# by `os.path.dirname`, which normalises AND drops the basename. So a spelling
# that still names the right map -- `//`, a `.` segment, a relative path typed
# from the instance's own directory, a symlinked `$HOME`, the bare DIRECTORY a
# tab-completion leaves you holding -- could fail to name the right LABEL, and
# the fallback is the DEFAULT label. That pair is the exact accident this
# function exists to prevent, arriving from the other direction: boot out
# instance A, wait for A's bridge (the narrow liveness pattern is built from A's
# plist), then forget B's bindings while B's bridge is live and merging. And it
# is reachable by a human following instructions -- `pane_config_warning` tells
# the operator to type this path by hand, on precisely the rows whose config has
# moved.
#
# ⚠️ So `same_map` compares DIRECTORIES, and two configs that share one
# match even when their basenames differ -- because they share a map, which is
# the only thing this run can damage. Two instances deliberately installed into
# ONE directory therefore both match, and that is right: they share the map too,
# and the "more than one" warning below is exactly the report that situation
# deserves.
#
# ⚠️ MATCHING on the directory and CHOOSING between the matches are two
# different questions, and running them together is how a job that merely shares
# the map came to beat the one whose config was named exactly. `*.plist` expands
# in collating order, so `com.agbridge.aaa` -- naming `<dir>/config.bak` -- won
# over `com.agbridge.hostb` naming `<dir>/config` on a `--config <dir>/config`
# run. Both are matches and both are reported; the one that names THIS PATH is
# the one used, and a plist that says so beats one that only implies it. Not a
# narrowing: a directory-only match still wins when it is the only one.
#
# ⚠️ And a plist carrying NO `--config` is not "no answer" either -- it is an
# answer of `$DEFAULT_CONFIG`. The bridge it starts resolves `agb.config_path()`
# itself, so the map it holds is the default instance's, and skipping it made
# the wrong-job bounce SILENT: with a second job's config installed into the
# default directory (`--instance hostb --config ~/.config/agbridge/hostb-config`
# -- one map, two jobs), a `--config <default config>` run saw only hostb's
# plist, adopted its label, and found nothing to warn about because it was the
# only match.
#
# Two guards on that implication, because both directions of it are wrong:
#
#   * the plist must be READABLE. `plist_config` answers "" both for "no
#     `--config` in it" and for "could not read it at all" (mode 000, root
#     owned), and reading the second as the default config would let an
#     unreadable plist claim a map it says nothing about -- the wrong-job bounce
#     manufactured by the fix for it.
#   * the name must be in the `com.agbridge` label space. `~/Library/LaunchAgents`
#     is shared with every other program on the Mac, and none of their plists
#     carries a `--config`; without this, `agb-refresh --config <default config>`
#     would count `com.some-other-app` as a claimant of agbridge's map and could
#     bounce it. An agbridge install under a `--label` of its own is therefore
#     NOT implied, which is the pre-existing behaviour: no match, the default
#     label, and the note that says so.
#
# Whether two paths name one map is `same_map`'s question and is asked nowhere
# else; the raw-then-canonical order and the fail-closed rule live with it.
bind_label_to_config() {
    # `bestrank=9` is the "nothing yet" sentinel: worse than any rank the loop
    # below can produce, so the first match always wins its own comparison.
    matched=""; claimants=""; nclaim=0; bestrank=9
    configbase=${config##*/}
    for candidate in "$agentsdir"/*.plist; do
        # An unmatched glob comes back as the pattern itself.
        [ -f "$candidate" ] || continue
        # ⚠️ `|| value=""`, exactly as the `$plistconfig` read below does it, and
        # for a reason `set -e` makes invisible: an ASSIGNMENT from a command
        # substitution takes that command's status, so one unreadable plist in
        # the directory (mode 000, or root-owned) makes `awk` exit 2 and kills
        # the whole script -- silently, since its stderr is discarded, in a
        # recovery command. The inline `[ "$(plist_config …)" = … ]` this
        # replaced was immune by accident: the status was the test's, not awk's.
        value=$(plist_config "$candidate") || value=""
        name=${candidate##*/}
        name=${name%.plist}
        declared=yes
        if [ -z "$value" ]; then
            # No `--config` -- or no answer at all. See the two guards above.
            [ -r "$candidate" ] || continue
            case $name in
                "$DEFAULT_LABEL"|"$DEFAULT_LABEL".*) ;;
                *) continue ;;
            esac
            value=$DEFAULT_CONFIG
            declared=no
        fi
        exact=no
        if [ "$value" = "$config" ]; then
            exact=yes
        else
            # Not the same text. The same MAP?
            same_map "$value" "$config" || continue
            # Same directory, so the same map either way; whether it is also
            # the same FILE is what breaks the tie below. Read off the paths,
            # not off `same_map` -- the basename is a RANKING input and must
            # never reach the match (see `same_map`).
            if [ "${value##*/}" = "$configbase" ]; then exact=yes; fi
        fi
        claimants="$claimants $name"
        nclaim=$((nclaim + 1))
        # ⚠️ RANKED, and the second half of the rank is not decoration: a plist
        # that DECLARES this config beats one that merely IMPLIES it by carrying
        # no `--config`. Without that, the implication introduced above hands the
        # glob order back the decision it was just taken away from -- a stale
        # flagless `com.agbridge.old.plist` sorts before `com.agbridge.plist` and
        # would be bounced instead of the job that actually names the path. The
        # rest is glob order, which is at least deterministic and is reported.
        #
        #   rank 1  names this exact file + declares a --config
        #        2  names this exact file + only implies one
        #        3  shares the directory  + declares a --config
        #        4  shares the directory  + only implies one
        #       (9  the sentinel above: no claimant seen yet)
        if [ "$exact" = yes ]; then rank=1; else rank=3; fi
        if [ "$declared" = no ]; then rank=$((rank + 1)); fi
        if [ "$rank" -lt "$bestrank" ]; then matched=$name; bestrank=$rank; fi
    done
    if [ -z "$matched" ]; then
        # Not fatal: an install made with `install.sh mac --config <nondefault>`
        # before the plist carried the flag is a plain `com.agbridge` job, and
        # that is exactly the case the default below is right for. Said out
        # loud, because the other reading -- a named instance whose plist was
        # deleted -- is the wrong-job bounce this function exists to prevent.
        #
        # ⚠️ And the CONSEQUENCE is spelled out, not just the fact, because the
        # note above reads as reassurance while the destructive steps run
        # anyway. This is the one branch where the label and the map provably
        # come from different places, so it says which job it is about to bounce
        # and whose bindings it is about to discard, in those words.
        #
        # ⚠️ Both are NAMED, never pointed at. This ran for a while saying "the
        # config above", and there is nothing above it: the banner that prints
        # the config comes later, so the one branch whose whole job is to be
        # precise about which config was pointing at blank space. `$config` is
        # always set here -- this function is only reached when `--config` was
        # given -- so it can simply be spelled.
        say "note:     no plist in $agentsdir names this config, so the label"
        say "          below is the default one. If this config belongs to an"
        say "          instance, pass --instance <name> (or --label) as well."
        say "          Otherwise this run stops $DEFAULT_LABEL and forgets the"
        say "          bindings of $config -- check they belong together,"
        say "          and use --dry-run if you are not sure."
        return 0
    fi
    # ⚠️ Reported on the COUNT of claimants, not on "was there a runner-up of
    # the same kind". Splitting the matches into exact and directory-only ones
    # gave two lists that could each hold one entry while two jobs were still
    # sharing the map -- the silence that made the wrong-job bounce above
    # invisible, arriving through the accounting rather than through the match.
    #
    # It is a warning and not a refusal because there is nothing to choose: the
    # jobs share a rows file, so whichever is bounced, the other keeps running
    # over the map `forget-rows` is about to rewrite. This is a recovery
    # command; it says so and gets on with it.
    if [ "$nclaim" -gt 1 ]; then
        say "WARNING:  more than one launchd job claims this config's map:"
        # `${claimants# }` strips the leading space the accumulator above leaves
        # on every value, so this line indents like the other three rather than
        # by nine and borrowing the tenth from the data.
        say "          ${claimants# }."
        say "          Using $matched -- the others keep running and hold the"
        say "          same rows file. Pass --label to pick one."
    fi
    label=$matched
}

# --instance is sugar over --label and --config, and the whole reason for the
# sugar is that those two must move TOGETHER: a label without its config stops
# instance B and forgets instance A's bindings. An explicit --label/--config
# still wins, because both of these are `[ -n ... ] ||` and so are the plain
# defaults below them.
#
# `--config` on its own stays supported and is not redundant: an install made
# with `install.sh mac --config <nondefault>` and no --instance has no instance
# name to pass, and would otherwise be unable to refresh against its own map.
# It is also what the bridge's stale-row hint prints, which is why it binds the
# label too (`bind_label_to_config`, above).
#
# The LABEL half is resolved first, on its own, because the plist it names is
# what the config half is read out of below.
if [ -n "$instance" ]; then
    [ -n "$label" ] || label="$DEFAULT_LABEL.$instance"
fi
if [ -z "$label" ] && [ -n "$config" ]; then bind_label_to_config; fi
[ -n "$label" ] || label="$DEFAULT_LABEL"

[ -f "$agb" ] || die "no agb at $agb (pass --agb <path>)"

if [ -z "$python" ]; then
    python=$(command -v python3 2>/dev/null || :)
    [ -n "$python" ] || die "no python3 found; pass --python <absolute path>"
fi

plist="$agentsdir/$label.plist"
uid=$(id -u)

# WHICH CONFIG. An explicit `--config` wins, exactly as it does in `install.sh`
# (install.sh:355) -- but with none given, ASK THE PLIST rather than rebuild the
# path by convention.
#
# ⚠️ `--instance hostb` does NOT imply `<config dir>/hostb/config`.
# `install.sh mac --instance hostb --config <somewhere else>` is supported and
# documented, and the plist is the only record of where that install put it.
# Reconstructing the conventional path there gives a config file that does not
# exist: `forget-rows` reports "the map is already empty" and returns 0, so the
# recovery command repairs a map that was never there and calls it a success --
# while the real map keeps its stale bindings and the `no such session` spam
# that sent you here carries on.
#
# The convention is still the fall-back, for the case the plist cannot answer:
# a Mac where the plist was never rendered (or was hand-deleted) can still be
# refreshed by name.
plistconfig=$(plist_config "$plist") || plistconfig=""
if [ -z "$config" ]; then
    if [ -n "$plistconfig" ]; then
        config=$plistconfig
    elif [ -n "$instance" ]; then
        config="$DEFAULT_CONFIG_DIR/$instance/config"
    else
        config="$DEFAULT_CONFIG"
    fi
fi

# Said out loud on EVERY run, not only on failure. Running this against the
# wrong instance is its one real hazard and it is entirely silent: the stop, the
# forget and the start all succeed, and every other line of output is identical
# to the run you meant to make. The banner is the whole mitigation, which is why
# it is unconditional and names both halves -- the label says which job was
# bounced, the config says whose bindings were discarded.
#
# The NAME is read back out of the label when the command line did not carry
# one, because `bind_label_to_config` (and a bare `--label com.agbridge.hostb`)
# can land on an instance nobody typed the name of -- and a banner that answered
# "(default)" there would be the one line of output that is wrong, in the line
# whose entire job is to say which instance moved. `com.agbridge` itself has no
# suffix and stays "(default)".
shown=$instance
if [ -z "$shown" ]; then
    case $label in
        "$DEFAULT_LABEL".*) shown=${label#"$DEFAULT_LABEL".} ;;
    esac
fi
say "instance: ${shown:-(default)} -- label $label, config $config"

# `agb` is not executable and has no shebang on purpose, so it is always run as
# an argument to the interpreter.
#
# `--config` travels to `forget-rows`, which derives BOTH the rows map and the
# placements file from it. Passing only a rows path would forget this instance's
# bindings and then write its `key = workspace` lines into the DEFAULT
# instance's placements file -- the recovery command corrupting the instance it
# was not even asked about. An explicit --rows still wins, as it always did.
set -- forget-rows --config "$config"
for k in $keys; do set -- "$@" --key "$k"; done
[ -n "$rows" ] && set -- "$@" --rows "$rows"
[ "$dry" = yes ] && set -- "$@" --dry-run
[ "$noclose" = yes ] && set -- "$@" --no-close

if [ "$dry" = yes ]; then
    say "dry run:  would stop $label, forget the bindings below, then start it"
    "$python" -S -E "$agb" "$@" || :
    say "dry run:  nothing was changed"
    exit 0
fi

# 1. stop, and WAIT for it. `|| :` because "not running" is a fine state to
#    start from -- this is a recovery command and refusing to run when the
#    bridge is already down would be the opposite of helpful.
#
#    `bootout` returns as soon as launchd has accepted the request, not when the
#    process is gone, and the bridge is usually blocked reading its ssh. A
#    forget that lands while the old bridge is still alive is the thing this
#    script exists to prevent: that bridge holds the row map in memory and
#    merges-then-writes on every save, so it can re-mint rows against ids
#    `forget-rows` has just closed -- reinstating the "no such session" spam
#    that sent you here. So poll until the process is actually gone.
#
#    WHICH bridge, though. `--dest` is shared by every instance (one code
#    install, N configurations), so a bare `pgrep -f "$agb bridge"` matches
#    instance A's bridge while B is being refreshed: B boots out immediately,
#    the poll never clears, and the run ends in "still running after 10s" --
#    a warning that the forget may have been undone, printed on every single
#    refresh, in a recovery command reached by someone already annoyed. The
#    plist carries `--config <path>`, so that path separates them.
#
#    ⚠️ But the narrow pattern is DERIVED FROM THE PLIST, never assumed,
#    because assuming it is the same bug pointing the other way -- and that one
#    is silent. `install.sh mac --instance hostb` renders hostb's plist and does
#    NOT restart the default job, while it does install this newer agb-refresh
#    (shared --dest). So the normal state right after adding an instance is a
#    default bridge running with no `--config` in its command line. Against it a
#    narrow pattern matches nothing: `bridge_alive` answers false on the first
#    call, the poll exits with zero waits and no warning at all, and the forget
#    lands while that bridge is still alive -- re-minting rows against the ids
#    it has just closed. That is the "no such session" spam this script exists
#    to cure, reinstated by a fix aimed at a cosmetic warning.
#
#    So ask the plist what its bridge was actually started with: narrow when it
#    carries the flag, broad when it does not (or does not exist), and say so.
#
#    ⚠️ And that is still only what the PLIST says, which is not the same claim
#    as what the PROCESS is running. When the two disagree the narrow pattern
#    misses and the paragraph above happens anyway -- see `bridge_alive`, which
#    treats a narrow miss as unproven and asks one further question rather than
#    concluding the bridge is gone.
#
#    ⚠️ The VALUE is read from the plist too, not just the flag's presence
#    (`$plistconfig`, above). Deriving "is there a --config" from the plist and
#    then interpolating the config THIS RUN resolved is the same silent failure
#    the paragraph above describes, reached from the other end: an install made
#    with `--instance hostb --config <elsewhere>` has a plist whose value is not
#    the conventional one, so a pattern built from the convention matches
#    nothing -- zero waits, no warning, forget under a live bridge. And it is
#    the plist's value that is right in every case, because the plist is what
#    launchd actually started the process with; `--config` on THIS command line
#    says which map to repair, which is a different question.
#
#    The trailing `([[:space:]]|$)` is a boundary, and `pgrep -f` needs one:
#    it matches an unanchored ERE against the whole command line, so the default
#    instance's `.../agbridge/config` is a PREFIX of an instance named
#    `configb`'s `.../agbridge/configb/config`. Without the boundary a plain
#    `agb-refresh` while that instance is up polls a live process for the full
#    10 s and warns -- on the most common invocation there is.
#
#    ⚠️ And an ERE is what the two interpolated PATHS are read as too, which is
#    why they go through `ere_quote`. A config at `/tmp/a+b/config` interpolated
#    raw yields `a+b`, which matches `ab` and `aab` and not the path it came
#    from: the same zero-waits-no-warning-forget-under-a-live-bridge failure as
#    an undecoded entity, reached from a third direction. `$agb` is quoted for
#    the same reason -- it is a path in the same pattern and just as free to
#    contain a `+` or a `(`.
ere_quote() {
    printf '%s' "$1" | sed -e 's/[][(){}.*+?^$|\\]/\\&/g'
}

# How many live processes a pattern matches. `pgrep -f` prints one pid per line
# and exits 1 with no output when there are none, so `wc -l` is the count either
# way -- and `tr -dc '0-9'` because BSD `wc` pads its output with blanks, which
# `[ ... -gt ... ]` is not obliged to accept.
bridge_count() {
    "$pgrep" -f "$1" 2>/dev/null | wc -l | tr -dc '0-9'
}

# ⚠️ A NARROW MISS IS "NOT PROVEN GONE", NOT "GONE", and that distinction is the
# whole of this function.
#
# `$pattern` is derived from the PLIST; what it is being asked about is the
# RUNNING PROCESS. Nothing keeps those two in step. `install.sh mac --no-load`
# writes the plist and deliberately leaves the old bridge running (install.sh
# says so, in those words); a bridge started by hand for debugging carries
# whatever was typed; a re-rendered or hand-edited plist describes a process
# that has not restarted yet. In every one of those the plist carries `--config`
# and the live bridge does not, the narrow pattern matches nothing on the first
# poll, and the loop below never runs a second time: zero waits, no output, and
# `stopped:` printed as a claim nobody checked. The forget then lands under a
# live bridge, which merges-then-writes and re-mints rows against the ids it has
# just closed -- the `no such session` spam this script exists to cure, restored
# silently. On main the pattern was the broad one and that bridge WAS waited
# for, so a narrow miss taken as proof is a REGRESSION, not merely a gap.
#
# So a miss is followed by one more question: is a bridge running that carries
# no `--config` AT ALL? It is asked by SUBTRACTION (every bridge, minus the ones
# that carry the flag) because "does not contain" is not an ERE, and `pgrep`
# speaks ERE.
#
# ⚠️ AND THAT QUESTION IS ONLY THIS RUN'S TO ASK WHEN IT IS REPAIRING THE
# DEFAULT MAP -- `$broad` is emptied above otherwise, which switches this whole
# probe off. The comment that used to stand here said an untagged bridge "cannot
# be another instance's, because `install.sh` renders the flag unconditionally",
# and that is only true of a bridge some 0.5.0 plist STARTED. The commonest
# untagged bridge on a Mac with instances is the DEFAULT job's, still running
# from a plist rendered before the flag existed: `install.sh mac --instance
# hostb` renders hostb's plist, installs this newer `agb-refresh`, and does not
# restart the default job. Against that bridge an ungated probe waited the full
# 10 s on EVERY `agb-refresh --instance hostb` and then printed
# "com.agbridge.hostb is still running after 10s" -- a warning that the forget
# may have been undone, provably false (hostb's bridge exited before the first
# poll), on every run of a recovery command. That is the every-run false warning
# narrowing the pattern was for, reinstated by the fix for the narrowing.
#
# An untagged bridge IS attributable, just not by its command line: with no
# `--config` it resolves `agb.config_path()` itself, so the only map it can hold
# is the default instance's. When that is the map being repaired the wait is
# real and is kept -- which is also the pre-0.5.0 behaviour, since the broad
# pattern is all `main` ever had.
#
# ⚠️ WHAT THIS PROBE DOES NOTHING FOR, deliberately, so the next reader does not
# have to rediscover it:
#
#   * an untagged bridge, when this run repairs a NON-default map. It cannot
#     hold that map unless it was started by hand with an explicit `--rows`, and
#     no plist can produce that.
#   * a bridge whose command line carries `--config <some other path>`. It is
#     counted on both sides, the difference is zero, and it is not waited for --
#     which is the POINT: an attributable bridge belongs to whichever instance
#     its config names, and waiting for another instance's bridge is the every-
#     run 10-second warning the narrow pattern exists to remove. If that path is
#     this instance's under a different spelling, the wait is skipped; the map is
#     still the right one, and the 10s branch is what reports the consequence.
#   * a Mac with no `pgrep` -- there is no poll at all there, and never was.
#   * a plist that carries no `--config`: `$pattern` is already the broad one, so
#     `$broad` is empty and this never runs. The note printed there covers it --
#     and that pattern matches ANY bridge, so nothing is missed, only attributed
#     loosely.
#
# It errs the other way for a bridge started by hand as
# `agb bridge --feed-host X --config Y`, whose `--config` is not adjacent to
# `bridge`: on a default-map run it counts as untagged and IS waited for. That
# is the safe direction (a bounded 10s wait for a hand-started process) and the
# case is one this probe is meant to catch anyway.
#
# `$looseheld` records WHICH question answered, for the 10s warning: `$label` is
# the job that was booted out, so naming it for a wait the probe is driving
# names the one process that is provably not what the poll keeps matching.
bridge_alive() {
    [ -n "$pgrep" ] || return 1
    if "$pgrep" -f "$pattern" >/dev/null 2>&1; then looseheld=""; return 0; fi
    [ -n "$broad" ] || return 1
    [ "$(bridge_count "$broad")" -gt "$(bridge_count "$broad --config")" ] \
        || return 1
    looseheld=yes
    # Once, not on all forty polls -- and said at all, because a wait nobody
    # asked for is otherwise indistinguishable from the hang it looks like.
    if [ -z "$notedloose" ]; then
        notedloose=yes
        say "note:     a bridge is running whose command line carries no"
        say "          --config, so it cannot be told apart from this"
        say "          instance's -- waiting for it too rather than assuming"
        say "          it is gone. install.sh mac --no-load, a hand-started"
        say "          bridge, or a plist re-rendered without a restart all"
        say "          leave one."
    fi
    return 0
}

# Derived INSIDE the launchctl branch, with the note it prints: `bridge_alive`
# is called from nowhere else, so on a host without launchctl this is advice
# about a poll that never runs.
if command -v launchctl >/dev/null 2>&1; then
    pattern="$(ere_quote "$agb") bridge"
    if [ -n "$plistconfig" ]; then
        # Kept as `$broad` before it is narrowed: the fallback probe in
        # `bridge_alive` needs the unnarrowed form, and rebuilding it there
        # would be a second place for the quoting to be got right.
        broad=$pattern
        pattern="$pattern --config $(ere_quote "$plistconfig")"'([[:space:]]|$)'
        # ⚠️ The fallback probe is only this run's to ask when this run repairs
        # the DEFAULT map: a bridge with no `--config` resolves
        # `agb.config_path()` itself, so that is the only map it can hold.
        # Emptying `$broad` is what switches it off -- see `bridge_alive` for
        # the every-run false warning an ungated probe printed on every
        # `agb-refresh --instance <name>`.
        #
        # `same_map` is the whole test, and deliberately the SAME call
        # `bind_label_to_config` makes: "is this the default instance's map"
        # is not a second, looser question. Its fail-closed rule is what is
        # wanted here too -- a config whose directory does not exist has no
        # map to protect anyway.
        same_map "$config" "$DEFAULT_CONFIG" || broad=""
    else
        say "note:     no --config in $plist, so the wait below matches ANY"
        say "          bridge on this Mac. Re-run install.sh mac to render a"
        say "          plist that carries it."
    fi
    pgrep=$(command -v pgrep 2>/dev/null || :)
    launchctl bootout "gui/$uid/$label" >/dev/null 2>&1 || :
    waited=0
    while bridge_alive; do
        # 40 x 0.25s. A bound rather than a spin: if something is holding the
        # process open we still go on and do the useful work, with the risk
        # named out loud rather than hanging for ever in a recovery command.
        if [ "$waited" -ge 40 ]; then
            # ⚠️ Which process, honestly. `$label` is the job that was booted
            # out; when the wait is the fallback probe's, that job is exactly
            # the one provably not still matching, and naming it makes the
            # warning false in the case it fires most.
            if [ -n "$looseheld" ]; then
                say "WARNING:  a bridge with no --config is still running after"
                say "          10s; forgetting anyway. It holds the default"
                say "          instance's map, which is the one being repaired."
            else
                say "WARNING:  $label is still running after 10s; forgetting anyway."
            fi
            say "          If rows come back wrong, run agb-refresh again."
            break
        fi
        sleep 0.25 2>/dev/null || sleep 1
        waited=$((waited + 1))
    done
    say "stopped:  $label"
else
    say "note:     launchctl not found; skipping stop/start"
fi

# 2. forget. Through `agb`, never with sed: the map ends in an `#end <count>`
#    sentinel and a hand-edited line leaves the count wrong, which makes the
#    whole map read as corrupt and discards the bindings you meant to keep.
code=0
"$python" -S -E "$agb" "$@" || code=$?

# 3. start again, whatever step 2 said: leaving the bridge down because one key
#    was not in the map would turn a small surprise into a dark sidebar.
if command -v launchctl >/dev/null 2>&1; then
    if [ -f "$plist" ]; then
        if launchctl bootstrap "gui/$uid" "$plist" >/dev/null 2>&1; then
            say "started:  $label"
        else
            launchctl load -w "$plist" >/dev/null 2>&1 \
                && say "started:  $label (legacy load -w)" \
                || say "WARNING:  could not start $label -- run install.sh mac again"
        fi
    else
        say "WARNING:  no plist at $plist -- the bridge was not restarted"
    fi
fi

say "next:     reopen agterm if it is closed; rows return on the next snapshot"
exit $code
