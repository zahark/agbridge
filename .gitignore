# build output
/build/
*.o
*.a
# NOT /dist/: the launchd plist template lives there
# (dist/com.agbridge.plist). It is source, rendered by install.sh, not output.

# python
__pycache__/
*.py[cod]
.venv/

# editor / os
*.swp
*.swo
*~
.DS_Store
.nfs*

# patches carried in from another machine (git am, then delete). At the repo
# ROOT only: a patch here is a transfer artifact, and `git add -A` swept one
# into a commit that was pushed before anyone looked at the diffstat.
/*.patch

# local runtime state (never commit live bridge state)
/state/
*.local
