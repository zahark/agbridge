#!/bin/sh
# agb-codex -- start Codex inside a named tmux session, so agbridge can
# give it an attachable row.
#
# Why this exists: agbridge resolves the tmux session name ONCE, when an agent
# first fires a hook. An agent started outside tmux gets a status-only row for
# its whole life -- visible, but nothing to click through to. Naming the session
# *before* starting the agent is the whole trick, and forgetting is easy, so
# this wraps it.
#
# It also mints the row itself, before Codex starts -- see PREMINT below.
#
# ⚠️ **CODEX FIRES NO agbridge HOOKS, so this row's status never changes.**
# agbridge's state machine is driven by Claude Code's four hooks
# (UserPromptSubmit/PostToolUse -> active, Notification -> blocked, Stop ->
# completed). Codex has its own hook system but nothing wires it to `agb hook`,
# so the row this mints stays `completed` for its whole life. That is honest --
# the session IS sitting there, and `completed` is what a waiting session
# means -- but it has two consequences worth knowing before relying on it:
#
#   * the sidebar glyph never moves, so you cannot see at a glance whether a
#     Codex agent is working or blocked;
#   * `agb-peer`'s status gate reads `completed` for it always, so that gate
#     protects a Codex peer not at all. Its mode and caret checks still apply,
#     and Codex is the safer peer anyway: MEASURED, it does not paste-collapse
#     a long injection, so delivery verification is more reliable than for
#     Claude.
#
# Wiring Codex's own hooks to `agb hook` would fix the first, and is
# unexplored. `docs/agtermctl.md` records what was measured about Codex.
#
# ⚠️ **A SANDBOXED CODEX IS RECEIVE-ONLY.** MEASURED 2026-08-24: Codex runs
# model-generated shell commands in a sandbox, and that sandbox refuses the
# tmux socket --
#
#     agb-peer: cannot read tmux options for %90:
#     error connecting to /tmp/tmux-100000/default (Operation not permitted)
#
# It is not a file-permission problem: under `workspace-write` the sandbox can
# write to /tmp and `ls` sees the socket, and connecting still fails, which
# points at unix-socket connects being blocked outright. Since `agb-peer`'s
# doorbell IS a tmux window name and its message store IS a tmux option, a
# sandboxed Codex can be SENT to and can never SEND.
#
# The escape hatch is running Codex with the sandbox bypassed, e.g.
#
#     agb-codex -d peer -- --dangerously-bypass-approvals-and-sandbox
#
# ⚠️ **And that hatch may not be available at all.** MEASURED on this host,
# Codex refuses to start with it:
#
#     Error loading configuration: `approval_policy = "never"` cannot be used
#     because requirements do not allow `sandbox_mode = "danger-full-access"`
#
# That is an ORG POLICY refusing the mode, not a bad flag -- so where such a
# requirement is in force, a Codex peer is receive-only and there is no local
# workaround. Send to it; do not expect it to answer.
#
# ⚠️ **This wrapper deliberately does NOT do that for you.** It removes the
# sandbox for every command that agent runs, not just ours, and that is a
# security decision belonging to the human -- the same reasoning that stops
# `agb-claude` answering Claude's "is this a project you trust?" prompt.
#
# ⚠️ **`AGB_CODEX_CUSTOM` REPLACES THE WHOLE CODEX COMMAND LINE.** Set it
# and the session runs that instead of `codex`; leave it unset and nothing here
# changes. It exists because the interesting Codex is often not the one on this
# host -- it may live behind a batch scheduler, a container, or a pool machine
# picked at submit time -- and the launcher for that is site-specific, so it
# does not belong in a file that ships publicly. The variable is the seam:
#
#     export AGB_CODEX_CUSTOM='submit -q big -I "codex --yolo"'
#     agb-codex -d pool
#
# The value is a SHELL COMMAND LINE, `eval`ed inside the session, so its own
# quoting is honoured -- which is what lets the agent be an *argument* to the
# launcher rather than the program being run.
#
# Three consequences, each with a refusal or a comment behind it:
#
#   * `--` passthrough args and `--greet` are REFUSED while it is set. This
#     wrapper cannot know which word of an opaque command line is the agent, so
#     it has nowhere honest to append. Put them inside the variable.
#   * it is EMBEDDED in the command tmux is given, never inherited. A session
#     created against an already-running tmux server takes its environment from
#     the SERVER's, plus `update-environment` -- so a variable exported in your
#     shell a moment ago is simply not there.
#   * the pre-mint is unchanged, and still correct: `exec` keeps the pid and
#     starttime of the pane's own process, which is now the launcher. That is
#     the process whose death should reap the row, even when the agent itself
#     ends up running on another machine.
#
#   agb-codex                  # session named after the current directory
#   agb-codex api-refactor     # session named explicitly
#   agb-codex -d api-refactor  # start it detached, with a row already showing
#   agb-codex api-refactor -- --model gpt-5.6-terra
#
# Everything after `--` is passed through to `codex` untouched.

set -e

say()  { printf '%s\n' "$*"; }
die()  { printf 'agb-codex: %s\n' "$*" >&2; exit 1; }

usage() {
    cat >&2 <<'EOF'
usage: agb-codex [-d] [name] [-- <codex args>...]

  name           tmux session name (default: the current directory's name)
  --             everything after this is passed to `codex`

  -d, --detach   start it in the background and return immediately. The row
                 appears either way -- it is minted before Codex starts.
  --greet <text> send an opening prompt. Only with -d, and NOT sent by
                 default: the row no longer needs one to exist.

  -h, --help     this message

Environment:
  AGB_CODEX_CUSTOM  a shell command line run INSTEAD of `codex`, eval'ed inside
                    the session -- for starting the agent through a scheduler,
                    a container or a pool launcher. While it is set, `--` args
                    and --greet are refused: put them inside the variable.

Re-running with the same name ATTACHES to the existing session rather than
starting a second agent in it.
EOF
}

# tmux session names may not contain "." or ":" -- both are target delimiters,
# so a name carrying one cannot be addressed by `attach-session -t`. Spaces work
# but make every command that names the session need quoting, so they go too.
sanitize() {
    printf '%s' "$1" | tr ' .:' '---' | tr -cd 'A-Za-z0-9_-' | cut -c1-60
}

# Replace every literal occurrence of $2 in $1 with $3, on stdout.
#
# POSIX sh has no ${var//a/b}, and `sed` is the wrong tool: the needle and the
# replacement are both user text, so every metacharacter would need escaping in
# two different contexts to substitute a fixed string.
subst() {
    _s=$1; _n=$2; _r=$3; _out=""
    while :; do
        case $_s in
            *"$_n"*)
                _pre=${_s%%"$_n"*}
                _out=$_out$_pre$_r
                _s=${_s#*"$_n"}
                ;;
            *) break ;;
        esac
    done
    printf '%s' "$_out$_s"
}

# ⚠️ PREMINT -- the row is minted BEFORE Codex, by the session's own shell.
#
# For Claude, a row appeared only when it first fired a hook, which meant it did
# not appear at all until somebody typed. Codex is worse still: it fires no
# agbridge hooks at any point, so without this the row would never exist at
# all -- not on the first prompt, not ever.
#
# So the session's shell hooks first, then `exec`s Codex. Three things make
# that produce ONE row rather than two, and all three were measured:
#
#   * it runs INSIDE the new session, because the anchor is (host, tmux server
#     pid, %PANE) -- hooking from the caller's pane would mint a row for the
#     caller's pane;
#   * `exec` preserves BOTH pid and starttime, so the identity the shell
#     records IS Codex's identity a moment later. `bind_key` finds a matching
#     record and adopts the key instead of minting a second one;
#   * recording a real pid (rather than none) keeps the entry reapable by proof
#     of death. A pid-less entry also adopts -- "absence of evidence must never
#     re-mint" -- but nothing except `agb prune` could ever remove it if Codex
#     failed to start at all.
#
# `completed` rather than `active`: the session exists and is waiting for you,
# which is what that glyph means. `active` would claim it is working and blink
# a transition that did not happen. It raises no banner -- the finished-turn
# banner needs a preceding `active` to measure from, and a fresh key has none.
#
# Best-effort by construction: `;` not `&&`, and stderr discarded, so a missing
# or broken `agb` costs a row and never a Codex.
PREMINT='AGB_AGENT_PID=$$ agb hook completed 2>/dev/null; exec codex "$@"'

name=""; detach=no; greet=""
while [ $# -gt 0 ]; do
    case $1 in
        -h|--help) usage; exit 0 ;;
        -d|--detach) detach=yes; shift ;;
        --greet)   [ $# -gt 1 ] || die "--greet needs a value"
                   greet=$2; shift 2 ;;
        --)        shift; break ;;
        -*)        die "unknown option: $1 (use -- to pass options to codex)" ;;
        *)         [ -n "$name" ] && die "only one name, got '$name' and '$1'"
                   name=$1; shift ;;
    esac
done

[ "$detach" = yes ] || [ -z "$greet" ] \
    || die "--greet only means something with -d: without it you are about to type in the session anyway"

# ⚠️ AGB_CODEX_CUSTOM -- see the note at the top of this file. Two
# placeholders, because the two things a caller wants to add belong in
# different places and only the caller knows where:
#
#   {}     this invocation's codex arguments, spliced verbatim
#   {env}  the identity a remotely-launched agent must report, so that its
#          hooks land on the row this wrapper already minted
#
custom=${AGB_CODEX_CUSTOM:-}
if [ -n "$custom" ]; then
    [ -z "$greet" ] \
        || die "AGB_CODEX_CUSTOM is set, so --greet has nowhere to go: it is prose, so it always needs quoting, and {} splices verbatim. Put the opening prompt inside the variable."
    # No placeholder and no arguments is the ordinary case. No placeholder WITH
    # arguments is refused rather than appended: the agent is inside somebody
    # else's argument, so a trailing word lands on the launcher instead.
    case $custom in
        *'{}'*) ;;
        *) [ $# -eq 0 ] || die "AGB_CODEX_CUSTOM has no {} placeholder, so these arguments have nowhere to go: $*. Put {} where codex's own arguments belong, e.g. -I \"codex {}\"." ;;
    esac
    # ⚠️ VERBATIM, which is why the allowed set is a positive list rather than
    # a list of characters to escape. This wrapper cannot know whether {} sits
    # inside quotes -- `-I "codex {}"` says it does, `docker run img codex {}`
    # says it does not -- so it cannot quote for you, and an argument that would
    # change how the line parses is refused instead of silently mangled.
    spliced=""
    for a in "$@"; do
        case $a in
            ""|*[!A-Za-z0-9._:/=+@,-]*)
                die "AGB_CODEX_CUSTOM splices arguments verbatim, and '$a' would change how the command line parses. Only [A-Za-z0-9._:/=+@,-] can be spliced; put anything else inside the variable, where you choose the quoting." ;;
        esac
        spliced="${spliced:+$spliced }$a"
    done
    # ⚠️ `own_host()`'s resolution, spelled again -- a cross-file agreement
    # with `agb` (CLAUDE.md invariant 14). Disagreeing with it does not raise an
    # error: the remote agent reports a host nothing has a mapping for, and you
    # get a SECOND row instead of the one this wrapper minted.
    agbhost=${AGB_HOST:-$(uname -n)}
    custom=$(subst "$custom" '{env}' "AGB_HOST=${agbhost%%.*} AGB_AGENT_PID=none")
    custom=$(subst "$custom" '{}' "$spliced")
    # Embedded as a single-quoted literal rather than passed as a positional or
    # left in the environment. Positionals would collide with the passthrough
    # args every launch site below still forwards, and the environment does not
    # survive the trip into a session on an already-running tmux server.
    esc=$(printf '%s' "$custom" | sed "s/'/'\\\\''/g")
    PREMINT="AGB_AGENT_PID=\$\$ agb hook completed 2>/dev/null; eval exec '$esc'"
fi

command -v tmux >/dev/null 2>&1 || die "tmux is not installed or not on \$PATH"
if [ -n "$custom" ]; then
    # Only the program can be checked; the rest is the launcher's business.
    # Leading `VAR=value` words are stepped over, because {env} puts two of them
    # in front of the agent and no shell would call those the command.
    head=$(printf '%s\n' "$custom" | awk '{for (i = 1; i <= NF; i++) { if ($i ~ /^[A-Za-z_][A-Za-z0-9_]*=/) continue; print $i; exit } }')
    [ -n "$head" ] || die "AGB_CODEX_CUSTOM is set but names no command"
    command -v "$head" >/dev/null 2>&1 \
        || die "AGB_CODEX_CUSTOM starts with '$head', which is not on \$PATH"
    say "agb-codex: AGB_CODEX_CUSTOM is set; a new session runs: $custom"
else
    command -v codex >/dev/null 2>&1 \
        || die "codex is not installed or not on \$PATH"
fi

[ -n "$name" ] || name=$(basename "$(pwd)")
name=$(sanitize "$name")
[ -n "$name" ] || die "the name is empty after removing characters tmux cannot address"

# Detached: the point is that the row exists without anyone attaching. A hook
# fires on UserPromptSubmit, not at launch, so a session started and left alone
# writes nothing and stays invisible -- which is why codex is handed an opening
# prompt rather than just being started.
if [ "$detach" = yes ]; then
    if tmux has-session -t "=$name" 2>/dev/null; then
        say "agb-codex: '$name' already exists; not starting a second agent in it"
        say "agb-codex: attach with  tmux attach -t $name"
        exit 0
    fi
    # The prompt goes LAST: `codex [options] [prompt]`. It is only passed when
    # asked for now -- the row no longer depends on it, so a detached start
    # costs no turn and no API call unless you actually wanted to say something.
    if [ -n "$greet" ]; then
        tmux new-session -d -s "$name" -c "$(pwd)" \
            sh -c "$PREMINT" agb-codex "$@" "$greet"
        say "agb-codex: started '$name' detached, greeting: $greet"
    else
        tmux new-session -d -s "$name" -c "$(pwd)" \
            sh -c "$PREMINT" agb-codex "$@"
        say "agb-codex: started '$name' detached"
    fi
    say "agb-codex: the row is there now; attach from agterm, or with"
    say "            tmux attach -t $name"
    # ⚠️ Codex has no "is this a project you trust?" prompt to get stuck on,
    # which is the one thing that makes -d fragile for Claude. What it has
    # instead is the caveat at the top of this file: no agbridge hooks, so the
    # row never moves off `completed`.
    exit 0
fi

# Already inside tmux: a nested session cannot be attached to from the outside,
# and agbridge would record the OUTER session's name for the inner agent. Making
# a sibling session and switching to it keeps one agent to one addressable pane.
if [ -n "${TMUX:-}" ]; then
    if tmux has-session -t "=$name" 2>/dev/null; then
        [ $# -gt 0 ] && say "agb-codex: NOTE '$name' already exists, so it is not being restarted -- these arguments are ignored: $*"
        say "agb-codex: switching to existing session '$name'"
        exec tmux switch-client -t "=$name"
    fi
    say "agb-codex: creating '$name' as a sibling session (you are inside tmux)"
    tmux new-session -d -s "$name" -c "$(pwd)" sh -c "$PREMINT" agb-codex "$@"
    exec tmux switch-client -t "=$name"
fi

if tmux has-session -t "=$name" 2>/dev/null; then
    [ $# -gt 0 ] && say "agb-codex: NOTE '$name' already exists, so it is not being restarted -- these arguments are ignored: $*"
    say "agb-codex: attaching to existing session '$name'"
    exec tmux attach-session -t "=$name"
fi

say "agb-codex: starting codex in tmux session '$name'"
exec tmux new-session -s "$name" -c "$(pwd)" sh -c "$PREMINT" agb-codex "$@"
