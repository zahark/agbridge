MENU_MARKER = "[enter] attach"

# ---------------------------------------------------------------------------
# HOW MUCH OF THIS IS AGENT-SPECIFIC -- measured, not assumed
#
# The agent-facing half is agent-agnostic by construction: `send` writes a tmux
# option and renames a window, which any agent that can run a shell command can
# do, and `skills/agb-peer/SKILL.md` names no model. What could have been
# agent-specific is the relay's reading of a pane, and the answer turned out to
# be much smaller than expected.
#
# MEASURED 2026-08-24, Claude Code vs codex-cli 0.149.1, on a live pane each:
#
#   composer glyph        `❯` vs `›`      <- the ONLY difference
#   EMPTY_COLUMN          2 vs 2          same
#   submit key            Enter vs Enter  same
#   ~900-char injection   Claude collapses to `[Pasted text #1]`;
#                         Codex renders it in full
#
# So `COMPOSER_GLYPHS` is a list and everything else is shared. `PASTE_MARK`
# stays Claude-shaped and simply never fires for Codex, which makes Codex the
# EASIER case for the delivery verification rather than the harder one.
#
# ⚠️ **Do not add a third entry from documentation.** Both of these were read
# off a running agent; this project has twice been wrong about agterm by
# reading rather than running, and once today about Codex -- agterm's cookbook
# says "Tab for Codex", which is about queueing while busy and not about
# submitting.
# ---------------------------------------------------------------------------

# The glyphs an agent draws its composer with. Used only to tell a pane holding
# an AGENT from `agb pane`'s menu or a plain shell -- never to decide the
# composer is empty, because an empty composer's rendering has not been
# recorded and guessing at it is how a delivery check passes vacuously.
#
# ⚠️ **A LIST, not a constant, and that is the whole of Codex support.**
# MEASURED 2026-08-24 against codex-cli 0.149.1: its composer glyph is `›`,
# and it is the ONLY thing that differs. The empty-composer caret is column 2
# for both, Enter submits for both, and a ~900-character fast injection is
# rendered in full by Codex rather than collapsed to a paste placeholder -- so
# Codex is the *easier* case for the delivery verification, not the harder one.
#
# ⚠️ agterm's own cookbook says "Tab for Codex". That is about queueing while
# BUSY, not submitting; Enter submits an idle composer. The difference is real
# but it is a property of the peer, not of this list: Enter into a working
# Codex interrupts it, exactly as with Claude.
#
# ⚠️ `codex queue --thread <uuid> --message …` is a first-party delivery
# channel that avoids the composer entirely and QUEUES rather than interrupts.
# It was measured working and deliberately NOT used: delivery already rides
# agterm's own ssh, so this route adds an ssh we otherwise do not need, plus a
# uuid-discovery problem and a second code path. `docs/agtermctl.md` records it
# for the day the interrupt-vs-queue difference actually bites.
COMPOSER_GLYPHS = ("❯", "›")

# ⚠️ Claude Code COLLAPSES a long, fast injection into a placeholder --
# `❯ [Pasted text #1]` / `paste again to expand` -- so the body is simply not
# on the screen to verify against. MEASURED: 843 characters pasted, and Return
# submitted it fine. The Return was never the problem; the verification was,
# and it refused to press it. agterm's own cookbook checks for "a
# pasted-content indicator" for exactly this reason, and this file had read
# that sentence and not carried it over.
PASTE_MARK = "[Pasted text"

# MEASURED: an empty Claude composer reports zero-based cursor column 2, the
# same value agterm's own cookbook checks for a local agent. ⚠️ It is a SIGNAL,
# not proof -- `surface cursor --help` says so itself: "AT the prompt it
# establishes nothing, since the caret may have been moved back over text that
# is still there." We take it because it is the cheapest gate that catches the
# case that actually happens (a human left a draft), not because it is sound.
EMPTY_COLUMN = 2

# Anything `agb pane` acts on rather than passing through. A message that strips
# to one of these must never be sent, in EITHER mode: mode detection is a
# screen read and a screen read can be wrong, and the cost of being wrong here
# is a destroyed row rather than a lost message.
# Mirrors agb_ops.PANE_QUIT_WORDS + PANE_SPLIT_WORDS + PANE_DRAWER_WORDS.
PANE_WORDS = ("q", "quit", "exit", "s", "shell", "split", "d", "drawer",
              "scratch")

# ⚠️ agterm spawns its shell with `bash --noprofile --norc`, so a pane inherits
# only what `login` provides -- NOT the user's PATH. Measured on macOS: an
# agent running inside tmux inside agterm has `$TMUX_PANE` set and cannot exec
# `tmux`, because `/opt/homebrew/bin` is not on that PATH. The same trap ate
# `tmux new` and `claude` in the row's own `--command` before it ate this.
# `$AGB_TMUX` overrides; otherwise the usual homes are tried before the bare
# name, which is the same shape as agbridge's `/proc/<pid>/exe` fallback.
TMUX_CANDIDATES = ("/opt/homebrew/bin/tmux", "/usr/local/bin/tmux",
                   "/usr/bin/tmux", "/bin/tmux")


def tmux_binary(env=None):
    """$AGB_TMUX, then **$PATH**, then the usual homes, then the bare name.

    ⚠️ **$PATH comes before the candidates, and getting that order wrong broke
    the farm side while fixing the Mac side.** On a cluster host `/usr/bin/tmux`
    is a decoy: measured, tmux **2.7**, while the running server is **3.5a**
    from `/shared/tools/tmux-3.5a/bin` on PATH. The old binary has no
    `show-options -p`, cannot speak to a 3.5a server, and answers
    `unknown option -- p` and then BLOCKS trying to start a server of its own --
    which read as "tmux is wedged" for three rounds of diagnosis.

    So: a populated PATH is the best evidence available, because the tmux that
    started the session we are inside is almost always the one on it. The
    hardcoded homes exist only for the case where PATH has been stripped, which
    is agterm's `bash --noprofile --norc`.
    """
    env = os.environ if env is None else env
    explicit = env.get("AGB_TMUX")
    if explicit:
        return explicit
    for directory in (env.get("PATH") or "").split(os.pathsep):
        if not directory:
            continue
        candidate = os.path.join(directory, "tmux")
        if os.access(candidate, os.X_OK):
            return candidate
    for path in TMUX_CANDIDATES:
        if os.access(path, os.X_OK):
            return path
    return "tmux"


MODE_MENU = "menu"
MODE_COMPOSER = "composer"
MODE_UNKNOWN = "unknown"

# Statuses agbridge can put on a row. `active` is mid-turn, `blocked` is sitting
# on a permission dialog -- typing into either is what the cookbook's README
