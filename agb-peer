def resolve(ctl, want):
    """The peer session, or a PeerError naming what to do about it."""
    sessions = sessions_of(ctl.tree())
    if not sessions:
        raise PeerError("agterm reports no sessions at all", 2)
    matches = match_sessions(sessions, want)
    if not matches:
        raise PeerError("no row matches %r -- `agb-peer --list` shows them"
                        % (want,), 2)
    if len(matches) > 1:
        names = ", ".join(str(s.get("name") or s.get("id")) for s in matches[:5])
        raise PeerError("%r matches %d rows (%s) -- use a longer prefix or the "
                        "row id" % (want, len(matches), names), 2)
    return matches[0]


def ensure_composer(ctl, session, pane, arm, lines, say):
    """Get the pane into composer mode, arming it if that is allowed.

    Arming is a real side effect on somebody's row -- it attaches it -- so it
    is reported rather than done quietly, and `--no-arm` refuses instead. The
    poll after it exists because the attach is an `ssh` and a `tmux attach`, so
    the composer is not there on the next syscall.
    """
    target = session["id"]
    text, err = ctl.text(target, pane, lines)
    if err:
        raise PeerError("cannot read the peer's pane: %s" % (err,))
    mode = classify(text)
    if mode == MODE_COMPOSER:
        return text
    if mode == MODE_UNKNOWN:
        raise PeerError(
            "the peer's pane shows neither `agb pane`'s menu nor a composer, "
            "so there is no safe place to type. Look at it first.", 3)
    # menu mode
    if not arm:
        raise PeerError("the peer's row is not attached, and --no-arm was "
                        "given. Press [enter] on it, or drop --no-arm.", 3)
    say("peer is at the `agb pane` menu -- attaching it with a bare newline")
    ctl.type(target, pane, "\n")
    for _ in range(10):
        ctl.sleep(1)
        text, err = ctl.text(target, pane, lines)
        if err:
            continue
        if classify(text) == MODE_COMPOSER:
            return text
    raise PeerError("the row did not reach a composer after attaching -- it may "
                    "be a shell, or the ssh may be slow or failing", 3)


def caret_reason(column, again=None):
    """Why a caret that is not `EMPTY_COLUMN` means we must not type.

    ⚠️ **`again` is a SECOND reading, and only the below-2 branch needs it.**
    The split below rests on a composer sitting at 2 -- true of a *settled*
    one, and the rendered view is measurably unstable (a 16 KB body read at 6 s
    showed less than the same body at 2 s: longer is not better). A composer
    caught mid-repaint, before its glyph is drawn, could plausibly read 0 or 1
    -- which is the branch that says "not a composer at all, a human is
    needed". That would be a confident, alarming, WRONG diagnosis about a
    perfectly healthy agent, produced by reading at the wrong moment.

    🔴 **MEASURED, TWICE, ON A HEALTHY LIVE ROW** -- this was filed as a
    hypothesis and is not one. A relay log caught its own peer's composer
    reading `column 0` and then `column 1`, minutes apart, on an agent that was
    working perfectly throughout. **So without the second read this branch
    would have announced "not a composer at all -- it needs a HUMAN" about a
    healthy agent**, which is the one case the wording exists for.

    ⚠️ **That makes the two-agreeing-reads guard the load-bearing half, not the
    caution.** The wording change alone would have been actively wrong more
    often than it was right.

    ⚠️ **Above 2 needs no such care** -- a draft that appears is a draft -- so
    the cost falls only on the branch making the scary claim.

    ⚠️ **And the DECISION is deliberately unchanged in every case: we refuse.**
    Only the sentence differs. That is what makes this safe to land without a
    live run -- a wrong reading can now only mis-word a refusal, never permit a
    delivery. If the two reads disagree, the honest answer is that the pane was
    repainting, and the next tick will settle it.

    ⚠️ **Two different situations, and this used to report both as the first.**
    MEASURED 2026-08-28, all three:

      trust prompt              column 1     <- BELOW empty
      empty composer            column 2     <- EMPTY_COLUMN
      composer, 9-char draft    column 11    <- 2 + 9, so it tracks content

    So *above* is a draft, and *below* is **not a composer at all** -- the
    caret is somewhere with no text field, which is what a startup prompt
    looks like. Saying "somebody has a draft in it" about an agent sitting on
    Claude Code's trust question sends an operator to clear a composer that
    does not exist, and this line is the ONLY thing they ever see: the message
    is held every tick, for ever, until a human answers that prompt.

    ⚠️ Column 1 is measured for the trust prompt specifically; it is not proof
    that a 1 IS the trust prompt. The wording says what is known -- the caret
    is not in a composer -- and names the trust prompt as the case that was
    measured, rather than asserting an identification.
    """
    if column < EMPTY_COLUMN:
        if again is not None and again != column:
            return ("the caret read %s then %s -- the pane is repainting, so "
                    "this is not a stable answer about anything. Refusing this "
                    "tick; the next one will settle it"
                    % (column, again))
        return ("the caret is at column %s, below an empty composer's %s -- so "
                "it is not in a composer at all. Claude Code's startup trust "
                "prompt reads 1 (measured); it needs a HUMAN, and until one "
                "answers it every message to this peer is held"
                % (column, EMPTY_COLUMN))
    return ("the composer is not empty (cursor at column %s, empty is %s) -- "
            "somebody has a draft in it" % (column, EMPTY_COLUMN))


def wait_ready(ctl, session, pane, retries, interval, force, lines, say):
    """Block until the peer's status and composer both say it is safe to type.

    Two gates, and they answer different questions. `status` is about the
    AGENT (is it mid-turn, is it on a permission prompt) and comes from its own
    hooks. The cursor column is about the COMPOSER (has a human left a draft),
    and is the one that fired on the first row this was ever pointed at.
    """
    target = session["id"]
    surface = surface_of(session, pane)
    if not surface:
        raise PeerError("that row has no %r pane" % (pane,), 2)
    attempt = 0
    while True:
        reason = None if force else peer_busy(session.get("status"))
        if reason is None and not force:
            # ⚠️ Second, and before the cursor: a working agent has an EMPTY
            # composer, so the caret gate reads it as ready. An unreadable pane
            # HOLDS rather than passing -- `ensure_composer` read it a moment
            # ago, so a failure here is transient and the next tick is free.
            text, err = ctl.text(target, pane, lines)
            reason = ("the peer's pane could not be read: %s" % (err,)
                      if err else pane_busy(text))
        if reason is None:
            column, err = ctl.cursor(surface)
            if err:
                raise PeerError("cannot read the composer's cursor: %s" % (err,))
            if column == EMPTY_COLUMN:
                return
            # ⚠️ A second reading ONLY for the alarming branch. `caret_reason`
            # explains why: below-2 is the answer a repaint could manufacture,
            # and it is the one that sends an operator looking for a human.
            again = None
            if column < EMPTY_COLUMN:
                ctl.sleep(1)
                again, second_err = ctl.cursor(surface)
                if second_err:
                    again = None
            reason = caret_reason(column, again)
        attempt += 1
        if attempt > retries:
            # ⚠️ `retries=0` is the RELAY's setting -- it must not block, so it
            # gives up immediately and tries again next tick. "after 0 checks"
            # was the direct command's phrasing leaking into that path and
            # reading as nonsense.
            waited = (", still, after %d checks" % (retries,)) if retries else ""
            raise PeerError("%s%s. Nothing was typed." % (reason, waited), 3)
        say("waiting: %s (%d/%d)" % (reason, attempt, retries))
        ctl.sleep(interval)
        # Re-read the session: `status` is a snapshot and this is the only
        # thing that can change our mind about it.
        for fresh in sessions_of(ctl.tree()):
            if fresh.get("id") == target:
                session = fresh
                break


# ⚠️ **How many times the pane is read back, one second apart, before a
# delivery is given up on.** It was ONE read after a one-second sleep, and that
# is not enough for a long body: MEASURED 2026-08-26, a ~2.8 KB message to a
# Codex row was still rendering when the read happened -- the screen held two
# paste placeholders and the tail had not arrived. A read that catches a
# half-rendered pane is indistinguishable from one that catches a swallowed
# message, and the wrong answer here is expensive: the failure is exit 4, which
# `try_deliver` DROPS rather than retries (typing again would leave two copies
# in the composer), so a slow render costs the whole message.
#
# ⚠️ The cost is paid only on the failing path -- the first read succeeds for
# anything that rendered promptly, which is almost everything -- and a relay
# must not block, so it is bounded rather than generous. Four seconds of one
# conversation stalling is worth one message not being thrown away; forty would
# not be.
VERIFY_READS = 4

# ⚠️ **What submits a composer: CR (`\r`), NOT LF (`\n`).** MEASURED 2026-08-26
# on live panes, after a Codex peer spent an evening receiving messages it never
# acted on:
#
#   raw 0x0A into Codex   -> a newline is INSERTED in the composer
#   raw 0x0A into Claude  -> a newline is INSERTED in the composer
#   raw 0x0D into Codex   -> SUBMITTED
#   agterm `type "\n"`    -> Claude submits; Codex INSERTS A NEWLINE
#
# The last row is the one that cost the messages, and it was measured by
# counting blank lines: an empty Codex composer renders ONE blank line above the
# model line and the loaded one rendered TWO. So the Return was going out and
# arriving -- as a newline. Whatever agterm does with `\n` on the way (the byte
# it puts on the wire is not observable from the farm side), the two TUIs
# disagree about the result, and CR is the byte a real Return key sends.
#
# ⚠️ **The `agb pane` MENU still gets a literal `"\n"`, and that is not an
# oversight.** That prompt is a shell `read` on a tty in canonical mode, where
# the line discipline's ICRNL makes CR and LF equivalent -- and that path is
# verified as it stands. A TUI puts the tty in raw mode and decodes keys itself,
# so the equivalence simply does not hold there. Same keystroke, two different
# readers; only the raw-mode one is picky.
SUBMIT_KEY = "\r"

# What empties a composer we typed into and could not verify. MEASURED
# 2026-08-28 on a throwaway agent: `\003` cleared a 3500-character draft to
# zero, both markers gone, agent alive. `\025` and Escape do nothing at all,
# and `\001\013` (Ctrl-A, Ctrl-K) is a TRAP -- on a wrapped body it kills to
# end of LINE, removing the markers while leaving 1527 characters behind, which
# looks exactly like a clear that worked.
#
# 🔴 **NEVER PUT TWO OF THESE IN ONE PAYLOAD.** Two `\003` as adjacent bytes
# kill the agent outright ("Process exited"). Two separated by ONE SECOND are
# safe, and by three seconds are safe -- so the hazard is a sub-second
# double-tap window, not a count, and the rule that is actually checkable is
# about a single `ctl.type` call rather than about history. `docs/agtermctl.md`
# has the measurements.
CLEAR_KEY = "\003"


def probes_for(body):
    """The fragments `rendered` looks for: the body's HEAD and its TAIL.

    ⚠️ **The tail alone was the defect.** `deliver` exists against a dialog
    swallowing keystrokes, which eats the HEAD -- so a tail-only probe passed
    on exactly the damage it was written to catch, and a message arrived in
    somebody's composer starting mid-sentence while both ends read success.

    ✅ **The head is checkable, MEASURED 2026-08-28**: the composer renders the
    two ends and elides the middle, and the head it keeps is a CONSTANT ~104
    characters at 1 K, 4 K, 8 K and 16 K. It does not thin as the body grows.
    The earlier objection -- that a long body's head may have scrolled out of
    the read window -- was wrong; it never scrolls out. 40 fits inside 104 with
    room to spare.

    ⚠️ **Nothing here can ever see the MIDDLE**, which the composer elides.
    That is a structural ceiling on screen-based verification, not a
    shortcoming of this function -- do not add a third probe expecting it to
    help.

    ⚠️ Below 80 characters the two ends OVERLAP, so each would match the whole
    and the pair would prove one thing twice while reading as two.
    """
    if len(body) <= 80:
        return (body,)
    return (body[:40], body[-40:])


def rendered(before, text, probes):
    """Did the body we typed actually reach the pane? Compared on BOTH ENDS,
    with ALL WHITESPACE STRIPPED from both sides.

    ⚠️ Two different things defeat a naive match, and fixing only the first left
    every wrapped message needing a human to press Enter:

      * **pasted** -- both agents collapse a long, fast injection into a
        placeholder (`[Pasted text #1]`, `[Pasted Content 1461 chars]`) and the
        body is not on screen at all;
      * **wrapped** -- the body IS on screen, but agterm has broken it across
        lines, so a 40-character probe straddles the wrap and matches nothing.
        Stripping whitespace makes the comparison wrap-immune, which is the same
        reasoning the old line protocol used and this check did not inherit.

    Stripping can in principle join two unrelated fragments into a false match;
    over a 40-character probe that is not a risk worth a more complicated
    comparison.

    ⚠️ **Requiring BOTH ends makes a false negative MORE likely**, because the
    rendered view is measurably unstable -- a 16 KB body read at 6 s showed
    less than the same body at 2 s. That was only affordable once a failed
    verification stopped stranding the draft: `deliver` clears now and the
    relay retries, so being wrong costs one more tick instead of a peer that
    never receives again. **The order those two landed in was not incidental**
    -- this change on its own would have made things worse.

    ⚠️ **`before` is not decoration.** A paste placeholder is evidence only if
    its count went UP -- one earlier long message left in the composer would
    otherwise make every later failure look like a success.
    """
    flat_text = "".join((text or "").split())
    was, now = (before or "").lower(), (text or "").lower()
    pasted = any(now.count(mark.lower()) > was.count(mark.lower())
                 for mark in PASTE_MARKS)
    if pasted:
        return True
    return all("".join(probe.split()) in flat_text for probe in probes)


def clear_composer(ctl, session, pane):
    """Empty a composer we typed into, and PROVE it is empty. True only then.

    ⚠️ **The proof is the point, not the keystroke.** The caller uses this to
    decide whether a failed delivery may be retried, and retrying into a
    composer that still holds the body is the doubling exit 4 exists to
    prevent. So every uncertain answer -- a send that errored, a cursor that
    could not be read, a column that is not `EMPTY_COLUMN` -- is `False`.

    🔴 **Exactly ONE `CLEAR_KEY` per call, and never two in a payload.**
    Measured: two `\003` as adjacent bytes kill the agent outright, while two
    separated by a second do not. One key in one `ctl.type` is a property of
    this function that a reader can check; "do not send it twice" would be a
    property of history, which nobody can.
    """
    surface = surface_of(session, pane)
    if not surface:
        return False
    try:
        ctl.type(session["id"], pane, CLEAR_KEY)
    except PeerError:
        # Best-effort by contract: this runs on a path that is already
        # reporting a failure, and raising here would replace that report.
        return False
    column, err = ctl.cursor(surface)
    return not err and column == EMPTY_COLUMN


def deliver(ctl, session, pane, body, send, lines, say):
    """Type, verify it rendered, and only then press Return.

    The verification is the cookbook's, and its value is not that typing might
    fail -- it is that a permission dialog can appear between the cursor check
    and the keystrokes, swallowing them. Seeing our own text on the screen is
    what rules that out, and it is why the Return is a SECOND call.

⚠️ **A FAILED VERIFICATION USED TO STRAND THE DRAFT, and that was the
    real cost of exit 4 -- not the lost message.** The body stays in the peer's
    composer, so the NEXT message hits `wait_ready`'s caret gate and is held,
    every tick, for ever: the peer goes deaf and the sender sees `queued` and
    exit 0. `try_deliver`'s "one lost message and a loud line" was costing the
    rest of the conversation.

    ✅ **So it clears, and the clear decides retryable from terminal.** Exit 4
    exists because "typing it again would leave two copies"; a **verified**
    clear removes that reason, so a verified clear raises **3** (held, retried
    next tick) and anything else raises **4** (dropped) exactly as before.

    ⚠️ **Unknown is folded into "not cleared" HERE ON PURPOSE**, which is the
    opposite of this file's usual rule -- because the negative is the status
    quo. Treating "I could not check" as cleared would let it retry into a
    composer that may still hold the body, which is the doubling exit 4 was
    written to prevent. Fail-safe and fail-open point the same way only when
    the safe answer is *do less*, and here it is.
    """
    target = session["id"]
    # Read BEFORE typing, so a paste placeholder left over from an earlier
    # message cannot be mistaken for this one arriving. A count that went up is
    # evidence; a placeholder merely being present is not.
    before, _err = ctl.text(target, pane, lines)
    ctl.type(target, pane, body)
    probe = probes_for(body)
    for _attempt in range(VERIFY_READS):
        ctl.sleep(1)
        text, err = ctl.text(target, pane, lines)
        if err:
            raise PeerError("typed, but the pane could not be read back, so it "
                            "was NOT sent: %s" % (err,), 4)
        if rendered(before, text, probe):
            break
    else:
        if clear_composer(ctl, session, pane):
            raise PeerError(
                "typed, but %s never appeared in the peer's pane within %ds. "
                "The composer was cleared and verified empty, so nothing was "
                "sent and nothing was left behind -- retrying."
                % (" and ".join(repr(p) for p in probe), VERIFY_READS), 3)
        raise PeerError("typed, but %s never appeared in the peer's pane within "
                        "%ds, so it was NOT sent -- AND THE COMPOSER COULD NOT "
                        "BE CLEARED, so a draft may be left in it and this peer "
                        "may stop receiving. Look at that row."
                        % (" and ".join(repr(p) for p in probe), VERIFY_READS),
                        4)
    if not send:
        say("typed, not sent (--no-send). It is sitting in the composer.")
        return
    ctl.type(target, pane, SUBMIT_KEY)
    say("delivered")


def cmd_who(run, out, env=None):
    """Ask the relay who is in this conversation. -> exit status.

    ⚠️ **The answer does not come back here.** It arrives later, as an ordinary
    message typed into this agent's composer, because there is no channel from
    the relay back to a command that has already exited. This prints only that
    the question was asked.

    ⚠️ **`TMUX_PANE` is checked HERE, before delegating.** `cmd_send` raises
    "send must run inside tmux", which reads as nonsense from `who` -- the same
    phrasing leak `wait_ready`'s `retries=0` note records. Resolve the
    environment, refuse in this command's own words, and only then delegate.
    """
    env = os.environ if env is None else env
    if not env.get("TMUX_PANE"):
        raise PeerError("who must run inside tmux: $TMUX_PANE is not set, so "
                        "the relay has no pane to answer into. Start the agent "
                        "with `agb-claude <name>`, or inside "
                        "`tmux new -A -s <name> <the agent>`.")
    status = cmd_send(RELAY_NAME, WHO_REQUEST, run, out, env=env)
    # ⚠️ **ASCII only on stdout.** `sys.stdout` is `strict`, so a non-ASCII
    # character here raises `UnicodeEncodeError` under an ASCII locale -- which
    # a plain login shell has, and `-E` does not touch `LC_ALL`. Measured: a
    # warning glyph in this line crashed `who` in a tcsh session AFTER the
    # request had already been sent, so the message went out and the command
    # reported a traceback. The comments in this file may hold anything; what
    # leaves through `out` may not.
    out.write("agb-peer: asked the relay who is here. NOTE: the answer arrives "
              "as a MESSAGE on a later turn, not here.\n")
    out.write("agb-peer: no answer at all means no relay is running, or this "
              "pane is not one of its participants. Neither is worth "
              "retrying.\n")
    return status


def cmd_list(ctl, pane, lines, out):
    """Candidate rows, with the two things that decide whether one is usable.

    ⚠️ **It must read the same window the flow does**, which is why `lines` is
    threaded here rather than a cheap constant. It was 6, measured live: a
    `blocked` agent's permission dialog pushes the composer glyph off a 6-line
    window, so the listing said `unknown` for a row the flow reads as
    `composer`. A listing that disagrees with the tool it is a listing FOR is
    worse than no listing, and it disagreed in the direction that looks safe.
    """
    sessions = sessions_of(ctl.tree())
    if not sessions:
        out.write("no sessions\n")
        return 0
    out.write("%-38s %-10s %-9s %s\n" % ("ID", "STATUS", "MODE", "NAME"))
    for session in sessions:
        text, err = ctl.text(session["id"], pane, lines)
        mode = "?" if err else classify(text)
        out.write("%-38s %-10s %-9s %s\n"
                  % (session.get("id"), (session.get("status") or "-")[:10],
                     mode, session.get("name") or ""))
    return 0


def cmd_send(recipient, text, run, out, now=None, env=None):
    """Stash the message in a tmux option and ring the doorbell.

    ⚠️ **Nothing is printed to the terminal**, and that is the whole lesson of
    the first design: Claude Code does not render tool output onto the pane, so
    a printed message is invisible to everything. tmux options are not a
    terminal -- nothing wraps, truncates or collapses them.
    """
    env = os.environ if env is None else env
    pane = env.get("TMUX_PANE")
    if not pane:
        raise PeerError("send must run inside tmux: $TMUX_PANE is not set. "
                        "Start the agent with `agb-claude <name>`, or inside "
                        "`tmux new -A -s <name> <the agent>`.")
    flat = " ".join((text or "").split())
    if not flat:
        raise PeerError("refusing to send an empty message")
    if flat.lower() in PANE_WORDS:
        raise PeerError("refusing to send %r: `agb pane` acts on that word, "
                        "and if the mode read were wrong it would close or "
                        "split the row rather than reach the agent" % (flat,))
    ident = message_id(now)
    exe = tmux_binary(env)

    def tmux(args):
        rc, _out, err = run([exe] + args)
        if rc != 0:
            raise PeerError("%s %s failed: %s" % (exe, args[0],
                                                  err.strip() or rc))

    forced = file_transport_forced(env)
    if forced:
        # Do not even reach for a socket the operator has said is unusable.
        rc, base, err = 1, "", "forced by $AGB_PEER_FILE"
    else:
        rc, base, err = run([exe, "show-options", "-pqv", "-t", pane,
                             OPTION_BASE])
    if rc != 0 and not forced and not socket_is_missing(env):
        # ⚠️ **Name the way out.** This used to end at the tmux error, and a
        # sandboxed Codex read `Operation not permitted`, reported it, and
        # stopped -- with a working transport one environment variable away.
        # The same defect as `run_ctl`'s missing-agtermctl message: a true
        # fact that leads somewhere false is worse than a vague one.
        raise PeerError(
            "cannot read tmux options for %s: %s. If this machine's tmux is "
            "genuinely unreachable to you -- a sandbox refusing the socket is "
            "the measured case -- set AGB_PEER_FILE=1 and the message goes by "
            "file instead, which needs no tmux at all."
            % (pane, err.strip() or rc))
    if rc != 0:
        # ⚠️ **The fallback, and it is NOT a silent one.** tmux being
        # unreachable is the normal state for an agent on a compute pool: it
        # inherited `$TMUX_PANE` through the job submission and the socket is
        # on another machine's `/tmp`. The message goes to a file on NFS and
        # the doorbell is echoed to this agent's own screen, which is the other
        # thing that crosses. Both the path and the reason are printed, because
        # a fallback nobody is told about is how a message quietly stops
        # arriving.
        out.write("agb-peer: tmux is unreachable (%s)\n"
                  % (err.strip() or rc,))
        # 🔴 **THE DOORBELL IS PRINTED BEFORE THE FILE IS WRITTEN, and that
        # order is load-bearing.** On this transport the printed marker is not
        # a report about the send, it IS the send: `drain_files` cannot sweep
        # a shared chat directory -- a message carries its recipient but not
        # its sender -- so it fetches BY NAME, and the only names it ever has
        # are the ones on this screen (`read_doorbells`). A file whose
        # doorbell was never printed is therefore unrecoverable, and these are
        # ordinary stdout writes: `agb-peer send … | head` and a full disk
        # both raise. The other way round is harmless and already handled --
        # a doorbell whose file is missing answers `FETCH_GONE`, which is the
        # documented "already collected" path.
        out.write("%s\n" % (DOORBELL % (ident,),))
        # 🔴 **A FAILED WRITE HERE USED TO BE A RAW TRACEBACK.** MEASURED
        # 2026-08-28: a Codex under a sandbox that made the statedir read-only
        # got `OSError: [Errno 30] Read-only file system` straight out of
        # `open()`, with no `agb-peer:` prefix and nothing a caller could
        # classify.
        #
        # ⚠️ It is worth seeing this beside the evening's other reporting
        # faults, because it fails in the OPPOSITE direction. Those were quiet
        # -- exit 0 for a dropped message, `queued` for one destroyed a tick
        # later, a true error that stopped an agent. This one is maximally
        # LOUD and equally useless: **loud-and-unclassifiable and
        # quiet-and-plausible are both failures to say what happened in terms
        # the caller can act on.**
        #
        # ⚠️ And the diagnosis names the SHARED CAUSE, which is the thing that
        # was missing: a sandbox blocks the tmux socket AND the statedir, and
        # reports them as `Operation not permitted` and `Read-only file
        # system` -- two strings from two subsystems, neither naming a sandbox.
        # Reaching the file path at all means the socket already failed, so if
        # this fails too, one cause has closed both doors.
        try:
            path = write_chat_file(chat_path(ident, env=env), recipient, flat)
        except EnvironmentError as exc:
            raise PeerError(
                "tmux was unreachable, so this fell back to the file "
                "transport -- and that failed too: %s. Both doors are shut by "
                "one cause: a sandbox that confines writes (Codex's default "
                "confines them to its workspace) blocks the tmux socket in "
                "/tmp AND the statedir, reporting each differently. Start the "
                "agent with access to both, or point $AGB_STATEDIR somewhere "
                "it may write and give the relay a matching --chat-dir. "
                "⚠️ The doorbell above named a message that was NOT written."
                % (exc,))
        out.write("agb-peer: wrote %s\n" % (path,))
        out.write("agb-peer: queued for %s as #%s (via file)\n"
                  % (recipient, ident))
        return 0
    base = base.strip()
    if not base:
        rc, base, err = run([exe, "display-message", "-p", "-t", pane,
                             "#{window_name}"])
        # ⚠️ **A failed read is not a value.** This used to fall back to a
        # hardcoded name and then STORE it -- so one transient tmux stall
        # (a wedged agterm client will do it) permanently renamed the pane's
        # base to a guess. Converting "could not read" into data is the exact
        # failure this project writes invariants against; a send that cannot
        # read tmux has no business writing to it either.
        if rc != 0:
            raise PeerError("cannot read the window name for %s: %s"
                            % (pane, err.strip() or rc))
        base = base.strip() or "agent"
        # ⚠️ MEASURED: tmux's global default is `automatic-rename on`. The
        # doorbell survives today only because an explicit `rename-window`
        # turns it off as a SIDE EFFECT -- an undocumented dependency, and if
        # anything ever re-enables it tmux wipes the doorbell and the relay
        # goes deaf with no error anywhere. Pinned explicitly instead.
        #
        # ⚠️ **BEFORE the memo below, and the order is the whole point.**
        # `tmux()` raises on any non-zero rc, including the 30 s `_spawn`
        # timeout a wedged agterm client produces -- and storing the base
        # FIRST closes the `if not base:` gate for every later send on that
        # pane, so a pin that failed once would never be attempted again.
        # The consequence is the one the paragraph above describes: tmux
        # renames the window, the doorbell is wiped, and the relay goes deaf
        # with no error anywhere. The memo is the last write here so that it
        # records "all of this was done", not "some of it was tried".
        tmux(["set", "-w", "-t", pane, "automatic-rename", "off"])
        # Remembered so a second send renders `<original> [peer #id]` rather
        # than `<original> [peer #id1] [peer #id2]`, for ever.
        tmux(["set", "-p", "-t", pane, OPTION_BASE, base])
    tmux(["set", "-p", "-t", pane, OPTION_PREFIX + ident,
          option_value(recipient, flat)])
    tmux(["rename-window", "-t", pane, doorbell_name(base, ident)])
    out.write("agb-peer: queued for %s as #%s\n" % (recipient, ident))
    return 0


# The tmux target that means "this participant's messages are files on NFS,
# not tmux options". A word rather than a flag, because it goes exactly where a
# tmux target would and answers the same question: where do I look.
NFS_TARGET = "nfs"

# Where the sender puts them, on the FAR side. An absolute path, because the
# statedir is not under `$HOME` here and `~` would expand to the wrong place:
# measured, the two routinely differ.
DEFAULT_CHAT_DIR = None


def file_argv(chat_dir, ident):
    """`cat <chat dir>/<id>.msg`. Pure argv, no shell.

    ⚠️ Same reason as `list_argv`: `ssh <host> <cmd>` hands the command to the
    remote LOGIN shell, which on a farm host is often tcsh, and a POSIX script
    quoted through it is a losing game. The doorbell carries the id, so exactly
    one file is named and no globbing or listing is needed.
    """
    return ["cat", "%s/%s.msg" % (chat_dir.rstrip("/"), ident)]


def unlink_argv(chat_dir, ident):
    return ["rm", "-f", "%s/%s.msg" % (chat_dir.rstrip("/"), ident)]


# What a drain attempt learned. ⚠️ These are about the FETCH, not about what it
# found: FETCH_OK with no messages means "the pane was read and nothing was
# pending", which is a fact, while FETCH_FAILED means we still know nothing.
# Priming a joiner turns on exactly that distinction.
FETCH_OK = "ok"
FETCH_FAILED = "failed"
# ⚠️ **THE COMMAND RAN AND THERE IS NOTHING TO FETCH -- EVER.** Distinct from
# FETCH_FAILED, which means we could not ask. The file transport names its file
# by the doorbell id, and the relay DELETES that file once it has read it -- but
# it cannot clear the doorbell, because the whole premise of that transport is
# that its tmux is unreachable. So a doorbell outlives its file, and every later
# relay primes on a stale id and fetches something that is rightly gone.
#
# Treated as FETCH_FAILED that was an ssh EVERY TICK, FOR EVER: `seen` never
# advanced, so the retry re-fired at the relay interval and `_throttled` hid it
# after the first line. Measured live at `--interval 2`.
#
# ⚠️ The discriminator is the EXIT STATUS, not the error text. `ssh` reserves
# **255** for its own failures; anything else non-zero means the remote command
# ran and failed. Measured: `cat` on a missing file exits 1, `ssh` to an
# unresolvable host exits 255. Matching "No such file or directory" would be the
# error-string guess this project keeps getting burned by -- see
# `socket_is_missing`, which exists to avoid exactly that.
FETCH_GONE = "gone"

# ssh's own failure code. Anything else non-zero came from the remote command.
SSH_FAILED_RC = 255


def _drained(outcome, result, messages=None):
    """Record the fetch outcome, if the caller asked for it, and return.

    An out-parameter rather than a second return value: seven existing tests
    assert on `drain`'s return, and a tuple would break all of them for a
    signal only the prime path reads.
    """
    if outcome is not None:
        outcome["fetch"] = result
    return [] if messages is None else messages


def drain_files(fetch, name, target, ident, chat_dir, say, outcome=None,
                idents=None, done=None):
    """One message, named by the doorbell, read over ssh to a REACHABLE host.

    Never to the machine the agent is on -- that is the whole point. The file
    is on NFS, so any host mounting it will do, and the container that carries
    the row is one.
    """
    if not chat_dir:
        say("%s: no --chat-dir given, so a file-transport participant cannot "
            "be read" % (name,))
        return _drained(outcome, FETCH_FAILED)
    if not ident:
        say("%s: no message id in the doorbell" % (name,))
        return _drained(outcome, FETCH_FAILED)
    # ⚠️ Every id still on the screen, not just the announced one -- see
    # `read_doorbells`. Ones already delivered are skipped so a long transcript
    # does not cost an ssh per marker per ring; ones already collected answer
    # FETCH_GONE and cost one cheap failed `cat`.
    #
    # ⚠️ **The same id legitimately appears TWICE on one screen**, so the
    # list is deduplicated rather than passed through. `skills/agb-peer/SKILL.md`
    # tells a file-transport sender to repeat the printed doorbell in its own
    # answer -- because an agent UI folds command output behind a `ran N
    # commands` summary -- and the second copy is the one that reaches the
    # screen. Measured on the live capture that found this bug. Undeduplicated
    # it costs a second `cat` that cannot succeed (the first fetch unlinked the
    # file) and logs `nothing to read ... normal after a relay restart`, which
    # is not what happened.
    wanted, already = [], set()
    for one in (idents or [ident]):
        if one in already or (done is not None and (name, one) in done):
            continue
        already.add(one)
        wanted.append(one)
    if not wanted:
        return _drained(outcome, FETCH_OK)
    collected, seen_gone = [], False
    for one in wanted:
        found, gone = _drain_one_file(fetch, name, target, one, chat_dir, say)
        if found is None:
            return _drained(outcome, FETCH_FAILED)
        seen_gone = seen_gone or gone
        collected.extend(found)
    if collected:
        return _drained(outcome, FETCH_OK, collected)
    return _drained(outcome, FETCH_GONE if seen_gone else FETCH_OK)


def _drain_one_file(fetch, name, target, ident, chat_dir, say):
    """([messages], gone) for one id, or (None, _) when the transport failed."""
    rc, out, err = fetch(ssh_argv(target, file_argv(chat_dir, ident)))
    if rc == SSH_FAILED_RC:
        # We could not ask. Retryable, and worth retrying.
        say("%s: cannot reach %s to read %s.msg: %s"
            % (name, target, ident, (err or "").strip() or rc))
        return None, False
    if rc != 0:
        # ⚠️ The command RAN and could not produce the file. Retrying cannot
        # help: the doorbell names one fixed id, and that file will not come
        # back. Almost always this relay's predecessor read it and removed it.
        # ⚠️ The cost, stated rather than hidden: a file that is momentarily
        # unreadable -- a permissions repair, an NFS hiccup -- is given up on
        # rather than waited out, so one message could be lost. The alternative
        # measured worse: an ssh every tick for the life of the relay, silent
        # after the first complaint.
        say("%s: nothing to read at %s/%s.msg (%s) -- treating that doorbell "
            "as already collected. This is normal after a relay restart."
            % (name, chat_dir, ident, (err or "").strip() or rc))
        return [], True
    parsed = parse_option_value(out)
    if not parsed:
        say("%s: %s.msg is not a message" % (name, ident))
        return None, False
    rc, _out, err = fetch(ssh_argv(target, unlink_argv(chat_dir, ident)))
    if rc != 0:
        say("%s: could not remove %s.msg (%s) -- it may be fetched again"
            % (name, ident, (err or "").strip() or rc))
    return [{"id": ident, "key": ident,
             "to": parsed[0], "text": parsed[1]}], False


def drain(fetch, name, target, pane, say, ident=None,
          chat_dir=None, outcome=None, idents=None, done=None):
    """Everything pending in one participant's tmux, or [] and a reason said.

    ⚠️ `fetch` defaults to the real runner when it is None. It did not, and the
    first live relay died with `'NoneType' object is not callable` -- every
    test injected a fake, so the PRODUCTION default was the one path nothing
    exercised. Same shape as `--all`/`--lines`: a seam only the tests filled in.

    ⚠️ **`[]` MEANS TWO DIFFERENT THINGS, AND THE CALLER HAS TO TELL THEM
    APART.** "The fetch failed" and "the fetch worked and nothing was pending"
    are the same return value, and priming a joiner must treat them oppositely:
    a failure means we still do not know what is on that pane, while an empty
    success means there is nothing stale to discard. `outcome` is an
    out-parameter rather than a second return value because seven existing
    tests assert on the return, and widening it would break every one.
    """
    fetch = fetch or run_local
    if not pane:
        say("%s: no tmux pane recorded for that row -- cannot fetch" % (name,))
        return _drained(outcome, FETCH_FAILED)
    if pane == NFS_TARGET:
        return drain_files(fetch, name, target, ident, chat_dir, say, outcome,
                           idents, done)
    rc, out, err = fetch(ssh_argv(target, list_argv(pane)))
    if rc != 0:
        say("%s: fetch failed: %s" % (name, (err or "").strip() or rc))
        return _drained(outcome, FETCH_FAILED)
    messages = parse_show_options(out)
    for message in messages:
        rc, _out, err = fetch(ssh_argv(target, unset_argv(pane, message["key"])))
        if rc != 0:
            # Not fatal, and not silent: the option survives, so the next ring
            # fetches it again. The relay's delivered-set is what stops that
            # becoming a second delivery.
            say("%s: could not clear %s (%s) -- it may be fetched again"
                % (name, message["key"], (err or "").strip() or rc))
    return _drained(outcome, FETCH_OK, messages)


# How many TICKS a message may wait for a roster participant whose row has not
# appeared yet. ⚠️ **A judgement, not a measurement**: at the default 8 s
# interval this is about half an hour, picked to outlast a scheduler queue and a
# container start. Holding for ever is defensible too -- the messages are
# addressed to a real participant and nothing else consumes them -- but a name
# that never resolves would then accumulate mail for the life of the relay with
# only the ladder below to say so.
HOLD_TICKS_MAX = 225


def _hold_unresolved(recipient, notes, say):
    """False (hold) while a roster participant's row has not appeared yet.

    ⚠️ **Counted per TICK, not per message.** `try_deliver` runs once per
    pending message, so three messages for one absent name would otherwise age
    the hold three times as fast and make the bound depend on queue depth.
    `relay_tick` stamps `notes["tick"]`; the count moves only when that does.

    With no `notes` there is nowhere to count, so the hold is unbounded and
    unthrottled -- the same way the `("said", ...)` throttle already degrades.
    Only the relay passes `notes`, and only the relay holds anything.
    """
    if notes is None:
        say("%s has no row yet -- holding the message" % (recipient,))
        return False
    tick = notes.get("tick")
    entry = notes.get(("held", recipient))
    if entry is None:
        count, fresh = 1, True
    else:
        count, seen_at = entry
        fresh = seen_at != tick
        count = count + 1 if fresh else count
    if fresh:
        notes[("held", recipient)] = (count, tick)
    if count > HOLD_TICKS_MAX:
        # ⚠️ The note is NOT popped here. Every other message queued for this
        # name must reach the same verdict on this tick, and a popped note
        # would restart the count at 1 for the second one and hold it.
        if fresh:
            say("giving up on %r after %d ticks with no row -- dropping its "
                "queued messages. It is in the roster, so nothing else will."
                % (recipient, HOLD_TICKS_MAX))
        return True
    if fresh and (count == 1 or count == 3 or count % 30 == 0):
        say("%s is in the roster but has no row yet -- holding (%d/%d)"
            % (recipient, count, HOLD_TICKS_MAX))
    return False


def try_deliver(ctl, sessions, people, sender, message, lines, say,
                notes=None, members=None, undeliverable=None):
    """One delivery attempt. True = done with it, False = try again next tick.

    ⚠️ **A relay must not block.** The direct command waits out a busy peer for
    forty seconds; here that would stall every other conversation, so the gates
    run with no retries and a refusal simply leaves the message pending.

    🔴 **Exit 4 is dropped, not retried -- AND ITS STATED COST IS WRONG.** It
    means the text WAS typed and could not be verified; typing it again would
    leave two copies in the composer, so it is dropped. This said the price was
    "one lost message and a loud line". It is not. The body is left sitting in
    the peer's composer, so the NEXT message hits `wait_ready`'s caret gate,
    raises code 3, and is HELD -- every tick, for ever. That is the same draft
    the throttle comment below describes as staying "until a human looks", and
    nothing connected the two: **exit 4 is a producer of it.** The peer goes
    deaf, and the sender sees `queued` and exit 0.

    ⚠️ **The relay cannot clean up after itself** -- MEASURED: `\025` and Escape
    through `session type` do nothing to a Claude composer. So there is no
    keystroke that undoes the state this branch creates, which is why "drop is
    safer than retry" does not survive contact: it would be, if dropping left a
    clean composer.
    docs/backlog/delivery-is-verified-on-the-one-end-a-lost-head-leaves-intact.md

    ⚠️ **MEMBERSHIP IS A QUESTION ABOUT THE ROSTER, NOT ABOUT WHAT RESOLVED.**
    `people` is the RESOLVED map -- names whose row is in agterm's tree right
    now -- and using it to answer "is this a participant?" silently discarded
    every message addressed to a participant whose agent had not started yet.
    With a fixed participant list that is masked, because you start the relay
    once the agents exist; with a roster you list three agents while two are
    up, and the third one's mail is thrown away with the sender seeing
    `queued for <name>` and exit 0.

    So `members` is the roster, and the two answers are different questions:
    not in the roster is a DROP (a typo, or a name nobody ever added), while
    in the roster but unresolved is a HOLD (a row that has not appeared yet).
    `members=None` means "use `people`", which keeps every existing caller --
    and the direct one-shot path, which has no roster at all -- unchanged.
    """
    recipient = message.get("to")
    members = people if members is None else members
    if recipient not in members:
        say("dropping a message for %r: not a participant" % (recipient,))
        # 🔴 **AND TELL THE SENDER, because nothing else can.** `send` printed
        # `queued for <name> as #<id>` and exited 0 a tick ago: the membership
        # test lives HERE, on the far side of the wire, so the sender is told
        # success for a message destroyed immediately afterwards and the only
        # trace is the line above -- which no agent can read.
        #
        # ⚠️ MEASURED 2026-08-28: this caught an agent that had spent the
        # evening writing up two other faults with the identical signature
        # (a peer goes quiet; visible only in relay output). It reported the
        # send as done, because exit 0 is the only thing there is to read.
        #
        # The relay already types into the sender's pane -- that is how `who`
        # is answered -- so the mechanism existed and only the decision to use
        # it for a failure did not. ⚠️ It cannot loop: this is signed
        # RELAY_NAME, `SKILL.md` says an answer from the relay needs no reply,
        # and the relay drops anything that is not the single word `who`.
        if undeliverable is not None and sender != RELAY_NAME:
            undeliverable.append((RELAY_NAME, {
                "id": message_id(), "to": sender,
                "text": "your message to %r was NOT delivered: no participant "
                        "of that name. Check the spelling with `agb-peer who`, "
                        "or ask your user. Nothing is queued -- it was dropped."
                        % (recipient,)}))
        return True
    if recipient not in people:
        return _hold_unresolved(recipient, notes, say)
    if notes is not None:
        notes.pop(("held", recipient), None)
    if recipient == sender:
        say("dropping a message %r addressed to itself" % (sender,))
        return True
    row, pane, _target, _tmux = people[recipient]
    session = sessions.get(row)
    if session is None:
        # ⚠️ Throttled: this HOLDS, so it is re-reached every tick for as long
        # as the row is missing -- and `resolve_all` deliberately keeps a stale
        # binding across a re-mint, so "missing" can last. It was the one
        # holding path in this file still saying its reason every tick.
        _throttled(say, notes, ("gone-row", recipient))(
            "%s's row is gone from the tree -- holding the message"
            % (recipient,))
        return False
    if notes is not None:
        notes.pop(("said", ("gone-row", recipient)), None)
    # The sender is the pane the marker was FOUND in, never the `from` field.
    # A pane is a place, and an agent cannot print into another agent's pane,
    # so the place is the only part of this that cannot be misstated.
    body = compose(message.get("text"), sender)
    try:
        ensure_composer(ctl, session, pane, True, lines, say)
        wait_ready(ctl, session, pane, 0, 0, False, lines, say)
        deliver(ctl, session, pane, body, True, lines, say)
    except PeerError as error:
        # ⚠️ Said ONCE per unchanged reason. A relay retries a held message
        # every tick, and a peer whose composer has a draft in it stays that
        # way until a human looks -- which produced the same line every eight
        # seconds for as long as nobody did. Repeating it adds no information
        # and buries everything else the relay says.
        line = "%s -> %s: %s" % (sender, recipient, error)
        if notes is None or notes.get(("said", recipient)) != line:
            say(line)
            if notes is not None:
                notes[("said", recipient)] = line
        return error.code == 4
    if notes is not None:
        notes.pop(("said", recipient), None)
    say("%s -> %s: delivered" % (sender, recipient))
    return True


# What one participant's scan learned, and the five ways it can end without
# ever reaching the doorbell. ⚠️ **The distinction that matters is "we did not
# read the pane" versus "we read it and there was nothing announced".** Priming
# a joiner turns on exactly that: the first leaves the pane still suspect, the
# second proves there is nothing stale on it. `SCAN_DETACHED` is the one that
# looks like the second and is the first -- a detached row's doorbell is not
# VISIBLE, which is not the same as ABSENT, and every row `agb-refresh`
# re-mints comes back detached.
SCAN_NO_ROW = "no-row"
SCAN_UNREADABLE = "unreadable"
SCAN_DETACHED = "detached"
SCAN_NO_DOORBELL = "no-doorbell"
SCAN_CAUGHT_UP = "caught-up"
SCAN_FETCHED = "fetched"
SCAN_FETCH_FAILED = "fetch-failed"

# The outcomes that prove the pane WAS READ. ⚠️ That is the question priming
# asks -- not "was anything found". `SCAN_NO_DOORBELL` belongs here because
# reading a pane and seeing nothing announced is a FACT about it, while
# `SCAN_DETACHED` does not, because a menu hides the status bar and the
# doorbell may be sitting there unseen.
SCAN_PANE_IS_CLEAN = (SCAN_FETCHED, SCAN_NO_DOORBELL, SCAN_CAUGHT_UP)


def scan_participant(ctl, sessions, name, binding, seen, lines, say,
                     fetch=None, notes=None, chat_dir=None):
    """Read one participant's pane and drain it. -> (outcome, messages).

    ⚠️ **This owns `seen`.** It reads it for the caught-up guard and writes it
    only on a successful drain, so a caller cannot mark a participant read
    without having read it -- the bug that cost every message a failed fetch
    touched. Priming calls this too, which is why priming leaves a participant
    caught up rather than needing to say so separately.

    The caller decides what the messages MEAN (delivered, or discarded as a
    backlog); this only decides what is there.
    """
    notes = {} if notes is None else notes
    row, pane, target, tmux_target = binding
    session = sessions.get(row)
    if session is None:
        # ⚠️ Not silent. A row is briefly absent while `agb-refresh`
        # re-mints it, which is why this is not reported on the first tick --
        # but if the bridge never comes back, a relay that said nothing would
        # leave "gone" looking exactly like "quiet".
        gone = notes.get(("gone", name), 0) + 1
        notes[("gone", name)] = gone
        if gone == 3 or gone % 30 == 0:
            say("%s: no row matches that label, %d ticks running. If this "
                "is not a refresh in progress, check the bridge."
                % (name, gone))
        return SCAN_NO_ROW, []
    notes.pop(("gone", name), None)
    text, err = ctl.text(row, pane, lines)
    if err:
        # Throttled for the same reason as the fetch below: this fires every
        # tick for as long as the read keeps failing, and it always did --
        # moving the `seen` write merely put a second unthrottled path beside
        # it and made the shape obvious.
        _throttled(say, notes, ("read", name))(
            "cannot read %s: %s" % (name, err))
        return SCAN_UNREADABLE, []
    notes.pop(("said", ("read", name)), None)
    if classify(text) == MODE_MENU:
        # ⚠️ **Armed, not merely reported.** Every row `agb-refresh` re-mints
        # comes back DETACHED, showing `agb pane`'s menu -- and a menu is not a
        # tmux screen, so the status bar is absent and the doorbell cannot be
        # seen. Its tmux is fine and its doorbell is still set; the relay just
        # cannot look. Complaining and waiting would make every refresh a
        # manual re-attach of every participant. The bare newline is the safe
        # arming primitive: `agb pane` strips its input and "" matches none of
        # its three word sets, so it falls through to the attach and cannot hit
        # the branch that closes the row.
        tries = notes.get(("menu", name), 0)
        notes[("menu", name)] = tries + 1
        if tries % 10 == 0:
            say("%s is detached -- attaching it so its doorbell can be seen"
                % (name,))
            ctl.type(row, pane, "\n")
        return SCAN_DETACHED, []
    notes.pop(("menu", name), None)
    idents = read_doorbells(text)
    ident = idents[-1] if idents else None
    if not ident:
        return SCAN_NO_DOORBELL, []
    if seen.get(name) == ident:
        return SCAN_CAUGHT_UP, []
    tmux_pane = tmux_target or pane_argv_field(session.get("foreground"),
                                               "--pane")
    host = target or pane_argv_field(session.get("foreground"), "--host")
    # ⚠️ **`seen` IS WRITTEN AFTER THE DRAIN, NOT BEFORE IT.** It used to be
    # written above the fetch -- so a fetch that FAILED left the participant
    # marked caught-up having read nothing, the guard above short-circuited
    # every later tick, and those messages were lost until the agent happened
    # to send again and moved the doorbell. Recording what we have read only
    # once we have actually read it makes the retry automatic; the cost is that
    # a persistent failure complains every tick, which is `_throttled`'s job.
    outcome = {}
    messages = drain(fetch, name, host, tmux_pane,
                     _throttled(say, notes, ("fetch", name)), ident,
                     chat_dir, outcome, idents, notes.get("delivered"))
    if outcome.get("fetch") == FETCH_FAILED:
        return SCAN_FETCH_FAILED, []
    # ⚠️ FETCH_GONE advances `seen` exactly as FETCH_OK does, and that is the
    # point: the doorbell has been dealt with, so the relay stops re-asking.
    seen[name] = ident
    notes.pop(("said", ("fetch", name)), None)
    return SCAN_FETCHED, messages


def _quiet(say):
    """A `say` that cannot raise, for reports whose failure must not matter.

    ⚠️ `out` is not guaranteed to be open: `agb-peer relay | head` closes it
    the instant `head` exits, and a write to it then raises. That is fine for a
    report about the grid -- which is an adjunct -- and fatal for the relay
    carrying the message. `close_grid` has always wrapped its own `say`; this
    is the same guarantee, in the one other place a grid talks.
    """
    def quiet(message):
        try:
            say(message)
        except Exception:
            pass
    return quiet


def _throttled(say, notes, key):
    """A `say` that repeats itself only when the message changes.

    ⚠️ The same discipline as `try_deliver`'s reason line, and needed here for
    the same reason moving the `seen` write created: a failure that is retried
    every tick would otherwise print the identical line every tick, for as long
    as nobody looks, and bury everything else the relay says. `key` is a tuple
    so these cannot collide with `try_deliver`'s `("said", <recipient>)`, which
    is keyed on a bare participant name.
    """
    def once(message):
        if notes is None:
            say(message)
        elif notes.get(("said", key)) != message:
            notes[("said", key)] = message
            say(message)
    return once


def answer_who(asker, message, pending, members, people, say):
    """Queue the relay's own reply to a `who`, or say why there is none.

    ⚠️ **The asker is the pane the doorbell rang in, never a `from` field.** That
    is `try_deliver`'s rule and it is the whole reason this feature needs no
    identity of its own: an agent cannot print into another agent's pane, so the
    place is the only part of a message that cannot be misstated.

    ⚠️ **Only the exact token is answered, and that is the loop guard.**
    `SKILL.md` tells an agent that anything arriving as `[chat from <name>]` is a
    peer talking to it and to reply -- so an answer signed `[chat from relay]`
    invites a reply, which is another message to `relay`, for ever. A polite
    "thanks" is not the token, so it is dropped here and the loop cannot start.
    The skill also says the answer needs no reply; that is a rule an agent may
    ignore, and this is one it cannot.
    """
    text = (message.get("text") or "").strip()
    if text != WHO_REQUEST:
        # Named, not silent: this is the loop guard's only visible evidence.
        say("%s sent %r to %s, which is not %r -- dropping it. The relay only "
            "answers that one word." % (asker, text, RELAY_NAME, WHO_REQUEST))
        return
    # ⚠️ `members` may be None -- `relay_tick`'s default, and ~40 test call sites
    # omit it -- in which case `people` stands in, exactly as `try_deliver` does.
    # `roster_answer` takes a dict as happily as a set.
    roster = people if members is None else members
    # ⚠️ The SENDER of the reply is RELAY_NAME, not the asker. `try_deliver`
    # drops a message whose recipient equals its sender, so signing it with the
    # asker's own name would lose the answer permanently -- with a line blaming
    # the asker. It is also what `compose` renders as `[chat from relay] `.
    pending.append((RELAY_NAME, {"id": message_id(), "to": asker,
                                 "text": roster_answer(asker, roster)}))
    say("%s asked who is here" % (asker,))


def relay_tick(ctl, people, seen, pending, lines, say, fetch=None,
               deliver_new=True, notes=None, chat_dir=None, members=None,
               deliver_to=None):
    """One pass: watch every doorbell, drain what rang, then drain the queue.

    `deliver_new=False` is the PRIMING pass. It still FETCHES -- and discards.
    Leaving stale options in tmux would mean the first real message's drain
    swept up an hour-old conversation and delivered it as if it were new; the
    honest move is to clear them and say how many.
    """
    notes = {} if notes is None else notes
    # Bounced-back notices for messages the drain destroys. Collected here
    # rather than appended to `pending`, which the drain overwrites.
    undeliverable = []
    # Stamped once per tick so `_hold_unresolved` can age a hold by ticks
    # rather than by messages -- see its docstring.
    notes["tick"] = notes.get("tick", 0) + 1
    sessions = {}
    for session in sessions_of(ctl.tree()):
        sessions[session["id"]] = session
    discarded = []
    for name in sorted(people):
        result, messages = scan_participant(
            ctl, sessions, name, people[name], seen, lines, say, fetch,
            notes, chat_dir)
        if result != SCAN_FETCHED:
            continue
        done = notes.setdefault("delivered", set())
        for message in messages:
            if (name, message["id"]) in done:
                # An option the far side would not let us unset comes back on
                # the next ring. Fetching it twice is harmless; DELIVERING it
                # twice would put the same sentence in a composer again.
                continue
            done.add((name, message["id"]))
            if deliver_new:
                if message.get("to") == RELAY_NAME:
                    # ⚠️ **INSIDE this branch, deliberately.** Above it, a `who`
                    # that predates the relay would be answered AND the answer
                    # delivered on the priming tick -- the delivery loop below
                    # runs unconditionally -- which breaks the contract that a
                    # startup or joiner backlog is discarded. Here, a stale
                    # request falls to the `else` and is named like any other.
                    answer_who(name, message, pending, members, people, say)
                    continue
                pending.append((name, message))
            else:
                # ⚠️ Named, not counted. "discarded 1 message(s)" reads as
                # housekeeping; an operator who queued something a moment
                # earlier needs to see that THIS is what was thrown away.
                discarded.append("#%s (%s -> %s)"
                                 % (message["id"], name, message["to"]))
    if not deliver_new and discarded:
        say("discarded %d message(s) queued before this relay started: %s. "
            "Send AFTER the relay is up, or it primes them away."
            % (len(discarded), ", ".join(discarded)))
    held = []
    # ⚠️ Delivery uses `deliver_to`, which may be WIDER than the set we scanned:
    # a joiner still being primed is skipped as a SENDER, because its pane has
    # not been read, but it must still be reachable as a RECIPIENT. Defaults to
    # the scanned set, so every other caller is unchanged.
    audience = people if deliver_to is None else deliver_to
    for sender, message in pending:
        if not try_deliver(ctl, sessions, audience, sender, message, lines, say,
                           notes, members, undeliverable):
            held.append((sender, message))
    # ⚠️ `held` REPLACES `pending`, so a note appended inside `try_deliver`
    # would be discarded here -- which is why it is collected separately and
    # merged rather than appended to `pending` directly.
    pending[:] = held + undeliverable
    return len(pending)


def resolve_all(ctl, spec, say, previous=None, notes=None):
    """{name: (row id, pane, target)}, re-resolved from LABELS every tick.

    ⚠️ This is the `agb-refresh` defence. A refresh closes and re-mints every
    row, so every id changes -- observed twice in one afternoon. A relay that
    resolved once would go permanently deaf, and its only symptom would be
    silence. Resolving by label costs one `tree` call the tick already makes.
    """
    previous = previous or {}
    resolved = {}
    for name in sorted(spec):
        row, pane, target, tmux_target = spec[name]
        try:
            resolved[name] = (resolve(ctl, row)["id"], pane, target, tmux_target)
            if notes is not None:
                notes.pop(("said", ("stale", name)), None)
        except PeerError as error:
            if name in previous:
                # Keep the old binding rather than dropping a participant on a
                # transient: a row is briefly absent while it is re-minted.
                resolved[name] = previous[name]
                # ⚠️ **But SAY so.** This fallback was silent, and silence is
                # only right for the case it was written for. A re-mint is
                # transient and resolves itself; **ambiguity does not** -- a new
                # row whose cwd basename equals this label collides for ever
                # (`match_sessions`' third tier searches the whole title), and
                # the fallback then masks it until the relay is restarted with
                # no `previous`, at which point it fails loudly, at the worst
                # possible moment, for a cause introduced hours earlier.
                # `resolve` already names the rival rows; nothing printed it.
                # Throttled, so a re-mint costs ONE line and an unresolved
                # collision costs one line rather than one per tick -- and
                # cleared above on success, or a fixed collision would stay
                # "reported" for the life of the relay.
                _throttled(say, notes, ("stale", name))(
                    "%s: %s -- keeping the row resolved earlier" % (name, error))
            else:
                # ⚠️ Throttled, because a roster turns this from a startup typo
                # the operator sees and Ctrl-Cs into a STEADY STATE: a mistyped
                # label would otherwise print every tick for the life of the
                # relay. The ("gone", name) ladder cannot help, because a name
                # that never resolved never reaches `resolved` at all.
                _throttled(say, notes, ("resolve", name))(
                    "%s: %s" % (name, error))
    return _one_name_per_row(resolved, say, notes)


# Where `_one_name_per_row` leaves the names it dropped. A one-element tuple,
# so it cannot collide with `_throttled`'s `("said", key)` or `try_deliver`'s
# `("said", <name>)`, both of which are two-element.
ALIAS_DROPS = ("alias-dropped",)


def _one_name_per_row(resolved, say, notes=None):
    """Refuse to let two participants share a row, keeping the first by name.

    ⚠️ `resolve` refuses an AMBIGUOUS label, but two DIFFERENT labels can each
    unambiguously match the same row -- `bob=alice-box` and `alice=alice` -- and
    nothing cross-checked the map. Two names on one pane both drain it, so a
    message is delivered twice; and `try_deliver`'s self-guard compares NAMES,
    so a message addressed to the alias is typed into the sender's own composer.
    A startup typo could do this before; a roster edit makes it ordinary.
    """
    owner, dropped = {}, set()
    for name in sorted(resolved):
        row = resolved[name][0]
        if row in owner:
            dropped.add(name)
            _throttled(say, notes, ("alias", name))(
                "%s and %s both resolve to row %s -- ignoring %s, because two "
                "names on one pane drain it twice and can type a message into "
                "its own sender" % (owner[row], name, row[:8], name))
            continue
        owner[row] = name
    if notes is not None:
        # ⚠️ **CLEARED when the collision goes away, like every other throttle
        # in this file.** It was the one that shipped without a clear, and the
        # cost is not a missing line: `update_grid` subtracts `ALIAS_DROPS`
        # from `missing` on the argument that an alias "has already been told",
        # which is true only the FIRST time. Measured -- bob aliases alice,
        # the roster is fixed, bob aliases alice again: the second collision is
        # throttled, `missing` skips bob because he is in the drop set, and a
        # participant vanishes from the grid with NOTHING saying so. That is
        # defect 3's exact symptom reached through the new code.
        for name in resolved:
            if name not in dropped:
                notes.pop(("said", ("alias", name)), None)
        # ⚠️ **In `notes`, NOT in the return value.** `resolve_all` ends with
        # `return _one_name_per_row(...)`, so this IS its return value: widening
        # it to a tuple would change `resolve_all`'s shape across eight call
        # sites, four of which index the result as a dict.
        #
        # ⚠️ **ASSIGNED WHOLE every call, never updated into.** A `notes` entry
        # normally persists -- that is what makes `_throttled` work -- and a
        # persisting drop set is a stale one: the alias goes away when the
        # roster is fixed, and a caller reading this as an accumulator would go
        # on calling a live participant somebody else's alias for ever. One
        # call per tick, one whole answer per call. (It is deliberately NOT in
        # `_name_notes`: it is not per-name state a leave has to purge, because
        # the next tick overwrites it regardless.)
        notes[ALIAS_DROPS] = dropped
    return dict((name, resolved[name]) for name in owner.values())


def cmd_relay(ctl, words, lines, interval, once, out, dashboard=False,
              fetch=None, chat_dir=None, roster=None, ticks=None):
    """Watch every participant's doorbell and carry messages between them."""
    if roster and words:
        raise PeerError("give participants OR --roster, not both: with two "
                        "sources of truth there is no answer to 'who is in "
                        "this conversation' that does not depend on which one "
                        "you read")
    # ⚠️ **Startup REFUSES where the running relay would hold.** Every reason a
    # runtime re-read holds -- unreadable, missing, empty, malformed, too few --
    # is a refusal here, because holding means keeping the roster you already
    # had and at startup there is none. It is also the only place the
    # two-participant minimum can be enforced: a relay may DROP to one when
    # somebody leaves, but it cannot begin with nobody to talk to.
    spec = (parse_roster_text(read_roster_file(roster)) if roster
            else parse_participants(words))

    def say(message):
        out.write("agb-peer: %s\n" % (message,))
        out.flush()

    seen, pending, resolved, notes = {}, [], {}, {}
    needs_prime = set()
    reader = RosterReader(roster, minimum=1) if roster else None
    if reader is not None:
        # The startup read above already applied; priming the initial roster is
        # the existing `deliver_new=False` pass, not a join. Seed the gate so
        # tick one does not re-apply the same file as a change.
        reader.raw, reader.spec = read_roster_file(roster), spec
    priming = True
    remaining = ticks
    # ⚠️ **Only a grid THIS RUN opened may be closed.** agterm has exactly one
    # grid and no ownership token, so an unconditional close on the way out
    # would dismiss whatever somebody else had up, and there is nothing to ask:
    # a flag is the only ownership record that exists.
    opened_grid = False
    # The cell set the grid was last opened with -- see `update_grid`. `None`
    # rather than `()` so a first tick with nothing to show is distinguishable
    # from a membership that dropped to nobody.
    grid_shown = None
    try:
        while True:
            # ⚠️ **THE ROSTER IS READ BEFORE `resolve_all`, NOT AFTER IT.** An
            # earlier draft resolved first, on the OLD spec, so a joiner was not
            # in `resolved` on the tick it joined and every later step silently
            # skipped it -- and, since the file did not change again, there was
            # no second attempt. Leaves happen to work under either ordering;
            # joins do not.
            if reader is not None:
                arrived = reader.poll(say, notes)
                if arrived is not None:
                    left = set(spec) - set(arrived)
                    joined = set(arrived) - set(spec)
                    rebound = set(name for name in set(spec) & set(arrived)
                                  if spec[name] != arrived[name])
                    # ⚠️ A binding is (row, pane, target, tmux_target). Only
                    # the first two say WHICH PANE -- the rest is how to reach
                    # it. Priming is about the pane, so it must key off the
                    # pane, not off the tuple.
                    moved = set(name for name in rebound
                                if spec[name][:2] != arrived[name][:2])
                    spec = arrived
                    apply_leaves(left, rebound, seen, pending, resolved,
                                 needs_prime, notes, say, moved)
                    needs_prime.update(joined)
                    if left or joined or rebound:
                        say("roster: %s" % (", ".join(
                            ["+" + n for n in sorted(joined)]
                            + ["-" + n for n in sorted(left)]
                            + ["~" + n for n in sorted(rebound)])
                                   or "unchanged"))
            fresh = resolve_all(ctl, spec, say, resolved, notes)
            if fresh != resolved:
                if resolved:
                    # ⚠️ Names the two causes it now has. It used to blame
                    # `agb-refresh` unconditionally, which became wrong the
                    # moment a roster edit could move this set too.
                    say("participant rows changed -- re-resolved (a roster "
                        "edit, or an `agb-refresh` re-minting every row)")
                resolved = fresh
                for name in sorted(resolved):
                    row, pane, target, tmux_target = resolved[name]
                    say("%-12s %s:%s%s%s"
                        % (name, row[:8], pane,
                           "  via " + target if target else "",
                           "  tmux " + tmux_target if tmux_target else ""))
            if dashboard:
                # ⚠️ **OUTSIDE `if fresh != resolved:`, deliberately.** A roster
                # edit that adds a member no row answers to leaves `resolved`
                # byte-identical, so anything inside that block never runs for
                # it -- and that is precisely the case with something to say.
                # What guards the repeated `agtermctl` call is the cell set;
                # what guards the repeated message is `_throttled`.
                grid_shown, opened_grid = update_grid(
                    ctl, spec, resolved, grid_shown, opened_grid, say, notes)
            if needs_prime:
                # ⚠️ Before the scan, and the scan skips whatever is still
                # pending: a joiner whose pane has not been read must not have
                # its backlog picked up by the ordinary pass and delivered as
                # new.
                sessions = {}
                for session in sessions_of(ctl.tree()):
                    sessions[session["id"]] = session
                prime_joiners(ctl, sessions, needs_prime, resolved, seen, lines,
                              say, fetch, notes, chat_dir)
            # ⚠️ A SECOND LINE OF DEFENCE, not the first, and worth saying so: a
            # prime that succeeds already writes `seen`, so the scan would find
            # the participant caught up anyway. This makes the guarantee
            # structural instead of a consequence of two functions agreeing -- a
            # mutation of it alone changes no observable behaviour, which is the
            # honest reason there is no test that only it can fail.
            scanning = dict((name, resolved[name]) for name in resolved
                            if name not in needs_prime)
            # ⚠️ `spec`, not `resolved`: membership is what the operator asked
            # for, and a participant whose row has not appeared yet must have
            # its mail HELD rather than dropped. See try_deliver. ⚠️ And
            # `pending` is delivered for EVERYONE, including names still being
            # primed: a name skipped as a SENDER must still be reachable as a
            # RECIPIENT, or its incoming mail waits out the whole prime budget
            # for no reason. The property is pinned on `relay_tick` itself
            # rather than here, because at this level the difference is a delay
            # rather than a loss.
            relay_tick(ctl, scanning, seen, pending, lines, say, fetch,
                       deliver_new=not priming, notes=notes, chat_dir=chat_dir,
                       members=set(spec), deliver_to=resolved)
            if priming:
                say("primed on %d doorbell(s); relaying every %ss -- "
                    "Ctrl-C to stop" % (len(seen), interval))
                priming = False
            if once:
                return 0
            if remaining is not None:
                remaining -= 1
                if remaining <= 0:
                    return 0
            ctl.sleep(interval)
    finally:
        # ⚠️ `finally`, because the relay's DOCUMENTED exit is Ctrl-C -- it
        # says so itself, above -- which reaches neither of the `return 0`s
        # this loop also has. One place covers all three.
        if opened_grid:
            close_grid(ctl, say)


# ⚠️ **The back-off after a grid call TIMED OUT, counted in ticks.** A wedged
# agterm answers nothing, so every grid call costs `SUBPROCESS_TIMEOUT` seconds
# of a loop whose real job is carrying messages. Doubling from one tick to this
# many means a wedge that lasts costs the pump a bounded fraction of its time,
# while one that clears is picked up within a few ticks -- neither "give up for
# the run" (a transient wedge would cost the grid for ever) nor "retry every
# tick" (the starvation this exists to stop). Ticks rather than seconds because
# `update_grid` has no clock and `--interval` is not its business.
GRID_STALL_MAX_TICKS = 32

# Its own key in `notes`, which is otherwise `("said", <key>)` and `ALIAS_DROPS`.
GRID_STALL = ("dashboard", "stalled")


def _grid_stall(notes):
    """Arm or lengthen the back-off; returns how many ticks will be skipped.

    ⚠️ **`notes is None` means there is nowhere to remember, so there is no
    back-off** -- the same reading `_throttled` gives it. Every caller that runs
    a loop passes a dict; the ones that pass `None` make a single call and have
    nothing to starve.
    """
    if notes is None:
        return 0
    wait = min((notes.get(GRID_STALL) or (0, 0))[1] * 2 or 1, GRID_STALL_MAX_TICKS)
    notes[GRID_STALL] = (wait, wait)
    return wait


def _grid_stalled(notes):
    """Is this tick inside the back-off? Consumes one tick of it if so.

    ⚠️ The doubling memory is kept at zero-remaining rather than deleted, so a
    wedge that survives the retry lengthens instead of restarting at one tick.
    Only a call that ANSWERED clears it, in `update_grid`.
    """
    remaining, wait = (None if notes is None else notes.get(GRID_STALL)) or (0, 0)
    if remaining <= 0:
        return False
    notes[GRID_STALL] = (remaining - 1, wait)
    return True


def update_grid(ctl, spec, resolved, shown, opened, say, notes):
    """Keep the relay's grid honest about its membership -> (shown, opened).

    ⚠️ **The tracked set is `(name, id, pane)` -- CELLS, not names.** An
    `agb-refresh` re-mints every row, so all the ids move while the names stay
    identical; that is the case `resolve_all` exists for, and a name-keyed
    trigger would call it "unchanged" and leave a grid of dead cells up. It is
    also why the old `len(resolved) > 1` guard was wrong: it skipped the re-open
    exactly when membership fell to one or none, so the grid went on showing the
    participant who had left.

    ⚠️ **A member with no row does NOT close the grid.** It opens with the rest
    and says which name is missing. Defect 3's symptom was a tidy partial grid
    *with nothing saying carol is missing*, so the marker is the fix; closing
    would be the worse regression, because `resolve_all` treats an unresolvable
    label as a steady state and throttles it for ever -- one typo would mean no
    grid at all for the life of the relay, and the relay's grid is an adjunct
    whose failures are meant to stay cosmetic.

    Every outcome is best-effort, like the rest of `Ctl`'s grid calls: nothing
    here may stop a message being carried. ⚠️ That sentence was written as a
    description and was FALSE -- `Ctl.dashboard` returns a status for a tool
    failure but `_spawn` raises when the tool cannot be started at all, and
    neither the open nor the reports were guarded. It is enforced below now:
    for the call, for `say` -- and for the outcome neither of those covers, a
    call that neither answered nor raised but BLOCKED until it was killed, which
    starves the pump by taking its time rather than by stopping it
    (`_grid_stall`).
    """
    # ⚠️ Every report below goes through a `say` that CANNOT RAISE. `say` writes
    # to `out`, which can be closed under a running relay -- `agb-peer relay |
    # head` closes it the moment head exits -- and an exception here unwinds
    # before `cmd_relay` assigns `opened_grid`, so the `finally` would not know
    # there was a grid to close. `close_grid` guards its own report for the same
    # reason; the open side did not.
    say = _quiet(say)
    cells = [(name, resolved[name][0], resolved[name][1])
             for name in sorted(resolved)]
    grid_cells, excluded = dashboard_cells([(c[1], c[2]) for c in cells])
    if excluded:
        # ⚠️ REPORTED, because a silent drop is the worse bug. agterm refuses
        # `:scratch` at parse time, so the whole dashboard call used to fail and
        # NO grid opened at all; routing through `dashboard_cells` fixed that,
        # and would otherwise have replaced a visible failure with a participant
        # quietly missing from the grid.
        #
        # `resolved` is inverted here rather than carried alongside because
        # `dashboard_cells` speaks in rows, and a row names a participant only
        # because `_one_name_per_row` guarantees the map is 1:1.
        named = dict((resolved[n][0], n) for n in resolved)
        _throttled(say, notes, ("dash-excluded",))(
            "dashboard: not shown -- %s; agterm's grid takes only %s panes"
            % (", ".join("%s (%s)" % (named.get(row, row[:8]), pane)
                         for row, pane in excluded),
               "/".join(DASHBOARD_PANES)))
    elif notes is not None:
        # Cleared once everyone fits, for the same reason the missing note is
        # below: a participant who moves out of the drawer and back in again
        # would otherwise be dropped from the grid in silence the second time.
        # The two notes had the same argument and only one of them applied it.
        notes.pop(("said", ("dash-excluded",)), None)
    if len(grid_cells) > DASHBOARD_MAX_CELLS:
        # ⚠️ **Defect 4's shape with a different cause: one participant too many
        # and NOBODY is gridded.** agterm's cap is nine cells; what it does with
        # a tenth is not measured, so this is decided here rather than found out
        # at run time. Trimmed and SAID, which is the same answer the drawer
        # exclusion gets and the opposite of `agb-dashboard`'s -- there the grid
        # is the point, here it is an adjunct and showing nine of ten beats
        # showing none. The order is the `sorted(resolved)` the cells were built
        # in, so the choice is deterministic rather than whatever a dict gave.
        kept = [c[0] for c in cells if (c[1], c[2]) not in excluded]
        grid_cells = grid_cells[:DASHBOARD_MAX_CELLS]
        _throttled(say, notes, ("dash-cap",))(
            "dashboard: %s not shown -- agterm's grid takes %d cells"
            % (", ".join(kept[DASHBOARD_MAX_CELLS:]), DASHBOARD_MAX_CELLS))
    elif notes is not None:
        # Cleared, for the third time and the same reason: a roster that drops
        # back under the cap and grows over it again must say so twice.
        notes.pop(("said", ("dash-cap",)), None)
    # ⚠️ **What is ACCOUNTED FOR is wider than what is in the grid**, and each
    # of the three has its own line already. A participant that resolved is in
    # `resolved` -- including one whose pane the grid cannot express, which the
    # exclusion above has just named and which is therefore not missing but
    # unshowable. A name `_one_name_per_row` dropped as an alias resolved
    # perfectly well and has been told which row it collided with; calling it
    # "no row" would be a second, contradictory diagnosis of one situation.
    missing = sorted(set(spec) - set(resolved)
                     - ((notes or {}).get(ALIAS_DROPS) or set()))
    if missing:
        # ⚠️ Throttled, because this runs every tick: `resolve_all` calls an
        # unresolvable label a steady state, so unthrottled a single typo prints
        # a line per tick for the life of the relay. `_throttled` dedupes on the
        # message TEXT, so a change in WHO is missing still gets through.
        _throttled(say, notes, ("dash-missing",))(
            "dashboard: no row for %s -- the grid shows the other %d"
            % (", ".join(missing), len(grid_cells)))
    elif notes is not None:
        # Forget it once everyone is back, or a second disappearance of the same
        # name would be silent -- the same reason `scan_participant` clears its fetch
        # note when the fetch succeeds.
        notes.pop(("said", ("dash-missing",)), None)
    fresh = tuple(cells)
    if fresh == shown:
        return shown, opened
    if _grid_stalled(notes):
        # ⚠️ **AFTER the reports, before the agtermctl calls**, so a wedge
        # silences the blocking calls and nothing else: the lines above are
        # local and cost nothing. See `_grid_stall`.
        return shown, opened
    if grid_cells:
        try:
            ok, said, why = ctl.dashboard(grid_cells)
        except Exception as exc:
            # 🔴 **GUARDED FOR THE SAME REASON `close_grid` IS -- and it was
            # not, three lines above a close that has been guarded since it was
            # written.** `_spawn` RAISES `PeerError` when agtermctl cannot be
            # started at all: a removed binary, a `$PATH` the pane did not
            # inherit, the `/proc/<pid>/exe (deleted)` case after an upgrade,
            # EMFILE. MEASURED -- the relay died with `PeerError agtermctl:
            # [Errno 2] No such file or directory` and the queued delivery was
            # never typed. The grid is an adjunct to a message pump; a cosmetic
            # failure that kills the pump is the one outcome forbidden here.
            ok, said, why = False, "", "%s" % (exc,)
        if ok is None:
            # 🔴 **THE TOOL WAS KILLED AT THE TIMEOUT, so whether a grid went
            # up is UNKNOWN -- and both of this branch's neighbours got that
            # wrong in opposite directions.**
            #
            # `opened` is armed, because the latch's question is "might this run
            # have put a grid on agterm's one screen"; leaving it False is a
            # *proof* of not-opened that nothing established, and the `finally`
            # would then walk past a grid this relay may well own. Closing a
            # grid we did not open is the cost, and it is the smaller one.
            #
            # ⚠️ **And `shown` unadvanced is RIGHT and was NOT ENOUGH.** It
            # makes the next tick retry, which for a wedge means another
            # `SUBPROCESS_TIMEOUT`-second blocking call, every tick, for as long
            # as it lasts -- `update_grid` runs BEFORE `relay_tick`, so at
            # `--interval 2` the message pump drops to about one pass in
            # fifteen. That is the outcome the guard three lines above forbids
            # in as many words; the fix for shape B walked in underneath it. The
            # retry therefore backs OFF rather than stopping: see `_grid_stall`.
            _throttled(say, notes, ("dash-open",))(
                "dashboard: %s -- a grid MAY be up; assuming this run owns it "
                "and retrying in %d tick(s)" % (why, _grid_stall(notes)))
            return shown, True
        if notes is not None:
            # The call ANSWERED, refusal or not, so agterm is not wedged.
            notes.pop(GRID_STALL, None)
        if not ok:
            # ⚠️ `shown` is deliberately NOT advanced on a failure, so the next
            # tick tries again -- otherwise one transient failure meant no grid
            # for the rest of the run, because the cell set is unchanged and the
            # trigger never fires again. The MESSAGE is throttled instead, which
            # is the same trade `missing` makes: a persistent failure says so
            # once rather than once per tick.
            #
            # ⚠️ And `opened` comes back UNTOUCHED, which is the ownership
            # latch: a re-open that failed does not mean the grid already up
            # went away, so clearing it here would strand somebody else's
            # screen full of cells this relay put there.
            _throttled(say, notes, ("dash-open",))("dashboard: %s" % (why,))
            return shown, opened
        opened = True
        if notes is not None:
            notes.pop(("said", ("dash-open",)), None)
        dropped = unresolved_lines(said)
        # ⚠️ **THE THIRD CAUSE OF A PARTIAL GRID, and the only one the relay
        # could not see.** agterm exits **0**, opens the grid without the cells
        # it could not resolve, and names them on stdout alone -- so a caller
        # reading only the status shows a grid quietly missing an agent. The
        # other two causes (no row at all, a pane the grid cannot express) have
        # had a line each since Task 2c; this one had none, while the docs said
        # a partial grid is always marked. Reachable with a documented shape: a
        # `:right` cell whose split has since closed is *unresolved, not an
        # error*. Said and not closed, like every other relay grid outcome.
        if dropped:
            # ⚠️ **`shown` IS NOT ADVANCED, for exactly the reason a failed
            # open does not advance it** -- and it was, three lines below the
            # comment making that argument. A partial open is an INCOMPLETE
            # outcome, and the documented cause of one is transient: a `:right`
            # cell whose split is briefly absent. Recording the cell set as
            # shown makes the next tick take the `fresh == shown` early return,
            # so the grid stays partial until the ids or the membership move --
            # which for a stable roster is the rest of the run. Retried instead,
            # with the MESSAGE throttled, which is the same trade the failed
            # open and the missing member both make.
            _throttled(say, notes, ("dash-dropped",))(
                "dashboard: open -- but agterm dropped %s"
                % ("; ".join(dropped),))
            return shown, opened
        if notes is not None:
            # Cleared on a clean open, like every other throttle here: a cell
            # agterm drops, recovers and drops again must say so twice.
            notes.pop(("said", ("dash-dropped",)), None)
        say("dashboard: open")
    elif opened:
        # Nobody left to show. Closing is the only honest rendering -- agterm
        # has no empty grid -- and it is cleared only on a close that WORKED, so
        # the `finally` still gets its turn if this one did not.
        #
        # ⚠️ **AND `shown` IS NOT ADVANCED ON A CLOSE THAT FAILED**, which is
        # the third incomplete outcome and the one this function did not cover:
        # a failed open and a partial open both keep `shown` so the next tick
        # retries, and a failed close is the same kind of unfinished business.
        # Advanced, it made the next tick take the `fresh == shown` early
        # return, so a stale grid of departed participants stayed on agterm's
        # one screen for the rest of the run. The message goes through
        # `_throttled` for the same reason the open's does -- retrying every
        # tick means complaining every tick otherwise.
        if not close_grid(ctl, _throttled(say, notes, ("dash-close",))):
            return shown, opened
        opened = False
        if notes is not None:
            notes.pop(("said", ("dash-close",)), None)
    return fresh, opened


def close_grid(ctl, say):
    """Best-effort like every other grid call, and here it has to be: this
    runs from a `finally` on the Ctrl-C path, where an exception would replace
    the KeyboardInterrupt with a traceback out of the cleanup -- and a grid
    that will not close is cosmetic, while a relay that dies reporting it is
    not. `say` writes to `out`, which can be closed by then, so even the
    report is guarded.

    Returns whether the grid is believed GONE, so an in-loop caller can drop
    its ownership flag on a close that worked and keep it on one that did not.
    The `finally` ignores it, there being nothing left to retry by then.

    ⚠️ **The REPORT is outside the try that decides the answer**, and it was
    not: a `say` that raised -- `agb-peer relay | head` closes `out` under a
    running relay -- landed in the same handler as a close that failed, so a
    grid that HAD gone was reported as still owned. The relay then kept its
    ownership flag and closed again on the way out, which by then may be
    somebody else's grid. What the caller asked is whether the grid is gone;
    only `dashboard_close` can answer that, and only it is asked here.

    ⚠️ **`agb-dashboard` has a `close_grid` too, and the duplication is
    deliberate** -- argued here rather than left for a reader to notice, the
    way `open_split`/`open_drawer` are. It answers `(closed, why)` and takes no
    `say`, because that script has no running loop to report into: its two
    callers put the reason inside a `DashError` and inside a printed warning
    respectively. Merging them would mean handing this one a formatter to make
    the other's message, which is more coupling than the six shared lines are
    worth. What they DO share is the reason to exist at all -- `_spawn` raises
    -- and that lives on `Ctl.dashboard_close`, where both can see it.
    """
    say = _quiet(say)
    try:
        ok, why = ctl.dashboard_close()
    except Exception as exc:
        say("dashboard: could not close (%s)" % (exc,))
        return False
    say("dashboard: %s" % ("closed" if ok else why))
    return bool(ok)


def main(argv, out=None, ctl=None):
    out = out or sys.stdout
    # Two leading verbs, and everything else is the direct one-shot form. A
    # verb rather than a flag because `send` needs no agtermctl at all -- it
    # prints a line -- while the rest of this file is nothing but agtermctl.
    if argv and argv[0] == "send":
        opts = parse_args(argv[1:])
        message = opts.get("message")
        if opts.get("stdin"):
            if message:
                raise PeerError("give a message or --stdin, not both")
            message = sys.stdin.read()
        if not (message or "").strip():
            raise PeerError("refusing to send an empty message")
        recipient = opts.get("to")
        if not recipient:
            raise PeerError("send: --to <name> is required")
        if opts.get("from"):
            # Refused rather than ignored. There is no `from` field on the
            # wire: the relay signs a message with the participant name of the
            # PANE it was found in, which an agent cannot misstate, and a
            # `--from` here would look like it changed that and would not.
            raise PeerError("send takes no --from: a message is signed with "
                            "the pane it was sent from, which is the only "
                            "part of it that cannot be misstated")
        return cmd_send(recipient, message, run_local, out)
    if argv and argv[0] == "who":
        return cmd_who(run_local, out)
    if argv and argv[0] == "relay":
        opts = parse_args(argv[1:])
        ctl = ctl or Ctl()
        return cmd_relay(ctl, (opts.get("message") or "").split(),
                         positive_int(opts["lines"], "--lines"),
                         positive_int(opts["interval"], "--interval"),
                         bool(opts.get("once")), out,
                         dashboard=bool(opts.get("dashboard")),
                         chat_dir=opts.get("chat_dir"),
                         roster=opts.get("roster"))
    opts = parse_args(argv)
    if opts.get("version"):
        out.write("agb-peer %s\n" % (VERSION,))
        return 0
    pane = opts["pane"]
    if pane not in PANE_KINDS:
        raise PeerError("--pane must be one of %s (agterm's 0.24.0 --help lists "
                        "more; the binary rejects them)"
                        % ("|".join(PANE_KINDS),))
    lines = positive_int(opts["lines"], "--lines")
    ctl = ctl or Ctl()

    def say(message):
        out.write("agb-peer: %s\n" % (message,))
        out.flush()

    if opts.get("list"):
        return cmd_list(ctl, pane, lines, out)

    want = opts.get("to")
    if not want:
        raise PeerError("--to is required. `agb-peer --list` shows the rows.")
    message = opts.get("message")
    if opts.get("stdin"):
        if message:
            raise PeerError("give a message or --stdin, not both")
        message = sys.stdin.read()
    body = compose(message, opts.get("from")
                   or os.environ.get("AGB_PEER_FROM") or "peer")

    session = resolve(ctl, want)
    say("peer: %s (%s), status %s"
        % (session.get("name") or "?", session["id"][:8],
           session.get("status") or "-"))

    if opts.get("dry_run"):
        text, err = ctl.text(session["id"], pane, lines)
        say("mode: %s" % ("unreadable (%s)" % err if err else classify(text)))
        say("would send: %s" % (body,))
        say("dry run -- nothing was typed")
        return 0

    ensure_composer(ctl, session, pane, not opts.get("no_arm"), lines, say)
    wait_ready(ctl, session, pane,
               positive_int(opts["retries"], "--retries"),
               positive_int(opts["interval"], "--interval"),
               bool(opts.get("force")), lines, say)
    deliver(ctl, session, pane, body, not opts.get("no_send"), lines, say)
    return 0


if __name__ == "__main__":
    if len(sys.argv) == 1:
        sys.stderr.write(USAGE)
        sys.exit(1)
    try:
        sys.exit(main(sys.argv[1:]))
    except PeerError as error:
        sys.stderr.write("agb-peer: %s\n" % (error,))
        sys.exit(error.code)
    except KeyboardInterrupt:
        sys.stderr.write("agb-peer: interrupted\n")
        sys.exit(1)
