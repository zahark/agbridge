def parse_args(argv):
    """Hand-rolled, matching the convention the other thirteen parsers use.

    `--opt=` with an empty inline value is a MISSING-VALUE error rather than an
    empty string, in this parser as in all of them: an empty `--to` would
    otherwise match the first row in the tree.
    """
    opts = {"pane": "left", "retries": "5", "interval": "8", "lines": "40"}
    words = []
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--":
            words.extend(argv[i + 1:])
            break
        if arg.startswith("--"):
            name, sep, inline = arg.partition("=")
            if name in PEER_FLAGS:
                if sep:
                    raise PeerError("%s takes no value" % (name,))
                opts[name[2:].replace("-", "_")] = True
            elif name in PEER_VALUE_ARGS:
                if sep:
                    if not inline:
                        raise PeerError("%s needs a value" % (name,))
                    value = inline
                else:
                    i += 1
                    if i >= len(argv):
                        raise PeerError("%s needs a value" % (name,))
                    value = argv[i]
                opts[name[2:].replace("-", "_")] = value
            else:
                raise PeerError("unknown option: %s" % (name,))
        else:
            words.append(arg)
        i += 1
    opts["message"] = " ".join(words) if words else None
    return opts


def positive_int(value, name):
    try:
        number = int(value)
    except (TypeError, ValueError):
        raise PeerError("%s must be a whole number, not %r" % (name, value))
    if number < 0:
        raise PeerError("%s must not be negative" % (name,))
    return number


def sessions_of(tree):
    """Every session object in `tree --json`, workspace order.

    Tolerant of a missing level rather than raising: a tree shape we do not
    recognise should read as "no rows here", which the caller reports as a
    peer that cannot be found -- not as a traceback that says nothing.
    """
    found = []
    spaces = (((tree or {}).get("result") or {}).get("tree") or {}).get(
        "workspaces")
    if not isinstance(spaces, list):
        return found
    for space in spaces:
        if not isinstance(space, dict):
            continue
        for session in space.get("sessions") or []:
            if isinstance(session, dict) and session.get("id"):
                found.append(session)
    return found


def match_sessions(sessions, want):
    """Sessions matching `want`: exact id, then id prefix, then name substring.

    Tried in that order and the FIRST non-empty tier wins, so an exact id is
    never made ambiguous by a name that happens to contain it. Case-insensitive
    for the two loose tiers only -- an id is echoed back by agterm and is
    compared as given.
    """
    if not want:
        return []
    exact = [s for s in sessions if s.get("id") == want]
    if exact:
        return exact
    lowered = want.lower()
    prefix = [s for s in sessions
              if str(s.get("id", "")).lower().startswith(lowered)]
    if prefix:
        return prefix
    return [s for s in sessions
            if lowered in str(s.get("name") or "").lower()]


def surface_of(session, kind):
    """The surface id for one pane, READ from `surfaces` rather than built.

    The id happens to be `surface:<session id>:<kind>`, so concatenation would
    work today. Reading it is not pedantry: `surfaces` is also what says which
    panes exist, so a missing entry is the answer to "is there a split?" and a
    built string would instead produce a confident `invalid surface` later.
    """
    for surface in session.get("surfaces") or []:
        if isinstance(surface, dict) and surface.get("kind") == kind:
            return surface.get("id")
    return None


def classify(text):
    """Which mode a pane is in, from its buffer.

    Three-valued on purpose, and `MODE_UNKNOWN` is not a failure: a pane that
    shows neither marker may be an agent whose UI we do not recognise, a pane
    mid-redraw, or a shell. The caller refuses on it rather than guessing,
    because both wrong guesses are bad in different ways.

    🔴 **A COMPOSER_GLYPH IS NOT PROOF OF A COMPOSER.** Observed live
    2026-08-28: Claude Code's startup trust prompt ("Is this a project you
    created or one you trust?") renders `❯`, so this returns MODE_COMPOSER for
    a blocking modal, and `peer_busy` does not catch it either -- it fires at
    STARTUP, before the agent has ever been active, so the status is `-`.

    ✅ **`wait_ready`'s CARET gate does catch it** -- MEASURED 2026-08-28: the
    trust prompt reads column **1**, an empty composer **2**, a 9-character
    draft **11**. So nothing is typed and no message can answer that dialog.
    ⚠️ **But that is luck rather than a defence** -- nothing makes a modal put
    its caret anywhere in particular, and the next one may read 2. This
    function is still wrong about what it saw, and the row still holds every
    message until a human answers the prompt. See
    docs/backlog/an-agent-at-the-trust-prompt-holds-every-message-for-ever.md.
    """
    if text is None:
        return MODE_UNKNOWN
    if MENU_MARKER in text:
        return MODE_MENU
    for glyph in COMPOSER_GLYPHS:
        if glyph in text:
            return MODE_COMPOSER
    return MODE_UNKNOWN


def pane_busy(text):
    """A reason not to type, read off the PANE itself, or None.

    The companion to `peer_busy`, and needed because that one is only as good as
    the agent's hooks. See `BUSY_MARKS` for what was measured and why holding is
    the whole fix.

    ⚠️ Searched over the WHOLE capture, deliberately. The hint sits just above
    the composer, which Claude anchors to the bottom of the pane and Codex does
    not -- reading a tail is what hid Codex's composer from `classify` once
    already, and the same mistake is available here.
    """
    low = (text or "").lower()
    for mark in BUSY_MARKS:
        if mark in low:
            return "the peer is working (%r is on its screen)" % (mark,)
    return None


def peer_busy(status):
    """Is the peer's agterm status a reason not to type? Returns a reason or None.

    ⚠️ What this IS: the state the AGENT's own Claude Code hooks reported, which
    the bridge pushed into agterm and `tree` reads back. That is strictly better
    evidence than the cookbook's caret check, which is a guess about a screen.

    ⚠️ **And it is not redundant with the mode check -- measured, not argued.**
    A `blocked` agent read as `composer`: its permission dialog is on screen and
    the composer glyph is still in the buffer, so `classify` says there is
    somewhere to type. There is, and it is the dialog. That is the cookbook's
    "Dialog Window Vulnerability", and THIS gate is the only thing that catches
    it -- the mode check cannot, and the cursor check would be measuring the
    dialog's caret. ⚠️ Note that last clause is about the PERMISSION dialog,
    which replaces a composer that already existed; it is not evidence about
    the startup trust prompt, where there was never a composer for the caret to
    be sitting in. Two different questions that look like one.

    🔴 **AND THERE IS A THIRD INSTANCE THAT THIS GATE DOES NOT CATCH.**
    Claude Code's startup trust prompt renders a COMPOSER_GLYPH, so `classify`
    calls it MODE_COMPOSER -- and it appears BEFORE the agent has ever run a
    turn, so the status is `-` rather than `active` and this gate passes it
    too.

    ✅ **And the CARET gate catches it** -- there are FOUR checks, not two:
    this one, `classify`, `pane_busy`, and `column == EMPTY_COLUMN`. MEASURED:
    the trust prompt reads column **1** against an empty composer's **2**, so
    `wait_ready` refuses and nothing is typed. The message is HELD -- which
    costs a peer that receives nothing until a human answers the prompt, but
    not a dialog answered by a message.

    ⚠️ **The count in that report was short, in the direction that made it
    sound worse.** It named the two gates whose docstrings argue with each
    other; `pane_busy` and the caret are argued in `wait_ready`'s body. An
    enumeration of defences is itself a claim.

    The docstring below argues the two gates are non-redundant, which is
    true; it must not be read as saying they are jointly sufficient. Observed
    live 2026-08-28;
    docs/backlog/an-agent-at-the-trust-prompt-holds-every-message-for-ever.md has what typing
    into it would do.

    ⚠️ **And the dialog is not the only instance -- COMPACTION is a second
    one, observed 2026-08-28.** A peer mid-autocompact reported `active` while
    `classify` read `composer`: the pane genuinely looks ready to type into,
    and this gate is again the only thing between a message and an agent that
    would drop it. Worth naming because the docstring justified two gates with
    one example, and an example reads like the reason rather than like a case
    of it -- the general rule is that the screen can look typeable while the
    agent cannot receive, and the screen is the half that cannot tell.

    ⚠️ What it is NOT. `idle` is emitted by the bridge alone, for a feed that
    went quiet and for a removed agent -- so it means "no current information",
    not "ready", and it is allowed through for that reason: refusing it would
    strand every row whose bridge is briefly disconnected. And a status can be
    up to REASSERT_INTERVAL (30 s) stale, so `completed` is a necessary
    condition and never a sufficient one. The composer check is what actually
    protects the message.
    """
    state = (status or "").strip().lower()
    if state in BUSY_STATUSES:
        return {"active": "the peer is mid-turn",
                "blocked": "the peer is waiting on a permission prompt"}[state]
    return None


def compose(message, sender):
    """The line that lands in the peer's composer.

    Prefixed for the reason agterm's cookbook gives: an agent that receives a
    bare sentence reads it as a fresh instruction from its human. Naming the
    sender says "this is a conversation", which is the difference between a
    reply and a new task.
    """
    text = (message or "").strip()
    if not text:
        raise PeerError("refusing to send an empty message")
    if "\n" in text:
        # A newline IS the submit key, so one inside the body would send the
        # first line on its own and leave the rest as a second turn.
        text = " ".join(part.strip() for part in text.splitlines() if part.strip())
    if text.lower() in PANE_WORDS:
        raise PeerError(
            "refusing to send %r: `agb pane` acts on that word, and if the "
            "mode read was wrong it would close or split the row rather than "
            "reach the agent" % (text,))
    return "[chat from %s] %s" % (sender, text)


# ---------------------------------------------------------------------------
# the doorbell protocol -- how one agent's message crosses to another's pane
# ---------------------------------------------------------------------------
#
# ⚠️ **The first design printed the message to the agent's own screen and had
# the relay read it back. That does not work, and the reason is measured:**
#
#   * `alternate_on=1, history_size=0` -- Claude Code runs on the alternate
#     screen, so the TERMINAL has no scrollback at all. `capture-pane -S -2000`
#     and agterm's `--all` both return exactly the visible screen.
#   * Claude Code keeps its own transcript and repaints it when you scroll --
#     but it **collapses multi-line blocks onto one line and truncates them
#     with an ellipsis**, so a scrolled-away message is destroyed, not merely
#     hard to find.
#   * Worst of all: **Claude Code does not render tool output onto the pane.**
#     It draws the command. A message printed to stdout is never on the screen
#     for anything to read, fresh or otherwise.
#
# So the screen cannot carry CONTENT. What it can carry is a **doorbell**,
# because tmux draws the status bar -- not the app -- and `session text`
# includes it:
#
#   window name:  claude [peer #k3n9x2]        <- always visible, never scrolls
#   tmux option:  @agbpeer_msg_k3n9x2          <- the message, exact
#
# ⚠️ **MEASURED, tmux 3.5a: the ceiling is 16336 bytes and it is LOUD.** This
# said "3 KB" for months, which is five times under, and said nothing about
# what happens past it -- so a truncated message was blamed on this transport
# first. A `set-option -p` value of 16337 bytes is REFUSED (`command too
# long` / `failed to send command`, rc 1), the option keeps its previous
# value, and `cmd_send`'s `tmux()` helper raises on the non-zero rc. Below
# that, `show-options -p` renders it on one line with head and tail intact.
# **This path cannot lose a message quietly.** The one that can is `deliver`
# -- see docs/backlog/delivery-is-verified-on-the-one-end-a-lost-head-leaves-intact.md.
#
# The relay reads the status bar on a tick it already makes for mode detection,
# so watching costs nothing. Only when the id CHANGES does it reach for the
# content -- one ssh per message, none while idle. That is the whole point: the
# screen says *when*, ssh says *what*.
#
# ⚠️ **A fetch takes everything pending, not just the announced id.** The
# doorbell shows only the latest, so a tick that missed one would otherwise
# lose it for ever; sweeping every `@agbpeer_msg_*` makes a missed doorbell
# harmless.
#
# ⚠️ **What survives `agb-refresh` and what does not.** Rows are re-minted and
# every row id changes -- observed twice in one afternoon. The doorbell and the
# content live in tmux on the agent's host and are untouched; the relay's
# resolved ids and any open `dashboard` are dead. So participants are named by
# LABEL and re-resolved every tick, and the dashboard is re-opened when ids
# move. A relay that cached ids would go permanently deaf and never say why.

OPTION_PREFIX = "@agbpeer_msg_"

# Where the sender stashes the window name it found, so the doorbell can be
# rendered as `<original> [peer #id]` rather than clobbering it.
OPTION_BASE = "@agbpeer_base"

DOORBELL = "[peer #%s]"


def message_id(now=None):
    """A short, readable, per-sender-monotonic id -- base36 milliseconds.

    ⚠️ **Ids are compared for EQUALITY only, never sorted.** Base36 of a
    millisecond clock is not lexicographically ordered once the digit count
    changes: `message_id(1e12)` is `"9ugxnorjls"`, which sorts BEFORE
    `message_id(1.0)`'s `"rs"`. Real timestamps all render 8 digits until
    roughly 2059, so a sort would appear to work for decades and then not.
    """
    value = int((now if now is not None else time.time()) * 1000)
    alphabet = "0123456789abcdefghijklmnopqrstuvwxyz"
    out = ""
    while value:
        value, digit = divmod(value, 36)
        out = alphabet[digit] + out
    return out or "0"


# --------------------------------------------------------------------------
# the NFS fallback -- for an agent whose tmux is on another machine
# --------------------------------------------------------------------------
#
# A job on a compute pool mounts the same NFS as everything else and the Mac
# cannot ssh it. Two of the three legs still work: an `agb-tmux` row on a
# REACHABLE host, with the pool session opened outward from inside it, carries
# keystrokes all the way down -- so delivery is unchanged. What breaks is
# sending, and it breaks in a way no permission fixes:
#
#   * `$TMUX` and `$TMUX_PANE` ARE inherited through the job submission, so the
#     agent believes it is `%99` of `/tmp/tmux-100000/default`;
#   * `/tmp` is local to each machine, so that socket is simply not there;
#   * ⚠️ and putting the socket on NFS does not help -- MEASURED. A
#     `tmux -S /home/user/.agb-sock/test` server accepts connections and holds
#     pane options locally, and from the pool machine, with that server alive
#     and the socket file plainly visible on the shared mount, tmux answers
#     `no server running`. A unix socket is a local kernel rendezvous, not a
#     filesystem object NFS carries.
#
# So the fallback uses the two things that DO cross: a file on NFS, and the
# agent's own screen.
#
#   doorbell   an echoed `[peer #id]` line -- `read_doorbell` already scans the
#              whole pane, so this needs no new parsing at all
#   content    `<statedir>/chat/<id>.msg`, an ordinary file
#   fetch      `ssh <reachable host> cat <path>` -- to the CONTAINER, never to
#              the pool, and only when the doorbell changes
#
# ⚠️ **This only works for an agent that renders command output on its screen.**
# MEASURED: Codex does (`└ <output>` under each `Ran …`); Claude Code does not
# render tool output at all, which is what killed the original screen-as-content
# design. A Claude on such a pool would need something else again.
CHAT_SUBDIR = "chat"


def file_transport_forced(env=None):
    """Has the operator said "always use the file transport"? (`$AGB_PEER_FILE`)

    ⚠️ **An opt-IN with no opposite, for the same reason `AGB_HOST_LOCAL` is
    one: a process cannot tell "my sandbox is blocking this socket" from "this
    socket is broken" by looking at itself.** So the case that needs it has to
    be typed rather than guessed.

    🔴 **The case it exists for, MEASURED live 2026-08-28.** A Codex ran
    `agb-peer send` and got `error connecting to /tmp/tmux-.../default
    (Operation not permitted)` -- its sandbox refuses the socket, which is
    right there and belongs to it. `socket_is_missing` correctly answers False
    (the socket IS on this machine), so `cmd_send` refused, and the agent
    reported the error and stopped. **The file transport would have worked the
    whole time.** Without this flag the feature is simply unavailable to an
    agent in that sandbox, and no error string it could match would be a sound
    discriminator -- which is why the answer is an operator's decision rather
    than a cleverer sniff.

    ⚠️ `"0"` and friends are FALSE, because a variable that silently means its
    opposite is worse than one that does not exist -- the rule `config_flag`
    already follows on the Mac side.
    """
    env = os.environ if env is None else env
    value = (env.get("AGB_PEER_FILE") or "").strip().lower()
    return value not in ("", "0", "no", "false", "off")


def socket_is_missing(env=None):
    """True when `$TMUX` names a socket that is not on this machine.

    ⚠️ **The discriminator, and it has to be a positive one.** Three different
    failures reach the same `rc != 0`, and only one of them means "use the file
    transport" -- all three were measured this week:

      * `Operation not permitted` -- Codex's sandbox refusing the socket. The
        socket is right there; falling back would hide a permissions problem.
      * a timeout -- a wedged agterm client blocking every tmux command that
        must notify it. Transient; falling back would silently move messages to
        a transport nobody is reading, and they would vanish.
      * `No such file or directory` -- the pool case. `$TMUX` and `$TMUX_PANE`
        were inherited through a job submission and the socket is on another
        machine's `/tmp`. This is the one, and it is checkable directly rather
        than inferred from an error string.

    `$TMUX` unset at all is NOT this case: we cannot tell, so the caller
    refuses, which is the same answer it gave before any of this existed.
    """
    env = os.environ if env is None else env
    tmux = env.get("TMUX")
    if not tmux:
        return False
    return not os.path.exists(tmux.split(",")[0])


def statedir(env=None):
    """`$AGB_STATEDIR`, then the config's `statedir`, then `~/.agbridge`.

    ⚠️ A cross-file agreement with `agb.statedir()` (CLAUDE.md invariant 14):
    `agb-peer` cannot import `agb`, so it spells the same resolution itself. A
    disagreement puts the message where nothing looks for it, silently.
    """
    env = os.environ if env is None else env
    explicit = env.get("AGB_STATEDIR")
    if explicit:
        return explicit
    path = os.path.join(os.path.expanduser("~"), ".config", "agbridge",
                        "config")
    try:
        with open(path) as handle:
            for line in handle:
                key, sep, value = line.partition("=")
                if sep and key.strip() == "statedir" and value.strip():
                    return value.strip()
    except (IOError, OSError):
        pass
    return os.path.join(os.path.expanduser("~"), ".agbridge")


def chat_path(ident, sd=None, env=None):
    return os.path.join(sd or statedir(env), CHAT_SUBDIR, "%s.msg" % (ident,))


def write_chat_file(path, recipient, text):
    """The message, as an ordinary file. Same two-part shape as the tmux option
    -- recipient on the first line, message on the rest -- so one parser reads
    both, and temp+rename because a torn read is a real possibility on NFS."""
    directory = os.path.dirname(path)
    if not os.path.isdir(directory):
        os.makedirs(directory)
    temp = path + ".tmp"
    # ⚠️ The temp is removed on ANY failure, which the three other temp+rename
    # writers in this file (`_write_roster_temp`, `write_roster_file`,
    # `write_draft_file`) all do and this one did not. `BaseException`, not
    # `Exception`: a `Ctrl-C` or an ENOSPC mid-write would otherwise leave
    # `<id>.msg.tmp` in a shared chat directory for ever, where nothing
    # collects it and nothing names it.
    try:
        with open(temp, "w") as handle:
            handle.write(option_value(recipient, text))
        os.rename(temp, path)
    except BaseException:
        try:
            os.unlink(temp)
        except OSError:
            pass
        raise
    return path


def option_value(recipient, text):
    """First line is the recipient, the rest is the message.

    Plain text on purpose: `tmux show-options -pqv @agbpeer_msg_k3n9x2` is a
    thing a human debugs with, and a base64 blob there would be a wall for no
    gain -- tmux options are not a terminal and nothing wraps them.
    """
    return "%s\n%s" % (recipient, " ".join((text or "").split()))


def parse_option_value(value):
    """(recipient, text) or None. Tolerant: a half-written option is not data."""
    if not value or "\n" not in value:
        return None
    recipient, _, text = value.partition("\n")
    recipient, text = recipient.strip(), text.strip()
    if not recipient or not text:
        return None
    return recipient, text


def doorbell_name(base, ident):
    return "%s %s" % (base, DOORBELL % (ident,))


def read_doorbell(text):
    """The newest announced id from a pane's rendered STATUS BAR, or None.

    ⚠️ Searched over the whole capture rather than just the last line. The bar
    is normally last, but a pane mid-redraw can put it elsewhere, and a missed
    doorbell costs a round trip.
    """
    found = read_doorbells(text)
    return found[-1] if found else None


def read_doorbells(text):
    """EVERY announced id on the pane, oldest first. [] when there are none.

    ⚠️ **The file transport needs all of them, and the tmux one does not.**
    `drain` sweeps every `@agbpeer_msg_*` option off the pane, so a doorbell it
    missed is harmless -- the option is still there next ring. `drain_files`
    cannot sweep: the chat directory is shared by every participant, and a
    message carries its recipient but not its sender, so a blind glob would
    attribute one agent's message to whichever pane happened to ring. It has to
    fetch BY NAME, and the only names it has are the ones on this screen.

    So two sends between one relay tick used to lose the earlier message: the
    window name shows only the newest, and that was the only id fetched.
    MEASURED live -- a Codex rang twice in one tick and its first message was
    orphaned in the chat directory for ever.
    """
    import re
    return re.findall(r"\[peer #([0-9a-z]+)\]", text or "")


def list_argv(pane):
    """Ask tmux for every option on a pane. **Pure argv, no shell.**

    ⚠️ The first version ran a `for … in $(…)` loop over ssh and failed with
    `Illegal variable name.` -- tcsh, because `ssh <host> <cmd>` hands the
    command to the remote LOGIN shell, and a farm login shell is often tcsh.
    Quoting a POSIX script through tcsh is a losing game, so there is no remote
    script any more: ssh execs `tmux` directly and every metacharacter problem
    goes away with it.
    """
    return ["tmux", "show-options", "-p", "-t", pane]


def unset_argv(pane, key):
    return ["tmux", "set", "-pu", "-t", pane, key]


def ssh_argv(target, argv, env=None):
    """Wrap for ssh, or not, for a participant whose tmux is on this machine.

    ⚠️ The LOCAL branch resolves tmux's path, the ssh branch deliberately does
    not: over ssh the remote login shell finds its own tmux, and a Mac path
    would be nonsense there. Only this side has the profile-less-PATH problem.
    """
    argv = list(argv)
    if not target or target == "local":
        if argv and argv[0] == "tmux":
            argv[0] = tmux_binary(env)
        return argv
    return ["ssh", "-o", "BatchMode=yes", target] + argv


def unescape_option(value):
    """Undo tmux's own quoting of an option value.

    `show-options -p` renders each option on ONE line, escaping newline as
    `\n`, plus `\"` and `\\` -- which is exactly why the Mac can parse it
    with no help from the far side.
    """
    out = []
    index = 0
    simple = {"n": "\n", "t": "\t", "r": "\r", "\\": "\\", '"': '"'}
    while index < len(value):
        char = value[index]
        if char == "\\" and index + 1 < len(value):
            out.append(simple.get(value[index + 1], value[index + 1]))
            index += 2
        else:
            out.append(char)
            index += 1
    return "".join(out)


def parse_show_options(text):
    """`show-options -p` output -> [{id, key, to, text}], skipping anything else.

    A pane carries options that are none of our business, and a value may be
    quoted or bare depending on whether tmux needed the quotes -- both are
    handled, and anything that does not parse is passed over rather than raised
    on. ⚠️ "Both are handled" was a claim before it was true; see the comment on
    the unescape below.
    """
    import re
    pattern = re.compile(r"^(%s[0-9a-z]+)\s+(.*)$" % (re.escape(OPTION_PREFIX),))
    messages = []
    for line in (text or "").splitlines():
        match = pattern.match(line.rstrip())
        if not match:
            continue
        key, raw = match.group(1), match.group(2).strip()
        if len(raw) >= 2 and raw.startswith('"') and raw.endswith('"'):
            raw = raw[1:-1]
        # ⚠️ **UNESCAPED WHETHER OR NOT IT WAS QUOTED, and this was a real bug.**
        # tmux quotes a value only when it has to, so `bob\nhello there` comes
        # back quoted and `bob\nhello` comes back BARE -- but BOTH render the
        # newline as a literal backslash-n. Unescaping only the quoted form left
        # a bare value holding two characters where the separator should be, so
        # `parse_option_value` found no newline, returned None, and the message
        # was skipped in silence. Every single-word message was lost that way:
        # measured, `agb-peer send --to bob hello` never arrived, while
        # `--to bob 'hello there'` did. `agb-peer who` hits it every time,
        # because its token is one word by design -- which is how it was found.
        raw = unescape_option(raw)
        parsed = parse_option_value(raw)
        if parsed:
            messages.append({"id": key[len(OPTION_PREFIX):], "key": key,
                             "to": parsed[0], "text": parsed[1]})
    return messages


# How many ticks to keep trying to prime a joiner before giving up. ⚠️ **Short
# on purpose, and the reason runs the other way from the message hold.** While a
# name is pending, the ordinary scan skips it, so anything it sends piles up on
# its pane and is DISCARDED by the prime that finally succeeds. The longer we
# persist, the more live messages a successful prime throws away. Giving up
# early risks delivering one stale backlog; giving up late destroys real mail,
# and this project's rule is that discarding a real message is the worse
# failure. Three arming attempts fit inside this, since `scan_participant` arms
# a detached row every tenth try.
PRIME_ATTEMPTS_MAX = 30


def prime_joiners(ctl, sessions, needs_prime, people, seen, lines, say,
                  fetch=None, notes=None, chat_dir=None):
    """Discard whatever was on a joiner's pane before it joined.

    ⚠️ **`needs_prime` MEANS: there may be content on this pane that predates
    the join, so the next successful drain must be discarded rather than
    delivered.** Every rule here is that sentence, not a list to memorise:

      * the pane was read -- drained, or read with nothing announced -- so
        there is nothing stale left: **clear it**;
      * the pane was NOT read -- no row, unreadable, detached, or the drain
        failed -- so we still do not know: **keep it**, and try next tick.

    ⚠️ `SCAN_DETACHED` is the one that looks like the first and is the second.
    A detached row shows `agb pane`'s menu, which hides the status bar, so its
    doorbell is not *visible* -- not *absent*. Every row `agb-refresh` re-mints
    comes back detached, so getting this wrong delivers a backlog on the
    ordinary path rather than in a corner.
    """
    notes = {} if notes is None else notes
    discarded = []
    # ⚠️ A copy: the loop removes from the set it is walking.
    for name in sorted(needs_prime):
        binding = people.get(name)
        if binding is None:
            # Not resolved this tick -- a row is briefly absent while it is
            # re-minted. Keep it pending and say nothing; scan_participant's
            # own ladder is what reports a row that never comes back.
            continue
        tries = notes.get(("prime", name), 0) + 1
        notes[("prime", name)] = tries
        result, messages = scan_participant(ctl, sessions, name, binding, seen,
                                            lines, say, fetch, notes, chat_dir)
        if result in SCAN_PANE_IS_CLEAN:
            needs_prime.discard(name)
            notes.pop(("prime", name), None)
            for message in messages:
                # ⚠️ Named, not counted: an operator who queued something a
                # moment earlier needs to see that THIS is what went.
                discarded.append("#%s (%s -> %s)"
                                 % (message["id"], name, message["to"]))
        elif tries >= PRIME_ATTEMPTS_MAX:
            # ⚠️ Cleared WITHOUT discarding. We never managed to read the pane,
            # so we do not know what is on it -- and holding on means every
            # message this participant sends meanwhile is thrown away by the
            # prime that eventually works. Letting a stale backlog through is
            # the lesser failure, and it is at least visible.
            needs_prime.discard(name)
            notes.pop(("prime", name), None)
            say("gave up priming %s after %d ticks (%s): whatever is on its "
                "pane will be DELIVERED rather than discarded, so an old "
                "message may arrive" % (name, tries, result))
    if discarded:
        say("discarded %d message(s) that predate a join: %s"
            % (len(discarded), ", ".join(discarded)))
    return discarded


# Every note this file keys on a participant name. ⚠️ **A list, not a pattern,
# and it has to grow when a new per-name note appears.** A note left behind
# after a leave is not cosmetic: `("held", name)` would resume a half-hour hold
# for a name that came back, and `("said", ...)` would swallow the first
# complaint about the new pane.
def _name_notes(name):
    return (("gone", name), ("menu", name), ("said", name), ("held", name),
            ("prime", name), ("said", ("fetch", name)),
            ("said", ("read", name)), ("said", ("gone-row", name)),
            # ⚠️ The alias throttle, and it shipped missing from this list
            # while the rule above was written out in full. A name that leaves
            # the roster is not in `resolved` on any later tick, so
            # `_one_name_per_row`'s own clear cannot reach it -- only a leave
            # can. Without this, a participant who left and came back to the
            # SAME collision is dropped from the grid in silence, because the
            # message text is identical and `missing` subtracts `ALIAS_DROPS`.
            ("said", ("alias", name)),
            # ⚠️ The resolver's own throttle, and the SIXTH one -- found by
            # looking for more of the shape the alias note above was. It has no
            # other clear and cannot have one: `resolve_all` keeps
            # `previous[name]` for any name that ever resolved, so only a name
            # that NEVER did reaches this throttle, and such a name is in no
            # `resolved` dict for an in-place clear to visit. Left behind, a
            # participant whose label is wrong, is removed from the roster and
            # is re-added with the SAME wrong label is reported nowhere at all
            # -- and without `--dashboard` that line is the only thing the
            # relay ever says about them.
            ("said", ("resolve", name)))


def apply_leaves(left, rebound, seen, pending, resolved, needs_prime, notes,
                 say, moved=None):
    """Forget everything pane-specific about names that left or moved.

    ⚠️ **A REBIND IS NOT A LEAVE, AND THE DIFFERENCE IS `pending`.** Both change
    which pane a name means, so both must forget `seen`, the notes, the
    delivered ids and the resolved binding. But a rebound participant has not
    gone anywhere -- it moved -- and its queued messages were already unset from
    the SENDER's pane, so they exist nowhere else. Dropping them would destroy
    mail for somebody still in the conversation.

    ⚠️ **Dropping `resolved[name]` is required, not tidiness.** `resolve_all`
    keeps `previous[name]` whenever resolution fails, and a rebind keeps the
    same NAME -- so a rebind to a label that does not resolve this tick would
    silently stay bound to the OLD row while `seen` had already been cleared,
    and the old pane's doorbell would read as new and be drained and delivered.
    """
    departing = set(left) | set(rebound)
    for name in sorted(departing):
        seen.pop(name, None)
        resolved.pop(name, None)
        needs_prime.discard(name)
        for key in _name_notes(name):
            notes.pop(key, None)
        done = notes.get("delivered")
        if done:
            for entry in [e for e in done if e[0] == name]:
                done.discard(entry)
    # 🔴 **ONLY A NAME WHOSE PANE ACTUALLY MOVED IS PRIMED.** The reason for
    # priming is that *the new pane may hold anything, including a conversation
    # this name was never part of* -- which cannot be true when the pane is the
    # same one. `moved` defaults to `rebound`, so every existing caller is
    # unchanged.
    #
    # ⚠️ MEASURED 2026-08-28, and it cost a real message. A participant's
    # roster entry was edited to add a TRANSPORT hint -- same row, same pane,
    # only `@host` gaining `:nfs`. The binding tuple differed, so it counted as
    # a rebind, so it was primed, and priming **discarded the very message the
    # repair existed to deliver**. The edit was the only way to fix delivery
    # for that participant and was guaranteed to destroy what was pending.
    #
    # ⚠️ Forgetting `seen` above is still right for a transport change and is
    # NOT the harmful half: it makes the doorbell read as new, which is exactly
    # how the repaired transport picks the message up. Discarding is the half
    # that had no justification.
    for name in sorted(rebound if moved is None else moved):
        needs_prime.add(name)
    gone = set(left)
    if not gone:
        return
    dropped, kept = [], []
    for sender, message in pending:
        if message.get("to") in gone:
            # ⚠️ Named, not counted, and load-bearing rather than duplicate:
            # `try_deliver` HOLDS for a roster member now, so without this a
            # leaver's mail would be held for ever instead of dropped.
            dropped.append("#%s (%s -> %s)"
                           % (message.get("id"), sender, message.get("to")))
        else:
            kept.append((sender, message))
    pending[:] = kept
    if dropped:
        say("%s left, so %d queued message(s) will not be delivered: %s"
            % (", ".join(sorted(gone)), len(dropped), ", ".join(dropped)))


class RosterReader(object):
    """Re-reads a roster file, and reports the participants only when they move.

    ⚠️ **TWO PIECES OF STATE, AND THEY DIVERGE ON PURPOSE.** `self.raw` is the
    change GATE -- what the file said the last time we looked -- while
    `self.spec` is the last roster actually APPLIED. A read that parses badly
    advances the first and not the second, so the next valid edit is still
    diffed against what is really running rather than against a file that was
    refused. Collapsing them loses a join.

    ⚠️ **The gate compares BYTES rather than a stat key.** The file is a handful
    of lines, so reading it is cheaper than reasoning about whether
    `(mtime, size, inode)` can miss a rewrite -- and `os.stat` on a network
    mount is served from the attribute cache, which is what invariant 6 is
    about. Comparing what we read satisfies that by construction instead of by
    a comment nobody re-checks.

    ⚠️ **Every failure HOLDS.** Unreadable, missing, not UTF-8, malformed,
    empty: at runtime none of those is evidence that anybody left. A truncated
    read is exactly what a file being rewritten in place looks like for a
    millisecond, and it parses *cleanly* as a shorter roster -- so treating a
    short answer as authoritative would apply a leave nobody asked for. This is
    invariant 2 in its own words: a short or malformed read is no information
    this poll, never "gone".
    """

    def __init__(self, path, minimum=1):
        self.path = path
        self.minimum = minimum
        self.raw = None
        self.spec = None

    def poll(self, say, notes=None):
        """The new roster when it changed and parsed, else None (keep going)."""
        def hold(reason):
            _throttled(say, notes, ("roster",))(
                "%s -- keeping the %d participant(s) already running"
                % (reason, len(self.spec or {})))
            return None

        try:
            data = read_roster_file(self.path)
        except PeerError as error:
            return hold(str(error))
        if data == self.raw:
            return None
        self.raw = data
        try:
            spec = parse_roster_text(data, minimum=self.minimum)
        except PeerError as error:
            return hold(str(error))
        if notes is not None:
            notes.pop(("said", ("roster",)), None)
        self.spec = spec
        if len(spec) < 2:
            # Announced, not refused. One participant is a legal state for a
            # RUNNING relay -- somebody left, somebody else may yet join -- and
            # stopping would make a roster edit unable to remove anybody.
            _throttled(say, notes, ("thin",))(
                "the roster is down to %d participant(s): nothing can be "
                "delivered until another joins" % (len(spec),))
        elif notes is not None:
            notes.pop(("said", ("thin",)), None)
        return spec


def read_roster_file(path):
    """The roster file's raw BYTES, or a PeerError naming what stopped us.

    Bytes rather than text because the change gate compares them: decoding
    first would mean a file that is not UTF-8 could not even be compared, and
    the runtime path's whole job is to survive a bad read rather than raise
    through it.
    """
    try:
        with open(path, "rb") as handle:
            return handle.read()
    except (IOError, OSError) as exc:
        raise PeerError("cannot read the roster %s: %s" % (path, exc))


ROSTER_ABSENT = None


def roster_bytes(path):
    """The roster's bytes, `ROSTER_ABSENT` if there is no file, else raise.

    ⚠️ **THREE ANSWERS, NOT TWO, AND THE THIRD IS A RAISE.** `read_roster_file`
    turns every errno into one `PeerError`, which is right for the relay -- at
    runtime nothing is evidence that anybody left -- and wrong for a WRITER.
    Folding "unreadable" into "absent" would make `write_roster_file` compare
    `None == None` and rename straight over a roster nobody could read: the
    gate goes vacuous exactly when it matters. That is invariant 12's rule
    ("I could not answer" is not "the answer is nothing") applied to the one
    input this file writes.

    ⚠️ **It READS the file rather than stat-ing it**, deliberately, and
    `RosterReader` explains why: the file is a handful of lines, so reading it
    is cheaper than reasoning about whether `(mtime, size, inode)` can miss a
    rewrite -- and `os.stat` on a network mount is served from the attribute
    cache, which is what invariant 6 is about. Comparing what we read satisfies
    that by construction instead of by a comment nobody re-checks.

    `ROSTER_ABSENT` is `None`, and it is unambiguous *because* unreadable
    raises: nothing else can produce it. It stays distinct from `b""`, which is
    an empty file that really is there -- a difference the relay cares about
    (`parse_roster_text` refuses an empty roster with its own message) and a
    writer must not erase.
    """
    import errno   # only this function needs it; `agb-peer send` does not
    try:
        with open(path, "rb") as handle:
            return handle.read()
    except (IOError, OSError) as exc:
        if exc.errno in (errno.ENOENT, errno.ENOTDIR):
            return ROSTER_ABSENT
        raise PeerError("cannot read the roster %s: %s" % (path, exc))


def render_roster_lines(entries):
    """`[(name, (row, pane, target, tmux_target))]` -> canonical `str` lines.

    The inverse of `parse_roster_text`, and **`str` rather than bytes** because
    every caller but the writer is showing a line to a human -- a picker echoes
    the entry it just built, the raw-edit hatch pre-fills a prompt with it.
    The writer encodes; nobody else should have to decode.

    ⚠️ **A LIST, ordered, not the dict `parse_participants` returns.** That dict
    only keeps insertion order as a CPython 3.6 implementation detail, and this
    project's floor *is* 3.6 -- so an editor that lets you delete "the second
    one" cannot be built on it. The caller owns the order; this just renders it.

    ⚠️ **The defaults are omitted, and that is what makes the round trip
    SEMANTIC rather than textual.** `parse_participants` normalises a missing
    pane to `"left"` and a missing `@`/`:` to `None`, so `alice=myrow` and
    `alice=myrow:left` parse identically and only one of them can be rendered
    back. Rendering the shorter spelling keeps a hand-written file recognisable
    after an edit; the test that matters is `parse(render(parse(x))) == parse(x)`.
    """
    lines = []
    for name, spec in entries:
        row, pane, target, tmux_target = spec
        if tmux_target and not target:
            # ⚠️ The grammar cannot express it: `<row>:<tmux>` with no `@`
            # reparses as a PANE, and `parse_participants` then refuses it for
            # not being one of PANE_KINDS -- or, worse, accepts it silently if
            # the tmux session happens to be called `left`. Refuse at the
            # point where the entry is built instead.
            raise PeerError("%s: a tmux target needs an ssh target -- "
                            "name=<row>@<target>:<tmux>" % (name,))
        text = "%s=%s" % (name, row)
        if pane and pane != "left":
            text += ":%s" % (pane,)
        if target:
            text += "@%s" % (target,)
            if tmux_target:
                text += ":%s" % (tmux_target,)
        lines.append(text)
    return lines


ROSTER_MODE = 0o600


def _roster_temp(path):
    """`<name>.tmp.<pid>.<rand>`, in the SAME directory as `path`.

    ⚠️ **This is `agb.temp_name` minus the host component, on purpose.** That
    one is `<name>.tmp.<host>.<pid>.<rand>` because two HOSTS may write one
    target over NFS. A roster is edited by a person sitting at the Mac the
    relay runs on, so the host adds nothing here -- and taking it would mean
    spelling `own_host()` a third time (`agb-claude` and `agb-codex` already
    hold copies, and CLAUDE.md invariant 14 records what that costs). The pid
    and the random suffix carry the whole job: two setup sessions, or one plus
    a hand edit, must not collide on the temp itself.

    Same directory because `rename()` is only atomic within a filesystem.
    """
    head, base = os.path.split(path)
    return os.path.join(head, "%s.tmp.%d.%s"
                        % (base, os.getpid(), os.urandom(4).hex()))


def _write_roster_temp(path, lines, mode=ROSTER_MODE):
    """Write the lines to a fresh same-dir temp and return its path.

    `O_CREAT|O_EXCL` so a temp that somehow exists is an error rather than a
    silent overwrite, and `fchmod` because `O_CREAT`'s mode argument is
    umask-filtered -- both copied from `agb.atomic_write`, which is the shape
    this file has settled on for content that must not tear.
    """
    payload = ("\n".join(lines) + "\n").encode("utf-8")
    temp = _roster_temp(path)
    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
    try:
        os.fchmod(fd, mode)
        written = os.write(fd, payload)
        while written < len(payload):
            written += os.write(fd, payload[written:])
    except BaseException:
        os.close(fd)
        _unlink_roster_temp(temp)
        raise
    os.close(fd)
    return temp


def _unlink_roster_temp(path):
    try:
        os.unlink(path)
    except (IOError, OSError):
        pass


def write_roster_file(path, lines, expect):
    """Replace the roster, but only if it still says what `expect` says.

    ⚠️ **temp+rename, never in place.** A file rewritten in place can be read
    truncated at a line boundary, and a truncated roster parses *cleanly* as a
    shorter one -- indistinguishable from a real removal, so the relay would
    apply a leave nobody asked for. `docs/commands.md` states this as a rule
    for whoever edits the file; this is the tool that keeps it.

    ⚠️ **`roster_bytes`' failure becomes a `RosterConflict`, and that
    conversion is load-bearing.** An unreadable roster is a reason not to
    write, exactly like a changed one -- but it arrives as a bare `PeerError`,
    which sails past the caller's `except RosterConflict`. The draft then never
    reaches a recovery file and is lost silently, with every test green. So the
    rule here is: anything that means *do not write* leaves through one door.

    ⚠️ **The gate is not a lock, and the docstring says so on purpose.** A
    writer landing between the comparison and the `rename` is still lost. The
    window is microseconds against a human deciding what to type, and closing
    it needs a lockfile whose failure modes are worse than the one it removes;
    if that trade ever changes, change it here rather than at a call site.

    `mode` is `ROSTER_MODE` (0600) and is **restated on every write**, so an
    existing roster loosened by hand tightens again the first time this tool
    saves it. That is a real behaviour change to somebody's file and it is
    chosen rather than inherited -- `agb.FILE_MODE` happens to be the same
    number, and inheriting a default is how the mode question gets skipped.
    """
    try:
        current = roster_bytes(path)
    except PeerError as exc:
        raise RosterConflict("%s -- nothing was written" % (exc,))
    if current != expect:
        raise RosterConflict(
            "the roster changed on disk since this session read it "
            "-- nothing was written to %s" % (path,))
    temp = _write_roster_temp(path, lines)
    try:
        os.rename(temp, path)
    except BaseException:
        _unlink_roster_temp(temp)
        raise
    return path


def write_draft_file(path, lines):
    """Write a recovery draft. **Ungated, and that is the whole point.**

    ⚠️ **Do not "improve" this by routing it through `write_roster_file`.**
    Its caller is the `RosterConflict` handler, and the path it hands over was
    just minted and belongs to nobody -- so there is nothing to compare
    against, `expect` has no honest value, and any gate would raise
    `RosterConflict` *from inside the conflict handler*, losing the draft it
    was called to save. The one path standing between a conflict and lost work
    cannot itself be conditional.

    It still goes temp+rename, which is belt and braces on a unique path
    nothing else can see: it means a crash mid-write leaves the recovery file
    **absent** rather than half-written, so what survives is either the whole
    draft or a clean nothing.
    """
    temp = _write_roster_temp(path, lines)
    try:
        os.rename(temp, path)
    except BaseException:
        _unlink_roster_temp(temp)
        raise
    return path


# Which participant panes the DASHBOARD can show. agterm's grid takes a
# `:left`/`:right` suffix; `PANE_KINDS` is wider because a participant may live
# in the scratch drawer, which is a place an agent can be but NOT a cell agterm
# will accept. ⚠️ Measured 2026-08-27 (agb-dashboard plan, Task 0): `:scratch`
# is refused with `invalid session id ... use <id>, <id>:left, or <id>:right`,
# and refused AT PARSE TIME -- byte-identical whether the row has a scratch pane
# open or not -- so the suffix vocabulary is fixed before agterm looks at any
# row state. That is why exclusion is the only option here: there is no state a
# caller could arrange that would make the cell work.
DASHBOARD_PANES = ("left", "right")

# agterm's own cap. ⚠️ It counts PANES, not sessions: a BARE id takes every pane
# of its session, so a row somebody opened a split on costs two. Emitting an
# explicit pane always is what turns this into a count of AGENTS, and is the
# only reason a caller can preflight it honestly.
DASHBOARD_MAX_CELLS = 9


def dashboard_cells(pairs):
    """`[(id, pane)]` -> `(cells, excluded)`.

    ⚠️ **Never a bare id.** Not a style rule: a bare id takes every pane of its
    session, so the same rows fit or do not depending on whether a stranger
    opened a split -- state nobody is looking at. An explicit pane makes one
    entry cost exactly one cell, which is what lets a caller say "9 cells; got
    10" before calling anything.

    ⚠️ **The pane is PRESERVED, not forced to `left`.** A participant may
    legitimately live in the right-hand pane, and rewriting that would point
    the cell at the wrong half of somebody's screen.

    Returns what it dropped as well as what it kept, because a pane the grid
    cannot show is a real absence: the relay reports it and carries on, while
    `agb-dashboard` treats it as a shortfall and refuses.
    """
    cells, excluded = [], []
    for row, pane in pairs:
        if pane in DASHBOARD_PANES:
            cells.append("%s:%s" % (row, pane))
        else:
            excluded.append((row, pane))
    return cells, excluded


def unresolved_lines(text):
    """The `unresolved: <id>` lines agterm printed, if any.

    ⚠️ **On STDOUT, and beside exit 0.** When only some cells resolve agterm
    opens the grid without the rest, says so here, and succeeds -- so this is
    the one place in the family where the exit status is deliberately not
    trusted. It is why `Ctl.dashboard` returns stdout at all.

    ⚠️ **It lives here, beside `dashboard_cells`, because there are TWO
    callers**: `agb-dashboard` treats a dropped cell as a shortfall and
    refuses, the relay says so and carries on. It was written in
    `agb-dashboard` alone, and for as long as it was, the third cause of a
    silently partial grid -- agterm's own drop -- was unread by the relay while
    the docs said a partial grid is always marked.

    ⚠️ `startswith`, not `in`: `unresolved:` is how agterm OPENS such a line,
    and a substring test would also match a row whose title happens to contain
    the word.
    """
    return [line.strip() for line in (text or "").splitlines()
            if line.strip().startswith("unresolved:")]


def parse_roster_text(data, minimum=2):
    """A roster file's participants. Same grammar as the positional form.

    Handing the words to `parse_participants` is the point: the file grammar
    cannot drift from the command-line one, because there is only one.

    ⚠️ **A `#` comment is a WHOLE LINE, never a trailing one.** `<row>` is a
    row-title substring and may contain anything a title does, `#` included, so
    stripping from the first `#` would silently truncate a legitimate spec.
    """
    if isinstance(data, bytes):
        try:
            data = data.decode("utf-8")
        except UnicodeDecodeError as exc:
            # ⚠️ A ValueError, not an OSError. A caller guarding this with a
            # bare `except IOError` lets it through, and at runtime that kills
            # the relay over a half-written file.
            raise PeerError("the roster is not UTF-8: %s" % (exc,))
    words = []
    for line in data.splitlines():
        line = line.strip()
        if line and not line.startswith("#"):
            words.extend(line.split())
    if not words:
        # ⚠️ Its own message, and not "0 participants". An empty read is what a
        # file being rewritten in place looks like for a millisecond, and the
        # runtime path has to treat it as NO INFORMATION rather than as
        # everybody leaving -- so the reason has to survive to the caller.
        raise PeerError("the roster is empty")
    return parse_participants(words, minimum=minimum)


# ⚠️ **A POSITIVE LIST, and it applies to the NAME only -- the text left of the
# `=`.** `<row>` is a row-title SUBSTRING and legitimately contains `/`, since
# the default `row_fields` renders `cwd` unshortened: `bob=/home/you/agbridge`
# is a working spec. Two reasons for the rule, and the second is why it is here
# rather than wherever it is first needed: a name has to survive being spliced
# into a value that crosses `ssh <host> tmux set ...`, where ssh flattens argv
# into a string for the remote login shell -- and **tightening a refusal later
# is the breaking direction**, so the time to draw it is before anyone has a
# name it would reject.
NAME_ALPHABET = frozenset(
    "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-")
NAME_RULE = "letters, digits, dot, underscore and hyphen"

# ⚠️ **The recipient that means THE RELAY ITSELF, and the only text it answers.**
# `agb-peer who` sends `WHO_REQUEST` to `RELAY_NAME`; the relay intercepts it
# while draining and replies with the roster.
#
# ⚠️ **The token exists to stop a reply loop, not to validate input.**
# `SKILL.md` tells an agent that anything arriving as `[chat from <name>]` is a
# peer talking to it and to reply -- so an answer signed `[chat from relay]`
# would be replied to, and the reply is another message to `relay`, for ever.
# Answering ONLY the exact token means a polite "thanks" is not a request and
# the loop cannot start. The skill also says the answer needs no reply, but that
# is a rule an agent may ignore; this is one it cannot.
#
# ⚠️ **Both comparisons are exact and case-sensitive**, deliberately and
# together. A case-INSENSITIVE refusal here with an exact intercept below would
# accept `Relay` as a participant and then never intercept it -- a name that can
# be added to a roster and never addressed. Matching the two is what makes
# `Relay` an ordinary, working participant instead.
RELAY_NAME = "relay"
WHO_REQUEST = "who"


def roster_answer(you, members):
    """The text of a `who` answer: `you=alice peer=bob peer=carol`.

    Plain, because it is delivered as an ordinary message and read by an agent
    and by whoever is watching the pane. Membership only -- no status, no
    timestamp: the answer is composed when the request is drained and delivered
    whenever the composer is free, so anything time-shaped in it would be a
    snapshot from one moment read as truth at another. `agb-peer` has no
    heartbeat by design, so there is nothing an age could honestly say.

    ⚠️ **`set(members)` is load-bearing and only looks redundant.** `cmd_relay`
    passes `members=set(spec)`, but `relay_tick`'s `members=None` fallback
    substitutes `people`, which is a **dict** -- and `{"a": 1} - {"a"}` raises
    `TypeError`. `try_deliver` survives the identical fallback only because it
    does `in` tests, which work on both. The path everyone tests is the set one.
    """
    peers = sorted(set(members) - set([you]))
    return " ".join(["you=%s" % (you,)] + ["peer=%s" % (n,) for n in peers])


def valid_participant_name(name):
    return bool(name) and not (set(name) - NAME_ALPHABET)


def parse_participants(words, minimum=2):
    """`name=<row>` or `name=<row>:<pane>` -> {name: (row, pane)}.

    An optional `@<ssh target>` says where that agent's tmux lives; `@local`
    means this machine. Without it the target comes from the row's own
    `agb pane --host`, which is a hostname and may need an ssh alias -- hence
    the override.

    ⚠️ An optional `:<tmux target>` after that names the tmux pane or session,
    and a **Mac-native participant needs it**. The pane id is otherwise read
    out of the row's `agb pane --pane` argv, and an agterm session that is not
    an agbridge row has no such argv -- its `foreground` is a shell. So
    `macside=<label>@local:<tmux session>` is the shape for an agent running in
    tmux on the Mac; tmux resolves a session name to its active pane.

    ⚠️ `<row>` should be a **label substring**, not a row id: `agb-refresh`
    re-mints every row and every id changes. `resolve` tries an exact id, then
    an id prefix, then a title substring, so a label keeps working across a
    refresh and an id does not.
    """
    people = {}
    for word in words:
        name, sep, where = word.partition("=")
        if not sep or not name or not where:
            raise PeerError("participants are name=<row> or name=<row>:<pane>, "
                            "not %r" % (word,))
        if not valid_participant_name(name):
            raise PeerError("%r is not a usable participant name: %s"
                            % (name, NAME_RULE))
        if name == RELAY_NAME:
            # Exact match: `Relay` and `relayed` are ordinary names. See the
            # comment on RELAY_NAME for why the two comparisons must agree.
            raise PeerError("%r is reserved: it is how an agent addresses the "
                            "relay itself, which is what `agb-peer who` sends "
                            "to. Pick another name for the participant."
                            % (RELAY_NAME,))
        where, at, target = where.partition("@")
        target, _sep3, tmux_target = target.partition(":")
        row, sep2, pane = where.partition(":")
        pane = pane if sep2 else "left"
        if pane not in PANE_KINDS:
            raise PeerError("%s: pane must be one of %s"
                            % (name, "|".join(PANE_KINDS)))
        if not row:
            raise PeerError("%s: no row id" % (name,))
        if at and not target:
            raise PeerError("%s: @ with no ssh target" % (name,))
        if name in people:
            raise PeerError("%s named twice" % (name,))
        # `@local` means "this agent's tmux is on THIS machine" -- a Mac-side
        # participant, which needs no ssh and is otherwise identical. Absent,
        # the target is taken from the row's own `agb pane --host`.
        people[name] = (row, pane, target or None, tmux_target or None)
    if len(people) < minimum:
        # ⚠️ `minimum` exists because startup and runtime disagree on purpose.
        # A relay cannot START with one participant -- there is nobody to talk
        # to -- but a running one can legitimately drop to one when somebody
        # leaves, and refusing that would mean a roster edit could not remove a
        # participant without also stopping the relay.
        raise PeerError("a relay needs at least %d participant%s"
                        % (minimum, "" if minimum == 1 else "s"))
    return people


def pane_argv_field(foreground, flag):
    """Pull a value out of a row's `agb pane` command line.

    ⚠️ `foreground` is the argv the SESSION WAS LAUNCHED WITH -- measured, and
    it is why it cannot be used to tell an attached row from a detached one.
    For this it is exactly right: `agb pane --host <h> --pane <%N>` is how the
    relay learns where to ssh and which tmux pane to drain, straight from
    agterm, with no configuration of its own.
    """
    if not isinstance(foreground, (list, tuple)):
        return None
    for index, word in enumerate(foreground):
        if word == flag and index + 1 < len(foreground):
            return foreground[index + 1]
        if word.startswith(flag + "="):
            return word[len(flag) + 1:] or None
    return None


# ---------------------------------------------------------------------------
# the agtermctl seam -- one door, injectable, never raises on a tool failure
# ---------------------------------------------------------------------------

# ⚠️ **Every subprocess here is timed out, and it is not defensive coding.**
# MEASURED: `tmux display-message -t %N` blocked indefinitely while an agterm
# `dashboard` had a wedged view-only client attached -- `list-clients` answered
# and everything that has to NOTIFY a client did not. `agb-peer send` hung for
# two minutes with no output and nothing written. This repo's own rule
# ("always pass timeout= to communicate()") exists for exactly that, and this
# file broke it in two places.
SUBPROCESS_TIMEOUT = 30

# How long `_spawn` waits for the pipes to close AFTER it has killed a timed-out
# child. Short on purpose: the direct child is already dead, so anything still
# holding the pipes is a grandchild we did not kill and will not out-wait. This
# is the difference between a bounded failure and an unbounded hang -- see
# `_spawn`.
REAP_TIMEOUT = 5

TIMED_OUT = 124


def _spawn(argv, timeout):
    """(rc, stdout, stderr). A timeout is an error, not a hang, so the caller
    can say which command stopped responding.

    ⚠️ **"Never blocks for ever" used to be true only while the command had no
    surviving children, and that is narrower than it sounds.** `kill()` ends
    the direct child; the `communicate()` after it took NO timeout and waited
    for EOF on the pipes. A grandchild inherits those pipes, so a command that
    spawns a helper outliving it blocked the second wait indefinitely -- an
    unbounded hang with no output, strictly worse than the timeout it was
    reaching for, and worse than every case `grid_unknown` was written to
    report.

    MEASURED live 2026-08-28, both shapes: a wedged `agtermctl` whose hang is
    the direct child (`exec sleep 300`) returned at 31s against a 30s budget,
    correctly. The same fake hanging in a GRANDCHILD (`sleep 300` as an
    ordinary child) never returned at all -- killed by hand after two minutes,
    with the intermediate shell already gone and the grandchild still holding
    the pipe.

    ✅ **Fixed by bounding the reap** (`REAP_TIMEOUT`). The worst case is now
    `timeout + REAP_TIMEOUT` and a TIMED_OUT answer, instead of no answer ever.

    ⚠️ **Bounded is not reaped, and the difference is deliberate.** A grandchild
    that outlives the kill keeps running and keeps the pipe; we abandon it
    rather than wait for it. The alternative -- `start_new_session=True` plus
    `os.killpg` -- is correct rather than merely bounded, and was NOT taken:
    it detaches every child from the controlling terminal, so Ctrl-C at an
    `agb-peer relay` prompt would stop reaching the subprocess it is running.
    That is a user-visible behaviour change to every caller of this function,
    traded for a case that is unreachable with today's single-binary
    `agtermctl`. Revisit it if that ever grows a helper; the reasoning and the
    measurement are in
    docs/backlog/a-timeout-is-only-a-timeout-without-grandchildren.md.
    """
    try:
        proc = subprocess.Popen(argv, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE)
    except OSError as exc:
        raise PeerError("%s: %s" % (argv[0], exc))
    try:
        out, err = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        proc.kill()
        try:
            proc.communicate(timeout=REAP_TIMEOUT)
        except subprocess.TimeoutExpired:
            # The direct child is dead; something else is holding the pipes.
            # `poll()` reaps the corpse without waiting on them -- calling
            # `wait()` here would reintroduce the very block this avoids.
            proc.poll()
        return TIMED_OUT, "", ("%s did not answer within %ss -- a wedged tmux "
                               "or agterm client will do this"
                               % (argv[0], timeout))
    return (proc.returncode, out.decode("utf-8", "replace"),
            err.decode("utf-8", "replace"))


def run_local(argv, timeout=SUBPROCESS_TIMEOUT):
    """(rc, stdout, stderr) for a command on THIS machine -- `send` runs tmux,
    not agtermctl, and must work on a farm host where agterm does not exist."""
    return _spawn(argv, timeout)


def run_ctl(argv, timeout=SUBPROCESS_TIMEOUT):
    """(rc, stdout, stderr) for an agtermctl call.

    🔴 **A missing `agtermctl` is reported with the way OUT, because without it
    the true message produces a false conclusion.** Observed live 2026-08-28: a
    Codex on a cluster host ran the direct form, got
    `agtermctl: [Errno 2] No such file or directory`, and told its user that
    *"agb-peer's required agtermctl dependency isn't installed"* -- then stopped.

    Every word of that is defensible and the conclusion is wrong. `agtermctl`
    is not a dependency of `agb-peer`; it is a dependency of the **direct
    delivery path**, which types into a row and therefore only exists where
    agterm does. `agb-peer send` needs **no agtermctl at all** -- it stashes the
    body in a tmux pane option and rings a doorbell -- and it was available the
    whole time. An error that names a true fact and leads somewhere false is
    worse than a vague one, because it gets believed.
    """
    try:
        return _spawn([CTL] + list(argv), timeout)
    except PeerError as error:
        if "No such file or directory" not in str(error):
            raise
        raise PeerError(
            "%s -- this form talks to agterm, which lives on the Mac. On a "
            "machine without it, use `agb-peer send --to <name> --stdin`, "
            "which needs no agtermctl: it stashes the message in tmux for the "
            "relay to collect. Set $AGB_AGTERMCTL if agterm IS here under "
            "another path." % (error,))


class Ctl(object):
    """Thin typed wrapper so the flow below reads as intent, not as argv."""

    def __init__(self, run=None, sleep=None):
        self.run = run or run_ctl
        self.sleep = sleep or time.sleep

    def tree(self):
        rc, out, err = self.run(["tree", "--json"])
        if rc != 0:
            raise PeerError("tree failed: %s" % (err.strip() or rc,))
        try:
            return json.loads(out)
        except ValueError:
            raise PeerError("tree returned something that is not JSON")

    def text(self, target, pane, lines=None, whole=False):
        """The pane's VISIBLE SCREEN -- no `--lines`, no `--all`.

        ⚠️ **Reading a tail hid Codex completely.** MEASURED: Claude Code
        anchors its composer to the BOTTOM of the pane, Codex draws from the
        TOP and leaves the bottom blank. So `--lines 40` finds Claude every
        time and can miss Codex's composer entirely -- `classify` answered
        `unknown` for a perfectly healthy Codex row, and the relay would never
        have delivered to it. The doorbell kept working throughout, because
        tmux's status bar is always the last line.

        ⚠️ And the tail bought nothing anyway: the alternate screen has NO
        scrollback, measured -- `--all`, `--lines 400` and the bare default all
        returned exactly the same 60 lines. `lines` and `whole` are still
        accepted so the call sites need not all change at once, and are
        deliberately ignored; the flags they used to produce are what agterm
        rejects when combined.
        """
        rc, out, err = self.run(["session", "text", "--target", target,
                                 "--pane", pane])
        if rc != 0:
            return None, (err.strip() or "exit %s" % (rc,))
        return out, None

    def cursor(self, surface):
        rc, out, err = self.run(["surface", "cursor", "--target", surface])
        if rc != 0:
            return None, (err.strip() or "exit %s" % (rc,))
        try:
            return int(out.strip()), None
        except ValueError:
            return None, "cursor returned %r" % (out.strip(),)

    def dashboard(self, members):
        """(ok, out, reason). Best-effort in the sense that a grid which will
        not open is a cosmetic failure and must never stop the relay.

        🔴 **"Best-effort" describes the RETURN, not the call: this RAISES.**
        `_spawn` raises `PeerError` when agtermctl cannot be started at all --
        a removed binary, a `$PATH` an agterm pane did not inherit, the
        `/proc/<pid>/exe (deleted)` case after an upgrade, EMFILE -- so the
        status is answered only when the tool ran. The guard therefore lives at
        **every call site where a raise could orphan a grid or kill the message
        pump** -- which is the bug two separate review passes found: the relay
        died mid-delivery with `agtermctl: [Errno 2]`, and `agb-dashboard` lost
        the message naming the grid it had left up. ⚠️ That is narrower than
        "every call site", deliberately: `agb-dashboard` opens BARE, because a
        raise there means agtermctl never ran, so there is no grid to orphan
        and its `__main__` turns the `PeerError` into the documented exit 1.
        Read this line before writing a call that "cannot fail".

        ⚠️ **STDOUT IS RETURNED, and that is the whole reason this is not a
        two-tuple.** agterm exits **0** when only SOME cells resolve, opens the
        grid without the rest, and names the casualties as `unresolved: <id>`
        on **stdout** only. So a caller that trusts the status gets a grid
        quietly missing the agent it was opened to watch -- and the status is
        the only thing a caller had, before this. ⚠️ **BOTH callers read it
        now** (`unresolved_lines`, which says so from the other end): they
        differ in what they do about it, not in whether they look.
        `agb-dashboard` refuses and closes; the relay says so, does not record
        the cells as shown, and retries. This docstring said the relay ignored
        it for as long as that was true, and went on saying it afterwards.

        🔴 **`ok` IS THREE-VALUED: `True`, `False`, and `None` for "the tool
        ran and was KILLED at the timeout, so nobody knows".** That third
        outcome existed from the first line of `_spawn` and both callers spelled
        it "would not open" -- a definite negative for an indefinite result,
        which is invariant 1's shape and invariant 12's rule. It is the one
        `not ok` where agterm may well have opened the grid: the timeout fires
        against a WEDGED agterm client, and the measured wedge was a view-only
        client attached to a **dashboard**. Reported as a refusal it left a grid
        nobody would close and nothing on screen saying so. `if not ok` still
        catches it, so a caller that does not care is unchanged; a caller that
        must decide whether a grid is up asks `if ok is None` first.

        ⚠️ A genuine agtermctl exit **124** is indistinguishable from our own
        `TIMED_OUT`, and that is the harmless direction: it downgrades a
        definite answer to an unknown one, never the reverse.
        """
        rc, out, err = self.run(["dashboard"] + list(members))
        return ((None if rc == TIMED_OUT else rc == 0), (out or ""),
                ((err or "").strip() or "exit %s" % (rc,)))

    def dashboard_close(self):
        """(ok, reason). Closes THE grid -- agterm has exactly one.

        ⚠️ Which is why a caller must only ever close a grid **it opened**:
        there is no ownership token, so closing unconditionally would dismiss
        whatever somebody else had up.

        ⚠️ **And that rule gates WHETHER, never WHICH -- it is weaker than it
        reads, and three docs stated the strong version.** `--close` takes no
        target, so a latch saying "this run opened a grid" cannot say "this
        one". A run whose grid was replaced closes the replacement. The code
        cannot do better; `design.md` §6 carries the sentence that is true.

        🔴 **And this RAISES too**, for the same `_spawn` reason spelled out
        above -- which is worse here, because both callers run it from a
        cleanup path where an exception replaces the exit with a traceback out
        of the tidy-up. `close_grid` in this file and `close_grid` in
        `agb-dashboard` are the two wrappers that exist for it.
        """
        rc, _out, err = self.run(["dashboard", "--close"])
        return (rc == 0), ((err or "").strip() or "exit %s" % (rc,))

    def type(self, target, pane, text):
        rc, out, err = self.run(["session", "type", text,
                                 "--target", target, "--pane", pane])
        if rc != 0:
            raise PeerError("session type failed: %s" % (err.strip() or rc,))
        return True


