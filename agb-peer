class PeerError(Exception):
    """Anything the caller should see as a one-line message plus an exit code."""

    def __init__(self, message, code=1):
        Exception.__init__(self, message)
        self.code = code


# ---------------------------------------------------------------------------
# pure helpers -- everything here is a string/dict test, no subprocess
# ---------------------------------------------------------------------------

def parse_args(argv):
    """Hand-rolled, matching the convention the other thirteen parsers use.

    `--opt=` with an empty inline value is a MISSING-VALUE error rather than an
    empty string, in this parser as in all of them: an empty `--to` would
    otherwise match the first row in the tree.
    """
    opts = {"pane": "left", "retries": "5", "interval": "8", "lines": "40"}
    words = []
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--":
            words.extend(argv[i + 1:])
            break
        if arg.startswith("--"):
            name, sep, inline = arg.partition("=")
            if name in PEER_FLAGS:
                if sep:
                    raise PeerError("%s takes no value" % (name,))
                opts[name[2:].replace("-", "_")] = True
            elif name in PEER_VALUE_ARGS:
                if sep:
                    if not inline:
                        raise PeerError("%s needs a value" % (name,))
                    value = inline
                else:
                    i += 1
                    if i >= len(argv):
                        raise PeerError("%s needs a value" % (name,))
                    value = argv[i]
                opts[name[2:].replace("-", "_")] = value
            else:
                raise PeerError("unknown option: %s" % (name,))
        else:
            words.append(arg)
        i += 1
    opts["message"] = " ".join(words) if words else None
    return opts


def positive_int(value, name):
    try:
        number = int(value)
    except (TypeError, ValueError):
        raise PeerError("%s must be a whole number, not %r" % (name, value))
    if number < 0:
        raise PeerError("%s must not be negative" % (name,))
    return number


def sessions_of(tree):
    """Every session object in `tree --json`, workspace order.

    Tolerant of a missing level rather than raising: a tree shape we do not
    recognise should read as "no rows here", which the caller reports as a
    peer that cannot be found -- not as a traceback that says nothing.
    """
    found = []
    spaces = (((tree or {}).get("result") or {}).get("tree") or {}).get(
        "workspaces")
    if not isinstance(spaces, list):
        return found
    for space in spaces:
        if not isinstance(space, dict):
            continue
        for session in space.get("sessions") or []:
            if isinstance(session, dict) and session.get("id"):
                found.append(session)
    return found


def match_sessions(sessions, want):
    """Sessions matching `want`: exact id, then id prefix, then name substring.

    Tried in that order and the FIRST non-empty tier wins, so an exact id is
    never made ambiguous by a name that happens to contain it. Case-insensitive
    for the two loose tiers only -- an id is echoed back by agterm and is
    compared as given.
    """
    if not want:
        return []
    exact = [s for s in sessions if s.get("id") == want]
    if exact:
        return exact
    lowered = want.lower()
    prefix = [s for s in sessions
              if str(s.get("id", "")).lower().startswith(lowered)]
    if prefix:
        return prefix
    return [s for s in sessions
            if lowered in str(s.get("name") or "").lower()]


def surface_of(session, kind):
    """The surface id for one pane, READ from `surfaces` rather than built.

    The id happens to be `surface:<session id>:<kind>`, so concatenation would
    work today. Reading it is not pedantry: `surfaces` is also what says which
    panes exist, so a missing entry is the answer to "is there a split?" and a
    built string would instead produce a confident `invalid surface` later.
    """
    for surface in session.get("surfaces") or []:
        if isinstance(surface, dict) and surface.get("kind") == kind:
            return surface.get("id")
    return None


def classify(text):
    """Which mode a pane is in, from its buffer.

    Three-valued on purpose, and `MODE_UNKNOWN` is not a failure: a pane that
    shows neither marker may be an agent whose UI we do not recognise, a pane
    mid-redraw, or a shell. The caller refuses on it rather than guessing,
    because both wrong guesses are bad in different ways.
    """
    if text is None:
        return MODE_UNKNOWN
    if MENU_MARKER in text:
        return MODE_MENU
    for glyph in COMPOSER_GLYPHS:
        if glyph in text:
            return MODE_COMPOSER
    return MODE_UNKNOWN


def peer_busy(status):
    """Is the peer's agterm status a reason not to type? Returns a reason or None.

    ⚠️ What this IS: the state the AGENT's own Claude Code hooks reported, which
    the bridge pushed into agterm and `tree` reads back. That is strictly better
    evidence than the cookbook's caret check, which is a guess about a screen.

    ⚠️ **And it is not redundant with the mode check -- measured, not argued.**
    A `blocked` agent read as `composer`: its permission dialog is on screen and
    the composer glyph is still in the buffer, so `classify` says there is
    somewhere to type. There is, and it is the dialog. That is the cookbook's
    "Dialog Window Vulnerability", and THIS gate is the only thing that catches
    it -- the mode check cannot, and the cursor check would be measuring the
    dialog's caret.

    ⚠️ What it is NOT. `idle` is emitted by the bridge alone, for a feed that
    went quiet and for a removed agent -- so it means "no current information",
    not "ready", and it is allowed through for that reason: refusing it would
    strand every row whose bridge is briefly disconnected. And a status can be
    up to REASSERT_INTERVAL (30 s) stale, so `completed` is a necessary
    condition and never a sufficient one. The composer check is what actually
    protects the message.
    """
    state = (status or "").strip().lower()
    if state in BUSY_STATUSES:
        return {"active": "the peer is mid-turn",
                "blocked": "the peer is waiting on a permission prompt"}[state]
    return None


def compose(message, sender):
    """The line that lands in the peer's composer.

    Prefixed for the reason agterm's cookbook gives: an agent that receives a
    bare sentence reads it as a fresh instruction from its human. Naming the
    sender says "this is a conversation", which is the difference between a
    reply and a new task.
    """
    text = (message or "").strip()
    if not text:
        raise PeerError("refusing to send an empty message")
    if "\n" in text:
        # A newline IS the submit key, so one inside the body would send the
        # first line on its own and leave the rest as a second turn.
        text = " ".join(part.strip() for part in text.splitlines() if part.strip())
    if text.lower() in PANE_WORDS:
        raise PeerError(
            "refusing to send %r: `agb pane` acts on that word, and if the "
            "mode read was wrong it would close or split the row rather than "
            "reach the agent" % (text,))
    return "[chat from %s] %s" % (sender, text)


# ---------------------------------------------------------------------------
# the doorbell protocol -- how one agent's message crosses to another's pane
# ---------------------------------------------------------------------------
#
# ⚠️ **The first design printed the message to the agent's own screen and had
# the relay read it back. That does not work, and the reason is measured:**
#
#   * `alternate_on=1, history_size=0` -- Claude Code runs on the alternate
#     screen, so the TERMINAL has no scrollback at all. `capture-pane -S -2000`
#     and agterm's `--all` both return exactly the visible screen.
#   * Claude Code keeps its own transcript and repaints it when you scroll --
#     but it **collapses multi-line blocks onto one line and truncates them
#     with an ellipsis**, so a scrolled-away message is destroyed, not merely
#     hard to find.
#   * Worst of all: **Claude Code does not render tool output onto the pane.**
#     It draws the command. A message printed to stdout is never on the screen
#     for anything to read, fresh or otherwise.
#
# So the screen cannot carry CONTENT. What it can carry is a **doorbell**,
# because tmux draws the status bar -- not the app -- and `session text`
# includes it:
#
#   window name:  claude [peer #k3n9x2]        <- always visible, never scrolls
#   tmux option:  @agbpeer_msg_k3n9x2          <- the message, 3 KB, exact
#
# The relay reads the status bar on a tick it already makes for mode detection,
# so watching costs nothing. Only when the id CHANGES does it reach for the
# content -- one ssh per message, none while idle. That is the whole point: the
# screen says *when*, ssh says *what*.
#
# ⚠️ **A fetch takes everything pending, not just the announced id.** The
# doorbell shows only the latest, so a tick that missed one would otherwise
# lose it for ever; sweeping every `@agbpeer_msg_*` makes a missed doorbell
# harmless.
#
# ⚠️ **What survives `agb-refresh` and what does not.** Rows are re-minted and
# every row id changes -- observed twice in one afternoon. The doorbell and the
# content live in tmux on the agent's host and are untouched; the relay's
# resolved ids and any open `dashboard` are dead. So participants are named by
# LABEL and re-resolved every tick, and the dashboard is re-opened when ids
# move. A relay that cached ids would go permanently deaf and never say why.

OPTION_PREFIX = "@agbpeer_msg_"

# Where the sender stashes the window name it found, so the doorbell can be
# rendered as `<original> [peer #id]` rather than clobbering it.
OPTION_BASE = "@agbpeer_base"

DOORBELL = "[peer #%s]"


def message_id(now=None):
    """A short, readable, per-sender-monotonic id -- base36 milliseconds.

    ⚠️ **Ids are compared for EQUALITY only, never sorted.** Base36 of a
    millisecond clock is not lexicographically ordered once the digit count
    changes: `message_id(1e12)` is `"9ugxnorjls"`, which sorts BEFORE
    `message_id(1.0)`'s `"rs"`. Real timestamps all render 8 digits until
    roughly 2059, so a sort would appear to work for decades and then not.
    """
    value = int((now if now is not None else time.time()) * 1000)
    alphabet = "0123456789abcdefghijklmnopqrstuvwxyz"
    out = ""
    while value:
        value, digit = divmod(value, 36)
        out = alphabet[digit] + out
    return out or "0"


# --------------------------------------------------------------------------
# the NFS fallback -- for an agent whose tmux is on another machine
# --------------------------------------------------------------------------
#
# A job on a compute pool mounts the same NFS as everything else and the Mac
# cannot ssh it. Two of the three legs still work: an `agb-tmux` row on a
# REACHABLE host, with the pool session opened outward from inside it, carries
# keystrokes all the way down -- so delivery is unchanged. What breaks is
# sending, and it breaks in a way no permission fixes:
#
#   * `$TMUX` and `$TMUX_PANE` ARE inherited through the job submission, so the
#     agent believes it is `%99` of `/tmp/tmux-100000/default`;
#   * `/tmp` is local to each machine, so that socket is simply not there;
#   * ⚠️ and putting the socket on NFS does not help -- MEASURED. A
#     `tmux -S /home/user/.agb-sock/test` server accepts connections and holds
#     pane options locally, and from the pool machine, with that server alive
#     and the socket file plainly visible on the shared mount, tmux answers
#     `no server running`. A unix socket is a local kernel rendezvous, not a
#     filesystem object NFS carries.
#
# So the fallback uses the two things that DO cross: a file on NFS, and the
# agent's own screen.
#
#   doorbell   an echoed `[peer #id]` line -- `read_doorbell` already scans the
#              whole pane, so this needs no new parsing at all
#   content    `<statedir>/chat/<id>.msg`, an ordinary file
#   fetch      `ssh <reachable host> cat <path>` -- to the CONTAINER, never to
#              the pool, and only when the doorbell changes
#
# ⚠️ **This only works for an agent that renders command output on its screen.**
# MEASURED: Codex does (`└ <output>` under each `Ran …`); Claude Code does not
# render tool output at all, which is what killed the original screen-as-content
# design. A Claude on such a pool would need something else again.
CHAT_SUBDIR = "chat"


def socket_is_missing(env=None):
    """True when `$TMUX` names a socket that is not on this machine.

    ⚠️ **The discriminator, and it has to be a positive one.** Three different
    failures reach the same `rc != 0`, and only one of them means "use the file
    transport" -- all three were measured this week:

      * `Operation not permitted` -- Codex's sandbox refusing the socket. The
        socket is right there; falling back would hide a permissions problem.
      * a timeout -- a wedged agterm client blocking every tmux command that
        must notify it. Transient; falling back would silently move messages to
        a transport nobody is reading, and they would vanish.
      * `No such file or directory` -- the pool case. `$TMUX` and `$TMUX_PANE`
        were inherited through a job submission and the socket is on another
        machine's `/tmp`. This is the one, and it is checkable directly rather
        than inferred from an error string.

    `$TMUX` unset at all is NOT this case: we cannot tell, so the caller
    refuses, which is the same answer it gave before any of this existed.
    """
    env = os.environ if env is None else env
    tmux = env.get("TMUX")
    if not tmux:
        return False
    return not os.path.exists(tmux.split(",")[0])


def statedir(env=None):
    """`$AGB_STATEDIR`, then the config's `statedir`, then `~/.agbridge`.

    ⚠️ A cross-file agreement with `agb.statedir()` (CLAUDE.md invariant 14):
    `agb-peer` cannot import `agb`, so it spells the same resolution itself. A
    disagreement puts the message where nothing looks for it, silently.
    """
    env = os.environ if env is None else env
    explicit = env.get("AGB_STATEDIR")
    if explicit:
        return explicit
    path = os.path.join(os.path.expanduser("~"), ".config", "agbridge",
                        "config")
    try:
        with open(path) as handle:
            for line in handle:
                key, sep, value = line.partition("=")
                if sep and key.strip() == "statedir" and value.strip():
                    return value.strip()
    except (IOError, OSError):
        pass
    return os.path.join(os.path.expanduser("~"), ".agbridge")


def chat_path(ident, sd=None, env=None):
    return os.path.join(sd or statedir(env), CHAT_SUBDIR, "%s.msg" % (ident,))


def write_chat_file(path, recipient, text):
    """The message, as an ordinary file. Same two-part shape as the tmux option
    -- recipient on the first line, message on the rest -- so one parser reads
    both, and temp+rename because a torn read is a real possibility on NFS."""
    directory = os.path.dirname(path)
    if not os.path.isdir(directory):
        os.makedirs(directory)
    temp = path + ".tmp"
    with open(temp, "w") as handle:
        handle.write(option_value(recipient, text))
    os.rename(temp, path)
    return path


def option_value(recipient, text):
    """First line is the recipient, the rest is the message.

    Plain text on purpose: `tmux show-options -pqv @agbpeer_msg_k3n9x2` is a
    thing a human debugs with, and a base64 blob there would be a wall for no
    gain -- tmux options are not a terminal and nothing wraps them.
    """
    return "%s\n%s" % (recipient, " ".join((text or "").split()))


def parse_option_value(value):
    """(recipient, text) or None. Tolerant: a half-written option is not data."""
    if not value or "\n" not in value:
        return None
    recipient, _, text = value.partition("\n")
    recipient, text = recipient.strip(), text.strip()
    if not recipient or not text:
        return None
    return recipient, text


def doorbell_name(base, ident):
    return "%s %s" % (base, DOORBELL % (ident,))


def read_doorbell(text):
    """The newest announced id from a pane's rendered STATUS BAR, or None.

    ⚠️ Searched over the whole capture rather than just the last line. The bar
    is normally last, but a pane mid-redraw can put it elsewhere, and a missed
    doorbell costs a round trip.
    """
    import re
    found = re.findall(r"\[peer #([0-9a-z]+)\]", text or "")
    return found[-1] if found else None


def list_argv(pane):
    """Ask tmux for every option on a pane. **Pure argv, no shell.**

    ⚠️ The first version ran a `for … in $(…)` loop over ssh and failed with
    `Illegal variable name.` -- tcsh, because `ssh <host> <cmd>` hands the
    command to the remote LOGIN shell, and a farm login shell is often tcsh.
    Quoting a POSIX script through tcsh is a losing game, so there is no remote
    script any more: ssh execs `tmux` directly and every metacharacter problem
    goes away with it.
    """
    return ["tmux", "show-options", "-p", "-t", pane]


def unset_argv(pane, key):
    return ["tmux", "set", "-pu", "-t", pane, key]


def ssh_argv(target, argv, env=None):
    """Wrap for ssh, or not, for a participant whose tmux is on this machine.

    ⚠️ The LOCAL branch resolves tmux's path, the ssh branch deliberately does
    not: over ssh the remote login shell finds its own tmux, and a Mac path
    would be nonsense there. Only this side has the profile-less-PATH problem.
    """
    argv = list(argv)
    if not target or target == "local":
        if argv and argv[0] == "tmux":
            argv[0] = tmux_binary(env)
        return argv
    return ["ssh", "-o", "BatchMode=yes", target] + argv


def unescape_option(value):
    """Undo tmux's own quoting of an option value.

    `show-options -p` renders each option on ONE line, escaping newline as
    `\n`, plus `\"` and `\\` -- which is exactly why the Mac can parse it
    with no help from the far side.
    """
    out = []
    index = 0
    simple = {"n": "\n", "t": "\t", "r": "\r", "\\": "\\", '"': '"'}
    while index < len(value):
        char = value[index]
        if char == "\\" and index + 1 < len(value):
            out.append(simple.get(value[index + 1], value[index + 1]))
            index += 2
        else:
            out.append(char)
            index += 1
    return "".join(out)


def parse_show_options(text):
    """`show-options -p` output -> [{id, key, to, text}], skipping anything else.

    A pane carries options that are none of our business, and a value may be
    quoted or bare depending on whether it needs escaping -- both are handled,
    and anything that does not parse is passed over rather than raised on.
    """
    import re
    pattern = re.compile(r"^(%s[0-9a-z]+)\s+(.*)$" % (re.escape(OPTION_PREFIX),))
    messages = []
    for line in (text or "").splitlines():
        match = pattern.match(line.rstrip())
        if not match:
            continue
        key, raw = match.group(1), match.group(2).strip()
        if len(raw) >= 2 and raw.startswith('"') and raw.endswith('"'):
            raw = unescape_option(raw[1:-1])
        parsed = parse_option_value(raw)
        if parsed:
            messages.append({"id": key[len(OPTION_PREFIX):], "key": key,
                             "to": parsed[0], "text": parsed[1]})
    return messages


# Every note this file keys on a participant name. ⚠️ **A list, not a pattern,
# and it has to grow when a new per-name note appears.** A note left behind
# after a leave is not cosmetic: `("held", name)` would resume a half-hour hold
# for a name that came back, and `("said", ...)` would swallow the first
# complaint about the new pane.
def _name_notes(name):
    return (("gone", name), ("menu", name), ("said", name), ("held", name),
            ("said", ("fetch", name)), ("said", ("read", name)))


def apply_leaves(left, rebound, seen, pending, resolved, needs_prime, notes,
                 say):
    """Forget everything pane-specific about names that left or moved.

    ⚠️ **A REBIND IS NOT A LEAVE, AND THE DIFFERENCE IS `pending`.** Both change
    which pane a name means, so both must forget `seen`, the notes, the
    delivered ids and the resolved binding. But a rebound participant has not
    gone anywhere -- it moved -- and its queued messages were already unset from
    the SENDER's pane, so they exist nowhere else. Dropping them would destroy
    mail for somebody still in the conversation.

    ⚠️ **Dropping `resolved[name]` is required, not tidiness.** `resolve_all`
    keeps `previous[name]` whenever resolution fails, and a rebind keeps the
    same NAME -- so a rebind to a label that does not resolve this tick would
    silently stay bound to the OLD row while `seen` had already been cleared,
    and the old pane's doorbell would read as new and be drained and delivered.
    """
    departing = set(left) | set(rebound)
    for name in sorted(departing):
        seen.pop(name, None)
        resolved.pop(name, None)
        needs_prime.discard(name)
        for key in _name_notes(name):
            notes.pop(key, None)
        done = notes.get("delivered")
        if done:
            for entry in [e for e in done if e[0] == name]:
                done.discard(entry)
    for name in sorted(rebound):
        # The new pane may hold anything, including a conversation this name
        # was never part of, so it is primed exactly like a fresh join.
        needs_prime.add(name)
    gone = set(left)
    if not gone:
        return
    dropped, kept = [], []
    for sender, message in pending:
        if message.get("to") in gone:
            # ⚠️ Named, not counted, and load-bearing rather than duplicate:
            # `try_deliver` HOLDS for a roster member now, so without this a
            # leaver's mail would be held for ever instead of dropped.
            dropped.append("#%s (%s -> %s)"
                           % (message.get("id"), sender, message.get("to")))
        else:
            kept.append((sender, message))
    pending[:] = kept
    if dropped:
        say("%s left, so %d queued message(s) will not be delivered: %s"
            % (", ".join(sorted(gone)), len(dropped), ", ".join(dropped)))


class RosterReader(object):
    """Re-reads a roster file, and reports the participants only when they move.

    ⚠️ **TWO PIECES OF STATE, AND THEY DIVERGE ON PURPOSE.** `self.raw` is the
    change GATE -- what the file said the last time we looked -- while
    `self.spec` is the last roster actually APPLIED. A read that parses badly
    advances the first and not the second, so the next valid edit is still
    diffed against what is really running rather than against a file that was
    refused. Collapsing them loses a join.

    ⚠️ **The gate compares BYTES rather than a stat key.** The file is a handful
    of lines, so reading it is cheaper than reasoning about whether
    `(mtime, size, inode)` can miss a rewrite -- and `os.stat` on a network
    mount is served from the attribute cache, which is what invariant 6 is
    about. Comparing what we read satisfies that by construction instead of by
    a comment nobody re-checks.

    ⚠️ **Every failure HOLDS.** Unreadable, missing, not UTF-8, malformed,
    empty: at runtime none of those is evidence that anybody left. A truncated
    read is exactly what a file being rewritten in place looks like for a
    millisecond, and it parses *cleanly* as a shorter roster -- so treating a
    short answer as authoritative would apply a leave nobody asked for. This is
    invariant 2 in its own words: a short or malformed read is no information
    this poll, never "gone".
    """

    def __init__(self, path, minimum=1):
        self.path = path
        self.minimum = minimum
        self.raw = None
        self.spec = None

    def poll(self, say, notes=None):
        """The new roster when it changed and parsed, else None (keep going)."""
        def hold(reason):
            _throttled(say, notes, ("roster",))(
                "%s -- keeping the %d participant(s) already running"
                % (reason, len(self.spec or {})))
            return None

        try:
            data = read_roster_file(self.path)
        except PeerError as error:
            return hold(str(error))
        if data == self.raw:
            return None
        self.raw = data
        try:
            spec = parse_roster_text(data, minimum=self.minimum)
        except PeerError as error:
            return hold(str(error))
        if notes is not None:
            notes.pop(("said", ("roster",)), None)
        self.spec = spec
        if len(spec) < 2:
            # Announced, not refused. One participant is a legal state for a
            # RUNNING relay -- somebody left, somebody else may yet join -- and
            # stopping would make a roster edit unable to remove anybody.
            _throttled(say, notes, ("thin",))(
                "the roster is down to %d participant(s): nothing can be "
                "delivered until another joins" % (len(spec),))
        elif notes is not None:
            notes.pop(("said", ("thin",)), None)
        return spec


def read_roster_file(path):
    """The roster file's raw BYTES, or a PeerError naming what stopped us.

    Bytes rather than text because the change gate compares them: decoding
    first would mean a file that is not UTF-8 could not even be compared, and
    the runtime path's whole job is to survive a bad read rather than raise
    through it.
    """
    try:
        with open(path, "rb") as handle:
            return handle.read()
    except (IOError, OSError) as exc:
        raise PeerError("cannot read the roster %s: %s" % (path, exc))


def parse_roster_text(data, minimum=2):
    """A roster file's participants. Same grammar as the positional form.

    Handing the words to `parse_participants` is the point: the file grammar
    cannot drift from the command-line one, because there is only one.

    ⚠️ **A `#` comment is a WHOLE LINE, never a trailing one.** `<row>` is a
    row-title substring and may contain anything a title does, `#` included, so
    stripping from the first `#` would silently truncate a legitimate spec.
    """
    if isinstance(data, bytes):
        try:
            data = data.decode("utf-8")
        except UnicodeDecodeError as exc:
            # ⚠️ A ValueError, not an OSError. A caller guarding this with a
            # bare `except IOError` lets it through, and at runtime that kills
            # the relay over a half-written file.
            raise PeerError("the roster is not UTF-8: %s" % (exc,))
    words = []
    for line in data.splitlines():
        line = line.strip()
        if line and not line.startswith("#"):
            words.extend(line.split())
    if not words:
        # ⚠️ Its own message, and not "0 participants". An empty read is what a
        # file being rewritten in place looks like for a millisecond, and the
        # runtime path has to treat it as NO INFORMATION rather than as
        # everybody leaving -- so the reason has to survive to the caller.
        raise PeerError("the roster is empty")
    return parse_participants(words, minimum=minimum)


# ⚠️ **A POSITIVE LIST, and it applies to the NAME only -- the text left of the
# `=`.** `<row>` is a row-title SUBSTRING and legitimately contains `/`, since
# the default `row_fields` renders `cwd` unshortened: `bob=/home/you/agbridge`
# is a working spec. Two reasons for the rule, and the second is why it is here
# rather than wherever it is first needed: a name has to survive being spliced
# into a value that crosses `ssh <host> tmux set ...`, where ssh flattens argv
# into a string for the remote login shell -- and **tightening a refusal later
# is the breaking direction**, so the time to draw it is before anyone has a
# name it would reject.
NAME_ALPHABET = frozenset(
    "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-")
NAME_RULE = "letters, digits, dot, underscore and hyphen"


def valid_participant_name(name):
    return bool(name) and not (set(name) - NAME_ALPHABET)


def parse_participants(words, minimum=2):
    """`name=<row>` or `name=<row>:<pane>` -> {name: (row, pane)}.

    An optional `@<ssh target>` says where that agent's tmux lives; `@local`
    means this machine. Without it the target comes from the row's own
    `agb pane --host`, which is a hostname and may need an ssh alias -- hence
    the override.

    ⚠️ An optional `:<tmux target>` after that names the tmux pane or session,
    and a **Mac-native participant needs it**. The pane id is otherwise read
    out of the row's `agb pane --pane` argv, and an agterm session that is not
    an agbridge row has no such argv -- its `foreground` is a shell. So
    `macside=<label>@local:<tmux session>` is the shape for an agent running in
    tmux on the Mac; tmux resolves a session name to its active pane.

    ⚠️ `<row>` should be a **label substring**, not a row id: `agb-refresh`
    re-mints every row and every id changes. `resolve` tries an exact id, then
    an id prefix, then a title substring, so a label keeps working across a
    refresh and an id does not.
    """
    people = {}
    for word in words:
        name, sep, where = word.partition("=")
        if not sep or not name or not where:
            raise PeerError("participants are name=<row> or name=<row>:<pane>, "
                            "not %r" % (word,))
        if not valid_participant_name(name):
            raise PeerError("%r is not a usable participant name: %s"
                            % (name, NAME_RULE))
        where, at, target = where.partition("@")
        target, _sep3, tmux_target = target.partition(":")
        row, sep2, pane = where.partition(":")
        pane = pane if sep2 else "left"
        if pane not in PANE_KINDS:
            raise PeerError("%s: pane must be one of %s"
                            % (name, "|".join(PANE_KINDS)))
        if not row:
            raise PeerError("%s: no row id" % (name,))
        if at and not target:
            raise PeerError("%s: @ with no ssh target" % (name,))
        if name in people:
            raise PeerError("%s named twice" % (name,))
        # `@local` means "this agent's tmux is on THIS machine" -- a Mac-side
        # participant, which needs no ssh and is otherwise identical. Absent,
        # the target is taken from the row's own `agb pane --host`.
        people[name] = (row, pane, target or None, tmux_target or None)
    if len(people) < minimum:
        # ⚠️ `minimum` exists because startup and runtime disagree on purpose.
        # A relay cannot START with one participant -- there is nobody to talk
        # to -- but a running one can legitimately drop to one when somebody
        # leaves, and refusing that would mean a roster edit could not remove a
        # participant without also stopping the relay.
        raise PeerError("a relay needs at least %d participant%s"
                        % (minimum, "" if minimum == 1 else "s"))
    return people


def pane_argv_field(foreground, flag):
    """Pull a value out of a row's `agb pane` command line.

    ⚠️ `foreground` is the argv the SESSION WAS LAUNCHED WITH -- measured, and
    it is why it cannot be used to tell an attached row from a detached one.
    For this it is exactly right: `agb pane --host <h> --pane <%N>` is how the
    relay learns where to ssh and which tmux pane to drain, straight from
    agterm, with no configuration of its own.
    """
    if not isinstance(foreground, (list, tuple)):
        return None
    for index, word in enumerate(foreground):
        if word == flag and index + 1 < len(foreground):
            return foreground[index + 1]
        if word.startswith(flag + "="):
            return word[len(flag) + 1:] or None
    return None


# ---------------------------------------------------------------------------
# the agtermctl seam -- one door, injectable, never raises on a tool failure
# ---------------------------------------------------------------------------

# ⚠️ **Every subprocess here is timed out, and it is not defensive coding.**
# MEASURED: `tmux display-message -t %N` blocked indefinitely while an agterm
# `dashboard` had a wedged view-only client attached -- `list-clients` answered
# and everything that has to NOTIFY a client did not. `agb-peer send` hung for
# two minutes with no output and nothing written. This repo's own rule
# ("always pass timeout= to communicate()") exists for exactly that, and this
# file broke it in two places.
SUBPROCESS_TIMEOUT = 30

TIMED_OUT = 124


def _spawn(argv, timeout):
    """(rc, stdout, stderr). Never blocks for ever; a timeout is an error, not
    a hang, so the caller can say which command stopped responding."""
    try:
        proc = subprocess.Popen(argv, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE)
    except OSError as exc:
        raise PeerError("%s: %s" % (argv[0], exc))
    try:
        out, err = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.communicate()
        return TIMED_OUT, "", ("%s did not answer within %ss -- a wedged tmux "
                               "or agterm client will do this"
                               % (argv[0], timeout))
    return (proc.returncode, out.decode("utf-8", "replace"),
            err.decode("utf-8", "replace"))


def run_local(argv, timeout=SUBPROCESS_TIMEOUT):
    """(rc, stdout, stderr) for a command on THIS machine -- `send` runs tmux,
    not agtermctl, and must work on a farm host where agterm does not exist."""
    return _spawn(argv, timeout)


def run_ctl(argv, timeout=SUBPROCESS_TIMEOUT):
    """(rc, stdout, stderr) for an agtermctl call."""
    return _spawn([CTL] + list(argv), timeout)


class Ctl(object):
    """Thin typed wrapper so the flow below reads as intent, not as argv."""

    def __init__(self, run=None, sleep=None):
        self.run = run or run_ctl
        self.sleep = sleep or time.sleep

    def tree(self):
        rc, out, err = self.run(["tree", "--json"])
        if rc != 0:
            raise PeerError("tree failed: %s" % (err.strip() or rc,))
        try:
            return json.loads(out)
        except ValueError:
            raise PeerError("tree returned something that is not JSON")

    def text(self, target, pane, lines=None, whole=False):
        """The pane's VISIBLE SCREEN -- no `--lines`, no `--all`.

        ⚠️ **Reading a tail hid Codex completely.** MEASURED: Claude Code
        anchors its composer to the BOTTOM of the pane, Codex draws from the
        TOP and leaves the bottom blank. So `--lines 40` finds Claude every
        time and can miss Codex's composer entirely -- `classify` answered
        `unknown` for a perfectly healthy Codex row, and the relay would never
        have delivered to it. The doorbell kept working throughout, because
        tmux's status bar is always the last line.

        ⚠️ And the tail bought nothing anyway: the alternate screen has NO
        scrollback, measured -- `--all`, `--lines 400` and the bare default all
        returned exactly the same 60 lines. `lines` and `whole` are still
        accepted so the call sites need not all change at once, and are
        deliberately ignored; the flags they used to produce are what agterm
        rejects when combined.
        """
        rc, out, err = self.run(["session", "text", "--target", target,
                                 "--pane", pane])
        if rc != 0:
            return None, (err.strip() or "exit %s" % (rc,))
        return out, None

    def cursor(self, surface):
        rc, out, err = self.run(["surface", "cursor", "--target", surface])
        if rc != 0:
            return None, (err.strip() or "exit %s" % (rc,))
        try:
            return int(out.strip()), None
        except ValueError:
            return None, "cursor returned %r" % (out.strip(),)

    def dashboard(self, members):
        """(ok, reason). Best-effort like every other call here: a grid that
        will not open is a cosmetic failure and must never stop the relay."""
        rc, _out, err = self.run(["dashboard"] + list(members))
        return (rc == 0), ((err or "").strip() or "exit %s" % (rc,))

    def type(self, target, pane, text):
        rc, out, err = self.run(["session", "type", text,
                                 "--target", target, "--pane", pane])
        if rc != 0:
            raise PeerError("session type failed: %s" % (err.strip() or rc,))
        return True


# ---------------------------------------------------------------------------
# the flow
# ---------------------------------------------------------------------------

def resolve(ctl, want):
    """The peer session, or a PeerError naming what to do about it."""
    sessions = sessions_of(ctl.tree())
    if not sessions:
        raise PeerError("agterm reports no sessions at all", 2)
    matches = match_sessions(sessions, want)
    if not matches:
        raise PeerError("no row matches %r -- `agb-peer --list` shows them"
                        % (want,), 2)
    if len(matches) > 1:
        names = ", ".join(str(s.get("name") or s.get("id")) for s in matches[:5])
        raise PeerError("%r matches %d rows (%s) -- use a longer prefix or the "
                        "row id" % (want, len(matches), names), 2)
    return matches[0]


def ensure_composer(ctl, session, pane, arm, lines, say):
    """Get the pane into composer mode, arming it if that is allowed.

    Arming is a real side effect on somebody's row -- it attaches it -- so it
    is reported rather than done quietly, and `--no-arm` refuses instead. The
    poll after it exists because the attach is an `ssh` and a `tmux attach`, so
    the composer is not there on the next syscall.
    """
    target = session["id"]
    text, err = ctl.text(target, pane, lines)
    if err:
        raise PeerError("cannot read the peer's pane: %s" % (err,))
    mode = classify(text)
    if mode == MODE_COMPOSER:
        return text
    if mode == MODE_UNKNOWN:
        raise PeerError(
            "the peer's pane shows neither `agb pane`'s menu nor a composer, "
            "so there is no safe place to type. Look at it first.", 3)
    # menu mode
    if not arm:
        raise PeerError("the peer's row is not attached, and --no-arm was "
                        "given. Press [enter] on it, or drop --no-arm.", 3)
    say("peer is at the `agb pane` menu -- attaching it with a bare newline")
    ctl.type(target, pane, "\n")
    for _ in range(10):
        ctl.sleep(1)
        text, err = ctl.text(target, pane, lines)
        if err:
            continue
        if classify(text) == MODE_COMPOSER:
            return text
    raise PeerError("the row did not reach a composer after attaching -- it may "
                    "be a shell, or the ssh may be slow or failing", 3)


def wait_ready(ctl, session, pane, retries, interval, force, lines, say):
    """Block until the peer's status and composer both say it is safe to type.

    Two gates, and they answer different questions. `status` is about the
    AGENT (is it mid-turn, is it on a permission prompt) and comes from its own
    hooks. The cursor column is about the COMPOSER (has a human left a draft),
    and is the one that fired on the first row this was ever pointed at.
    """
    target = session["id"]
    surface = surface_of(session, pane)
    if not surface:
        raise PeerError("that row has no %r pane" % (pane,), 2)
    attempt = 0
    while True:
        reason = None if force else peer_busy(session.get("status"))
        if reason is None:
            column, err = ctl.cursor(surface)
            if err:
                raise PeerError("cannot read the composer's cursor: %s" % (err,))
            if column == EMPTY_COLUMN:
                return
            reason = ("the composer is not empty (cursor at column %s, empty "
                      "is %s) -- somebody has a draft in it"
                      % (column, EMPTY_COLUMN))
        attempt += 1
        if attempt > retries:
            # ⚠️ `retries=0` is the RELAY's setting -- it must not block, so it
            # gives up immediately and tries again next tick. "after 0 checks"
            # was the direct command's phrasing leaking into that path and
            # reading as nonsense.
            waited = (", still, after %d checks" % (retries,)) if retries else ""
            raise PeerError("%s%s. Nothing was typed." % (reason, waited), 3)
        say("waiting: %s (%d/%d)" % (reason, attempt, retries))
        ctl.sleep(interval)
        # Re-read the session: `status` is a snapshot and this is the only
        # thing that can change our mind about it.
        for fresh in sessions_of(ctl.tree()):
            if fresh.get("id") == target:
                session = fresh
                break


def deliver(ctl, session, pane, body, send, lines, say):
    """Type, verify it rendered, and only then press Return.

    The verification is the cookbook's, and its value is not that typing might
    fail -- it is that a permission dialog can appear between the cursor check
    and the keystrokes, swallowing them. Seeing our own text on the screen is
    what rules that out, and it is why the Return is a SECOND call.
    """
    target = session["id"]
    # Read BEFORE typing, so a paste placeholder left over from an earlier
    # message cannot be mistaken for this one arriving. A count that went up is
    # evidence; a placeholder merely being present is not.
    before, _err = ctl.text(target, pane, lines)
    ctl.type(target, pane, body)
    ctl.sleep(1)
    text, err = ctl.text(target, pane, lines)
    if err:
        raise PeerError("typed, but the pane could not be read back, so it was "
                        "NOT sent: %s" % (err,), 4)
    # Compare on the tail of the body, with ALL WHITESPACE STRIPPED from both
    # sides.
    #
    # ⚠️ Two different things defeat a naive match, and fixing only the first
    # left every wrapped message needing a human to press Enter:
    #
    #   * **pasted** -- Claude Code collapses a long, fast injection into
    #     `[Pasted text #1]` and the body is not on screen at all;
    #   * **wrapped** -- the body IS on screen, but agterm has broken it across
    #     lines, so a 40-character probe straddles the wrap and matches
    #     nothing. Stripping whitespace makes the comparison wrap-immune, which
    #     is the same reasoning the old line protocol used and this check did
    #     not inherit.
    #
    # Stripping can in principle join two unrelated fragments into a false
    # match; over a 40-character probe that is not a risk worth a more
    # complicated comparison.
    probe = body[-40:] if len(body) > 40 else body
    flat_probe = "".join(probe.split())
    flat_text = "".join((text or "").split())
    pasted = text.count(PASTE_MARK) > (before or "").count(PASTE_MARK)
    if flat_probe not in flat_text and not pasted:
        raise PeerError("typed, but %r never appeared in the peer's pane, so it "
                        "was NOT sent. Look at that row before retrying."
                        % (probe,), 4)
    if not send:
        say("typed, not sent (--no-send). It is sitting in the composer.")
        return
    ctl.type(target, pane, "\n")
    say("delivered")


def cmd_list(ctl, pane, lines, out):
    """Candidate rows, with the two things that decide whether one is usable.

    ⚠️ **It must read the same window the flow does**, which is why `lines` is
    threaded here rather than a cheap constant. It was 6, measured live: a
    `blocked` agent's permission dialog pushes the composer glyph off a 6-line
    window, so the listing said `unknown` for a row the flow reads as
    `composer`. A listing that disagrees with the tool it is a listing FOR is
    worse than no listing, and it disagreed in the direction that looks safe.
    """
    sessions = sessions_of(ctl.tree())
    if not sessions:
        out.write("no sessions\n")
        return 0
    out.write("%-38s %-10s %-9s %s\n" % ("ID", "STATUS", "MODE", "NAME"))
    for session in sessions:
        text, err = ctl.text(session["id"], pane, lines)
        mode = "?" if err else classify(text)
        out.write("%-38s %-10s %-9s %s\n"
                  % (session.get("id"), (session.get("status") or "-")[:10],
                     mode, session.get("name") or ""))
    return 0


def cmd_send(recipient, text, run, out, now=None, env=None):
    """Stash the message in a tmux option and ring the doorbell.

    ⚠️ **Nothing is printed to the terminal**, and that is the whole lesson of
    the first design: Claude Code does not render tool output onto the pane, so
    a printed message is invisible to everything. tmux options are not a
    terminal -- nothing wraps, truncates or collapses them.
    """
    env = os.environ if env is None else env
    pane = env.get("TMUX_PANE")
    if not pane:
        raise PeerError("send must run inside tmux: $TMUX_PANE is not set. "
                        "Start the agent with `agb-claude <name>`, or inside "
                        "`tmux new -A -s <name> <the agent>`.")
    flat = " ".join((text or "").split())
    if not flat:
        raise PeerError("refusing to send an empty message")
    if flat.lower() in PANE_WORDS:
        raise PeerError("refusing to send %r: `agb pane` acts on that word, "
                        "and if the mode read were wrong it would close or "
                        "split the row rather than reach the agent" % (flat,))
    ident = message_id(now)
    exe = tmux_binary(env)

    def tmux(args):
        rc, _out, err = run([exe] + args)
        if rc != 0:
            raise PeerError("%s %s failed: %s" % (exe, args[0],
                                                  err.strip() or rc))

    rc, base, err = run([exe, "show-options", "-pqv", "-t", pane,
                         OPTION_BASE])
    if rc != 0 and not socket_is_missing(env):
        raise PeerError("cannot read tmux options for %s: %s"
                        % (pane, err.strip() or rc))
    if rc != 0:
        # ⚠️ **The fallback, and it is NOT a silent one.** tmux being
        # unreachable is the normal state for an agent on a compute pool: it
        # inherited `$TMUX_PANE` through the job submission and the socket is
        # on another machine's `/tmp`. The message goes to a file on NFS and
        # the doorbell is echoed to this agent's own screen, which is the other
        # thing that crosses. Both the path and the reason are printed, because
        # a fallback nobody is told about is how a message quietly stops
        # arriving.
        path = write_chat_file(chat_path(ident, env=env), recipient, flat)
        out.write("agb-peer: tmux is unreachable (%s)\n"
                  % (err.strip() or rc,))
        out.write("agb-peer: wrote %s\n" % (path,))
        out.write("%s\n" % (DOORBELL % (ident,),))
        out.write("agb-peer: queued for %s as #%s (via file)\n"
                  % (recipient, ident))
        return 0
    base = base.strip()
    if not base:
        rc, base, err = run([exe, "display-message", "-p", "-t", pane,
                             "#{window_name}"])
        # ⚠️ **A failed read is not a value.** This used to fall back to a
        # hardcoded name and then STORE it -- so one transient tmux stall
        # (a wedged agterm client will do it) permanently renamed the pane's
        # base to a guess. Converting "could not read" into data is the exact
        # failure this project writes invariants against; a send that cannot
        # read tmux has no business writing to it either.
        if rc != 0:
            raise PeerError("cannot read the window name for %s: %s"
                            % (pane, err.strip() or rc))
        base = base.strip() or "agent"
        # Remembered so a second send renders `<original> [peer #id]` rather
        # than `<original> [peer #id1] [peer #id2]`, for ever.
        tmux(["set", "-p", "-t", pane, OPTION_BASE, base])
        # ⚠️ MEASURED: tmux's global default is `automatic-rename on`. The
        # doorbell survives today only because an explicit `rename-window`
        # turns it off as a SIDE EFFECT -- an undocumented dependency, and if
        # anything ever re-enables it tmux wipes the doorbell and the relay
        # goes deaf with no error anywhere. Pinned explicitly instead.
        tmux(["set", "-w", "-t", pane, "automatic-rename", "off"])
    tmux(["set", "-p", "-t", pane, OPTION_PREFIX + ident,
          option_value(recipient, flat)])
    tmux(["rename-window", "-t", pane, doorbell_name(base, ident)])
    out.write("agb-peer: queued for %s as #%s\n" % (recipient, ident))
    return 0


# The tmux target that means "this participant's messages are files on NFS,
# not tmux options". A word rather than a flag, because it goes exactly where a
# tmux target would and answers the same question: where do I look.
NFS_TARGET = "nfs"

# Where the sender puts them, on the FAR side. An absolute path, because the
# statedir is not under `$HOME` here and `~` would expand to the wrong place:
# measured, the two routinely differ.
DEFAULT_CHAT_DIR = None


def file_argv(chat_dir, ident):
    """`cat <chat dir>/<id>.msg`. Pure argv, no shell.

    ⚠️ Same reason as `list_argv`: `ssh <host> <cmd>` hands the command to the
    remote LOGIN shell, which on a farm host is often tcsh, and a POSIX script
    quoted through it is a losing game. The doorbell carries the id, so exactly
    one file is named and no globbing or listing is needed.
    """
    return ["cat", "%s/%s.msg" % (chat_dir.rstrip("/"), ident)]


def unlink_argv(chat_dir, ident):
    return ["rm", "-f", "%s/%s.msg" % (chat_dir.rstrip("/"), ident)]


# What a drain attempt learned. ⚠️ These are about the FETCH, not about what it
# found: FETCH_OK with no messages means "the pane was read and nothing was
# pending", which is a fact, while FETCH_FAILED means we still know nothing.
# Priming a joiner turns on exactly that distinction.
FETCH_OK = "ok"
FETCH_FAILED = "failed"


def _drained(outcome, result, messages=None):
    """Record the fetch outcome, if the caller asked for it, and return.

    An out-parameter rather than a second return value: seven existing tests
    assert on `drain`'s return, and a tuple would break all of them for a
    signal only the prime path reads.
    """
    if outcome is not None:
        outcome["fetch"] = result
    return [] if messages is None else messages


def drain_files(fetch, name, target, ident, chat_dir, say, outcome=None):
    """One message, named by the doorbell, read over ssh to a REACHABLE host.

    Never to the machine the agent is on -- that is the whole point. The file
    is on NFS, so any host mounting it will do, and the container that carries
    the row is one.
    """
    if not chat_dir:
        say("%s: no --chat-dir given, so a file-transport participant cannot "
            "be read" % (name,))
        return _drained(outcome, FETCH_FAILED)
    if not ident:
        say("%s: no message id in the doorbell" % (name,))
        return _drained(outcome, FETCH_FAILED)
    rc, out, err = fetch(ssh_argv(target, file_argv(chat_dir, ident)))
    if rc != 0:
        say("%s: cannot read %s/%s.msg: %s"
            % (name, chat_dir, ident, (err or "").strip() or rc))
        return _drained(outcome, FETCH_FAILED)
    parsed = parse_option_value(out)
    if not parsed:
        say("%s: %s.msg is not a message" % (name, ident))
        return _drained(outcome, FETCH_FAILED)
    rc, _out, err = fetch(ssh_argv(target, unlink_argv(chat_dir, ident)))
    if rc != 0:
        say("%s: could not remove %s.msg (%s) -- it may be fetched again"
            % (name, ident, (err or "").strip() or rc))
    return _drained(outcome, FETCH_OK,
                    [{"id": ident, "key": ident,
                      "to": parsed[0], "text": parsed[1]}])


def drain(fetch, name, target, pane, say, ident=None,
          chat_dir=None, outcome=None):
    """Everything pending in one participant's tmux, or [] and a reason said.

    ⚠️ `fetch` defaults to the real runner when it is None. It did not, and the
    first live relay died with `'NoneType' object is not callable` -- every
    test injected a fake, so the PRODUCTION default was the one path nothing
    exercised. Same shape as `--all`/`--lines`: a seam only the tests filled in.

    ⚠️ **`[]` MEANS TWO DIFFERENT THINGS, AND THE CALLER HAS TO TELL THEM
    APART.** "The fetch failed" and "the fetch worked and nothing was pending"
    are the same return value, and priming a joiner must treat them oppositely:
    a failure means we still do not know what is on that pane, while an empty
    success means there is nothing stale to discard. `outcome` is an
    out-parameter rather than a second return value because seven existing
    tests assert on the return, and widening it would break every one.
    """
    fetch = fetch or run_local
    if not pane:
        say("%s: no tmux pane recorded for that row -- cannot fetch" % (name,))
        return _drained(outcome, FETCH_FAILED)
    if pane == NFS_TARGET:
        return drain_files(fetch, name, target, ident, chat_dir, say, outcome)
    rc, out, err = fetch(ssh_argv(target, list_argv(pane)))
    if rc != 0:
        say("%s: fetch failed: %s" % (name, (err or "").strip() or rc))
        return _drained(outcome, FETCH_FAILED)
    messages = parse_show_options(out)
    for message in messages:
        rc, _out, err = fetch(ssh_argv(target, unset_argv(pane, message["key"])))
        if rc != 0:
            # Not fatal, and not silent: the option survives, so the next ring
            # fetches it again. The relay's delivered-set is what stops that
            # becoming a second delivery.
            say("%s: could not clear %s (%s) -- it may be fetched again"
                % (name, message["key"], (err or "").strip() or rc))
    return _drained(outcome, FETCH_OK, messages)


# How many TICKS a message may wait for a roster participant whose row has not
# appeared yet. ⚠️ **A judgement, not a measurement**: at the default 8 s
# interval this is about half an hour, picked to outlast a scheduler queue and a
# container start. Holding for ever is defensible too -- the messages are
# addressed to a real participant and nothing else consumes them -- but a name
# that never resolves would then accumulate mail for the life of the relay with
# only the ladder below to say so.
HOLD_TICKS_MAX = 225


def _hold_unresolved(recipient, notes, say):
    """False (hold) while a roster participant's row has not appeared yet.

    ⚠️ **Counted per TICK, not per message.** `try_deliver` runs once per
    pending message, so three messages for one absent name would otherwise age
    the hold three times as fast and make the bound depend on queue depth.
    `relay_tick` stamps `notes["tick"]`; the count moves only when that does.

    With no `notes` there is nowhere to count, so the hold is unbounded and
    unthrottled -- the same way the `("said", ...)` throttle already degrades.
    Only the relay passes `notes`, and only the relay holds anything.
    """
    if notes is None:
        say("%s has no row yet -- holding the message" % (recipient,))
        return False
    tick = notes.get("tick")
    entry = notes.get(("held", recipient))
    if entry is None:
        count, fresh = 1, True
    else:
        count, seen_at = entry
        fresh = seen_at != tick
        count = count + 1 if fresh else count
    if fresh:
        notes[("held", recipient)] = (count, tick)
    if count > HOLD_TICKS_MAX:
        # ⚠️ The note is NOT popped here. Every other message queued for this
        # name must reach the same verdict on this tick, and a popped note
        # would restart the count at 1 for the second one and hold it.
        if fresh:
            say("giving up on %r after %d ticks with no row -- dropping its "
                "queued messages. It is in the roster, so nothing else will."
                % (recipient, HOLD_TICKS_MAX))
        return True
    if fresh and (count == 1 or count == 3 or count % 30 == 0):
        say("%s is in the roster but has no row yet -- holding (%d/%d)"
            % (recipient, count, HOLD_TICKS_MAX))
    return False


def try_deliver(ctl, sessions, people, sender, message, lines, say,
                notes=None, members=None):
    """One delivery attempt. True = done with it, False = try again next tick.

    ⚠️ **A relay must not block.** The direct command waits out a busy peer for
    forty seconds; here that would stall every other conversation, so the gates
    run with no retries and a refusal simply leaves the message pending.

    ⚠️ **Exit 4 is dropped, not retried.** It means the text WAS typed and could
    not be verified -- typing it again would leave two copies in the composer,
    which is a worse outcome than one lost message and a loud line.

    ⚠️ **MEMBERSHIP IS A QUESTION ABOUT THE ROSTER, NOT ABOUT WHAT RESOLVED.**
    `people` is the RESOLVED map -- names whose row is in agterm's tree right
    now -- and using it to answer "is this a participant?" silently discarded
    every message addressed to a participant whose agent had not started yet.
    With a fixed participant list that is masked, because you start the relay
    once the agents exist; with a roster you list three agents while two are
    up, and the third one's mail is thrown away with the sender seeing
    `queued for <name>` and exit 0.

    So `members` is the roster, and the two answers are different questions:
    not in the roster is a DROP (a typo, or a name nobody ever added), while
    in the roster but unresolved is a HOLD (a row that has not appeared yet).
    `members=None` means "use `people`", which keeps every existing caller --
    and the direct one-shot path, which has no roster at all -- unchanged.
    """
    recipient = message.get("to")
    members = people if members is None else members
    if recipient not in members:
        say("dropping a message for %r: not a participant" % (recipient,))
        return True
    if recipient not in people:
        return _hold_unresolved(recipient, notes, say)
    if notes is not None:
        notes.pop(("held", recipient), None)
    if recipient == sender:
        say("dropping a message %r addressed to itself" % (sender,))
        return True
    row, pane, _target, _tmux = people[recipient]
    session = sessions.get(row)
    if session is None:
        say("%s's row is gone from the tree -- holding the message" % (recipient,))
        return False
    # The sender is the pane the marker was FOUND in, never the `from` field.
    # A pane is a place, and an agent cannot print into another agent's pane,
    # so the place is the only part of this that cannot be misstated.
    body = compose(message.get("text"), sender)
    try:
        ensure_composer(ctl, session, pane, True, lines, say)
        wait_ready(ctl, session, pane, 0, 0, False, lines, say)
        deliver(ctl, session, pane, body, True, lines, say)
    except PeerError as error:
        # ⚠️ Said ONCE per unchanged reason. A relay retries a held message
        # every tick, and a peer whose composer has a draft in it stays that
        # way until a human looks -- which produced the same line every eight
        # seconds for as long as nobody did. Repeating it adds no information
        # and buries everything else the relay says.
        line = "%s -> %s: %s" % (sender, recipient, error)
        if notes is None or notes.get(("said", recipient)) != line:
            say(line)
            if notes is not None:
                notes[("said", recipient)] = line
        return error.code == 4
    if notes is not None:
        notes.pop(("said", recipient), None)
    say("%s -> %s: delivered" % (sender, recipient))
    return True


# What one participant's scan learned, and the five ways it can end without
# ever reaching the doorbell. ⚠️ **The distinction that matters is "we did not
# read the pane" versus "we read it and there was nothing announced".** Priming
# a joiner turns on exactly that: the first leaves the pane still suspect, the
# second proves there is nothing stale on it. `SCAN_DETACHED` is the one that
# looks like the second and is the first -- a detached row's doorbell is not
# VISIBLE, which is not the same as ABSENT, and every row `agb-refresh`
# re-mints comes back detached.
SCAN_NO_ROW = "no-row"
SCAN_UNREADABLE = "unreadable"
SCAN_DETACHED = "detached"
SCAN_NO_DOORBELL = "no-doorbell"
SCAN_CAUGHT_UP = "caught-up"
SCAN_FETCHED = "fetched"
SCAN_FETCH_FAILED = "fetch-failed"

# The outcomes that prove the pane was read and nothing is waiting on it.
SCAN_PANE_IS_CLEAN = (SCAN_FETCHED, SCAN_NO_DOORBELL)


def scan_participant(ctl, sessions, name, binding, seen, lines, say,
                     fetch=None, notes=None, chat_dir=None):
    """Read one participant's pane and drain it. -> (outcome, messages).

    ⚠️ **This owns `seen`.** It reads it for the caught-up guard and writes it
    only on a successful drain, so a caller cannot mark a participant read
    without having read it -- the bug that cost every message a failed fetch
    touched. Priming calls this too, which is why priming leaves a participant
    caught up rather than needing to say so separately.

    The caller decides what the messages MEAN (delivered, or discarded as a
    backlog); this only decides what is there.
    """
    notes = {} if notes is None else notes
    row, pane, target, tmux_target = binding
    session = sessions.get(row)
    if session is None:
        # ⚠️ Not silent. A row is briefly absent while `agb-refresh`
        # re-mints it, which is why this is not reported on the first tick --
        # but if the bridge never comes back, a relay that said nothing would
        # leave "gone" looking exactly like "quiet".
        gone = notes.get(("gone", name), 0) + 1
        notes[("gone", name)] = gone
        if gone == 3 or gone % 30 == 0:
            say("%s: no row matches that label, %d ticks running. If this "
                "is not a refresh in progress, check the bridge."
                % (name, gone))
        return SCAN_NO_ROW, []
    notes.pop(("gone", name), None)
    text, err = ctl.text(row, pane, lines)
    if err:
        # Throttled for the same reason as the fetch below: this fires every
        # tick for as long as the read keeps failing, and it always did --
        # moving the `seen` write merely put a second unthrottled path beside
        # it and made the shape obvious.
        _throttled(say, notes, ("read", name))(
            "cannot read %s: %s" % (name, err))
        return SCAN_UNREADABLE, []
    notes.pop(("said", ("read", name)), None)
    if classify(text) == MODE_MENU:
        # ⚠️ **Armed, not merely reported.** Every row `agb-refresh` re-mints
        # comes back DETACHED, showing `agb pane`'s menu -- and a menu is not a
        # tmux screen, so the status bar is absent and the doorbell cannot be
        # seen. Its tmux is fine and its doorbell is still set; the relay just
        # cannot look. Complaining and waiting would make every refresh a
        # manual re-attach of every participant. The bare newline is the safe
        # arming primitive: `agb pane` strips its input and "" matches none of
        # its three word sets, so it falls through to the attach and cannot hit
        # the branch that closes the row.
        tries = notes.get(("menu", name), 0)
        notes[("menu", name)] = tries + 1
        if tries % 10 == 0:
            say("%s is detached -- attaching it so its doorbell can be seen"
                % (name,))
            ctl.type(row, pane, "\n")
        return SCAN_DETACHED, []
    notes.pop(("menu", name), None)
    ident = read_doorbell(text)
    if not ident:
        return SCAN_NO_DOORBELL, []
    if seen.get(name) == ident:
        return SCAN_CAUGHT_UP, []
    tmux_pane = tmux_target or pane_argv_field(session.get("foreground"),
                                               "--pane")
    host = target or pane_argv_field(session.get("foreground"), "--host")
    # ⚠️ **`seen` IS WRITTEN AFTER THE DRAIN, NOT BEFORE IT.** It used to be
    # written above the fetch -- so a fetch that FAILED left the participant
    # marked caught-up having read nothing, the guard above short-circuited
    # every later tick, and those messages were lost until the agent happened
    # to send again and moved the doorbell. Recording what we have read only
    # once we have actually read it makes the retry automatic; the cost is that
    # a persistent failure complains every tick, which is `_throttled`'s job.
    outcome = {}
    messages = drain(fetch, name, host, tmux_pane,
                     _throttled(say, notes, ("fetch", name)), ident,
                     chat_dir, outcome)
    if outcome.get("fetch") != FETCH_OK:
        return SCAN_FETCH_FAILED, []
    seen[name] = ident
    notes.pop(("said", ("fetch", name)), None)
    return SCAN_FETCHED, messages


def _throttled(say, notes, key):
    """A `say` that repeats itself only when the message changes.

    ⚠️ The same discipline as `try_deliver`'s reason line, and needed here for
    the same reason moving the `seen` write created: a failure that is retried
    every tick would otherwise print the identical line every tick, for as long
    as nobody looks, and bury everything else the relay says. `key` is a tuple
    so these cannot collide with `try_deliver`'s `("said", <recipient>)`, which
    is keyed on a bare participant name.
    """
    def once(message):
        if notes is None:
            say(message)
        elif notes.get(("said", key)) != message:
            notes[("said", key)] = message
            say(message)
    return once


def relay_tick(ctl, people, seen, pending, lines, say, fetch=None,
               deliver_new=True, notes=None, chat_dir=None, members=None):
    """One pass: watch every doorbell, drain what rang, then drain the queue.

    `deliver_new=False` is the PRIMING pass. It still FETCHES -- and discards.
    Leaving stale options in tmux would mean the first real message's drain
    swept up an hour-old conversation and delivered it as if it were new; the
    honest move is to clear them and say how many.
    """
    notes = {} if notes is None else notes
    # Stamped once per tick so `_hold_unresolved` can age a hold by ticks
    # rather than by messages -- see its docstring.
    notes["tick"] = notes.get("tick", 0) + 1
    sessions = {}
    for session in sessions_of(ctl.tree()):
        sessions[session["id"]] = session
    discarded = []
    for name in sorted(people):
        result, messages = scan_participant(
            ctl, sessions, name, people[name], seen, lines, say, fetch,
            notes, chat_dir)
        if result != SCAN_FETCHED:
            continue
        done = notes.setdefault("delivered", set())
        for message in messages:
            if (name, message["id"]) in done:
                # An option the far side would not let us unset comes back on
                # the next ring. Fetching it twice is harmless; DELIVERING it
                # twice would put the same sentence in a composer again.
                continue
            done.add((name, message["id"]))
            if deliver_new:
                pending.append((name, message))
            else:
                # ⚠️ Named, not counted. "discarded 1 message(s)" reads as
                # housekeeping; an operator who queued something a moment
                # earlier needs to see that THIS is what was thrown away.
                discarded.append("#%s (%s -> %s)"
                                 % (message["id"], name, message["to"]))
    if not deliver_new and discarded:
        say("discarded %d message(s) queued before this relay started: %s. "
            "Send AFTER the relay is up, or it primes them away."
            % (len(discarded), ", ".join(discarded)))
    held = []
    for sender, message in pending:
        if not try_deliver(ctl, sessions, people, sender, message, lines, say,
                           notes, members):
            held.append((sender, message))
    pending[:] = held
    return len(pending)


def resolve_all(ctl, spec, say, previous=None):
    """{name: (row id, pane, target)}, re-resolved from LABELS every tick.

    ⚠️ This is the `agb-refresh` defence. A refresh closes and re-mints every
    row, so every id changes -- observed twice in one afternoon. A relay that
    resolved once would go permanently deaf, and its only symptom would be
    silence. Resolving by label costs one `tree` call the tick already makes.
    """
    previous = previous or {}
    resolved = {}
    for name in sorted(spec):
        row, pane, target, tmux_target = spec[name]
        try:
            resolved[name] = (resolve(ctl, row)["id"], pane, target, tmux_target)
        except PeerError as error:
            if name in previous:
                # Keep the old binding rather than dropping a participant on a
                # transient: a row is briefly absent while it is re-minted.
                resolved[name] = previous[name]
            else:
                say("%s: %s" % (name, error))
    return resolved


def cmd_relay(ctl, words, lines, interval, once, out, dashboard=False,
              fetch=None, chat_dir=None, roster=None):
    """Watch every participant's doorbell and carry messages between them."""
    if roster and words:
        raise PeerError("give participants OR --roster, not both: with two "
                        "sources of truth there is no answer to 'who is in "
                        "this conversation' that does not depend on which one "
                        "you read")
    # ⚠️ **Startup REFUSES where the running relay would hold.** Every reason a
    # runtime re-read holds -- unreadable, missing, empty, malformed, too few --
    # is a refusal here, because holding means keeping the roster you already
    # had and at startup there is none. It is also the only place the
    # two-participant minimum can be enforced: a relay may DROP to one when
    # somebody leaves, but it cannot begin with nobody to talk to.
    spec = (parse_roster_text(read_roster_file(roster)) if roster
            else parse_participants(words))

    def say(message):
        out.write("agb-peer: %s\n" % (message,))
        out.flush()

    seen, pending, resolved, notes = {}, [], {}, {}
    priming = True
    while True:
        fresh = resolve_all(ctl, spec, say, resolved)
        if fresh != resolved:
            if resolved:
                say("row ids moved -- re-resolved (an `agb-refresh` re-mints "
                    "every row, and the old ids are dead)")
            resolved = fresh
            for name in sorted(resolved):
                row, pane, target, tmux_target = resolved[name]
                say("%-12s %s:%s%s%s"
                    % (name, row[:8], pane,
                       "  via " + target if target else "",
                       "  tmux " + tmux_target if tmux_target else ""))
            if dashboard and len(resolved) > 1:
                # Re-opened on every move for the same reason the ids are
                # re-resolved: a grid built on dead ids shows dead cells.
                grid_cells = ["%s:%s" % (resolved[n][0], resolved[n][1])
                              for n in sorted(resolved)]
                ok, why = ctl.dashboard(grid_cells)
                say("dashboard: %s" % ("open" if ok else why))
        # ⚠️ `spec`, not `resolved`: membership is what the operator asked for,
        # and a participant whose row has not appeared yet must have its mail
        # HELD rather than dropped. See try_deliver.
        relay_tick(ctl, resolved, seen, pending, lines, say, fetch,
                   deliver_new=not priming, notes=notes, chat_dir=chat_dir,
                   members=set(spec))
        if priming:
            say("primed on %d doorbell(s); relaying every %ss -- Ctrl-C to stop"
                % (len(seen), interval))
            priming = False
        if once:
            return 0
        ctl.sleep(interval)


def main(argv, out=None, ctl=None):
    out = out or sys.stdout
    # Two leading verbs, and everything else is the direct one-shot form. A
    # verb rather than a flag because `send` needs no agtermctl at all -- it
    # prints a line -- while the rest of this file is nothing but agtermctl.
    if argv and argv[0] == "send":
        opts = parse_args(argv[1:])
        message = opts.get("message")
        if opts.get("stdin"):
            if message:
                raise PeerError("give a message or --stdin, not both")
            message = sys.stdin.read()
        if not (message or "").strip():
            raise PeerError("refusing to send an empty message")
        recipient = opts.get("to")
        if not recipient:
            raise PeerError("send: --to <name> is required")
        if opts.get("from"):
            # Refused rather than ignored. There is no `from` field on the
            # wire: the relay signs a message with the participant name of the
            # PANE it was found in, which an agent cannot misstate, and a
            # `--from` here would look like it changed that and would not.
            raise PeerError("send takes no --from: a message is signed with "
                            "the pane it was sent from, which is the only "
                            "part of it that cannot be misstated")
        return cmd_send(recipient, message, run_local, out)
    if argv and argv[0] == "relay":
        opts = parse_args(argv[1:])
        ctl = ctl or Ctl()
        return cmd_relay(ctl, (opts.get("message") or "").split(),
                         positive_int(opts["lines"], "--lines"),
                         positive_int(opts["interval"], "--interval"),
                         bool(opts.get("once")), out,
                         dashboard=bool(opts.get("dashboard")),
                         chat_dir=opts.get("chat_dir"),
                         roster=opts.get("roster"))
    opts = parse_args(argv)
    if opts.get("version"):
        out.write("agb-peer %s\n" % (VERSION,))
        return 0
    pane = opts["pane"]
    if pane not in PANE_KINDS:
        raise PeerError("--pane must be one of %s (agterm's 0.24.0 --help lists "
                        "more; the binary rejects them)"
                        % ("|".join(PANE_KINDS),))
    lines = positive_int(opts["lines"], "--lines")
    ctl = ctl or Ctl()

    def say(message):
        out.write("agb-peer: %s\n" % (message,))
        out.flush()

    if opts.get("list"):
        return cmd_list(ctl, pane, lines, out)

    want = opts.get("to")
    if not want:
        raise PeerError("--to is required. `agb-peer --list` shows the rows.")
    message = opts.get("message")
    if opts.get("stdin"):
        if message:
            raise PeerError("give a message or --stdin, not both")
        message = sys.stdin.read()
    body = compose(message, opts.get("from")
                   or os.environ.get("AGB_PEER_FROM") or "peer")

    session = resolve(ctl, want)
    say("peer: %s (%s), status %s"
        % (session.get("name") or "?", session["id"][:8],
           session.get("status") or "-"))

    if opts.get("dry_run"):
        text, err = ctl.text(session["id"], pane, lines)
        say("mode: %s" % ("unreadable (%s)" % err if err else classify(text)))
        say("would send: %s" % (body,))
        say("dry run -- nothing was typed")
        return 0

    ensure_composer(ctl, session, pane, not opts.get("no_arm"), lines, say)
    wait_ready(ctl, session, pane,
               positive_int(opts["retries"], "--retries"),
               positive_int(opts["interval"], "--interval"),
               bool(opts.get("force")), lines, say)
    deliver(ctl, session, pane, body, not opts.get("no_send"), lines, say)
    return 0


if __name__ == "__main__":
    if len(sys.argv) == 1:
        sys.stderr.write(USAGE)
        sys.exit(1)
    try:
        sys.exit(main(sys.argv[1:]))
    except PeerError as error:
        sys.stderr.write("agb-peer: %s\n" % (error,))
        sys.exit(error.code)
    except KeyboardInterrupt:
        sys.stderr.write("agb-peer: interrupted\n")
        sys.exit(1)
