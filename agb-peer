class PeerError(Exception):
    """Anything the caller should see as a one-line message plus an exit code."""

    def __init__(self, message, code=1):
        Exception.__init__(self, message)
        self.code = code


class RosterConflict(PeerError):
    """The roster changed underneath an editing session: do not write.

    ⚠️ **A distinct class because the caller must RECOVER, not print and exit.**
    Every other `PeerError` here ends the command; this one means an in-memory
    draft is still good and has to be persisted somewhere before anything else
    happens. `agb-peer-setup` catches exactly this to write its recovery draft,
    so anything that reaches that handler as a bare `PeerError` loses the
    draft silently -- which is why `write_roster_file` converts rather than
    letting `roster_bytes`' own failure through.
    """


